#include "modm-donna-32bit.h"

#define RECOVERY_THREAD thread
#define RECOVERY_THREAD_CONST thread const
#define RECOVERY_CONSTANT constant




typedef SHA512_CTX ed25519_hash_context;
#define bignum256modm_bits_per_limb 30
#define bignum256modm_limb_size 9
REC_DEVICE  void
// ed25519_hash_init: computes init for ed 25519.
ed25519_hash_init(RECOVERY_THREAD ed25519_hash_context* ctx) {
	sha512_Init(ctx);
}

REC_DEVICE  void
// ed25519_hash_update: computes update for ed 25519.
ed25519_hash_update(RECOVERY_THREAD ed25519_hash_context* ctx, RECOVERY_THREAD_CONST uint8_t* in, size_t inlen) {
	sha512_Update(ctx, in, inlen);
}

REC_DEVICE  void
// ed25519_hash_final: computes final for ed 25519.
ed25519_hash_final(RECOVERY_THREAD ed25519_hash_context* ctx, RECOVERY_THREAD uint8_t* hash) {
	sha512_Final(ctx, hash);
}

REC_DEVICE  void
// ed25519_hash: computes the related data for ed 25519.
ed25519_hash(RECOVERY_THREAD uint8_t* hash, RECOVERY_THREAD_CONST uint8_t* in, size_t inlen) {
	sha512_Raw(in, inlen, hash);
}


