/* subtraction x-y % m */
REC_DEVICE  void
// sub256_modm: subtracts 256 modm.
sub256_modm(bignum256modm r, const bignum256modm x, const bignum256modm y) {
	bignum256modm negy;
	neg256_modm(negy, y);
	add256_modm(r, x, negy);
