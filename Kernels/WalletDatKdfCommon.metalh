static inline void wallet_aes_add_round_key256(thread uchar state[16],
                                               const thread uint round_keys[60],
                                               int round) {
    for (int col = 0; col < 4; ++col) {
        const uint rk = round_keys[round * 4 + col];
        state[col * 4 + 0] ^= uchar(rk >> 24u);
        state[col * 4 + 1] ^= uchar(rk >> 16u);
        state[col * 4 + 2] ^= uchar(rk >> 8u);
        state[col * 4 + 3] ^= uchar(rk);
    }
}

static inline uchar wallet_aes_gmul(uchar a, uchar b) {
    uchar p = 0u;
    for (int i = 0; i < 8; ++i) {
        if ((b & 1u) != 0u) {
            p ^= a;
        }
        const uchar hi = a & 0x80u;
        a <<= 1u;
        if (hi != 0u) {
            a ^= 0x1bu;
        }
        b >>= 1u;
    }
    return p;
}

static inline void wallet_aes_inv_sub_bytes(thread uchar state[16]) {
    for (int i = 0; i < 16; ++i) {
        state[i] = kWalletAesInvSbox[state[i]];
    }
}

static inline void wallet_aes_inv_shift_rows(thread uchar state[16]) {
    uchar t[16];
    t[0] = state[0];   t[4] = state[4];   t[8] = state[8];    t[12] = state[12];
    t[1] = state[13];  t[5] = state[1];   t[9] = state[5];    t[13] = state[9];
    t[2] = state[10];  t[6] = state[14];  t[10] = state[2];   t[14] = state[6];
    t[3] = state[7];   t[7] = state[11];  t[11] = state[15];  t[15] = state[3];
    for (int i = 0; i < 16; ++i) state[i] = t[i];
}

static inline void wallet_aes_inv_mix_columns(thread uchar state[16]) {
    for (int col = 0; col < 4; ++col) {
        const int i = col * 4;
        const uchar a0 = state[i + 0];
        const uchar a1 = state[i + 1];
        const uchar a2 = state[i + 2];
        const uchar a3 = state[i + 3];
        state[i + 0] = wallet_aes_gmul(a0, 0x0eu) ^ wallet_aes_gmul(a1, 0x0bu) ^ wallet_aes_gmul(a2, 0x0du) ^ wallet_aes_gmul(a3, 0x09u);
        state[i + 1] = wallet_aes_gmul(a0, 0x09u) ^ wallet_aes_gmul(a1, 0x0eu) ^ wallet_aes_gmul(a2, 0x0bu) ^ wallet_aes_gmul(a3, 0x0du);
        state[i + 2] = wallet_aes_gmul(a0, 0x0du) ^ wallet_aes_gmul(a1, 0x09u) ^ wallet_aes_gmul(a2, 0x0eu) ^ wallet_aes_gmul(a3, 0x0bu);
        state[i + 3] = wallet_aes_gmul(a0, 0x0bu) ^ wallet_aes_gmul(a1, 0x0du) ^ wallet_aes_gmul(a2, 0x09u) ^ wallet_aes_gmul(a3, 0x0eu);
    }
}

static inline void wallet_aes256_decrypt_block(const thread uint round_keys[60],
                                               const device uchar* in,
                                               thread uchar out[16]) {
    uchar state[16];
    for (int i = 0; i < 16; ++i) {
        state[i] = in[i];
    }
    wallet_aes_add_round_key256(state, round_keys, 14);
    for (int round = 13; round >= 1; --round) {
        wallet_aes_inv_shift_rows(state);
        wallet_aes_inv_sub_bytes(state);
        wallet_aes_add_round_key256(state, round_keys, round);
        wallet_aes_inv_mix_columns(state);
    }
    wallet_aes_inv_shift_rows(state);
    wallet_aes_inv_sub_bytes(state);
    wallet_aes_add_round_key256(state, round_keys, 0);
    for (int i = 0; i < 16; ++i) {
        out[i] = state[i];
    }
}

static inline bool wallet_aes256_cbc_check_pkcs7_tail(const thread uchar key32[32],
                                                      const thread uchar iv16[16],
                                                      const device uchar* ciphertext,
                                                      uint ciphertext_len,
                                                      thread uint* plaintext_len) {
    if (ciphertext_len == 0u || (ciphertext_len & 15u) != 0u || ciphertext_len > WALLETDAT_MAX_CRYPTED_KEY_LEN) {
        return false;
    }
    uint round_keys[60];
    provider_aes_expand_key(key32, round_keys);

    const uint last_off = ciphertext_len - 16u;
    const device uchar* last_prev = (last_off == 0u) ? nullptr : (ciphertext + last_off - 16u);
    uchar last_plain[16];
    wallet_aes256_decrypt_block(round_keys, ciphertext + last_off, last_plain);
    for (int i = 0; i < 16; ++i) {
        const uchar prev = (last_off == 0u) ? iv16[i] : last_prev[i];
        last_plain[i] = uchar(last_plain[i] ^ prev);
    }
    const uchar pad = last_plain[15];
    if (pad == 0u || pad > 16u || uint(pad) > ciphertext_len) {
        return false;
    }
    for (uint i = 0u; i < uint(pad); ++i) {
        if (last_plain[15u - i] != pad) {
            return false;
        }
    }
    *plaintext_len = ciphertext_len - uint(pad);
    return true;
}

static inline void walletdat_kdf_sha512(const thread uchar* pass,
                                        uint pass_len,
                                        const device WalletDatTarget& target,
                                        thread uchar key32[32],
                                        thread uchar iv16[16]) {
    ulong digest_words[8];
    wallet_sha512_pass_salt_words(pass, pass_len, target.salt, target.salt_len, digest_words);
    for (uint i = 1u; i < target.iterations; ++i) {
        wallet_sha512_digest64_once_words(digest_words);
    }
    for (int i = 0; i < 4; ++i) {
        wallet_store_be64(key32 + i * 8, digest_words[i]);
    }
    for (int i = 0; i < 2; ++i) {
        wallet_store_be64(iv16 + i * 8, digest_words[4 + i]);
    }
}

static inline bool walletdat_target_valid_for_master_check(const device WalletDatTarget& target) {
    if (!(target.iterations != 0u && target.salt_len != 0u && target.salt_len <= WALLET_MAX_SALT_LEN &&
          target.crypted_master_len != 0u && target.crypted_master_len <= WALLETDAT_MAX_CRYPTED_KEY_LEN &&
          (target.crypted_master_len & 15u) == 0u &&
          target.ckey_count <= WALLETDAT_MAX_CKEY_SLOTS)) {
        return false;
    }
    if (target.ckey_count == 0u) {
        return true;
    }
    for (uint i = 0u; i < target.ckey_count; ++i) {
        if (target.crypted_key_len[i] != 0u &&
            target.crypted_key_len[i] <= WALLETDAT_MAX_CRYPTED_KEY_LEN &&
            (target.crypted_key_len[i] & 15u) == 0u &&
            (target.pubkey_len[i] == 33u || target.pubkey_len[i] == 65u)) {
            return true;
        }
    }
    return false;
}

static inline bool walletdat_master_len_valid_for_target(const device WalletDatTarget& target,
                                                         uint master_len) {
    if (target.ckey_count != 0u) {
        return master_len >= 32u;
    }
    if (target.crypted_master_len == 32u) {
        return (target.salt_len == 18u) ? (master_len == 24u) : (master_len == 16u);
    }
    return master_len == 32u;
}

#endif
