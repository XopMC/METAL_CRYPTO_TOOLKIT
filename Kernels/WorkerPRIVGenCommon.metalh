#ifndef METAL_CRYPTO_WORKER_PRIV_GEN_COMMON_METALH
#define METAL_CRYPTO_WORKER_PRIV_GEN_COMMON_METALH

#include "GPUHash.metalh"

static inline void _GetHash160ED(const thread unsigned char* pubkey, thread int& keyLen, thread uint8_t* hash) {
    _GetHash160ED(const_cast<thread unsigned char*>(pubkey), keyLen, hash);
}

#include "WorkerPrivCommon.metalh"
#include "PrngCommon.metalh"

using namespace metal;

constant bool PG_FC_COMPRESSED [[function_constant(0)]];
constant bool PG_FC_UNCOMPRESSED [[function_constant(1)]];
constant bool PG_FC_SEGWIT [[function_constant(2)]];
constant bool PG_FC_P2WSH [[function_constant(3)]];
constant bool PG_FC_TAPROOT [[function_constant(4)]];
constant bool PG_FC_ETHEREUM [[function_constant(5)]];
constant bool PG_FC_XPOINT [[function_constant(6)]];
constant bool PG_FC_XRP_SECP [[function_constant(7)]];
constant bool PG_FC_SUI_SECP [[function_constant(8)]];
constant bool PG_FC_IOTA_SECP [[function_constant(9)]];
constant bool PG_FC_APTOS_SECP [[function_constant(10)]];
constant bool PG_FC_ICP_SECP [[function_constant(11)]];
constant bool PG_FC_FIL_SECP [[function_constant(12)]];
constant bool PG_FC_XTZ_SECP [[function_constant(13)]];
constant bool PG_FC_SECP_ANY [[function_constant(14)]];
constant bool PG_FC_ED_ANY [[function_constant(15)]];
constant bool PG_FC_SOLANA [[function_constant(16)]];
constant bool PG_FC_DOT [[function_constant(17)]];
constant bool PG_FC_ADA [[function_constant(18)]];
constant bool PG_FC_TON [[function_constant(19)]];
constant bool PG_FC_TON_ALL [[function_constant(20)]];
constant bool PG_FC_XRP_ED [[function_constant(21)]];
constant bool PG_FC_APTOS_ED [[function_constant(22)]];
constant bool PG_FC_SUI_ED [[function_constant(23)]];
constant bool PG_FC_IOTA_ED [[function_constant(24)]];
constant bool PG_FC_ICP_ED [[function_constant(25)]];
constant bool PG_FC_XTZ_ED [[function_constant(26)]];
constant bool PG_FC_PRNG_SPECIALIZED [[function_constant(27)]];
constant bool PG_FC_PRNG_IS64 [[function_constant(28)]];
constant int PG_FC_PRNG_ENTROPY_LEN [[function_constant(29)]];
constant int PG_FC_PRNG_MODE [[function_constant(30)]];
constant int PG_FC_PRNG_GEN [[function_constant(31)]];

constant uint PRIV_ROTATE_BATCH_METAL = 32u;
constant uint PRIV_ROTATE_PHASES_METAL = 8u;
constant uint PRIV_GEN_MAX_BATCH = 32u;

static inline void priv_gen_init_found(thread FoundBuffers& found,
                                       device RuntimeConfig& config,
                                       device char* foundStrings,
                                       device uchar* foundPrvKeys,
                                       device uint* foundHash160,
                                       device uint* foundLen,
                                       device uint* foundIter,
                                       device uchar* foundType,
                                       device uint* foundDerivations,
                                       device uint* foundDerivations2,
                                       device char* foundPass,
                                       device ushort* foundPassSize,
                                       device long* foundRound,
                                       device ulong* foundSeed,
                                       device atomic_uint* resultsCount) {
    found.foundStrings = foundStrings;
    found.foundPrvKeys = foundPrvKeys;
    found.foundHash160 = foundHash160;
    found.len = foundLen;
    found.iter = foundIter;
    found.type = foundType;
    found.foundDerivations = foundDerivations;
    found.foundDerivations2 = foundDerivations2;
    found.pass = foundPass;
    found.passSize = foundPassSize;
    found.round = foundRound;
    found.seed = foundSeed;
    found.resultsCount = resultsCount;
    found.maxFounds = config.maxFounds;
}

static inline void priv_gen_init_found_minimal(thread FoundBuffers& found,
                                               device RuntimeConfig& config,
                                               device uchar* foundPrvKeys,
                                               device uint* foundHash160,
                                               device uchar* foundType,
                                               device long* foundRound,
                                               device ulong* foundSeed,
                                               device atomic_uint* resultsCount) {
    priv_gen_init_found(found, config, nullptr, foundPrvKeys, foundHash160, nullptr, nullptr,
                        foundType, nullptr, nullptr, nullptr, nullptr, foundRound, foundSeed,
                        resultsCount);
}

static inline ulong priv_gen_result_seed(const thread ulong* keySeeds, uint keyIndex, ulong seedValue) {
    return (keySeeds != nullptr) ? keySeeds[keyIndex] : seedValue;
}

static inline void priv_gen_store_result_round_seed(device bool* isResult,
                                                    device bool* buffResult,
                                                    const thread uchar* private_key32,
                                                    const thread void* payload,
                                                    uint payload_len,
                                                    uchar type_value,
                                                    long current_round,
                                                    bool store_seed,
                                                    ulong seed_value,
                                                    FoundBuffers found) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
    if (found.resultsCount == nullptr) {
        return;
    }

    const ulong idx64 = found_atomic_add_count(found.resultsCount, 1u);
    if (idx64 >= ulong(found.maxFounds)) {
        return;
    }
    const uint idx = uint(idx64);

    if (found.foundPrvKeys != nullptr && private_key32 != nullptr) {
        found_copy_thread_to_device_uchar(found.foundPrvKeys + ulong(idx) * kFoundPrivateKeyBytes, private_key32, 32u);
    }
    if (found.foundHash160 != nullptr && payload != nullptr && payload_len > 0u) {
        const uint n = min(payload_len, kFoundHashWords * 4u);
        device uchar* out = reinterpret_cast<device uchar*>(found.foundHash160 + ulong(idx) * kFoundHashWords);
        found_copy_thread_to_device_bytes(out, payload, n);
    }
    if (found.type != nullptr) {
        found.type[idx] = type_value;
    }
    if (found.round != nullptr) {
        found.round[idx] = current_round;
    }
    if (store_seed && found.seed != nullptr) {
        found.seed[idx] = seed_value;
    }
}

static inline void priv_gen_check_and_store_words_round_seed(device bool* isResult,
                                                             device bool* buffResult,
                                                             const thread uchar* private_key32,
                                                             const thread void* payload,
                                                             uint payload_len,
                                                             const thread uint* hash_words,
                                                             uchar type_value,
                                                             long current_round,
                                                             bool store_seed,
                                                             ulong seed_value,
                                                             device RuntimeConfig& config,
                                                             device XorFilterState& filters,
                                                             device FilterStorageState& storage,
                                                             const device uchar* bloom_storage,
                                                             const device uchar* xor_storage,
                                                             const device uchar* xor_un_storage,
                                                             const device uchar* xor_uc_storage,
                                                             const device uchar* xor_hc_storage,
                                                             FoundBuffers found) {
    if (priv_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage,
                              xor_uc_storage, xor_hc_storage, hash_words)) {
        priv_gen_store_result_round_seed(isResult, buffResult, private_key32, payload, payload_len, type_value,
                                         current_round, store_seed, seed_value, found);
    }
}

static inline void priv_gen_check_and_store_bytes_round_seed(device bool* isResult,
                                                             device bool* buffResult,
                                                             const thread uchar* private_key32,
                                                             const thread uchar* payload,
                                                             uint payload_len,
                                                             const thread uchar* hash_bytes,
                                                             uint hash_len,
                                                             uchar type_value,
                                                             long current_round,
                                                             bool store_seed,
                                                             ulong seed_value,
                                                             device RuntimeConfig& config,
                                                             device XorFilterState& filters,
                                                             device FilterStorageState& storage,
                                                             const device uchar* bloom_storage,
                                                             const device uchar* xor_storage,
                                                             const device uchar* xor_un_storage,
                                                             const device uchar* xor_uc_storage,
                                                             const device uchar* xor_hc_storage,
                                                             FoundBuffers found) {
    uint hash_words[8];
    priv_hash_words_from_bytes(hash_bytes, hash_words, hash_len);
    priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key32, payload, payload_len, hash_words,
                                              type_value, current_round, store_seed, seed_value, config, filters,
                                              storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
}

static inline void priv_gen_emit_p2wsh_from_pubkey65_round_seed(device bool* isResult,
                                                                device bool* buffResult,
                                                                const thread uchar* private_key32,
                                                                const thread uchar* pubkey65,
                                                                long current_round,
                                                                bool store_seed,
                                                                ulong seed_value,
                                                                device RuntimeConfig& config,
                                                                device XorFilterState& filters,
                                                                device FilterStorageState& storage,
                                                                const device uchar* bloom_storage,
                                                                const device uchar* xor_storage,
                                                                const device uchar* xor_un_storage,
                                                                const device uchar* xor_uc_storage,
                                                                const device uchar* xor_hc_storage,
                                                                FoundBuffers found) {
    uchar p2wsh_hash[32];
    uint p2wsh_rmd[8] = { 0 };
    _GetP2WSHComp(pubkey65, p2wsh_hash, p2wsh_rmd);
    priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key32, p2wsh_hash, 32u, p2wsh_rmd,
                                              0x07u, current_round, store_seed, seed_value, config, filters,
                                              storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
}

static inline void priv_gen_emit_ton_type_round_seed(device bool* isResult,
                                                     device bool* buffResult,
                                                     const thread uchar* private_key32,
                                                     const thread uchar* publ,
                                                     const constant char* ton_kind,
                                                     uchar type_value,
                                                     long current_round,
                                                     bool store_seed,
                                                     ulong seed_value,
                                                     device RuntimeConfig& config,
                                                     device XorFilterState& filters,
                                                     device FilterStorageState& storage,
                                                     const device uchar* bloom_storage,
                                                     const device uchar* xor_storage,
                                                     const device uchar* xor_un_storage,
                                                     const device uchar* xor_uc_storage,
                                                     const device uchar* xor_hc_storage,
                                                     FoundBuffers found) {
    uchar hash_addr[32];
    if (ton_type_enabled_config(config, type_value) &&
        pubkey_to_hash_ton(publ, ton_kind, hash_addr, config.tonTypeMask) &&
        priv_check_hash_bytes(config, filters, storage, bloom_storage, xor_storage, xor_un_storage,
                              xor_uc_storage, xor_hc_storage, hash_addr, 32u)) {
        priv_gen_store_result_round_seed(isResult, buffResult, private_key32, hash_addr, 32u, type_value,
                                         current_round, store_seed, seed_value, found);
    }
}

static inline bool priv_gen_read_indexed_key(const device char* lines,
                                             const device uint* indexes,
                                             uint indexes_size,
                                             uint starter,
                                             device RuntimeConfig& config,
                                             thread uchar out_key[32]) {
    if (lines == nullptr || indexes == nullptr || starter >= indexes_size) {
        return false;
    }

    const uint prev = (starter == 0u) ? 0u : indexes[starter - 1u];
    const uint end = indexes[starter];
    const uint len = (end >= prev) ? (end - prev) : 0u;
    uchar toHash[65] = { 0 };
    const uint copy_len = min(len, 65u);
    for (uint i = 0u; i < copy_len; ++i) {
        toHash[i] = uchar(lines[prev + i]);
    }
    toHash[min(len, 64u)] = 0x80u;

    if (config.isHex != 0u) {
        priv_unhex(toHash, 64u, out_key, 32u);
    } else {
        for (uint i = 0u; i < 32u; ++i) {
            out_key[i] = toHash[i];
        }
    }
    return true;
}

static inline bool priv_gen_entropy_fill_fallback(int entropy_len,
                                                  thread uchar entropy[128],
                                                  ulong seed_l,
                                                  bool is_64,
                                                  int mode,
                                                  int gen,
                                                  ulong skip64) {
    if (entropy_len < 0 || entropy_len > 128) {
        return false;
    }
    if (PG_FC_PRNG_SPECIALIZED) {
        if (PG_FC_PRNG_ENTROPY_LEN < 0 || PG_FC_PRNG_ENTROPY_LEN > 128) {
            return false;
        }
        if (PG_FC_PRNG_IS64) {
            return prng64_entropy_fill(PG_FC_PRNG_ENTROPY_LEN,
                                       entropy,
                                       seed_l,
                                       PG_FC_PRNG_MODE,
                                       PG_FC_PRNG_GEN,
                                       skip64);
        }
        if (seed_l > 0xfffffffful) {
            return false;
        }
        return prng32_entropy_fill(PG_FC_PRNG_ENTROPY_LEN,
                                   entropy,
                                   uint(seed_l),
                                   PG_FC_PRNG_MODE,
                                   PG_FC_PRNG_GEN,
                                   skip64);
    }
    if (is_64) {
        return prng64_entropy_fill(entropy_len, entropy, seed_l, mode, gen, skip64);
    }
    if (seed_l > 0xfffffffful) {
        return false;
    }
    return prng32_entropy_fill(entropy_len, entropy, uint(seed_l), mode, gen, skip64);
}

static inline void priv_gen_fallback_seed(thread uchar out_seed[32]) {
    for (uint i = 0u; i < 32u; ++i) {
        out_seed[i] = 0u;
    }
    ulong v = 0xFFA1B2D3C5042367ul + 0x11ul;
    for (uint i = 0u; i < 8u; ++i) {
        out_seed[i] = uchar((v >> (i * 8u)) & 0xfful);
    }
}

static inline bool priv_gen_seed_from_entropy(thread uchar out_seed[32],
                                              ulong seed_l,
                                              bool is_64,
                                              int entropy_len,
                                              int mode,
                                              int gen,
                                              ulong skip64,
                                              bool direct_fallback_seed) {
    uchar entropy[128] = { 0 };
    bool ok = priv_gen_entropy_fill_fallback(entropy_len, entropy, seed_l, is_64, mode, gen, skip64);
    if (!ok) {
        if (direct_fallback_seed) {
            priv_gen_fallback_seed(out_seed);
            return false;
        }
        uchar fallback[32];
        priv_gen_fallback_seed(fallback);
        for (uint i = 0u; i < 32u; ++i) {
            entropy[i] = fallback[i];
        }
    }
    for (int i = 0; i < 32; ++i) {
        if (entropy_len >= 32) {
            out_seed[i] = entropy[(entropy_len - 32) + i];
        } else {
            out_seed[i] = (i < (32 - entropy_len)) ? 0u : entropy[i - (32 - entropy_len)];
        }
    }
    return true;
}

static inline void priv_gen_hash_variants(const thread uchar seed[32], thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u]) {
    uchar sha256_hash[32] = { 0 };
    uchar keccak256_hash[32] = { 0 };
    priv_copy_thread_uchar(sha256_hash, seed, 32u);
    priv_copy_thread_uchar(keccak256_hash, seed, 32u);
    for (uint i = 0u; i < 32u; i += 2u) {
        sha256_d(reinterpret_cast<thread uint*>(sha256_hash), 32, reinterpret_cast<thread uint*>(sha256_hash));
        priv_copy_thread_uchar(prvKeys + i * 32u, sha256_hash, 32u);
        keccak(reinterpret_cast<thread char*>(keccak256_hash), 32, keccak256_hash, 32);
        priv_copy_thread_uchar(prvKeys + (i + 1u) * 32u, keccak256_hash, 32u);
    }
}

static inline void priv_gen_byte_variants(const thread uchar seed[32],
                                          int iteration,
                                          int bytePosition,
                                          thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u]) {
    for (uint i = 0u; i < 32u; ++i) {
        priv_copy_thread_uchar(prvKeys + i * 32u, seed, 32u);
        prvKeys[i * 32u + uint(bytePosition - 1)] = uchar(i + uint(iteration * 32));
    }
}

static inline void priv_gen_plus_variants(const thread uchar seed_base[32],
                                          int num,
                                          thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u]) {
    for (uint i = 0u; i < 32u; ++i) {
        const uchar add = uchar(num * 32 + int(i) + 1);
        thread uchar* dst = prvKeys + i * 32u;
        for (uint b = 0u; b < 32u; ++b) {
            dst[b] = uchar(seed_base[b] + add);
        }
    }
}

static inline ulong priv_gen_random_word(ulong seed_l, uint lane) {
    ulong s = seed_l ^ (0x9E3779B97F4A7C15ul * ulong(lane + 1u));
    return rng_splitmix64(s);
}

static inline bool priv_gen_add_variants(const thread uchar seed[32],
                                         int true_priv,
                                         ulong seed_l,
                                         thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u]) {
    if (true_priv == 1) {
        for (uint i = 0u; i < 32u; ++i) {
            thread uchar* dst = prvKeys + i * 32u;
            for (uint b = 0u; b < (32u - i); ++b) {
                dst[b] = seed[i + b];
            }
            for (uint b = 0u; b < i; ++b) {
                dst[32u - i + b] = seed[b];
            }
        }
        return true;
    }
    if (true_priv == 2) {
        priv_copy_thread_uchar(prvKeys, seed, 32u);
        for (uint i = 0u; i < 31u; ++i) {
            thread uchar* dst = prvKeys + (1u + i) * 32u;
            priv_copy_thread_uchar(dst, seed, 32u);
            const uint rnd = uint(priv_gen_random_word(seed_l, i));
            dst[rnd % 32u] = uchar(rnd & 0xffu);
        }
        return true;
    }
    if (true_priv == 3) {
        uchar hash_prepared[32];
        priv_copy_thread_uchar(hash_prepared, seed, 32u);
        for (uint i = 0u; i < 32u; ++i) {
            hash_prepared[i] = uchar(hash_prepared[i] + 1u);
            priv_copy_thread_uchar(prvKeys + i * 32u, hash_prepared, 32u);
            hash_prepared[i] = uchar(hash_prepared[i] - 1u);
        }
        return true;
    }
    return false;
}

static inline void priv_gen_rotate_left_variants_32_phase(const thread uchar key32[32],
                                                          thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u],
                                                          int phase) {
    uchar phase_key[32];
    if (phase == 0) {
        priv_copy_thread_uchar(phase_key, key32, 32u);
    } else {
        for (uint i = 0u; i < 32u; ++i) {
            const uchar a = key32[i];
            const uchar b = key32[(i + 1u) & 31u];
            phase_key[i] = uchar((a << uint(phase)) | (b >> uint(8 - phase)));
        }
    }

    uchar phase_key2[64];
    for (uint i = 0u; i < 32u; ++i) {
        phase_key2[i] = phase_key[i];
        phase_key2[i + 32u] = phase_key[i];
    }
    for (uint k = 0u; k < PRIV_ROTATE_BATCH_METAL; ++k) {
        priv_copy_thread_uchar(prvKeys + k * 32u, phase_key2 + k, 32u);
    }
}

static inline int priv_gen_pattern_variants(const device uchar* pattern_start_nibbles,
                                            uchar pattern_len,
                                            ulong gpu_stride,
                                            bool cycle_last_nibble,
                                            uint tid,
                                            thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u]) {
    if (pattern_start_nibbles == nullptr || pattern_len == 0u || pattern_len > 64u || gpu_stride == 0ul) {
        return 0;
    }

    const int variants_per_base = cycle_last_nibble ? ((int(PRIV_THREAD_STEPS) < 16) ? int(PRIV_THREAD_STEPS) : 16) : 1;
    int bases_per_thread = int(PRIV_THREAD_STEPS) / variants_per_base;
    if (bases_per_thread < 1) {
        bases_per_thread = 1;
    }

    int privKeyIx = 0;
    const ulong thread_base_start = ulong(tid) * ulong(bases_per_thread);
    for (int base_idx = 0; base_idx < bases_per_thread && privKeyIx < int(PRIV_THREAD_STEPS); ++base_idx) {
        const ulong offset = (thread_base_start + ulong(base_idx)) * gpu_stride;
        uchar nibbles[64];
        for (uint i = 0u; i < uint(pattern_len); ++i) {
            nibbles[i] = uchar(pattern_start_nibbles[i] & 0x0fu);
        }

        ulong carry = offset;
        for (int pos = int(pattern_len) - 1; pos >= 0; --pos) {
            const uint sum = uint(nibbles[pos]) + uint(carry & 0x0ful);
            nibbles[pos] = uchar(sum & 0x0fu);
            carry = (carry >> 4) + ulong(sum >> 4);
        }
        if (carry != 0ul) {
            continue;
        }

        uchar base_key[32];
        for (uint bi = 0u; bi < 32u; ++bi) {
            const uchar hi = nibbles[(bi * 2u) % uint(pattern_len)];
            const uchar lo = nibbles[(bi * 2u + 1u) % uint(pattern_len)];
            base_key[bi] = uchar((hi << 4u) | lo);
        }

        if (cycle_last_nibble) {
            const uchar last_hi = uchar(base_key[31] & 0xf0u);
            const uchar last_lo = uchar(base_key[31] & 0x0fu);
            int variant_count = int(PRIV_THREAD_STEPS) - privKeyIx;
            if (variant_count > 16) {
                variant_count = 16;
            }
            for (int v = 0; v < variant_count; ++v) {
                priv_copy_thread_uchar(prvKeys + uint(privKeyIx) * 32u, base_key, 32u);
                prvKeys[uint(privKeyIx) * 32u + 31u] = uchar(last_hi | ((last_lo + uchar(v)) & 0x0fu));
                ++privKeyIx;
            }
        } else {
            priv_copy_thread_uchar(prvKeys + uint(privKeyIx) * 32u, base_key, 32u);
            ++privKeyIx;
        }
    }
    return privKeyIx;
}

static inline void priv_gen_emit_ethereum(device bool* isResult,
                                          device bool* buffResult,
                                          const thread uchar* private_key,
                                          const thread uchar* pubkey,
                                          long current_round,
                                          bool store_seed,
                                          ulong seed_value,
                                          device RuntimeConfig& config,
                                          device XorFilterState& filters,
                                          device FilterStorageState& filter_storage,
                                          const device uchar* bloom_storage,
                                          const device uchar* xor_storage,
                                          const device uchar* xor_un_storage,
                                          const device uchar* xor_uc_storage,
                                          const device uchar* xor_hc_storage,
                                          FoundBuffers found) {
    uchar keccak_hash[32];
    uint hash160[8] = { 0 };
    keccak(reinterpret_cast<thread char*>(const_cast<thread uchar*>(pubkey + 1)), 64, keccak_hash, 32);
    for (uint h = 12u, i = 0u; i < 5u; ++i) {
        hash160[i] = uint(keccak_hash[h]) |
                     ((uint(keccak_hash[h + 1u]) << 8u) & 0x0000ff00u) |
                     ((uint(keccak_hash[h + 2u]) << 16u) & 0x00ff0000u) |
                     ((uint(keccak_hash[h + 3u]) << 24u) & 0xff000000u);
        h += 4u;
    }
    priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, hash160, 32u, hash160,
                                              0x06u, current_round, store_seed, seed_value, config, filters,
                                              filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                              xor_uc_storage, xor_hc_storage, found);
}

static inline void priv_gen_emit_taproot(device bool* isResult,
                                         device bool* buffResult,
                                         const thread uchar* private_key,
                                         const thread uchar* taproot_hash,
                                         long current_round,
                                         bool store_seed,
                                         ulong seed_value,
                                         device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& filter_storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         FoundBuffers found) {
    uint hash160[8] = { 0 };
    _GetRMD160(reinterpret_cast<thread uint*>(const_cast<thread uchar*>(taproot_hash)), hash160);
    priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, taproot_hash, 32u, hash160,
                                              0x04u, current_round, store_seed, seed_value, config, filters,
                                              filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                              xor_uc_storage, xor_hc_storage, found);
}

static inline void priv_gen_emit_secp_batch(device bool* isResult,
                                            device bool* buffResult,
                                            thread uchar* prvKeys,
                                            thread uchar* pubKeys,
                                            int count,
                                            constant secp256k1_ge_storage* precPtr,
                                            ulong precPitch,
                                            long current_round,
                                            bool store_seed,
                                            ulong seed_value,
                                            const thread ulong* keySeeds,
                                            bool ethereum_before_taproot,
                                            bool aptos_before_iota,
                                            device RuntimeConfig& config,
                                            device XorFilterState& filters,
                                            device FilterStorageState& filter_storage,
                                            const device uchar* bloom_storage,
                                            const device uchar* xor_storage,
                                            const device uchar* xor_un_storage,
                                            const device uchar* xor_uc_storage,
                                            const device uchar* xor_hc_storage,
                                            FoundBuffers found) {
    uchar tap_hash[PRIV_GEN_MAX_BATCH * 32u];
    if (PG_FC_TAPROOT) {
        TweakTaproot_batch(tap_hash, pubKeys, count, precPtr, size_t(precPitch));
    }

    for (int pkField = 0; pkField < count; ++pkField) {
        thread uchar* private_key = prvKeys + uint(pkField) * 32u;
        thread uchar* pubkey = pubKeys + uint(pkField) * 65u;
        const ulong result_seed = priv_gen_result_seed(keySeeds, uint(pkField), seed_value);
        uint hash160[8] = { 0 };
        int keyLenSkip = 65 * pkField;

        if (PG_FC_UNCOMPRESSED) {
            _GetHash160(pubKeys, keyLenSkip, reinterpret_cast<thread uchar*>(hash160));
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, hash160, 32u, hash160,
                                                      0x01u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_COMPRESSED) {
            _GetHash160Comp(pubKeys, keyLenSkip, reinterpret_cast<thread uchar*>(hash160));
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, hash160, 32u, hash160,
                                                      0x02u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_SEGWIT) {
            if (!PG_FC_COMPRESSED) {
                _GetHash160Comp(pubKeys, keyLenSkip, reinterpret_cast<thread uchar*>(hash160));
            }
            _GetHash160P2SHCompFromHash(hash160, hash160);
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, hash160, 32u, hash160,
                                                      0x03u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_P2WSH) {
            priv_gen_emit_p2wsh_from_pubkey65_round_seed(isResult, buffResult, private_key, pubkey,
                                                         current_round, store_seed, result_seed, config, filters,
                                                         filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                                         xor_uc_storage, xor_hc_storage, found);
        }

        if (ethereum_before_taproot && PG_FC_ETHEREUM) {
            priv_gen_emit_ethereum(isResult, buffResult, private_key, pubkey, current_round, store_seed,
                                   result_seed, config, filters, filter_storage, bloom_storage, xor_storage,
                                   xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_TAPROOT) {
            priv_gen_emit_taproot(isResult, buffResult, private_key, tap_hash + uint(pkField) * 32u,
                                  current_round, store_seed, result_seed, config, filters, filter_storage,
                                  bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (!ethereum_before_taproot && PG_FC_ETHEREUM) {
            priv_gen_emit_ethereum(isResult, buffResult, private_key, pubkey, current_round, store_seed,
                                   result_seed, config, filters, filter_storage, bloom_storage, xor_storage,
                                   xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_XPOINT) {
            uint xpoint_hash[8] = { 0 };
            thread uchar* xbytes = reinterpret_cast<thread uchar*>(xpoint_hash);
            priv_copy_thread_uchar(xbytes, pubkey + 1, 32u);
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, xpoint_hash, 32u,
                                                      xpoint_hash, 0x05u, current_round, store_seed, result_seed,
                                                      config, filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_XRP_SECP) {
            _GetHash160Comp(pubKeys, keyLenSkip, reinterpret_cast<thread uchar*>(hash160));
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, hash160, 32u, hash160,
                                                      0x90u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_SUI_SECP) {
            uchar buff[34];
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey[64] & 1u);
            priv_copy_thread_uchar(buff + 2, pubkey + 1, 32u);
            uchar hash_addr[32];
            Blake2b_256(buff, 34u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 32u,
                                                      hash_addr, 32u, 0x70u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
        if (!aptos_before_iota && PG_FC_IOTA_SECP) {
            uchar buff[34];
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey[64] & 1u);
            priv_copy_thread_uchar(buff + 2, pubkey + 1, 32u);
            uchar hash_addr[32];
            Blake2b_256(buff, 34u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 32u,
                                                      hash_addr, 32u, 0x50u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
        if (PG_FC_APTOS_SECP) {
            uchar buff[35] = { 0 };
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey[64] & 1u);
            priv_copy_thread_uchar(buff + 2, pubkey + 1, 32u);
            buff[34] = 0x02u;
            uchar hash_addr[32];
            sha3_256(reinterpret_cast<thread char*>(buff), 35, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 32u,
                                                      hash_addr, 32u, 0x22u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
        if (aptos_before_iota && PG_FC_IOTA_SECP) {
            uchar buff[34];
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey[64] & 1u);
            priv_copy_thread_uchar(buff + 2, pubkey + 1, 32u);
            uchar hash_addr[32];
            Blake2b_256(buff, 34u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 32u,
                                                      hash_addr, 32u, 0x50u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
        if (PG_FC_ICP_SECP) {
            uchar principal[29] = { 0 };
            icp_principal_from_secp256k1(pubkey, principal);
            uchar hash_addr[32];
            icp_account_identifier(principal, nullptr, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 32u,
                                                      hash_addr, 32u, 0x53u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
        if (PG_FC_FIL_SECP) {
            if (fil_type_enabled(config, 0x41u)) {
                uchar hash_addr[20];
                Blake2b_160(pubkey, 65u, hash_addr);
                priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 20u,
                                                          hash_addr, 20u, 0x41u, current_round, store_seed,
                                                          result_seed, config, filters, filter_storage,
                                                          bloom_storage, xor_storage, xor_un_storage,
                                                          xor_uc_storage, xor_hc_storage, found);
            }
            if (fil_type_enabled(config, 0x42u)) {
                uchar keccak_hash[32];
                uint fil_hash[8] = { 0 };
                keccak(reinterpret_cast<thread char*>(pubkey + 1), 64, keccak_hash, 32);
                for (uint h = 12u, i = 0u; i < 5u; ++i) {
                    fil_hash[i] = uint(keccak_hash[h]) |
                                  ((uint(keccak_hash[h + 1u]) << 8u) & 0x0000ff00u) |
                                  ((uint(keccak_hash[h + 2u]) << 16u) & 0x00ff0000u) |
                                  ((uint(keccak_hash[h + 3u]) << 24u) & 0xff000000u);
                    h += 4u;
                }
                priv_gen_check_and_store_words_round_seed(isResult, buffResult, private_key, fil_hash, 20u,
                                                          fil_hash, 0x42u, current_round, store_seed, result_seed,
                                                          config, filters, filter_storage, bloom_storage,
                                                          xor_storage, xor_un_storage, xor_uc_storage,
                                                          xor_hc_storage, found);
            }
        }
        if (PG_FC_XTZ_SECP) {
            uchar buff[33] = { 0 };
            buff[0] = 0x02u + (pubkey[64] & 1u);
            priv_copy_thread_uchar(buff + 1, pubkey + 1, 32u);
            uchar hash_addr[20];
            Blake2b_160(buff, 33u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, private_key, hash_addr, 20u,
                                                      hash_addr, 20u, 0x92u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                                      xor_hc_storage, found);
        }
    }
}

static inline void priv_gen_emit_ed_batch(device bool* isResult,
                                          device bool* buffResult,
                                          thread uchar* prvKeys,
                                          int count,
                                          long current_round,
                                          bool store_seed,
                                          ulong seed_value,
                                          const thread ulong* keySeeds,
                                          const device SubstratePathDevice* substratePaths,
                                          device RuntimeConfig& config,
                                          device XorFilterState& filters,
                                          device FilterStorageState& filter_storage,
                                          const device uchar* bloom_storage,
                                          const device uchar* xor_storage,
                                          const device uchar* xor_un_storage,
                                          const device uchar* xor_uc_storage,
                                          const device uchar* xor_hc_storage,
                                          FoundBuffers found) {
    uchar pubKeysED[PRIV_GEN_MAX_BATCH * 32u];
    uint hash160[8] = { 0 };
    const bool ed_common_pub_needed = priv_ed_common_pub_needed(PG_FC_SOLANA,
                                                                PG_FC_DOT,
                                                                PG_FC_TON,
                                                                PG_FC_TON_ALL,
                                                                PG_FC_XRP_ED,
                                                                PG_FC_APTOS_ED,
                                                                PG_FC_SUI_ED,
                                                                PG_FC_IOTA_ED,
                                                                PG_FC_ICP_ED,
                                                                PG_FC_XTZ_ED,
                                                                config);
    if (ed_common_pub_needed) {
        priv_ed25519_key_to_pub_batch_config(prvKeys, pubKeysED, count, config);
    }

    for (int pkField = 0; pkField < count; ++pkField) {
        thread uchar* publ = ed_common_pub_needed ? (pubKeysED + uint(pkField) * 32u) : nullptr;
        thread uchar* pkey = prvKeys + uint(pkField) * 32u;
        const thread uchar* next_key = (pkField < (count - 1)) ? (prvKeys + uint(pkField + 1) * 32u) : nullptr;
        const ulong result_seed = priv_gen_result_seed(keySeeds, uint(pkField), seed_value);

        if (PG_FC_DOT) {
            if (dot_type_enabled(config, 0x30u)) {
                adadot_emit_dot_ed25519_public(isResult, buffResult, nullptr, 0ul, pkey, publ,
                                               0u, current_round, 0u, nullptr, 0u, 0ul, store_seed,
                                               result_seed, 0u, false, config, filters, filter_storage,
                                               bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                               xor_hc_storage, found);
            }
            if (dot_type_enabled(config, 0x31u)) {
                adadot_emit_dot_sr25519_seed(isResult, buffResult, nullptr, 0ul, pkey,
                                             0u, current_round, 0u, nullptr, 0u, 0ul, store_seed,
                                             result_seed, 0u, false, config, filters, filter_storage,
                                             bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                             xor_hc_storage, found);
            }
            if (substratePaths != nullptr &&
                config.substratePathCount > 0u &&
                (dot_type_enabled(config, 0x30u) || dot_type_enabled(config, 0x31u))) {
                adadot_emit_dot_substrate_from_seed(isResult, buffResult, nullptr, 0ul, pkey,
                                                    current_round, 0u, nullptr, 0u, 0ul, store_seed,
                                                    result_seed, 0u, false, config, substratePaths, filters,
                                                    filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                                    xor_uc_storage, xor_hc_storage, found);
            }
        }
        if (PG_FC_ADA) {
            adadot_emit_ada_direct_keyset(isResult, buffResult, nullptr, 0ul, pkey, next_key,
                                          0u, current_round, 0u, nullptr, 0u, 0ul, store_seed,
                                          result_seed, 0u, false, false, config, filters, filter_storage,
                                          bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                          xor_hc_storage, found);
        }
        if (PG_FC_SOLANA) {
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, publ, 32u, publ, 32u,
                                                      0x60u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_TON) {
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v3r1", 0x85u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v3r2", 0x86u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v4r2", 0x88u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v5r1", 0x89u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "hv3", 0x8cu, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
        }
        if (PG_FC_TON_ALL) {
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v1r1", 0x80u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v1r2", 0x81u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v1r3", 0x82u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v2r1", 0x83u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v2r2", 0x84u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v3r1", 0x85u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v3r2", 0x86u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v4r1", 0x87u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v4r2", 0x88u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "v5r1", 0x89u, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "hv1", 0x8au, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "hv2", 0x8bu, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
            priv_gen_emit_ton_type_round_seed(isResult, buffResult, pkey, publ, "hv3", 0x8cu, current_round,
                                              store_seed, result_seed, config, filters, filter_storage,
                                              bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                              xor_hc_storage, found);
        }
        if (PG_FC_XRP_ED) {
            int keyLenSkip = 0;
            _GetHash160ED(publ, keyLenSkip, reinterpret_cast<thread uchar*>(hash160));
            priv_gen_check_and_store_words_round_seed(isResult, buffResult, pkey, hash160, 32u, hash160,
                                                      0x91u, current_round, store_seed, result_seed, config,
                                                      filters, filter_storage, bloom_storage, xor_storage,
                                                      xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_APTOS_ED) {
            if (aptos_type_enabled(config, 0x20u)) {
                uchar buff[33] = { 0 };
                priv_copy_thread_uchar(buff, publ, 32u);
                uchar hash_addr[32];
                sha3_256(reinterpret_cast<thread char*>(buff), 33, hash_addr);
                priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr, 32u,
                                                          hash_addr, 32u, 0x20u, current_round, store_seed,
                                                          result_seed, config, filters, filter_storage,
                                                          bloom_storage, xor_storage, xor_un_storage,
                                                          xor_uc_storage, xor_hc_storage, found);
            }
            if (aptos_type_enabled(config, 0x21u)) {
                uchar buff2[34] = { 0 };
                priv_copy_thread_uchar(buff2 + 1, publ, 32u);
                buff2[33] = 0x02u;
                uchar hash_addr2[32];
                sha3_256(reinterpret_cast<thread char*>(buff2), 34, hash_addr2);
                priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr2, 32u,
                                                          hash_addr2, 32u, 0x21u, current_round, store_seed,
                                                          result_seed, config, filters, filter_storage,
                                                          bloom_storage, xor_storage, xor_un_storage,
                                                          xor_uc_storage, xor_hc_storage, found);
            }
        }
        if (PG_FC_SUI_ED) {
            uchar buff[33] = { 0 };
            priv_copy_thread_uchar(buff + 1, publ, 32u);
            uchar hash_addr[32];
            Blake2b_256(buff, 33u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr, 32u,
                                                      hash_addr, 32u, 0x71u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage,
                                                      xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_IOTA_ED) {
            uchar hash_addr[32];
            Blake2b_256(publ, 32u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr, 32u,
                                                      hash_addr, 32u, 0x51u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage,
                                                      xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_ICP_ED) {
            uchar principal[29] = { 0 };
            icp_principal_from_ed25519(publ, principal);
            uchar hash_addr[32];
            icp_account_identifier(principal, nullptr, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr, 32u,
                                                      hash_addr, 32u, 0x52u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage,
                                                      xor_uc_storage, xor_hc_storage, found);
        }
        if (PG_FC_XTZ_ED) {
            uchar hash_addr[20];
            Blake2b_160(publ, 32u, hash_addr);
            priv_gen_check_and_store_bytes_round_seed(isResult, buffResult, pkey, hash_addr, 20u,
                                                      hash_addr, 20u, 0x93u, current_round, store_seed,
                                                      result_seed, config, filters, filter_storage,
                                                      bloom_storage, xor_storage, xor_un_storage,
                                                      xor_uc_storage, xor_hc_storage, found);
        }
    }
}

static inline void priv_gen_process_rounds(device bool* isResult,
                                           device bool* buffResult,
                                           thread uchar prvKeys[PRIV_GEN_MAX_BATCH * 32u],
                                           int count,
                                           ulong round,
                                           constant secp256k1_ge_storage* precPtr,
                                           ulong precPitch,
                                           bool store_seed,
                                           ulong seed_value,
                                           const thread ulong* keySeeds,
                                           bool ethereum_before_taproot,
                                           bool aptos_before_iota,
                                           device RuntimeConfig& config,
                                           device XorFilterState& filters,
                                           device FilterStorageState& filter_storage,
                                           const device uchar* bloom_storage,
                                           const device uchar* xor_storage,
                                           const device uchar* xor_un_storage,
                                           const device uchar* xor_uc_storage,
                                           const device uchar* xor_hc_storage,
                                           FoundBuffers found,
                                           const device SubstratePathDevice* substratePaths) {
    if (count <= 0) {
        return;
    }

    uchar pubKeys[PRIV_GEN_MAX_BATCH * 65u];
    if (round > 0ul) {
        bump_all_keys(prvKeys, count, round, false, nullptr);
    }

    for (ulong i = 0ul; i <= 2ul * round; ++i) {
        const long current_round = long(i) - long(round);

        if (config.secp256 != 0u) {
            if (i == 0ul) {
                secp256k1_ec_pubkey_create_serialized_batch_myunsafe(pubKeys, prvKeys, count, precPtr, size_t(precPitch));
            }
            priv_gen_emit_secp_batch(isResult, buffResult, prvKeys, pubKeys, count, precPtr, precPitch,
                                     current_round, store_seed, seed_value, keySeeds, ethereum_before_taproot,
                                     aptos_before_iota, config, filters, filter_storage, bloom_storage,
                                     xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (config.ed25519 != 0u) {
            priv_gen_emit_ed_batch(isResult, buffResult, prvKeys, count, current_round, store_seed, seed_value,
                                   keySeeds, substratePaths, config, filters, filter_storage, bloom_storage,
                                   xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }

        if (i < 2ul * round) {
            int zeroz[PRIV_GEN_MAX_BATCH] = { 0 };
            bump_all_keys(prvKeys, count, 1ul, true, zeroz);
            if (config.secp256 != 0u) {
                secp256k1_ec_pubkey_create_serialized_batch_myunsafe(pubKeys, prvKeys, count, precPtr, size_t(precPitch));
            }
        }
    }
}

#endif
