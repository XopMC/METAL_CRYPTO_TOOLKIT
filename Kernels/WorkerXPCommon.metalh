static inline uint xp_be32_tap_thread(const thread uchar* p) {
    return (uint(p[0]) << 24u) | (uint(p[1]) << 16u) | (uint(p[2]) << 8u) | uint(p[3]);
}

static inline uint xp_be32_tap_constant(const constant uchar* p) {
    return (uint(p[0]) << 24u) | (uint(p[1]) << 16u) | (uint(p[2]) << 8u) | uint(p[3]);
}

static inline void xp_sha256_taptweak_px_metal(const thread uchar px32[32],
                                               thread uchar out32[32]) {
    thread uint h[8];
    SHA256Initialize(h);

    thread uint w0[16];
    for (int i = 0; i < 8; ++i) {
        w0[i] = xp_be32_tap_constant(XP_TAG_TAPTWEAK_METAL + i * 4);
        w0[i + 8] = w0[i];
    }
    SHA256Transform(h, w0);

    thread uint w1[16];
    for (int i = 0; i < 8; ++i) {
        w1[i] = xp_be32_tap_thread(px32 + i * 4);
    }
    w1[8] = 0x80000000u;
    for (int i = 9; i < 15; ++i) {
        w1[i] = 0u;
    }
    w1[15] = 0x00000300u;
    SHA256Transform(h, w1);

    for (int i = 0; i < 8; ++i) {
        out32[i * 4 + 0] = uchar(h[i] >> 24u);
        out32[i * 4 + 1] = uchar(h[i] >> 16u);
        out32[i * 4 + 2] = uchar(h[i] >> 8u);
        out32[i * 4 + 3] = uchar(h[i]);
    }
}

static inline void xp_tweak_taproot_metal(thread uchar* out32,
                                          const thread uchar* pub_uncomp,
                                          const constant secp256k1_ge_storage* precPtr,
                                          size_t precPitch) {
    const thread uchar* p = pub_uncomp;
    if (p[0] != 0x04u) {
        for (int k = 0; k < 32; ++k) {
            out32[k] = 0u;
        }
        return;
    }

    secp256k1_fe x;
    secp256k1_fe y;
    secp256k1_fe_set_b32(&x, p + 1);
    secp256k1_fe_set_b32(&y, p + 33);

    secp256k1_ge point;
    secp256k1_ge_set_xy(&point, &x, &y);
    secp256k1_fe_normalize_var(&point.y);
    if (secp256k1_fe_is_odd(&point.y)) {
        secp256k1_ge neg = point;
        secp256k1_fe_negate(&neg.y, &neg.y, 1);
        point = neg;
    }

    thread uchar px32[32];
    thread uchar tweak32[32];
    secp256k1_fe_normalize_var(&point.x);
    secp256k1_fe_get_b32(px32, &point.x);
    xp_sha256_taptweak_px_metal(px32, tweak32);

    secp256k1_scalar tweak_scalar;
    secp256k1_scalar_set_b32(&tweak_scalar, tweak32, nullptr);

    secp256k1_gej tweak_j;
    secp256k1_ecmult_big(&tweak_j, &tweak_scalar, precPtr, precPitch);
    secp256k1_gej out_j;
    secp256k1_gej_add_ge_var(&out_j, &tweak_j, &point, nullptr);
    if (out_j.infinity != 0) {
        for (int k = 0; k < 32; ++k) {
            out32[k] = 0u;
        }
        return;
    }

    secp256k1_fe z_inv;
    secp256k1_fe_inv_all_var(1, &z_inv, &out_j.z);
    secp256k1_ge out_ge;
    secp256k1_ge_set_gej_zinv(&out_ge, &out_j, &z_inv);
    secp256k1_fe_normalize_var(&out_ge.y);
    if (secp256k1_fe_is_odd(&out_ge.y)) {
        secp256k1_ge_neg(&out_ge, &out_ge);
    }
    secp256k1_fe_normalize_var(&out_ge.x);
    secp256k1_fe_get_b32(out32, &out_ge.x);
}

static inline ulong xp_atomic_add_count(device atomic_uint* counter, uint value) {
    const uint low = atomic_fetch_add_explicit(counter, value, memory_order_relaxed);
    if (low + value < low) {
        atomic_fetch_add_explicit(counter + 1, 1u, memory_order_relaxed);
    }
    const uint high = atomic_load_explicit(counter + 1, memory_order_relaxed);
    return (ulong(high) << 32u) | ulong(low);
}

static inline bool xp_check_hash_words(device RuntimeConfig& config,
                                       device XorFilterState& filters,
                                       device FilterStorageState& storage,
                                       const device uchar* bloom_storage,
                                       const device uchar* xor_storage,
                                       const device uchar* xor_un_storage,
                                       const device uchar* xor_uc_storage,
                                       const device uchar* xor_hc_storage,
                                       const thread uint* hash_words,
                                       uint payload_len) {
    return filter_check_hash_payload(config, filters, storage, bloom_storage, xor_storage,
                                     xor_un_storage, xor_uc_storage, xor_hc_storage,
                                     hash_words, payload_len);
}

static inline void xp_emit_result(device bool* isResult,
                                  device bool* buffResult,
                                  uchar profile_kind,
                                  uchar path_id,
                                  uint pid,
                                  uint key_index,
                                  uint line_index,
                                  const thread uchar priv32[32],
                                  uchar type_value,
                                  const thread void* payload,
                                  uint payload_len,
                                  uchar arch_id,
                                  ulong source_state,
                                  uint seed_time0,
                                  uint seed_time1,
                                  uchar variant_id,
                                  device XpReplayResult* xp_results,
                                  device atomic_uint* xp_count,
                                  uint max_founds) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
    if (xp_results == nullptr || xp_count == nullptr) {
        return;
    }
    const ulong ridx = xp_atomic_add_count(xp_count, 1u);
    if (ridx >= ulong(max_founds)) {
        return;
    }
    device XpReplayResult& out = xp_results[ridx];
    for (int i = 0; i < 32; ++i) {
        out.priv[i] = priv32[i];
    }
    for (uint i = 0u; i < XP_REPLAY_PAYLOAD_MAX_METAL; ++i) {
        out.payload[i] = 0u;
    }
    uint n = min(payload_len, XP_REPLAY_PAYLOAD_MAX_METAL);
    if (payload != nullptr) {
        const thread uchar* p = reinterpret_cast<const thread uchar*>(payload);
        for (uint i = 0u; i < n; ++i) {
            out.payload[i] = p[i];
        }
    }
    out.profile_kind = profile_kind;
    out.path_id = path_id;
    out.type = type_value;
    out.payload_len = uchar(n);
    out.pid = pid;
    out.key_index = key_index;
    out.line_index = line_index;
    out.source_state = source_state;
    out.seed_time0 = seed_time0;
    out.seed_time1 = seed_time1;
    out.reserved[0] = arch_id;
    out.reserved[1] = variant_id;
    out.reserved[2] = 0u;
    out.reserved[3] = 0u;
}

static inline bool xp_priv_to_xy(const constant secp256k1_ge_storage* precPtr,
                                 size_t precPitch,
                                 const thread uchar priv32[32],
                                 thread uchar pubkey65[65],
                                 thread ulong px[4],
                                 thread ulong py[4]) {
    pubkey65[0] = 0x04u;
    const int ok = secp256k1_ec_pubkey_create(reinterpret_cast<thread secp256k1_pubkey*>(pubkey65 + 1),
                                              priv32,
                                              precPtr,
                                              precPitch);
    if (ok == 0) {
        return false;
    }
    for (int w = 0; w < 4; ++w) {
        const int off = (3 - w) * 8;
        px[w] = profanity_load_be64(pubkey65 + 1 + off);
        py[w] = profanity_load_be64(pubkey65 + 33 + off);
    }
    return true;
}

static inline void xp_check_emit_targets(device bool* isResult,
                                         device bool* buffResult,
                                         const constant secp256k1_ge_storage* precPtr,
                                         ulong precPitch,
                                         uchar profile_kind,
                                         uchar path_id,
                                         uint pid,
                                         uint key_index,
                                         uint line_index,
                                         const thread uchar priv32[32],
                                         uchar arch_id,
                                         ulong source_state,
                                         uint seed_time0,
                                         uint seed_time1,
                                         uchar variant_id,
                                         bool do_c,
                                         bool do_u,
                                         bool do_s,
                                         bool do_r,
                                         bool do_x,
                                         bool do_e,
                                         device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         device XpReplayResult* xp_results,
                                         device atomic_uint* xp_count) {
    thread uchar pubkey65[65];
    thread ulong px[4];
    thread ulong py[4];
    if (!xp_priv_to_xy(precPtr, size_t(precPitch), priv32, pubkey65, px, py)) {
        return;
    }

    thread uint h[8] = { 0u };
    thread uint comp_hash[8] = { 0u };
    const uchar odd_py = uchar(py[0] & 1ul);
    const bool need_comp = do_c || do_s || (XP_FC_P2WSH && config.p2wsh != 0u);

    if (need_comp) {
        _GetHash160Comp_fast(px, odd_py, reinterpret_cast<thread uchar*>(comp_hash));
    }
    if (do_c) {
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, comp_hash, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x02u, comp_hash, 20u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (do_u) {
        _GetHash160Uncomp_fast(px, py, reinterpret_cast<thread uchar*>(h));
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, h, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x01u, h, 20u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (do_s) {
        for (int i = 0; i < 8; ++i) {
            h[i] = comp_hash[i];
        }
        _GetHash160P2SHCompFromHash(h, h);
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, h, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x03u, h, 20u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (XP_FC_P2WSH && config.p2wsh != 0u) {
        thread uchar p2wsh_hash[32];
        thread uint p2wsh_rmd[8] = { 0u };
        _GetP2WSHComp_fast(px, odd_py, p2wsh_hash, p2wsh_rmd);
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, p2wsh_rmd, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x07u, p2wsh_hash, 32u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (do_r) {
        thread uchar taproot_hash[32];
        xp_tweak_taproot_metal(taproot_hash, pubkey65, precPtr, size_t(precPitch));
        _GetRMD160(reinterpret_cast<thread uint*>(taproot_hash), h);
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, h, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x04u, taproot_hash, 32u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (do_x) {
        thread uint xpoint[8] = { 0u };
        u64x4_to_x32(px, reinterpret_cast<thread unsigned char*>(xpoint));
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, xpoint, 32u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x05u, xpoint, 32u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
    if (do_e) {
        thread uint eth_hash160[5] = { 0u };
        keccak_eth64_tail20_from_xy(px, py, eth_hash160);
        if (xp_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, eth_hash160, 20u)) {
            xp_emit_result(isResult, buffResult, profile_kind, path_id, pid, key_index, line_index,
                           priv32, 0x06u, eth_hash160, 20u, arch_id, source_state, seed_time0,
                           seed_time1, variant_id, xp_results, xp_count, config.maxFounds);
        }
    }
}

static inline uint xp_mask_variant_index(ulong mask, uint ordinal, uint count) {
    uint seen = 0u;
    for (uint i = 0u; i < count; ++i) {
        if ((mask & (1ul << i)) == 0ul) {
            continue;
        }
        if (seen == ordinal) {
            return i;
        }
        ++seen;
    }
    return count;
}

struct XpRandstormPosixRand48CoreMetal {
    ulong x;

    static inline void init(thread XpRandstormPosixRand48CoreMetal& r, ulong seed) {
        r.x = (seed << 16) | 0x330eul;
    }

    inline ulong step() thread {
        x = (x * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
        return x;
    }

    inline uint lrand31() thread {
        return uint(step() >> 17);
    }
};

template<int DEG, int SEP, int WARMUP>
struct XpRandstormGlibcRandomFeedbackMetal {
    uint state[DEG];
    int fptr;
    int rptr;

    static inline void init(thread XpRandstormGlibcRandomFeedbackMetal& r, ulong seed) {
        r.fptr = SEP;
        r.rptr = 0;
        uint s = uint(seed);
        if (s == 0u) {
            s = 1u;
        }
        r.state[0] = s;
        for (int i = 1; i < DEG; ++i) {
            r.state[i] = uint((16807ul * ulong(r.state[i - 1])) % 0x7ffffffful);
        }
        for (int i = 0; i < WARMUP; ++i) {
            (void)r.next31();
        }
    }

    inline uint next31() thread {
        const uint sum = state[fptr] + state[rptr];
        state[fptr] = sum;
        const uint result = sum >> 1;
        if (++fptr >= DEG) {
            fptr = 0;
        }
        if (++rptr >= DEG) {
            rptr = 0;
        }
        return result;
    }
};

struct RandstormV8_2011Profile64 {
    uint hi;
    uint lo;

    static inline void init(thread RandstormV8_2011Profile64& r, ulong seed) {
        r.hi = uint(seed >> 32);
        r.lo = uint(seed);
        if (r.hi == 0u) {
            r.hi = 1u;
        }
        if (r.lo == 0u) {
            r.lo = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        hi = 36969u * (hi & 0xffffu) + (hi >> 16);
        lo = 18273u * (lo & 0xffffu) + (lo >> 16);
        const uint random_bits = (hi << 16) + (lo & 0xffffu);
        return ushort((random_bits & 0x3fffffffu) >> 14);
    }
};

struct RandstormV8_2015Profile64 {
    ushort a;
    ushort b;
    ushort c;
    ushort d;

    static inline void init(thread RandstormV8_2015Profile64& r, ulong seed) {
        r.a = ushort(seed & 0xfffful);
        r.b = ushort((seed >> 16) & 0xfffful);
        r.c = ushort((seed >> 32) & 0xfffful);
        r.d = ushort((seed >> 48) & 0xfffful);
        if (r.a < 2u) {
            r.a = 1u;
        }
        if (r.b < 2u) {
            r.b = 1u;
        }
        if (r.c < 2u) {
            r.c = 1u;
        }
        if (r.d < 2u) {
            r.d = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        const uint r0 = 18030u * uint(a) + uint(b);
        const uint r1 = 36969u * uint(c) + uint(d);
        a = ushort(r0 & 0xffffu);
        b = ushort(r0 >> 16);
        c = ushort(r1 & 0xffffu);
        d = ushort(r1 >> 16);
        return ushort((r0 ^ r1) >> 4);
    }
};

struct RandstormSpiderMonkeyLcg48Profile64 {
    ulong state;

    static inline void init(thread RandstormSpiderMonkeyLcg48Profile64& r, ulong seed) {
        r.state = seed & 0xfffffffffffful;
        if (r.state == 0ul) {
            r.state = 1ul;
        }
    }

    inline ushort next_pool_u16() thread {
        state = (state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
        const ushort out = ushort((state >> 32) & 0xfffful);
        state = (state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
        return out;
    }
};

struct RandstormJscWeakRandomProfile64 {
    uint low;
    uint high;

    static inline void init(thread RandstormJscWeakRandomProfile64& r, ulong seed) {
        r.low = uint(seed) ^ 0x49616e42u;
        r.high = uint(seed);
    }

    inline ushort next_pool_u16() thread {
        high = (high << 16) + (high >> 16);
        high += low;
        low += high;
        return ushort(high >> 16);
    }
};

struct RandstormLcg32Profile64 {
    uint state;

    static inline void init(thread RandstormLcg32Profile64& r, ulong seed) {
        r.state = uint(seed);
    }

    inline ushort next_pool_u16() thread {
        state = state * 1664525u + 1013904223u;
        return ushort(state >> 16);
    }
};

struct RandstormV8ClassicMwcProfile64 {
    uint hi;
    uint lo;

    static inline void init(thread RandstormV8ClassicMwcProfile64& r, ulong seed) {
        r.hi = uint(seed >> 32);
        r.lo = uint(seed);
        if (r.hi == 0u) {
            r.hi = 1u;
        }
        if (r.lo == 0u) {
            r.lo = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        hi = 36969u * (hi & 0xffffu) + (hi >> 16);
        lo = 18273u * (lo & 0xffffu) + (lo >> 16);
        const uint random_bits = (hi << 16) + (lo & 0xffffu);
        return ushort(random_bits >> 16);
    }
};

struct RandstormV8AltMwcProfile64 {
    uint state0;
    uint state1;

    static inline void init(thread RandstormV8AltMwcProfile64& r, ulong seed) {
        r.state0 = uint(seed >> 32);
        r.state1 = uint(seed);
        if (r.state0 == 0u) {
            r.state0 = 1u;
        }
        if (r.state1 == 0u) {
            r.state1 = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        state0 = 18030u * (state0 & 0xffffu) + (state0 >> 16);
        state1 = 36969u * (state1 & 0xffffu) + (state1 >> 16);
        const uint random_bits = (state0 << 16) + (state1 & 0xffffu);
        return ushort(random_bits >> 16);
    }
};

struct RandstormV8Mwc1616Profile64 {
    uint state0;
    uint state1;

    static inline void init(thread RandstormV8Mwc1616Profile64& r, ulong seed) {
        r.state0 = uint(seed >> 32);
        r.state1 = uint(seed);
        if (r.state0 == 0u) {
            r.state0 = 1u;
        }
        if (r.state1 == 0u) {
            r.state1 = 2u;
        }
    }

    inline ushort next_pool_u16() thread {
        state0 = 18030u * (state0 & 0xffffu) + (state0 >> 16);
        state1 = 30903u * (state1 & 0xffffu) + (state1 >> 16);
        const uint random_bits = (state0 << 16) + (state1 & 0xffffu);
        return ushort(random_bits >> 16);
    }
};

struct RandstormMsvcRandSeed64 {
    uint state;

    static inline void init(thread RandstormMsvcRandSeed64& r, ulong seed) {
        r.state = uint(seed);
    }

    inline uint next_seed_word() thread {
        state = state * 214013u + 2531011u;
        return (state >> 16) & 0x7fffu;
    }
};

struct RandstormAnsiRandSeed64 {
    uint state;

    static inline void init(thread RandstormAnsiRandSeed64& r, ulong seed) {
        r.state = uint(seed);
    }

    inline uint next_seed_word() thread {
        state = state * 1103515245u + 12345u;
        return (state >> 16) & 0x7fffu;
    }
};

struct RandstormLrand48Seed64 {
    XpRandstormPosixRand48CoreMetal core;

    static inline void init(thread RandstormLrand48Seed64& r, ulong seed) {
        XpRandstormPosixRand48CoreMetal::init(r.core, seed);
    }

    inline uint next_seed_word() thread {
        return core.lrand31();
    }
};

struct RandstormGlibcRandomType3Seed64 {
    XpRandstormGlibcRandomFeedbackMetal<31, 3, 310> core;

    static inline void init(thread RandstormGlibcRandomType3Seed64& r, ulong seed) {
        XpRandstormGlibcRandomFeedbackMetal<31, 3, 310>::init(r.core, seed);
    }

    inline uint next_seed_word() thread {
        return core.next31();
    }
};

template <typename SeedProfile>
static inline ulong randstorm_v8init_math_state64(ulong seed) {
    thread SeedProfile seed_profile;
    SeedProfile::init(seed_profile, seed);
    uint hi = seed_profile.next_seed_word();
    uint lo = seed_profile.next_seed_word();
    if (hi == 0u) {
        hi = seed_profile.next_seed_word();
    }
    if (lo == 0u) {
        lo = seed_profile.next_seed_word();
    }
    if (hi == 0u) {
        hi = 1u;
    }
    if (lo == 0u) {
        lo = 1u;
    }
    return (ulong(hi) << 32) | ulong(lo);
}

static inline void randstorm_arc4_seed_int64(thread uchar pool[256], thread int& pptr, uint x) {
    pool[pptr++] ^= uchar(x & 255u);
    pool[pptr++] ^= uchar((x >> 8) & 255u);
    pool[pptr++] ^= uchar((x >> 16) & 255u);
    pool[pptr++] ^= uchar((x >> 24) & 255u);
    if (pptr >= 256) {
        pptr -= 256;
    }
}

static inline void randstorm_arc4_init64(thread uchar S[256], const thread uchar pool[256]) {
    for (int n = 0; n < 256; ++n) {
        S[n] = uchar(n);
    }
    uchar k = 0u;
    for (int n = 0; n < 256; ++n) {
        k = uchar(k + S[n] + pool[n]);
        const uchar t = S[n];
        S[n] = S[k];
        S[k] = t;
    }
}

static inline uchar randstorm_arc4_next_byte64(thread uchar S[256], thread uchar& i, thread uchar& j) {
    i = uchar(i + 1u);
    j = uchar(j + S[i]);
    const uchar t = S[i];
    S[i] = S[j];
    S[j] = t;
    return S[uchar(t + S[i])];
}

template <typename Profile>
static inline bool randstorm_direct_bytes_fill_exact_mileage64(int entropy_len,
                                                               thread uchar* entropy,
                                                               uint skip_len,
                                                               ulong math_random_state,
                                                               uint mileage) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    for (uint n = 0u; n < mileage; ++n) {
        (void)profile.next_pool_u16();
    }
    for (uint n = 0u; n < skip_len; ++n) {
        (void)profile.next_pool_u16();
    }
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = uchar(profile.next_pool_u16() >> 8);
    }
    return true;
}

template <typename Profile>
static inline bool randstorm_direct_bytes_low_fill_exact_mileage64(int entropy_len,
                                                                   thread uchar* entropy,
                                                                   uint skip_len,
                                                                   ulong math_random_state,
                                                                   uint mileage) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    for (uint n = 0u; n < mileage; ++n) {
        (void)profile.next_pool_u16();
    }
    for (uint n = 0u; n < skip_len; ++n) {
        (void)profile.next_pool_u16();
    }
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = uchar(profile.next_pool_u16() & 0xffu);
    }
    return true;
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormV8_2011Profile64& profile) {
    profile.hi = 36969u * (profile.hi & 0xffffu) + (profile.hi >> 16);
    profile.lo = 18273u * (profile.lo & 0xffffu) + (profile.lo >> 16);
    const uint random_bits = (profile.hi << 16) + (profile.lo & 0xffffu);
    return uchar(((random_bits & 0x3fffffffu) << 2) & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormV8_2015Profile64& profile) {
    const uint r0 = 18030u * uint(profile.a) + uint(profile.b);
    const uint r1 = 36969u * uint(profile.c) + uint(profile.d);
    profile.a = ushort(r0 & 0xffffu);
    profile.b = ushort(r0 >> 16);
    profile.c = ushort(r1 & 0xffffu);
    profile.d = ushort(r1 >> 16);
    return uchar((r0 ^ r1) & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormSpiderMonkeyLcg48Profile64& profile) {
    profile.state = (profile.state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
    const uint hi26 = uint(profile.state >> 22);
    profile.state = (profile.state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
    const uint lo27 = uint(profile.state >> 21);
    return uchar(((hi26 << 6) | (lo27 >> 21)) & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormJscWeakRandomProfile64& profile) {
    profile.high = (profile.high << 16) + (profile.high >> 16);
    profile.high += profile.low;
    profile.low += profile.high;
    return uchar(profile.high & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormLcg32Profile64& profile) {
    profile.state = profile.state * 1664525u + 1013904223u;
    return uchar(profile.state & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormV8ClassicMwcProfile64& profile) {
    profile.hi = 36969u * (profile.hi & 0xffffu) + (profile.hi >> 16);
    profile.lo = 18273u * (profile.lo & 0xffffu) + (profile.lo >> 16);
    const uint random_bits = (profile.hi << 16) + (profile.lo & 0xffffu);
    return uchar(random_bits & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormV8AltMwcProfile64& profile) {
    profile.state0 = 18030u * (profile.state0 & 0xffffu) + (profile.state0 >> 16);
    profile.state1 = 36969u * (profile.state1 & 0xffffu) + (profile.state1 >> 16);
    const uint random_bits = (profile.state0 << 16) + (profile.state1 & 0xffffu);
    return uchar(random_bits & 0xffu);
}

static inline uchar randstorm_crypto_browserify_byte1(thread RandstormV8Mwc1616Profile64& profile) {
    profile.state0 = 18030u * (profile.state0 & 0xffffu) + (profile.state0 >> 16);
    profile.state1 = 30903u * (profile.state1 & 0xffffu) + (profile.state1 >> 16);
    const uint random_bits = (profile.state0 << 16) + (profile.state1 & 0xffffu);
    return uchar(random_bits & 0xffu);
}

template <typename Profile>
static inline bool randstorm_crypto_browserify_bytes1_fill_exact_mileage64(int entropy_len,
                                                                           thread uchar* entropy,
                                                                           uint skip_len,
                                                                           ulong math_random_state,
                                                                           uint mileage) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    for (uint n = 0u; n < mileage; ++n) {
        (void)randstorm_crypto_browserify_byte1(profile);
    }
    for (uint n = 0u; n < skip_len; ++n) {
        (void)randstorm_crypto_browserify_byte1(profile);
    }
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = randstorm_crypto_browserify_byte1(profile);
    }
    return true;
}

template <typename Profile, bool LowHighPoolOrder>
static inline bool randstorm_pool_fill_exact64(int entropy_len,
                                               thread uchar* entropy,
                                               uint skip_len,
                                               ulong math_random_state) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    const uint skip_words = skip_len >> 1;
    for (uint n = 0u; n < skip_words; ++n) {
        (void)profile.next_pool_u16();
    }
    const bool skip_low_byte = (skip_len & 1u) != 0u;
    int out = 0;
    if (skip_low_byte && out < entropy_len) {
        const ushort t = profile.next_pool_u16();
        entropy[out++] = LowHighPoolOrder ? uchar(t >> 8) : uchar(t & 255u);
    }
    while (out < entropy_len) {
        const ushort t = profile.next_pool_u16();
        if (LowHighPoolOrder) {
            entropy[out++] = uchar(t & 255u);
            if (out < entropy_len) {
                entropy[out++] = uchar(t >> 8);
            }
        } else {
            entropy[out++] = uchar(t >> 8);
            if (out < entropy_len) {
                entropy[out++] = uchar(t & 255u);
            }
        }
    }
    return true;
}

template <typename Profile, bool LowHighPoolOrder>
static inline bool randstorm_jsbn_arc4_fill_exact_events_mileage64(int entropy_len,
                                                                   thread uchar* entropy,
                                                                   uint skip_len,
                                                                   ulong math_random_state,
                                                                   uint seed_time0,
                                                                   uint seed_time1,
                                                                   uint seed_event_count,
                                                                   uint screen_seed_x,
                                                                   uint screen_seed_y,
                                                                   uint mileage) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    for (uint n = 0u; n < mileage; ++n) {
        (void)profile.next_pool_u16();
    }
    thread uchar pool[256];
    int pptr = 0;
    while (pptr < 256) {
        const ushort t = profile.next_pool_u16();
        if (LowHighPoolOrder) {
            pool[pptr++] = uchar(t & 255u);
            pool[pptr++] = uchar(t >> 8);
        } else {
            pool[pptr++] = uchar(t >> 8);
            pool[pptr++] = uchar(t & 255u);
        }
    }
    pptr = 0;
    randstorm_arc4_seed_int64(pool, pptr, seed_time0);
    const bool repeat_seed_time = (seed_event_count & XP_RANDSTORM_SEED_EVENTS_REPEAT_FLAG_METAL) != 0u;
    const uint seed_event_count_only = seed_event_count & XP_RANDSTORM_SEED_EVENTS_COUNT_MASK_METAL;
    for (uint event_i = 0u; event_i < seed_event_count_only; ++event_i) {
        randstorm_arc4_seed_int64(pool, pptr, repeat_seed_time ? seed_time0 : (seed_time0 + event_i + 1u));
    }
    if ((seed_event_count & XP_RANDSTORM_SEED_EVENTS_SCREEN_ZERO_FLAG_METAL) != 0u) {
        randstorm_arc4_seed_int64(pool, pptr, screen_seed_x);
        randstorm_arc4_seed_int64(pool, pptr, screen_seed_y);
    }
    randstorm_arc4_seed_int64(pool, pptr, seed_time1);

    thread uchar S[256];
    randstorm_arc4_init64(S, pool);
    uchar i = 0u;
    uchar j = 0u;
    for (uint n = 0u; n < skip_len; ++n) {
        (void)randstorm_arc4_next_byte64(S, i, j);
    }
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = randstorm_arc4_next_byte64(S, i, j);
    }
    return true;
}

template <typename SeedProfile, typename MathProfile, bool LowHighPoolOrder>
static inline bool randstorm_v8init_jsbn_fill_exact_events_mileage64(int entropy_len,
                                                                     thread uchar* entropy,
                                                                     uint skip_len,
                                                                     ulong seed,
                                                                     uint seed_time0,
                                                                     uint seed_time1,
                                                                     uint seed_event_count,
                                                                     uint screen_seed_x,
                                                                     uint screen_seed_y,
                                                                     uint mileage) {
    const ulong math_state = randstorm_v8init_math_state64<SeedProfile>(seed);
    return randstorm_jsbn_arc4_fill_exact_events_mileage64<MathProfile, LowHighPoolOrder>(
        entropy_len, entropy, skip_len, math_state, seed_time0, seed_time1,
        seed_event_count, screen_seed_x, screen_seed_y, mileage);
}

template <typename SeedProfile, typename MathProfile>
static inline bool randstorm_v8init_direct_bytes_fill_exact_mileage64(int entropy_len,
                                                                      thread uchar* entropy,
                                                                      uint skip_len,
                                                                      ulong seed,
                                                                      uint mileage) {
    const ulong math_state = randstorm_v8init_math_state64<SeedProfile>(seed);
    return randstorm_direct_bytes_fill_exact_mileage64<MathProfile>(
        entropy_len, entropy, skip_len, math_state, mileage);
}

template <typename SeedProfile, typename MathProfile>
static inline bool randstorm_v8init_direct_bytes_low_fill_exact_mileage64(int entropy_len,
                                                                          thread uchar* entropy,
                                                                          uint skip_len,
                                                                          ulong seed,
                                                                          uint mileage) {
    thread MathProfile profile;
    MathProfile::init(profile, randstorm_v8init_math_state64<SeedProfile>(seed));
    for (uint n = 0u; n < mileage; ++n) {
        (void)profile.next_pool_u16();
    }
    for (uint n = 0u; n < skip_len; ++n) {
        (void)profile.next_pool_u16();
    }
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = uchar(profile.next_pool_u16() & 0xffu);
    }
    return true;
}

template <typename SeedProfile, typename MathProfile, bool LowHighPoolOrder>
static inline bool randstorm_v8init_pool32_fill_exact_mileage64(int entropy_len,
                                                                thread uchar* entropy,
                                                                uint skip_len,
                                                                ulong seed,
                                                                uint mileage) {
    const ulong pool_skip64 = ulong(skip_len) + ulong(mileage) * 2ul;
