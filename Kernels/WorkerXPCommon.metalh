        XpTimeMt19937Metal::init(rng, uint(seed));
        for (uint key_index = 0u; key_index < keys_per_pid; ++key_index) {
            thread uchar priv32[32];
            rng.next_priv_le_limbs(priv32);
            xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind,
                                  uchar(XP_TIME_MT_VARIANT_MT19937_U32_LE_LIMBS_METAL),
                                  0u, key_index, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                                  seed, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                                  config, filters, storage, bloom_storage, xor_storage,
                                  xor_un_storage, xor_uc_storage, xor_hc_storage,
                                  xp_results, xp_count);
        }
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_SHA256_DIRECT_METAL)) {
        if (keys_per_pid == 0u || randstorm_state_count == 0ul || path_count == 0u || path_mask == 0ul) {
            return;
        }
        const ulong state_idx = linear % randstorm_state_count;
        const ulong variant_idx = linear / randstorm_state_count;
        if (variant_idx >= ulong(path_count)) {
            return;
        }
        const uint variant = xp_mask_variant_index(path_mask, uint(variant_idx), XP_SHA256_DIRECT_VARIANT_COUNT_METAL);
        if (variant >= XP_SHA256_DIRECT_VARIANT_COUNT_METAL) {
            return;
        }
        const ulong input = randstorm_state_start + state_idx;
        thread uchar priv32[32];
        if (!xp_sha256_direct_priv_metal(input, variant, priv32)) {
            return;
        }
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, uchar(variant),
                              0u, 0u, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              input, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_PID_HASH_DIRECT_METAL)) {
        if (randstorm_state_count == 0ul || path_count == 0u || path_mask == 0ul) {
            return;
        }
        const ulong state_idx = linear % randstorm_state_count;
        const ulong variant_idx = linear / randstorm_state_count;
        if (variant_idx >= ulong(path_count)) {
            return;
        }
        const uint variant = xp_mask_variant_index(path_mask, uint(variant_idx), XP_PID_HASH_DIRECT_VARIANT_COUNT_METAL);
        if (variant >= XP_PID_HASH_DIRECT_VARIANT_COUNT_METAL) {
            return;
        }
        const ulong pid = randstorm_state_start + state_idx;
        thread uchar priv32[32];
        if (!xp_pid_hash_direct_priv_metal(pid, variant, priv32)) {
            return;
        }
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, uchar(variant),
                              uint(pid), 0u, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              pid, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_LOWBITS_DIRECT_METAL)) {
        if (randstorm_state_count == 0ul || path_count == 0u || path_mask == 0ul) {
            return;
        }
        const ulong state_idx = linear % randstorm_state_count;
        const ulong variant_idx = linear / randstorm_state_count;
        if (variant_idx >= ulong(path_count)) {
            return;
        }
        const ulong value = randstorm_state_start + state_idx;
        thread uchar priv32[32];
        if (!xp_lowbits_direct_priv_metal(value, XP_LOWBITS_DIRECT_VARIANT_BE64_METAL, priv32)) {
            return;
        }
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind,
                              uchar(XP_LOWBITS_DIRECT_VARIANT_BE64_METAL),
                              uint(value), 0u, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              value, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_PYBTC_MT_METAL)) {
        if (keys_per_pid == 0u || randstorm_state_count == 0ul || path_count == 0u || path_mask == 0ul) {
            return;
        }
        const bool has_time = randstorm_time_count != 0u;
        const ulong key_count = ulong(keys_per_pid);
        const ulong time_count = has_time ? ulong(randstorm_time_count) : 1ul;
        ulong rem = linear;
        const ulong key_idx = rem % key_count;
        rem /= key_count;
        const ulong time_idx = has_time ? (rem % time_count) : 0ul;
        rem /= time_count;
        const ulong state_idx = rem % randstorm_state_count;
        rem /= randstorm_state_count;
        const ulong variant_idx = rem;
        if (variant_idx >= ulong(path_count)) {
            return;
        }
        const uint variant = xp_mask_variant_index(path_mask, uint(variant_idx), XP_PYBTC_MT_VARIANT_COUNT_METAL);
        if (variant >= XP_PYBTC_MT_VARIANT_COUNT_METAL) {
            return;
        }
        const ulong base_state = randstorm_state_start + state_idx;
        const uint ts_lo = has_time ? (randstorm_time_start + uint(time_idx)) : 0u;
        const uint key_index = uint(key_idx);
        thread XpPybtcMtMetal rng;
        XpPybtcMtMetal::init(rng, uint(base_state));
        for (uint k = 0u; k < key_index; ++k) {
            thread uchar dummy[32];
            rng.next_priv(dummy, variant, ts_lo);
        }
        thread uchar priv32[32];
        rng.next_priv(priv32, variant, ts_lo);
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, uchar(variant),
                              ts_lo, key_index, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              base_state, ts_lo, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_NANO_JAVA_RANDOM_METAL)) {
        if (keys_per_pid == 0u || randstorm_state_count == 0ul || path_count == 0u || path_mask == 0ul) {
            return;
        }
        const ulong state_idx = linear % randstorm_state_count;
        const ulong variant_idx = linear / randstorm_state_count;
        if (variant_idx >= ulong(path_count)) {
            return;
        }
        const ulong seed = randstorm_state_start + state_idx;
        thread XpNanoJavaRandomMetal rng;
        XpNanoJavaRandomMetal::init(rng, seed);
        for (uint key_index = 0u; key_index < keys_per_pid; ++key_index) {
            thread uchar priv32[32];
            rng.next_priv(priv32);
            xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind,
                                  uchar(XP_NANO_JAVA_RANDOM_VARIANT_HEX64_METAL),
                                  0u, key_index, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                                  seed, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                                  config, filters, storage, bloom_storage, xor_storage,
                                  xor_un_storage, xor_uc_storage, xor_hc_storage,
                                  xp_results, xp_count);
        }
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_PYWALLET_TS_WEAK_METAL)) {
        if (randstorm_state_count == 0ul) {
            return;
        }
        const ulong state_idx = linear % randstorm_state_count;
        const ulong variant_idx = (path_count > 0u) ? (linear / randstorm_state_count) : 0ul;
        if (path_count > 0u && variant_idx >= ulong(path_count)) {
            return;
        }
        const uint ts_lo = uint(randstorm_state_start + state_idx);
        thread uchar priv32[32];
        xp_pywallet_ts_weak_next_priv_metal(priv32, ts_lo);
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind,
                              uchar(XP_PYWALLET_TS_WEAK_VARIANT_SHA256_METAL),
                              ts_lo, 0u, 0xffffffffu, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              ulong(ts_lo), 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_CGR_STATE_METAL) || XP_PROFILE_MATCH(XP_PROFILE_CGR_BRIDGE_METAL) ||
        XP_PROFILE_MATCH(XP_PROFILE_CGR_XOR_METAL) || XP_PROFILE_MATCH(XP_PROFILE_CGR_CHAIN_METAL) ||
        XP_PROFILE_MATCH(XP_PROFILE_CGR_CHAIN_BRIDGE_METAL)) {
        const uint local_line = uint(linear);
        if (cgr_inputs == nullptr || local_line >= cgr_count) {
            return;
        }
        thread uchar priv32[32];
        xp_cgr_state_generate_priv_metal(&cgr_inputs[local_line], profile_kind, priv32);
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, 0xffu,
                              0u, 0u, input_line_base + local_line, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              0ul, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_RAW32_METAL)) {
        const uint local_line = uint(linear);
        if (cgr_inputs == nullptr || local_line >= cgr_count) {
            return;
        }
        thread uchar priv32[32];
        for (int i = 0; i < 20; ++i) {
            priv32[i] = cgr_inputs[local_line].state20[i];
        }
        for (int i = 0; i < 12; ++i) {
            priv32[20 + i] = cgr_inputs[local_line].aux20[i];
        }
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, 0xffu,
                              0u, 0u, input_line_base + local_line, priv32, 0xffu,
                              0ul, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
    if (XP_PROFILE_MATCH(XP_PROFILE_SSLEAY_STIR_METAL)) {
        const uint local_line = uint(linear);
        if (ssleay_inputs == nullptr || local_line >= ssleay_count) {
            return;
        }
        thread uchar priv32[32];
        if (!xp_ssleay_stir_generate_priv_metal(&ssleay_inputs[local_line], priv32)) {
            return;
        }
        xp_check_emit_targets(isResult, buffResult, precPtr, precPitch, profile_kind, 0xffu,
                              0u, 0u, input_line_base + local_line, priv32, XP_OPENSSL_ARCH_NONE_METAL,
                              0ul, 0u, 0u, 0u, do_c, do_u, do_s, do_r, do_x, do_e,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage,
                              xp_results, xp_count);
        return;
    }
}

#endif
