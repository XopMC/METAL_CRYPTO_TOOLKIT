class Prng64Lua54Xoshiro256StarStar {
    ulong s0;
    ulong s1;
    ulong s2;
    ulong s3;
public:
    explicit Prng64Lua54Xoshiro256StarStar(ulong seed) {
        s0 = seed;
        s1 = 0xfful;
        s2 = seed ^ 0x4c55413534583236ul;
        s3 = 0ul;
        for (int i = 0; i < 16; ++i) (void)next();
    }
    ulong next() {
        ulong a0 = s0;
        ulong a1 = s1;
        ulong a2 = s2;
        ulong a3 = s3;
        const ulong result = prng64_rotl64(a1 * 5ul, 7) * 9ul;
        const ulong t = a1 << 17u;
        a2 ^= a0;
        a3 ^= a1;
        a1 ^= a2;
        a0 ^= a3;
        a2 ^= t;
        a3 = prng64_rotl64(a3, 45);
        s0 = a0; s1 = a1; s2 = a2; s3 = a3;
        return result;
    }
};

