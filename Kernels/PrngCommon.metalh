template <int N, int POS1>
class Prng64SFMT64Core {
    ulong state[N];
    int idx;
public:
    explicit Prng64SFMT64Core(ulong seed) : idx(N) {
        ulong sm = seed;
        for (int i = 0; i < N; ++i) state[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        if (idx >= N) {
            for (int i = 0; i < N; ++i) {
                const ulong x = state[i];
                const ulong y = state[(i + POS1) % N];
                state[i] = (x >> 1u) ^ y ^ (x << 1u);
            }
            idx = 0;
        }
        return state[idx++];
    }
};

