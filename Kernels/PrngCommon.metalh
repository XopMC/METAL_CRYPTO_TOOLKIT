struct Prng32Sober128State32 {
    uint R[kPrng32Sober128N32];
    uint initR[kPrng32Sober128N32];
    uint konst;
    uint sbuf;
    int nbuf;
};

// Device helper: prng32_sober128_off_32.
static inline int prng32_sober128_off_32(int zero, int i) {
    int x = zero + i;
    return (x >= kPrng32Sober128N32) ? (x - kPrng32Sober128N32) : x;
}

// Device helper: prng32_sober128_ror32_32.
static inline uint prng32_sober128_ror32_32(uint x, unsigned r) {
    return (x >> r) | (x << (32u - r));
}

// Device helper: prng32_sober128_step_32.
static inline void prng32_sober128_step_32(thread uint* R, int z) {
    const int i0 = prng32_sober128_off_32(z, 0);
    const uint r0 = R[i0];
    R[i0] = R[prng32_sober128_off_32(z, 15)] ^
        R[prng32_sober128_off_32(z, 4)] ^
        (r0 << 8) ^
        kPrng32Sober128Multab32[(r0 >> 24) & 0xff];
}

// Device helper: prng32_sober128_nlfunc_32.
static inline uint prng32_sober128_nlfunc_32(const thread Prng32Sober128State32* st, int z) {
    uint t = st->R[prng32_sober128_off_32(z, 0)] + st->R[prng32_sober128_off_32(z, 16)];
    t ^= kPrng32Sober128Sbox32[(t >> 24) & 0xff];
    t = prng32_sober128_ror32_32(t, 8);
    t = ((t + st->R[prng32_sober128_off_32(z, 1)]) ^ st->konst) + st->R[prng32_sober128_off_32(z, 6)];
    t ^= kPrng32Sober128Sbox32[(t >> 24) & 0xff];
    t += st->R[prng32_sober128_off_32(z, 13)];
    return t;
}

// Device helper: prng32_sober128_cycle_32.
static inline void prng32_sober128_cycle_32(thread uint* R) {
    prng32_sober128_step_32(R, 0);
    const uint t = R[0];
    for (int i = 1; i < kPrng32Sober128N32; ++i) {
        R[i - 1] = R[i];
    }
    R[kPrng32Sober128N32 - 1] = t;
}

// Device helper: prng32_sober128_nltap_32.
static inline uint prng32_sober128_nltap_32(const thread Prng32Sober128State32* st) {
    return prng32_sober128_nlfunc_32(st, 0);
}

// Device helper: prng32_sober128_dround_32.
static inline void prng32_sober128_dround_32(thread Prng32Sober128State32* st, int z) {
    prng32_sober128_step_32(st->R, z);
    const uint t = prng32_sober128_nlfunc_32(st, z + 1);
    st->R[prng32_sober128_off_32(z + 1, kPrng32Sober128Foldp32)] ^= t;
}

// Device helper: prng32_sober128_diffuse_32.
static inline void prng32_sober128_diffuse_32(thread Prng32Sober128State32* st) {
    for (int z = 0; z < kPrng32Sober128N32; ++z) {
        prng32_sober128_dround_32(st, z);
    }
}

// Device helper: prng32_sober128_save_state_32.
static inline void prng32_sober128_save_state_32(thread Prng32Sober128State32* st) {
    memcpy(st->initR, st->R, sizeof(st->R));
}

// Device helper: prng32_sober128_reload_state_32.
static inline void prng32_sober128_reload_state_32(thread Prng32Sober128State32* st) {
    memcpy(st->R, st->initR, sizeof(st->R));
}

// Device helper: prng32_sober128_gen_konst_32.
static inline void prng32_sober128_gen_konst_32(thread Prng32Sober128State32* st) {
    uint new_konst = 0u;
    do {
        prng32_sober128_cycle_32(st->R);
        new_konst = prng32_sober128_nltap_32(st);
    } while ((new_konst & 0xff000000u) == 0u);
    st->konst = new_konst;
}

// Device helper: prng32_sober128_setup_32.
static inline void prng32_sober128_setup_32(thread Prng32Sober128State32* st, thread const uchar* key, int key_len) {
    st->R[0] = 1u;
    st->R[1] = 1u;
    for (int i = 2; i < kPrng32Sober128N32; ++i) {
        st->R[i] = st->R[i - 1] + st->R[i - 2];
    }
    st->konst = kPrng32Sober128InitKonst32;
    for (int i = 0; i < key_len; i += 4) {
        const uint k = prng32_provider_load_u32_le32(key + i);
        st->R[kPrng32Sober128Keyp32] += k;
        prng32_sober128_cycle_32(st->R);
        st->R[kPrng32Sober128Foldp32] ^= prng32_sober128_nltap_32(st);
    }
    st->R[kPrng32Sober128Keyp32] += (uint)key_len;
    prng32_sober128_diffuse_32(st);
    prng32_sober128_gen_konst_32(st);
    prng32_sober128_save_state_32(st);
    st->sbuf = 0u;
    st->nbuf = 0;
}

// Device helper: prng32_sober128_setiv_32.
static inline void prng32_sober128_setiv_32(thread Prng32Sober128State32* st, thread const uchar* iv, int iv_len) {
    prng32_sober128_reload_state_32(st);
    for (int i = 0; i < iv_len; i += 4) {
        const uint k = prng32_provider_load_u32_le32(iv + i);
        st->R[kPrng32Sober128Keyp32] += k;
        prng32_sober128_cycle_32(st->R);
        st->R[kPrng32Sober128Foldp32] ^= prng32_sober128_nltap_32(st);
    }
    st->R[kPrng32Sober128Keyp32] += (uint)iv_len;
    prng32_sober128_diffuse_32(st);
    st->sbuf = 0u;
    st->nbuf = 0;
}

// Device helper: prng32_sober128_keystream_32.
static inline void prng32_sober128_keystream_32(thread Prng32Sober128State32* st, thread uchar* out, int out_len) {
    int pos = 0;
    while (st->nbuf != 0 && pos < out_len) {
        out[pos++] = (uchar)(st->sbuf & 0xffu);
        st->sbuf >>= 8;
        st->nbuf -= 8;
    }
    while (out_len - pos >= 4) {
        prng32_sober128_cycle_32(st->R);
        const uint t = prng32_sober128_nltap_32(st);
        out[pos + 0] = (uchar)(t);
        out[pos + 1] = (uchar)(t >> 8);
        out[pos + 2] = (uchar)(t >> 16);
        out[pos + 3] = (uchar)(t >> 24);
        pos += 4;
    }
    if (pos < out_len) {
        prng32_sober128_cycle_32(st->R);
        st->sbuf = prng32_sober128_nltap_32(st);
        st->nbuf = 32;
        while (st->nbuf != 0 && pos < out_len) {
            out[pos++] = (uchar)(st->sbuf & 0xffu);
            st->sbuf >>= 8;
            st->nbuf -= 8;
        }
    }
}

// LibTomCrypt sober128 is a real PRNG surface over the SOBER-128 stream generator.
class Prng32LibTomCryptSober128Prng32 {
    Prng32Sober128State32 st;
    uchar buffer[32];
    int index;
// Device helper: refill.
    void refill() {
        prng32_sober128_keystream_32(&st, buffer, (int)sizeof(buffer));
        index = 0;
    }
public:
    explicit Prng32LibTomCryptSober128Prng32(uint seed) : index(32) {
        uchar ent[40];
        uchar material[64];
        memset(ent, 0, sizeof(ent));
        prng32_provider_fill_material(seed, 0x4c5443534f424552ul, 0x31323850524e4732ul, material, (int)sizeof(material));
        for (int i = 0; i < (int)sizeof(material); ++i) {
            ent[i % (int)sizeof(ent)] ^= material[i];
        }
        memset(buffer, 0, sizeof(buffer));
        prng32_sober128_setup_32(&st, ent, 32);
        prng32_sober128_setiv_32(&st, ent + 32, 8);
    }
    uint next() {
        if (index > 28) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(buffer + index);
        index += 4;
        return out;
    }
};

template <typename Gen32>
static inline void prng32_generate_entropy_shared(thread Gen32& gen,
                                                  int number_of_bytes,
                                                  thread uchar* entropy,
                                                  int mode,
                                                  ulong skip32) {
    mode = prng32_canonicalize_mode(mode);
    if (mode < 0) return;

    for (ulong i = 0ul; i < skip32; ++i) {
        (void)gen.next();
    }

    if (mode > 20)
    {
        int local_len = number_of_bytes;

        if (mode == 21)
        {
            uchar r[4] = { 0 };
#pragma unroll 1
            for (int i = 0; i < local_len; i++) {
                if (i % sizeof(r) == 0) {
                    uint randomNumber = gen.next();
                    uchar B0 = (uchar)(randomNumber & 0xFF);
                    uchar B1 = (uchar)((randomNumber >> 8) & 0xFF);
                    uchar B2 = (uchar)((randomNumber >> 16) & 0xFF);
                    uchar B3 = (uchar)((randomNumber >> 24) & 0xFF);

                    r[0] = B0;
                    r[1] = B1;
                    r[2] = B2;
                    r[3] = B3;
                }
                entropy[i] ^= r[i % sizeof(r)];
            }
        }
        else if (mode >= 22 && mode < 34)
        {
            const uchar combos2[12][2] = {
                {0,1},{0,2},{0,3},
                {1,0},{1,2},{1,3},
                {2,0},{2,1},{2,3},
                {3,0},{3,1},{3,2}
            };
            int idx = mode - 22;
            uchar p = combos2[idx][0], q = combos2[idx][1];
#pragma unroll 1
            for (int i = 0; i < local_len; )
            {
                uint rnd = gen.next();
                uchar B[4] = {
                    uchar(rnd & 0xFF),
                    uchar((rnd >> 8) & 0xFF),
                    uchar((rnd >> 16) & 0xFF),
                    uchar((rnd >> 24) & 0xFF)
                };
                entropy[i++] = B[p];
                if (i < local_len) entropy[i++] = B[q];
            }
        }
        else if (mode >= 34 && mode < 58)
        {
            const uchar combos3[24][3] = {
                {0,1,2},{0,1,3},{0,2,1},{0,2,3},{0,3,1},{0,3,2},
                {1,0,2},{1,0,3},{1,2,0},{1,2,3},{1,3,0},{1,3,2},
