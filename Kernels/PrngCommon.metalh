static constant ulong PRNG64_JAVA_MASK48 = ((1ul << 48u) - 1ul);

static inline ulong prng64_rotl64(ulong x, int r) {
    return (x << uint(r)) | (x >> uint(64 - r));
}

static inline uint prng64_rotl32(uint x, int r) {
    return (x << uint(r)) | (x >> uint(32 - r));
}

static inline ulong prng64_mul64_hi(ulong a, ulong b) {
    const ulong a0 = a & 0xfffffffful;
    const ulong a1 = a >> 32u;
    const ulong b0 = b & 0xfffffffful;
    const ulong b1 = b >> 32u;
    const ulong p0 = a0 * b0;
    const ulong p1 = a0 * b1;
    const ulong p2 = a1 * b0;
    const ulong p3 = a1 * b1;
    const ulong carry = ((p0 >> 32u) + (p1 & 0xfffffffful) + (p2 & 0xfffffffful)) >> 32u;
    return p3 + (p1 >> 32u) + (p2 >> 32u) + carry;
}

static inline ulong prng64_splitmix64_next(thread ulong& x) {
    return rng_splitmix64(x);
}

static inline ulong prng64_mix_murmur64_provider(ulong z) {
    z = (z ^ (z >> 33u)) * 0xff51afd7ed558ccdul;
    z = (z ^ (z >> 33u)) * 0xc4ceb9fe1a85ec53ul;
    return z ^ (z >> 33u);
}

static inline ulong prng64_mix_stafford13_provider(ulong z) {
    z = (z ^ (z >> 30u)) * 0xbf58476d1ce4e5b9ul;
    z = (z ^ (z >> 27u)) * 0x94d049bb133111ebul;
    return z ^ (z >> 31u);
}

static inline ulong prng64_mix_lea_provider(ulong z) {
    z = (z ^ (z >> 32u)) * 0xdaba0b6eb09322e3ul;
    z = (z ^ (z >> 32u)) * 0xdaba0b6eb09322e3ul;
    return z ^ (z >> 32u);
}

static inline uint prng64_provider_load_u32_be(thread const uchar* in) {
    return (uint(in[0]) << 24u) |
           (uint(in[1]) << 16u) |
           (uint(in[2]) << 8u) |
           uint(in[3]);
}

static inline ulong prng64_provider_load_u64_be(thread const uchar* in) {
    return (ulong(prng64_provider_load_u32_be(in)) << 32u) |
           ulong(prng64_provider_load_u32_be(in + 4));
}

static inline void prng64_provider_fill_material(ulong seed,
                                                 ulong domain0,
                                                 ulong domain1,
                                                 thread uchar* out,
                                                 int len) {
    const ulong base = seed ^ domain0;
    int off = 0;
    for (ulong ctr = 0ul; off < len; ++ctr) {
        const ulong word = (ctr & 1ul)
            ? prng64_mix_murmur64_provider((base ^ domain1) + ctr * 0x9e3779b97f4a7c15ul)
            : prng64_mix_stafford13_provider(base + ctr * 0x243f6a8885a308d3ul);
        for (int i = 0; i < 8 && off < len; ++i, ++off) {
            out[off] = uchar(word >> uint(i * 8));
        }
    }
}

static inline void prng64_chacha_quarter_round(thread uint& a,
                                               thread uint& b,
                                               thread uint& c,
                                               thread uint& d) {
    a += b; d ^= a; d = prng64_rotl32(d, 16);
    c += d; b ^= c; b = prng64_rotl32(b, 12);
    a += b; d ^= a; d = prng64_rotl32(d, 8);
    c += d; b ^= c; b = prng64_rotl32(b, 7);
}

static inline void prng64_chacha_block_generic(thread const uint in[16],
                                               thread uint out[16],
                                               int rounds) {
    for (int i = 0; i < 16; ++i) {
        out[i] = in[i];
    }
    for (int i = 0; i < rounds; i += 2) {
        prng64_chacha_quarter_round(out[0], out[4], out[8], out[12]);
        prng64_chacha_quarter_round(out[1], out[5], out[9], out[13]);
        prng64_chacha_quarter_round(out[2], out[6], out[10], out[14]);
        prng64_chacha_quarter_round(out[3], out[7], out[11], out[15]);
        prng64_chacha_quarter_round(out[0], out[5], out[10], out[15]);
        prng64_chacha_quarter_round(out[1], out[6], out[11], out[12]);
        prng64_chacha_quarter_round(out[2], out[7], out[8], out[13]);
        prng64_chacha_quarter_round(out[3], out[4], out[9], out[14]);
    }
    for (int i = 0; i < 16; ++i) {
        out[i] += in[i];
    }
}

class Prng64DotNetRandom {
    int seedArray[56];
    int inext;
    int inextp;
    int InternalSample() {
        const int MBIG = 2147483647;
        int locINext = inext + 1;
        if (locINext >= 56) locINext = 1;
        int locINextp = inextp + 1;
        if (locINextp >= 56) locINextp = 1;
        int retVal = seedArray[locINext] - seedArray[locINextp];
        if (retVal == MBIG) retVal--;
        if (retVal < 0) retVal += MBIG;
        seedArray[locINext] = retVal;
        inext = locINext;
        inextp = locINextp;
        return retVal;
    }
public:
    explicit Prng64DotNetRandom(ulong seed64) {
        const int MBIG = 2147483647;
        const int MSEED = 161803398;
        const uint seed = uint(seed64 & 0xfffffffful);
        const int subtraction = (seed == 0x80000000u) ? 2147483647 : int(seed & 0x7fffffffu);
        int mj = MSEED - subtraction;
        if (mj < 0) mj += MBIG;
        seedArray[55] = mj;
        int mk = 1;
        for (int i = 1; i < 55; ++i) {
            const int ii = (21 * i) % 55;
            seedArray[ii] = mk;
            mk = mj - mk;
            if (mk < 0) mk += MBIG;
            mj = seedArray[ii];
        }
        for (int k = 1; k < 5; ++k) {
            for (int i = 1; i < 56; ++i) {
                seedArray[i] -= seedArray[1 + (i + 30) % 55];
                if (seedArray[i] < 0) seedArray[i] += MBIG;
            }
        }
        inext = 0;
        inextp = 21;
    }
    ulong next() {
        const ulong hi = ulong(uint(InternalSample()));
        const ulong lo = ulong(uint(InternalSample()));
        return (hi << 32u) | lo;
    }
};

class Prng64DotNetXoshiro256StarStar {
    ulong s0;
    ulong s1;
    ulong s2;
    ulong s3;
    ulong splitmix64_local(thread ulong& x) {
        return prng64_splitmix64_next(x);
    }
public:
    explicit Prng64DotNetXoshiro256StarStar(ulong seed) {
        ulong sm = seed ^ 0x6A09E667F3BCC909ul;
        s0 = splitmix64_local(sm);
        s1 = splitmix64_local(sm);
        s2 = splitmix64_local(sm);
        s3 = splitmix64_local(sm);
        if ((s0 | s1 | s2 | s3) == 0ul) s0 = 1ul;
    }
    ulong next() {
        ulong a0 = s0;
        ulong a1 = s1;
        ulong a2 = s2;
        ulong a3 = s3;
        const ulong result = prng64_rotl64(a1 * 5ul, 7) * 9ul;
        const ulong t = a1 << 17u;
        a2 ^= a0;
        a3 ^= a1;
        a1 ^= a2;
        a0 ^= a3;
        a2 ^= t;
        a3 = prng64_rotl64(a3, 45);
        s0 = a0; s1 = a1; s2 = a2; s3 = a3;
        return result;
    }
};

class Prng64JavaThreadLocalRandom {
    ulong state;
public:
    explicit Prng64JavaThreadLocalRandom(ulong seed) {
        state = prng64_mix_stafford13_provider(seed ^ 0x5448524541444c52ul);
    }
    ulong next() {
        state += 0x9e3779b97f4a7c17ul;
        return prng64_mix_murmur64_provider(state);
    }
};

class Prng64JavaSplittableRandom {
    ulong state;
    ulong gamma;
public:
    explicit Prng64JavaSplittableRandom(ulong seed) : state(seed), gamma(0x9E3779B97F4A7C15ul) {}
    ulong next() {
        ulong z = (state += gamma);
        z = (z ^ (z >> 30u)) * 0xBF58476D1CE4E5B9ul;
        z = (z ^ (z >> 27u)) * 0x94D049BB133111EBul;
        return z ^ (z >> 31u);
    }
};

class Prng64L64X128StarStarRandom {
    ulong lcg;
    ulong add;
    ulong x0;
    ulong x1;
public:
    explicit Prng64L64X128StarStarRandom(ulong seed) {
        ulong sm = seed;
        lcg = prng64_splitmix64_next(sm);
        add = prng64_splitmix64_next(sm) | 1ul;
        x0 = prng64_splitmix64_next(sm);
        x1 = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong s0 = x0;
        ulong s1 = x1;
        const ulong out = prng64_rotl64(s0 * 5ul, 7) * 9ul;
        s1 ^= s0;
        x0 = prng64_rotl64(s0, 24) ^ s1 ^ (s1 << 16u);
        x1 = prng64_rotl64(s1, 37);
        lcg = lcg * 0xD1342543DE82EF95ul + add;
        return out + lcg;
    }
};

class Prng64L64X256MixRandom {
    ulong lcg;
    ulong add;
    ulong s[4];
public:
    explicit Prng64L64X256MixRandom(ulong seed) {
        ulong sm = seed;
        lcg = prng64_splitmix64_next(sm);
        add = prng64_splitmix64_next(sm) | 1ul;
        for (int i = 0; i < 4; ++i) s[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong out = prng64_mix_stafford13_provider(s[0] + lcg);
        const ulong t = s[1] << 17u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = prng64_rotl64(s[3], 45);
        lcg = lcg * 0xD1342543DE82EF95ul + add;
        return out;
    }
};

class Prng64JavaL64X1024MixRandom {
    ulong a;
    ulong s;
    ulong x[16];
    int p;
public:
    explicit Prng64JavaL64X1024MixRandom(ulong seed) : p(0) {
        seed ^= 0x6A09E667F3BCC909ul;
        a = prng64_mix_murmur64_provider(seed) | 1ul;
        s = 1ul;
        x[0] = prng64_mix_stafford13_provider(seed);
        for (int i = 1; i < 16; ++i) {
            seed += 0x9e3779b97f4a7c15ul;
            x[i] = prng64_mix_stafford13_provider(seed);
        }
        bool all_zero = true;
        for (int i = 0; i < 16; ++i) all_zero = all_zero && (x[i] == 0ul);
        if (all_zero) {
            ulong v = s;
            for (int i = 0; i < 16; ++i) {
                v += 0x9e3779b97f4a7c15ul;
                x[i] = prng64_mix_stafford13_provider(v);
            }
        }
    }
    ulong next() {
        const int q = p;
        const ulong s0 = x[p = (p + 1) & 15];
        ulong s15 = x[q];
        const ulong result = prng64_mix_lea_provider(s + s0);
        s = 0xd1342543de82ef95ul * s + a;
        s15 ^= s0;
        x[q] = prng64_rotl64(s0, 25) ^ s15 ^ (s15 << 27u);
        x[p] = prng64_rotl64(s15, 36);
        return result;
    }
};

class Prng64L128X128MixRandom {
    ulong l0;
    ulong l1;
    ulong a0;
    ulong a1;
    ulong x0;
    ulong x1;
public:
    explicit Prng64L128X128MixRandom(ulong seed) {
        ulong sm = seed;
        l0 = prng64_splitmix64_next(sm);
        l1 = prng64_splitmix64_next(sm);
        a0 = prng64_splitmix64_next(sm) | 1ul;
        a1 = prng64_splitmix64_next(sm) | 1ul;
        x0 = prng64_splitmix64_next(sm);
        x1 = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong old0 = l0;
        l0 = l0 * 0xD1342543DE82EF95ul + a0;
        l1 = l1 * 0x9E3779B97F4A7C15ul + a1 + ((l0 < old0) ? 1ul : 0ul);
        const ulong s0 = x0;
        ulong s1 = x1;
        const ulong out = prng64_mix_stafford13_provider(s0 + l0 + l1);
        s1 ^= s0;
        x0 = prng64_rotl64(s0, 24) ^ s1 ^ (s1 << 16u);
        x1 = prng64_rotl64(s1, 37);
        return out;
    }
};

class Prng64L128X256MixRandom {
    ulong l0;
    ulong l1;
    ulong a0;
    ulong a1;
    ulong s[4];
public:
    explicit Prng64L128X256MixRandom(ulong seed) {
        ulong sm = seed;
        l0 = prng64_splitmix64_next(sm);
        l1 = prng64_splitmix64_next(sm);
        a0 = prng64_splitmix64_next(sm) | 1ul;
        a1 = prng64_splitmix64_next(sm) | 1ul;
        for (int i = 0; i < 4; ++i) s[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong old0 = l0;
        l0 = l0 * 0xD1342543DE82EF95ul + a0;
        l1 = l1 * 0x9E3779B97F4A7C15ul + a1 + ((l0 < old0) ? 1ul : 0ul);
        const ulong out = prng64_mix_stafford13_provider(s[0] + l0 + l1);
        const ulong t = s[1] << 17u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = prng64_rotl64(s[3], 45);
        return out;
    }
};

class Prng64JavaL128X1024MixRandom {
    ulong ah;
    ulong al;
    ulong sh;
    ulong sl;
    ulong x[16];
    int p;
public:
    explicit Prng64JavaL128X1024MixRandom(ulong seed) : p(0) {
        seed ^= 0x6A09E667F3BCC909ul;
        ah = prng64_mix_murmur64_provider(seed);
        seed += 0x9e3779b97f4a7c15ul;
        al = prng64_mix_murmur64_provider(seed) | 1ul;
        sh = 0ul;
        sl = 1ul;
        x[0] = prng64_mix_stafford13_provider(seed);
        for (int i = 1; i < 16; ++i) {
            seed += 0x9e3779b97f4a7c15ul;
            x[i] = prng64_mix_stafford13_provider(seed);
        }
        bool all_zero = true;
        for (int i = 0; i < 16; ++i) all_zero = all_zero && (x[i] == 0ul);
        if (all_zero) {
            ulong v = sh;
            for (int i = 0; i < 16; ++i) {
                v += 0x9e3779b97f4a7c15ul;
                x[i] = prng64_mix_stafford13_provider(v);
            }
        }
    }
    ulong next() {
        const int q = p;
        const ulong s0 = x[p = (p + 1) & 15];
        ulong s15 = x[q];
        const ulong result = prng64_mix_lea_provider(sh + s0);
        const ulong u = 0x1d605bbb58c8abbful * sl;
        sh = (0x1d605bbb58c8abbful * sh) + prng64_mul64_hi(0x1d605bbb58c8abbful, sl) + sl + ah;
        sl = u + al;
        if (sl < u) ++sh;
        s15 ^= s0;
        x[q] = prng64_rotl64(s0, 25) ^ s15 ^ (s15 << 27u);
        x[p] = prng64_rotl64(s15, 36);
        return result;
    }
};

class Prng64Mt19937ProviderCore {
    uint mt[624];
    int idx;
public:
    explicit Prng64Mt19937ProviderCore(ulong seed) : idx(624) {
        mt[0] = uint(seed);
        for (int i = 1; i < 624; ++i) {
            mt[i] = 1812433253u * (mt[i - 1] ^ (mt[i - 1] >> 30u)) + uint(i);
        }
    }
    void twist() {
        for (int i = 0; i < 624; ++i) {
            const uint y = (mt[i] & 0x80000000u) | (mt[(i + 1) % 624] & 0x7fffffffu);
            mt[i] = mt[(i + 397) % 624] ^ (y >> 1u);
            if ((y & 1u) != 0u) mt[i] ^= 0x9908b0dfu;
        }
        idx = 0;
    }
    uint next32() {
        if (idx >= 624) twist();
        uint y = mt[idx++];
        y ^= y >> 11u;
        y ^= (y << 7u) & 0x9d2c5680u;
        y ^= (y << 15u) & 0xefc60000u;
        y ^= y >> 18u;
        return y;
    }
};

class Prng64PythonRandom {
    Prng64Mt19937ProviderCore core;
public:
    explicit Prng64PythonRandom(ulong seed) : core(seed ^ 0x505954484f4e3634ul) {}
    ulong next() {
        const ulong lo = ulong(core.next32());
        const ulong hi = ulong(core.next32());
        return (hi << 32u) | lo;
    }
};

class Prng64MT19937_64 {
    ulong mt[312];
    int idx;
public:
    explicit Prng64MT19937_64(ulong seed) : idx(312) {
        mt[0] = seed;
        for (int i = 1; i < 312; ++i) {
            mt[i] = 6364136223846793005ul * (mt[i - 1] ^ (mt[i - 1] >> 62u)) + ulong(i);
        }
    }
    ulong next() {
        if (idx >= 312) {
            for (int i = 0; i < 312; ++i) {
                const ulong x = (mt[i] & 0xFFFFFFFF80000000ul) | (mt[(i + 1) % 312] & 0x7FFFFFFFul);
                ulong xa = x >> 1u;
                if ((x & 1ul) != 0ul) xa ^= 0xB5026F5AA96619E9ul;
                mt[i] = mt[(i + 156) % 312] ^ xa;
            }
            idx = 0;
        }
        ulong y = mt[idx++];
        y ^= (y >> 29u) & 0x5555555555555555ul;
        y ^= (y << 17u) & 0x71D67FFFEDA60000ul;
        y ^= (y << 37u) & 0xFFF7EEE000000000ul;
        y ^= y >> 43u;
        return y;
    }
};

class Prng64GoMathRandV2PCG {
    ulong hi;
    ulong lo;
public:
    explicit Prng64GoMathRandV2PCG(ulong seed) {
        ulong z = seed + 0x9E3779B97F4A7C15ul;
        hi = prng64_mix_stafford13_provider(z);
        z += 0x9E3779B97F4A7C15ul;
        lo = prng64_mix_stafford13_provider(z);
        if ((hi | lo) == 0ul) {
            hi = 6364136223846793005ul;
            lo = 1442695040888963407ul;
        }
    }
    ulong next() {
        ulong prod_lo = lo * 4865540595714422341ul;
        ulong prod_hi = prng64_mul64_hi(lo, 4865540595714422341ul);
        prod_hi += hi * 4865540595714422341ul + lo * 2549297995355413924ul;
        const ulong old_lo = prod_lo;
        prod_lo += 1442695040888963407ul;
        const ulong carry = (prod_lo < old_lo) ? 1ul : 0ul;
        prod_hi += 6364136223846793005ul + carry;
        lo = prod_lo;
        hi = prod_hi;
        return hi ^ lo;
    }
};

class Prng64ChaChaProviderCore {
    uint state[16];
    uint buffer[16];
    int idx;
    int rounds;
public:
    void init(ulong seed, int rounds_in, ulong tweak, bool derive_stream) {
        rounds = rounds_in;
        ulong sm = ((seed != 0ul ? seed : 0x9E3779B97F4A7C15ul) ^ tweak);
        const ulong k0 = prng64_splitmix64_next(sm);
        const ulong k1 = prng64_splitmix64_next(sm);
        const ulong k2 = prng64_splitmix64_next(sm);
        const ulong k3 = prng64_splitmix64_next(sm);
        const ulong n0 = derive_stream ? prng64_splitmix64_next(sm) : 0ul;
        state[0] = 0x61707865u;
        state[1] = 0x3320646eu;
        state[2] = 0x79622d32u;
        state[3] = 0x6b206574u;
        state[4] = uint(k0);
        state[5] = uint(k0 >> 32u);
        state[6] = uint(k1);
        state[7] = uint(k1 >> 32u);
        state[8] = uint(k2);
        state[9] = uint(k2 >> 32u);
        state[10] = uint(k3);
        state[11] = uint(k3 >> 32u);
        state[12] = 0u;
        state[13] = 0u;
        state[14] = uint(n0);
        state[15] = uint(n0 >> 32u);
        idx = 16;
    }
    void refill() {
        prng64_chacha_block_generic(state, buffer, rounds);
        ulong ctr = (ulong(state[13]) << 32u) | ulong(state[12]);
        ++ctr;
        state[12] = uint(ctr);
        state[13] = uint(ctr >> 32u);
        idx = 0;
    }
    ulong next64() {
        if (idx >= 16) refill();
        const ulong lo = ulong(buffer[idx]);
        const ulong hi = ulong(buffer[idx + 1]);
        idx += 2;
        return (hi << 32u) | lo;
    }
};

class Prng64GoChaCha8Global {
    Prng64ChaChaProviderCore core;
public:
    explicit Prng64GoChaCha8Global(ulong seed) {
        core.init(seed, 8, 0x474f434841434838ul, false);
    }
    ulong next() { return core.next64(); }
};

// Case 41 implementation notes.
class OpenBSDArc4randomChaCha20_64 {
    Prng64ChaChaProviderCore core;
public:
    explicit OpenBSDArc4randomChaCha20_64(ulong seed) {
        core.init(seed, 20, 0x4f50454e43483230ul, false);
    }
    ulong next() { return core.next64(); }
};

// Case 42 implementation notes.
class OpenBSDArc4randomRC4_64 {
    uchar S[256];
    uchar i;
    uchar j;
    uchar next_byte() {
        i = uchar(i + 1u);
        j = uchar(j + S[i]);
        uchar t = S[i]; S[i] = S[j]; S[j] = t;
        return S[uchar(S[i] + S[j])];
    }
public:
    explicit OpenBSDArc4randomRC4_64(ulong seed) : i(0), j(0) {
        uchar key[40];
        ulong sm = seed ^ 0x4f50454e42534436ul;
        for (int n = 0; n < 40; n += 8) {
            ulong v = rng_splitmix64(sm);
            for (int b = 0; b < 8 && (n + b) < 40; ++b) {
                key[n + b] = uchar(v >> uint(b * 8));
            }
        }
        for (int n = 0; n < 256; ++n) S[n] = uchar(n);
        uchar k = 0;
        for (int n = 0; n < 256; ++n) {
            k = uchar(k + S[n] + key[n % 40]);
            uchar t = S[n]; S[n] = S[k]; S[k] = t;
        }
        for (int n = 0; n < 1024; ++n) (void)next_byte();
    }
    ulong next() {
        ulong v = ulong(next_byte());
        v |= ulong(next_byte()) << 8u;
        v |= ulong(next_byte()) << 16u;
        v |= ulong(next_byte()) << 24u;
        v |= ulong(next_byte()) << 32u;
        v |= ulong(next_byte()) << 40u;
        v |= ulong(next_byte()) << 48u;
        v |= ulong(next_byte()) << 56u;
        return v;
    }
};

// PRNG64 provider-backed cases 43..52.
// PRNG64 cases 43..52 and their helper ranges.
// Requires existing PrngCommon helpers:
//   prng64_provider_fill_material, prng64_mix_stafford13_provider,
//   prng64_mix_murmur64_provider, prng64_store64_le,
//   Prng64ChaChaProviderCore
// Requires existing GPUHash.metalh:
//   SHA256, hmac_sha256
// Requires ProviderAes.metalh:
//   provider_aes_expand_key, provider_aes_encrypt_block

constant uchar PRNG64_PERS_OPENJDK_HASH_DRBG[16] = {
    'O','p','e','n','J','D','K','H','a','s','h','D','R','B','G',0
};
constant uchar PRNG64_PERS_OPENJDK_CTR_DRBG[16] = {
    'O','p','e','n','J','D','K','C','t','r','D','R','B','G',0,0
};
constant uchar PRNG64_PERS_OPENJDK_HMAC_DRBG[16] = {
    'O','p','e','n','J','D','K','H','m','a','c','D','R','B','G',0
};
constant uchar PRNG64_PERS_OPENSSL_CTR_DRBG[16] = {
    'O','p','e','n','S','S','L','C','T','R','D','R','B','G',0,0
};
constant uchar PRNG64_PERS_OPENSSL_HMAC_DRBG[16] = {
    'O','p','e','n','S','S','L','H','M','A','C','D','R','B','G',0
};
constant uchar PRNG64_PERS_OPENSSL_HASH_DRBG[16] = {
    'O','p','e','n','S','S','L','H','A','S','H','D','R','B','G',0
};
constant uchar PRNG64_PERS_BORING_CTR_DRBG[16] = {
    'B','o','r','i','n','g','C','T','R','D','R','B','G',0,0,0
};
constant uchar PRNG64_PERS_WOLFSSL_HASH_DRBG[16] = {
    'w','o','l','f','S','S','L','H','a','s','h','D','R','B','G',0
};

static inline void prng64_case43_52_copy16(thread uchar* dst, constant uchar* src) {
    for (int i = 0; i < 16; ++i) {
        dst[i] = src[i];
    }
}

static inline void prng64_case43_52_be_add_right_aligned(thread uchar* dst,
                                                         int dst_len,
                                                         thread const uchar* src,
                                                         int src_len) {
    uint carry = 0u;
    int i = 0;
    for (; i < src_len && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const int si = src_len - 1 - i;
        const uint sum = uint(dst[di]) + uint(src[si]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
    for (; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = uint(dst[di]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
}

static inline void prng64_case43_52_be_add_u64(thread uchar* dst, int dst_len, ulong value) {
    uint carry = 0u;
    for (int i = 0; i < 8 && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const uint add = uint((value >> uint(i * 8)) & 0xfful);
        const uint sum = uint(dst[di]) + add + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
    for (int i = 8; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = uint(dst[di]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
}

static inline void prng64_case43_52_hash_df_sha256(thread const uchar* input,
                                                   int input_len,
                                                   thread uchar* out,
                                                   int out_len) {
    uchar msg[128];
    uchar digest[32];
    const uint bits = uint(out_len * 8);
    int produced = 0;
    uchar counter = 1u;
    while (produced < out_len) {
        msg[0] = counter++;
        msg[1] = uchar(bits >> 24u);
        msg[2] = uchar(bits >> 16u);
        msg[3] = uchar(bits >> 8u);
        msg[4] = uchar(bits);
        for (int i = 0; i < input_len; ++i) {
            msg[5 + i] = input[i];
        }
        SHA256(msg, size_t(input_len + 5), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        for (int i = 0; i < take; ++i) {
            out[produced + i] = digest[i];
        }
        produced += take;
    }
}

static inline void prng64_case43_52_hashgen_sha256(thread const uchar* value,
                                                   int value_len,
                                                   thread uchar* out,
                                                   int out_len) {
    uchar data[64];
    uchar digest[32];
    for (int i = 0; i < value_len; ++i) {
        data[i] = value[i];
    }
    int produced = 0;
    while (produced < out_len) {
        SHA256(data, size_t(value_len), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        for (int i = 0; i < take; ++i) {
            out[produced + i] = digest[i];
        }
        produced += take;
        prng64_case43_52_be_add_u64(data, value_len, 1ul);
    }
}

static inline void prng64_case43_52_sha256_counter_kdf(thread const uchar* material,
                                                       int material_len,
                                                       uchar domain,
                                                       thread uchar* out,
                                                       int out_len) {
    uchar msg[128];
    uchar digest[32];
    for (int i = 0; i < material_len; ++i) {
        msg[i] = material[i];
    }
    int produced = 0;
    uchar counter = 0u;
    while (produced < out_len) {
        msg[material_len] = domain;
        msg[material_len + 1] = counter++;
        SHA256(msg, size_t(material_len + 2), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        for (int i = 0; i < take; ++i) {
            out[produced + i] = digest[i];
        }
        produced += take;
    }
}

class HashDrbgSha256Provider64Core {
    static constant int kSeedLen = 55;
    uchar value[kSeedLen];
    uchar constant_c[kSeedLen];
    uchar block[32];
    ulong reseed_counter;
    int block_index;

    void post_generate_update() {
        uchar msg[kSeedLen + 1];
        uchar h[32];
        msg[0] = 0x03u;
        for (int i = 0; i < kSeedLen; ++i) {
            msg[1 + i] = value[i];
        }
        SHA256(msg, size_t(kSeedLen + 1), h);
        prng64_case43_52_be_add_right_aligned(value, kSeedLen, h, 32);
        prng64_case43_52_be_add_right_aligned(value, kSeedLen, constant_c, kSeedLen);
        prng64_case43_52_be_add_u64(value, kSeedLen, reseed_counter);
        ++reseed_counter;
    }

    void refill() {
        prng64_case43_52_hashgen_sha256(value, kSeedLen, block, int(sizeof(block)));
        post_generate_update();
        block_index = 0;
    }

public:
    void init(thread const uchar* material, int material_len) {
        uchar tmp[kSeedLen + 1];
        prng64_case43_52_hash_df_sha256(material, material_len, value, kSeedLen);
        tmp[0] = 0x00u;
        for (int i = 0; i < kSeedLen; ++i) {
            tmp[1 + i] = value[i];
        }
        prng64_case43_52_hash_df_sha256(tmp, int(sizeof(tmp)), constant_c, kSeedLen);
        for (int i = 0; i < 32; ++i) {
            block[i] = 0u;
        }
        reseed_counter = 1ul;
        block_index = int(sizeof(block));
    }

    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8u) | ulong(block[block_index + i]);
        }
        block_index += 8;
        return out;
    }
};

class CtrDrbgAes256Provider64Core {
    uchar key[32];
    uchar value[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;

    void expand_key() {
        provider_aes_expand_key(key, round_keys);
    }

    void increment_value() {
        for (int i = 15; i >= 0; --i) {
            value[i] = uchar(value[i] + 1u);
            if (value[i] != 0u) {
                break;
            }
        }
    }

    void update(thread const uchar* provided_data, bool has_provided_data) {
        uchar temp[48];
        for (int i = 0; i < 3; ++i) {
            increment_value();
            provider_aes_encrypt_block(round_keys, value, temp + i * 16);
        }
        if (has_provided_data) {
            for (int i = 0; i < 48; ++i) {
                temp[i] ^= provided_data[i];
            }
        }
        for (int i = 0; i < 32; ++i) {
            key[i] = temp[i];
        }
        for (int i = 0; i < 16; ++i) {
            value[i] = temp[32 + i];
        }
        expand_key();
    }

    void refill() {
        increment_value();
        provider_aes_encrypt_block(round_keys, value, block + 0);
        increment_value();
        provider_aes_encrypt_block(round_keys, value, block + 16);
        update(block, false);
        block_index = 0;
    }

public:
    void init(thread const uchar* material, int material_len, uchar domain_tag) {
        uchar seed[48];
        for (int i = 0; i < 32; ++i) {
            key[i] = 0u;
            block[i] = 0u;
        }
        for (int i = 0; i < 16; ++i) {
            value[i] = 0u;
        }
        expand_key();
        prng64_case43_52_sha256_counter_kdf(material, material_len, domain_tag, seed, int(sizeof(seed)));
        update(seed, true);
        block_index = int(sizeof(block));
    }

    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8u) | ulong(block[block_index + i]);
        }
        block_index += 8;
        return out;
    }
};

class HmacDrbgSha256Provider64Core {
    uchar key[32];
    uchar value[32];
    uchar block[32];
    int block_index;

    void update(thread const uchar* provided, int provided_len) {
        uchar msg[96];
        uchar out[32];
        for (int i = 0; i < 32; ++i) {
            msg[i] = value[i];
        }
        msg[32] = 0x00u;
        if (provided_len > 0) {
            for (int i = 0; i < provided_len; ++i) {
                msg[33 + i] = provided[i];
            }
        }
        hmac_sha256(key, 32, msg, size_t(33 + provided_len), out);
        for (int i = 0; i < 32; ++i) {
            key[i] = out[i];
        }
        hmac_sha256(key, 32, value, 32, out);
        for (int i = 0; i < 32; ++i) {
            value[i] = out[i];
        }
        if (provided_len > 0) {
            for (int i = 0; i < 32; ++i) {
                msg[i] = value[i];
            }
            msg[32] = 0x01u;
            for (int i = 0; i < provided_len; ++i) {
                msg[33 + i] = provided[i];
            }
            hmac_sha256(key, 32, msg, size_t(33 + provided_len), out);
            for (int i = 0; i < 32; ++i) {
                key[i] = out[i];
            }
            hmac_sha256(key, 32, value, 32, out);
            for (int i = 0; i < 32; ++i) {
                value[i] = out[i];
            }
        }
    }

    void refill() {
        hmac_sha256(key, 32, value, 32, block);
        for (int i = 0; i < 32; ++i) {
            value[i] = block[i];
        }
        update(value, 0);
        block_index = 0;
    }

public:
    void init(thread const uchar* material, int material_len) {
        for (int i = 0; i < 32; ++i) {
            key[i] = 0u;
            value[i] = 0x01u;
            block[i] = 0u;
        }
        block_index = 32;
        update(material, material_len);
    }

    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8u) | ulong(block[block_index + i]);
        }
        block_index += 8;
        return out;
    }
};

