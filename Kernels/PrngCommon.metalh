public:
    explicit Prng64PHPRandomEnginePcgOneseq128XslRr64(ulong seed) {
        const Prng64ProviderUint128 initseed = prng64_provider128_make(0ul, seed);
        state = prng64_provider128_make(0ul, 0ul);
        state = prng64_provider_pcg128_step_oneseq(state);
        state = prng64_provider128_add(state, initseed);
        state = prng64_provider_pcg128_step_oneseq(state);
    }
    ulong next() {
        state = prng64_provider_pcg128_step_oneseq(state);
        return prng64_provider_pcg_xsl_rr_output(state);
    }
};

