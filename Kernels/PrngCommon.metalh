class Prng32CakeWalletDartRandom32 {
    ulong state;

    static ulong mix64(ulong n) {
        n = (~n) + (n << 21u);
        n ^= n >> 24u;
        n *= 265ul;
        n ^= n >> 14u;
        n *= 21ul;
        n ^= n >> 28u;
        n += n << 31u;
        return n;
    }

    uint next_state_lo() {
        const ulong lo = state & 0xfffffffful;
        const ulong hi = state >> 32u;
        state = (0xffffda61ul * lo + hi) & 0xfffffffffffffffful;
        return uint(state);
    }

public:
    explicit Prng32CakeWalletDartRandom32(uint seed) {
        state = mix64(ulong(seed));
        if (state == 0ul) state = 0x5a17ul;
        for (int i = 0; i < 4; ++i) {
            (void)next_state_lo();
        }
    }
    uint next() {
        return next_state_lo();
    }
};

