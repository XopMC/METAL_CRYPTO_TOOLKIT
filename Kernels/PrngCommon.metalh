template <int SKIP>
class Prng64Ranlux64DoubleCore {
    ulong x[24];
    int i;
    int j;
    ulong step() {
        const ulong y = (x[j] >= x[i]) ? (x[j] - x[i]) : ((1ul << 53u) + x[j] - x[i]);
        x[i] = y;
        if (--i < 0) i = 23;
        if (--j < 0) j = 23;
        return y;
    }
public:
    explicit Prng64Ranlux64DoubleCore(ulong seed) : i(23), j(3) {
        ulong sm = seed;
        for (int k = 0; k < 24; ++k) {
            x[k] = prng64_splitmix64_next(sm) >> 11u;
        }
    }
    ulong next() {
        ulong y = step();
        for (int k = 0; k < SKIP; ++k) {
            y = step();
        }
        return y << 11u;
    }
};

