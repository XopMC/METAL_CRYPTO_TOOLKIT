template <int ROUNDS>
class Prng64ChaChaRNG64Core {
    uint state[16];
    uint buffer[16];
    int idx;
public:
    explicit Prng64ChaChaRNG64Core(ulong seed) : idx(16) {
        prng64_cases151_chacha_init_from_seed(state, seed);
    }
    void refill() {
        prng64_chacha_block_generic(state, buffer, ROUNDS);
        ulong ctr = (ulong(state[13]) << 32u) | ulong(state[12]);
        ++ctr;
        state[12] = uint(ctr);
        state[13] = uint(ctr >> 32u);
        idx = 0;
    }
    ulong next() {
        if (idx >= 16) refill();
        const ulong lo = ulong(buffer[idx]);
        const ulong hi = ulong(buffer[idx + 1]);
        idx += 2;
        return (hi << 32u) | lo;
    }
};

