class Prng32Rule150Generator {
    uint state;
public:
    explicit Prng32Rule150Generator(uint seed) : state(seed) {}
    uint next() {
        uint nxt = 0u;
        for (int b = 0; b < 32; ++b) {
            const uint l = (state >> uint((b + 1) & 31)) & 1u;
            const uint r = (state >> uint((b + 31) & 31)) & 1u;
            nxt |= (l ^ r) << uint(b);
        }
        state = nxt;
        return state;
    }
};

class Prng32Rule30_32 {
    ulong cells;
public:
    explicit Prng32Rule30_32(uint seed) : cells(ulong(seed ? seed : 1u)) {}
    uint next() {
        uint result = 0u;
        for (int bit = 0; bit < 32; ++bit) {
            result |= uint(cells & 1ul) << uint(bit);
            const ulong n = cells;
            cells = (n >> 1u) ^ (n | (n << 1u));
        }
        return result;
    }
};

