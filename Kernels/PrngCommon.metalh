// PRNG64 cases 151..210.
static inline void prng64_cases151_chacha_init_from_seed(thread uint state[16], ulong seed) {
    if (seed == 0ul) {
        seed = 0xdeadbeefcafebabeul;
    }
    ulong sm = seed;
    const ulong k0 = prng64_splitmix64_next(sm);
    const ulong k1 = prng64_splitmix64_next(sm);
    const ulong k2 = prng64_splitmix64_next(sm);
    const ulong k3 = prng64_splitmix64_next(sm);
    const ulong n0 = prng64_splitmix64_next(sm);

    state[0] = 0x61707865u;
    state[1] = 0x3320646eu;
    state[2] = 0x79622d32u;
    state[3] = 0x6b206574u;
    state[4] = uint(k0);
    state[5] = uint(k0 >> 32u);
    state[6] = uint(k1);
    state[7] = uint(k1 >> 32u);
    state[8] = uint(k2);
    state[9] = uint(k2 >> 32u);
    state[10] = uint(k3);
    state[11] = uint(k3 >> 32u);
    state[12] = 0u;
    state[13] = 0u;
    state[14] = uint(n0);
    state[15] = uint(n0 >> 32u);
}

static inline void prng64_cases151_siphash_round(thread ulong& v0,
                                                  thread ulong& v1,
                                                  thread ulong& v2,
                                                  thread ulong& v3) {
    v0 += v1; v2 += v3;
    v1 = prng64_rotl64(v1, 13);
    v3 = prng64_rotl64(v3, 16);
    v1 ^= v0;
    v3 ^= v2;
    v0 = prng64_rotl64(v0, 32);
    v2 += v1;
    v0 += v3;
    v1 = prng64_rotl64(v1, 17);
    v3 = prng64_rotl64(v3, 21);
    v1 ^= v2;
    v3 ^= v0;
    v2 = prng64_rotl64(v2, 32);
}

