class Prng32CombinedTausGenerator {
    uint ss1, s2, s3;
public:
    explicit Prng32CombinedTausGenerator(uint seed)
        : ss1(seed ^ 0xaaaaaaaau), s2(seed ^ 0x55555555u), s3(seed ^ 0x33333333u) {}
    uint next() {
        ss1 = (((ss1 & 4294967294u) << 12u) ^ (((ss1 << 13u) ^ ss1) >> 19u));
        s2 = (((s2 & 4294967288u) << 4u) ^ (((s2 << 2u) ^ s2) >> 25u));
        s3 = (((s3 & 4294967280u) << 17u) ^ (((s3 << 3u) ^ s3) >> 11u));
        return ss1 ^ s2 ^ s3;
    }
};

