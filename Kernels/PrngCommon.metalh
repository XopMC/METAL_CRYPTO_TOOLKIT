        return ushort(state >> 16u);
    }
    ulong next() {
        ulong v = ulong(next_pool_u16());
        v |= ulong(next_pool_u16()) << 16u;
        v |= ulong(next_pool_u16()) << 32u;
        v |= ulong(next_pool_u16()) << 48u;
        return v;
    }
};

template <typename Profile>
class Prng64RandstormExactArc4Profile {
    Profile profile;
    uchar S[256];
    uchar i;
    uchar j;
public:
    explicit Prng64RandstormExactArc4Profile(ulong seed) : profile(seed), i(0), j(0) {
        uchar pool[256];
        int pptr = 0;
        while (pptr < 256) {
            const ushort t = profile.next_pool_u16();
            pool[pptr++] = uchar(t >> 8u);
            pool[pptr++] = uchar(t & 255u);
        }
        pptr = 0;
        const uint seed32 = uint(seed);
        seed_int(pool, pptr, seed32);
        seed_int(pool, pptr, seed32);
        for (uint n = 0u; n < 256u; ++n) {
            S[n] = uchar(n);
        }
        uchar k = 0u;
        for (uint n = 0u; n < 256u; ++n) {
            k = uchar(k + S[n] + pool[n]);
            const uchar t = S[n];
            S[n] = S[k];
            S[k] = t;
        }
    }
    void seed_int(thread uchar pool[256], thread int& pptr, uint x) {
        pool[pptr++] ^= uchar(x & 255u);
        pool[pptr++] ^= uchar((x >> 8u) & 255u);
        pool[pptr++] ^= uchar((x >> 16u) & 255u);
        pool[pptr++] ^= uchar((x >> 24u) & 255u);
        if (pptr >= 256) {
            pptr -= 256;
        }
    }
    uchar next_byte() {
        i = uchar(i + 1u);
        j = uchar(j + S[i]);
        const uchar t = S[i];
        S[i] = S[j];
        S[j] = t;
        return S[uchar(t + S[i])];
    }
    ulong next() {
        ulong v = ulong(next_byte());
        v |= ulong(next_byte()) << 8u;
        v |= ulong(next_byte()) << 16u;
        v |= ulong(next_byte()) << 24u;
        v |= ulong(next_byte()) << 32u;
        v |= ulong(next_byte()) << 40u;
        v |= ulong(next_byte()) << 48u;
        v |= ulong(next_byte()) << 56u;
        return v;
    }
};

static inline uint prng64_rn_word32(thread Prng64RandstormV8_2015Profile& profile) {
    const uint r0 = 18030u * uint(profile.a) + uint(profile.b);
    const uint r1 = 36969u * uint(profile.c) + uint(profile.d);
    profile.a = ushort(r0 & 0xffffu);
    profile.b = ushort(r0 >> 16u);
    profile.c = ushort(r1 & 0xffffu);
    profile.d = ushort(r1 >> 16u);
    return r0 ^ r1;
}

static inline uint prng64_rn_word32(thread Prng64RandstormSpiderMonkeyLcg48Profile& profile) {
    profile.state = (profile.state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
    const uint hi26 = uint(profile.state >> 22u);
    profile.state = (profile.state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
    const uint lo27 = uint(profile.state >> 21u);
    return (hi26 << 6u) | (lo27 >> 21u);
}

static inline uint prng64_rn_word32(thread Prng64RandstormJscWeakRandomProfile& profile) {
    profile.high = (profile.high << 16u) + (profile.high >> 16u);
    profile.high += profile.low;
    profile.low += profile.high;
    return profile.high;
}

static inline uint prng64_rn_word32(thread Prng64RandstormLcg32Profile& profile) {
    profile.state = profile.state * 1664525u + 1013904223u;
    return profile.state;
}

static inline uchar prng64_browserify_byte1(thread Prng64RandstormV8_2015Profile& profile) {
    return uchar(prng64_rn_word32(profile) & 0xffu);
}

static inline uchar prng64_browserify_byte1(thread Prng64RandstormSpiderMonkeyLcg48Profile& profile) {
    profile.state = (profile.state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
    const uint hi26 = uint(profile.state >> 22u);
    profile.state = (profile.state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
    const uint lo27 = uint(profile.state >> 21u);
    return uchar(((hi26 << 6u) | (lo27 >> 21u)) & 0xffu);
}

static inline uchar prng64_browserify_byte1(thread Prng64RandstormJscWeakRandomProfile& profile) {
    return uchar(prng64_rn_word32(profile) & 0xffu);
}

static inline uchar prng64_browserify_byte1(thread Prng64RandstormLcg32Profile& profile) {
    return uchar(prng64_rn_word32(profile) & 0xffu);
}

template <typename Gen64>
static inline void prng64_generate_entropy_shared(thread Gen64& gen,
                                                  int number_of_bytes,
                                                  thread uchar* entropy,
                                                  int mode,
                                                  ulong skip64) {
    mode = prng64_canonicalize_mode(mode);
    if (mode < 0) return;

    for (ulong i = 0ul; i < skip64; ++i) {
        (void)gen.next();
    }

    if (number_of_bytes <= 0) return;

    if (mode == 13 || mode == 14) {
        int i = 0;
        for (; i + 8 <= number_of_bytes; i += 8) {
            ulong r = gen.next();
            if (mode == 13) prng64_store64_le(entropy + i, r);
            else prng64_store64_be(entropy + i, r);
        }
        if (i < number_of_bytes) {
            ulong r = gen.next();
            uchar tmp[8];
            if (mode == 13) prng64_store64_le(tmp, r);
            else prng64_store64_be(tmp, r);
            for (int k = 0; i < number_of_bytes; i++, k++) entropy[i] = tmp[k];
        }
        return;
    }

    // uniform_int_distribution<uchar>-style (rejection sampling)
    else if (mode == 15) {
        const ulong RANGE = 256ul;
        const ulong MAX64 = 0xfffffffffffffffful;
        const ulong LIMIT = MAX64 - (MAX64 % RANGE); // = MAX64 - 255
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, LIMIT);
            entropy[i] = (uchar)(r & 0xFFu); // r%256 == low byte
        }
        return;
    }

    else if (mode == 16) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            uint mix = (uint)(r ^ (r >> 32));
            entropy[i] = (uchar)(mix >> 24);
        }
        return;
    }

    else if (mode == 17) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            ulong z = r * 0x9E3779B97F4A7C15ul;
            entropy[i] = (uchar)(z >> 56);
        }
        return;
    }

    else if (mode == 18) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong z = gen.next();
            z ^= z >> 33;
            z *= 0xff51afd7ed558ccdul;
            z ^= z >> 33;
            z *= 0xc4ceb9fe1a85ec53ul;
            z ^= z >> 33;
            entropy[i] = (uchar)(z >> 56);
        }
        return;
    }

    else if (mode >= 19 && mode <= 45) {
        int t = mode - 19; // 0..26
        int k = 2;
        int span = 7;

        while (t >= span && k < 8) {
            t -= span;
            ++k;
            --span;
        }
        int start = t;        // 0 .. (8 - k)

        int out = 0;
        while (out < number_of_bytes) {
            ulong r = gen.next();

            uchar bytes[8];
#pragma unroll
            for (int b = 0; b < 8; ++b) {
                bytes[b] = prng64_byte_of_u64(r, b); // 0=LSB .. 7=MSB
            }

#pragma unroll 1
            for (int j = 0; j < k && out < number_of_bytes; ++j, ++out) {
                int idx = start + j;
                entropy[out] = bytes[idx];
            }
        }
        return;
    }

    else if (mode >= 46 && mode <= 72) {
        int t = mode - 46; // 0..26
        int k = 2;
        int span = 7;

        while (t >= span && k < 8) {
            t -= span;
            ++k;
            --span;
        }
        int start = t;        // 0 .. (8 - k)

        int out = 0;
        while (out < number_of_bytes) {
            ulong r = gen.next();

            uchar bytes[8];
#pragma unroll
            for (int b = 0; b < 8; ++b) {
                bytes[b] = prng64_byte_of_u64(r, b);
            }

#pragma unroll 1
            for (int j = 0; j < k && out < number_of_bytes; ++j, ++out) {
                int idx = start + j;
                int rev = 7 - idx;
                entropy[out] = bytes[rev];
            }
        }
        return;
    }

    else if (mode == 73) {
        // Word-swapped byte stream: 3,2,1,0,7,6,5,4 from every 64-bit sample.
        ulong r = 0;
        const int order[8] = { 3, 2, 1, 0, 7, 6, 5, 4 };
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) r = gen.next();
            int idx = order[i & 7];
            entropy[i] = (uchar)((r >> (idx * 8)) & 0xFFu);
        }
        return;
    }

    else if (mode == 74) {
        // Adjacent-byte xor stream from a single 64-bit sample.
        ulong r = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) r = gen.next();
            int idx = i & 7;
            uchar a = (uchar)((r >> (idx * 8)) & 0xFFu);
            uchar b = (uchar)((r >> (((idx + 1) & 7) * 8)) & 0xFFu);
            entropy[i] = (uchar)(a ^ b);
        }
        return;
    }

    else if (mode == 75) {
        // Mix two consecutive words, then stream bytes (LE order).
        ulong mix = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) {
                ulong a = gen.next();
                ulong b = gen.next();
                mix = a ^ ((b << 17) | (b >> 47));
            }
            entropy[i] = (uchar)((mix >> ((i & 7) * 8)) & 0xFFu);
        }
        return;
    }

    else if (mode == 76) {
        // Gray-code transform, take MSB.
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            ulong g = r ^ (r >> 1);
            entropy[i] = (uchar)(g >> 56);
        }
        return;
    }

    else if (mode == 77) {
        // SplitMix-style finalizer, then BE byte stream.
        ulong z = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) {
                z = gen.next();
                z ^= z >> 30; z *= 0xBF58476D1CE4E5B9ul;
                z ^= z >> 27; z *= 0x94D049BB133111EBul;
                z ^= z >> 31;
            }
            entropy[i] = (uchar)((z >> ((7 - (i & 7)) * 8)) & 0xFFu);
        }
        return;
    }

    else if (mode == 78) {
        // Uniform byte via rejection sampling (64-bit source).
        const ulong LIMIT = 0xfffffffffffffffful - (0xfffffffffffffffful % 256ul);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, LIMIT);
            entropy[i] = (uchar)(r & 0xFFu);
        }
        return;
    }
    else if (mode == 79) {
        // 53-bit fraction from one 64-bit sample (nextDouble-style), then floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = prng_scale_power2_fraction_to_byte(r >> 11, 53u);
        }
        return;
    }
    else if (mode == 80) {
        // drand48-like conversion: low 48 bits as fraction, then floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = prng_scale_power2_fraction_to_byte(r & 0xFFFFFFFFFFFFul, 48u);
        }
        return;
    }
    else if (mode == 81) {
        // Java-like nextInt(255) rejection loop from non-negative 63-bit values.
        const ulong bound = 255ul;
        for (int i = 0; i < number_of_bytes; i++) {
            ulong bits, val;
            val = prng64_guarded_java_int63_mod(gen, bound);
            entropy[i] = (uchar)val;
        }
        return;
    }
    else if (mode == 82) {
        // Bounded byte via 64-bit rejection with bound=255 (returns 0..254).
        const ulong bound = 255ul;
        const ulong limit = 0xfffffffffffffffful - (0xfffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, limit);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 83) {
        // .NET-like NextDouble legacy path from 31-bit sample, then floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            uint s31 = (uint)((r >> 33) & 0x7FFFFFFFul);
            entropy[i] = prng_scale_power2_fraction_to_byte(ulong(s31), 31u);
        }
        return;
    }
    else if (mode == 84) {
        // Python-like random() 53-bit composition from two draws.
        for (int i = 0; i < number_of_bytes; i++) {
            ulong a = gen.next() >> 37; // 27 bits
            ulong b = gen.next() >> 38; // 26 bits
            ulong m53 = (a << 26) + b;
            entropy[i] = prng_scale_power2_fraction_to_byte(m53, 53u);
        }
        return;
    }
    else if (mode == 85) {
        // JS-like Math.random() 53-bit (26+27 bits), then floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong hi26 = (gen.next() >> 38) & 0x03FFFFFFul;
            ulong lo27 = (gen.next() >> 37) & 0x07FFFFFFul;
            ulong m53 = (hi26 << 27) | lo27;
            entropy[i] = prng_scale_power2_fraction_to_byte(m53, 53u);
        }
        return;
    }
    else if (mode == 86) {
        // glibc random()-style extraction path (31-bit), folded to byte.
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            uint v31 = (uint)((r >> 33) & 0x7FFFFFFFul);
            entropy[i] = (uchar)(v31 & 0xFFu);
        }
        return;
    }
    else if (mode >= 87 && mode <= 96) {
        // Bounded rejection lanes (small bounds, int63-style).
        const ulong bounds[10] = {
            2ul, 3ul, 4ul, 5ul, 6ul, 7ul, 10ul, 16ul, 32ul, 64ul
        };
        const ulong bound = bounds[mode - 87];
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode >= 97 && mode <= 104) {
        // Bounded rejection lanes (practical API bounds).
        const ulong bounds[8] = {
            100ul, 128ul, 200ul, 251ul, 255ul, 256ul, 1000ul, 2048ul
        };
        const ulong bound = bounds[mode - 97];
        const ulong limit = 0xfffffffffffffffful - (0xfffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, limit);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode >= 105 && mode <= 108) {
        // Biased modulo lanes.
        const ulong bounds[4] = { 10ul, 100ul, 255ul, 256ul };
        const ulong bound = bounds[mode - 105];
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)(gen.next() % bound);
        }
        return;
    }
    else if (mode == 109) {
        // nextBoolean-style lane from top bit.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)((gen.next() >> 63) & 1ul);
        }
        return;
    }
    else if (mode == 110) {
        // 53-bit float lane from one 64-bit draw.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = prng_scale_power2_fraction_to_byte(gen.next() >> 11, 53u);
        }
        return;
    }
    else if (mode == 111) {
        // 52-bit mantissa lane from one draw.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = prng_scale_power2_fraction_to_byte(gen.next() >> 12, 52u);
        }
        return;
    }
    else if (mode == 112) {
        // drand48-style lane from low 48 bits.
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next() & 0xFFFFFFFFFFFFul;
            entropy[i] = prng_scale_power2_fraction_to_byte(r, 48u);
        }
        return;
    }
    else if (mode == 113) {
        // nextLong-like byte stream, LSB-first.
        ulong r = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) r = gen.next();
            entropy[i] = (uchar)((r >> ((i & 7) * 8)) & 0xFFu);
        }
        return;
    }
    else if (mode == 114) {
        // uniform_int_distribution<uchar>-style rejection.
        const ulong limit = 0xfffffffffffffffful - (0xfffffffffffffffful % 256ul);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, limit);
            entropy[i] = (uchar)(r & 0xFFu);
        }
        return;
    }
    else if (mode == 115) {
        // Rust-like gen::<u8>() lane.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)(gen.next() & 0xFFu);
        }
        return;
    }
    else if (mode == 116) {
        // JS-style 53-bit (26+27), floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong hi26 = (gen.next() >> 38) & 0x03FFFFFFul;
            ulong lo27 = (gen.next() >> 37) & 0x07FFFFFFul;
            ulong m53 = (hi26 << 27) | lo27;
            entropy[i] = prng_scale_power2_fraction_to_byte(m53, 53u);
        }
        return;
    }
    else if (mode == 117) {
        // Python-style 53-bit (27+26), floor(*256).
        for (int i = 0; i < number_of_bytes; i++) {
            ulong a = gen.next() >> 37;
            ulong b = gen.next() >> 38;
            ulong m53 = (a << 26) + b;
            entropy[i] = prng_scale_power2_fraction_to_byte(m53, 53u);
        }
        return;
    }
    else if (mode == 118) {
        // .NET legacy NextDouble-like 31-bit sample lane.
        for (int i = 0; i < number_of_bytes; i++) {
            uint s31 = (uint)((gen.next() >> 33) & 0x7FFFFFFFul);
            entropy[i] = prng_scale_power2_fraction_to_byte(ulong(s31), 31u);
        }
        return;
    }
    else if (mode == 119) {
        // .NET NextInt64(256)-style rejection.
        const ulong bound = 256ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 120) {
        // .NET NextInt64(255)-style rejection.
        const ulong bound = 255ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 121) {
        // Java SplittableRandom nextInt(256)-style lane.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)((gen.next() >> 56) & 0xFFu);
        }
        return;
    }
    else if (mode == 122) {
        // Java SplittableRandom nextInt(255)-style rejection.
        const ulong bound = 255ul;
        const ulong limit = 0xfffffffffffffffful - (0xfffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, limit);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 123) {
        // Go Int63n(256)-style rejection.
        const ulong bound = 256ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 124) {
        // Go Int63n(255)-style rejection.
        const ulong bound = 255ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 125) {
        // Ruby rand(256)-style via float53 conversion.
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = prng_scale_power2_fraction_to_byte(gen.next() >> 11, 53u);
        }
        return;
    }
    else if (mode == 126) {
        // PHP random_int(0,255)-style rejection.
        const ulong bound = 256ul;
        const ulong limit = 0xfffffffffffffffful - (0xfffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt(gen, limit);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 127) {
        // OpenSSL/BoringSSL-like stream lane (big-endian bytes).
        ulong r = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) r = gen.next();
            entropy[i] = (uchar)((r >> ((7 - (i & 7)) * 8)) & 0xFFu);
        }
        return;
    }
    else if (mode == 128) {
        // CTR-like stream lane (little-endian bytes).
        ulong r = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) r = gen.next();
            entropy[i] = (uchar)((r >> ((i & 7) * 8)) & 0xFFu);
        }
        return;
    }
    else if (mode == 129) {
        // Mixed lane from two 64-bit words.
        ulong mix = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) {
                ulong a = gen.next();
                ulong b = gen.next();
                mix = (a ^ prng64_rotl(b, 23)) + 0x9E3779B97F4A7C15ul;
            }
            entropy[i] = (uchar)((mix >> ((i & 7) * 8)) & 0xFFu);
        }
        return;
    }
    else if (mode == 130) {
        // Java nextLong()-style byte stream from two 32-bit halves, LSB-first.
        ulong x = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            if ((i & 7) == 0) {
                ulong hi = (gen.next() >> 32) & 0xFFFFFFFFul;
                ulong lo = (gen.next() >> 32) & 0xFFFFFFFFul;
                x = (hi << 32) | lo;
            }
            entropy[i] = (uchar)((x >> ((i & 7) * 8)) & 0xFFu);
        }
        return;
    }
    else if (mode == 131) {
