class Prng64SeedrandomArc4Quick {
    uchar S[256];
    uchar i;
    uchar j;
    uchar next_byte() {
        uchar t = S[i = uchar(i + 1u)];
        S[i] = S[j = uchar(j + t)];
        S[j] = t;
        return S[uchar(S[i] + S[j])];
    }
    uint g32() {
        uint r = 0u;
        for (int count = 0; count < 4; ++count) r = (r << 8u) | uint(next_byte());
        return r;
    }
public:
    explicit Prng64SeedrandomArc4Quick(ulong seed) : i(0), j(0) {
        char seed_str[22];
        int seed_len = prng64_seedrandom_decimal(seed, seed_str);
        seed_str[seed_len++] = '\0';
        uchar key[256];
        const int key_len = prng64_seedrandom_mixkey(seed_str, seed_len, key);
        for (int n = 0; n < 256; ++n) S[n] = uchar(n);
        uchar jj = 0u;
        for (int n = 0; n < 256; ++n) {
            const uchar t = S[n];
            jj = uchar(jj + t + key[n % key_len]);
            S[n] = S[jj]; S[jj] = t;
        }
        for (int drop = 0; drop < 256; ++drop) (void)next_byte();
    }
    ulong next() {
        ulong lo = ulong(g32());
        ulong hi = ulong(g32());
        return (hi << 32u) | lo;
    }
};

class Prng64SeedrandomAlea {
    uint s0, s1, s2, c;
    uint next32() {
        const ulong t = 2091639ul * ulong(s0) + ulong(c);
        s0 = s1; s1 = s2; c = uint(t >> 32u); s2 = uint(t);
        return s2;
    }
public:
    explicit Prng64SeedrandomAlea(ulong seed) : c(1u) {
        char seed_str[21];
        const int seed_len = prng64_seedrandom_decimal(seed, seed_str);
        PrngSeedrandomMashDouble mash_state = prng_seedrandom_mash_from_u64(4022871197ul);
        const char space = ' ';
        s0 = prng64_seedrandom_mash(mash_state, &space, 1);
        s1 = prng64_seedrandom_mash(mash_state, &space, 1);
        s2 = prng64_seedrandom_mash(mash_state, &space, 1);
        s0 -= prng64_seedrandom_mash(mash_state, seed_str, seed_len);
        s1 -= prng64_seedrandom_mash(mash_state, seed_str, seed_len);
        s2 -= prng64_seedrandom_mash(mash_state, seed_str, seed_len);
    }
    ulong next() {
        ulong lo = ulong(next32());
        ulong hi = ulong(next32());
        return (hi << 32u) | lo;
    }
};

class Prng64SeedrandomXor128 {
    uint x, y, z, w;
    uint next32() {
        const uint t = x ^ (x << 11u);
        x = y; y = z; z = w;
        w ^= (w >> 19u) ^ t ^ (t >> 8u);
        return w;
    }
public:
    explicit Prng64SeedrandomXor128(ulong seed) : x(uint(seed)), y(0u), z(0u), w(0u) {
        for (int k = 0; k < 64; ++k) (void)next32();
    }
    ulong next() {
        ulong lo = ulong(next32());
        ulong hi = ulong(next32());
        return (hi << 32u) | lo;
    }
};

class Prng64SeedrandomTychei {
    uint a, b, c, d;
    uint next32() {
        uint bb = (b << 25u) ^ (b >> 7u) ^ c;
        uint cc = c - d;
        uint dd = (d << 24u) ^ (d >> 8u) ^ a;
        uint aa = a - bb;
        bb = (bb << 20u) ^ (bb >> 12u) ^ cc;
        cc = cc - dd;
        dd = (dd << 16u) ^ (cc >> 16u) ^ aa;
        aa = aa - bb;
        a = aa; b = bb; c = cc; d = dd;
        return a;
    }
public:
    explicit Prng64SeedrandomTychei(ulong seed)
        : a(uint(seed >> 32u)), b(uint(seed)), c(0x9e3779b9u), d(0x517cc1b7u) {
        for (int k = 0; k < 20; ++k) (void)next32();
    }
    ulong next() {
        ulong lo = ulong(next32());
        ulong hi = ulong(next32());
        return (hi << 32u) | lo;
    }
};

static inline ulong prng64_rotr64_compat(ulong v, ulong r) {
    const uint n = uint(r & 63ul);
    return (v >> n) | (v << uint((0u - n) & 63u));
}

class Prng64SeedrandomXor4096_64 {
    uint X[128];
    uint i;
    uint w;

    uint next32() {
        w += 0x61c88647u;
        uint v = X[(i + 34u) & 127u];
        uint t = X[i = (i + 1u) & 127u];
        v ^= v << 13u;
        t ^= t << 17u;
        v ^= v >> 15u;
        t ^= t >> 12u;
        v = X[i] = v ^ t;
        return v + (w ^ (w >> 16u));
    }

public:
    explicit Prng64SeedrandomXor4096_64(ulong seed) : i(127u), w(0u) {
        memset(X, 0, sizeof(X));
        uint v = uint(seed);
        uint zeroes = 0u;
        for (int jj = -32; jj < 128; ++jj) {
            if (jj == 0) {
                w = v;
            }
            v ^= v << 10u;
            v ^= v >> 15u;
            v ^= v << 4u;
            v ^= v >> 13u;
            if (jj >= 0) {
                w += 0x61c88647u;
                const int idx = jj & 127;
                X[idx] ^= uint(v + w);
                zeroes = (X[idx] == 0u) ? (zeroes + 1u) : 0u;
            }
        }
        if (zeroes >= 128u) {
            X[0] = 0xffffffffu;
        }
        i = 127u;
        for (int jj = 0; jj < 512; ++jj) {
            uint v0 = X[(i + 34u) & 127u];
            uint t0 = X[i = (i + 1u) & 127u];
            v0 ^= v0 << 13u;
            t0 ^= t0 << 17u;
            v0 ^= v0 >> 15u;
            t0 ^= t0 >> 12u;
            X[i] = v0 ^ t0;
        }
    }

    ulong next() {
        const ulong lo = ulong(next32());
        const ulong hi = ulong(next32());
        return (hi << 32u) | lo;
    }
};

class Prng64SeedrandomXorShift7_64 {
    uint x[8];
    uint i;

    uint next32() {
        uint t = x[i];
        t ^= t >> 7u;
        uint v = t ^ (t << 24u);
        t = x[(i + 1u) & 7u]; v ^= t ^ (t >> 10u);
        t = x[(i + 3u) & 7u]; v ^= t ^ (t >> 3u);
        t = x[(i + 4u) & 7u]; v ^= t ^ (t << 7u);
        t = x[(i + 7u) & 7u]; t ^= t << 13u; v ^= t ^ (t << 9u);
        x[i] = v;
        i = (i + 1u) & 7u;
        return v;
    }

public:
    explicit Prng64SeedrandomXorShift7_64(ulong seed) : i(0u) {
        memset(x, 0, sizeof(x));
        x[0] = uint(seed);
        bool all_zero = true;
        for (int jj = 0; jj < 8; ++jj) {
            all_zero &= (x[jj] == 0u);
        }
        if (all_zero) {
            x[7] = 0xffffffffu;
        }
        for (int jj = 0; jj < 256; ++jj) {
            (void)next32();
        }
    }

    ulong next() {
        const ulong lo = ulong(next32());
        const ulong hi = ulong(next32());
        return (hi << 32u) | lo;
    }
};

class Prng64SeedrandomXorwow64 {
    uint x;
    uint y;
