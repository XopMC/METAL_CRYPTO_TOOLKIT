class Prng32Alea32Generator {
    uint s0, s1, s2, c;
public:
    explicit Prng32Alea32Generator(uint seed) {
        ulong sm = ulong(seed) ^ 0x6a09e667f3bcc909ul;
        s0 = uint(prng32_seed_mix64_local(sm));
        s1 = uint(prng32_seed_mix64_local(sm));
        s2 = uint(prng32_seed_mix64_local(sm));
        c = (uint(prng32_seed_mix64_local(sm)) % 2091639u) + 1u;
    }
    uint next() {
        const ulong t = 2091639ul * ulong(s0) + ulong(c);
        s0 = s1;
        s1 = s2;
        c = uint(t >> 32u);
        s2 = uint(t);
        return s2;
    }
};

class Prng32XSadd32Generator {
    uint st[4];
public:
    explicit Prng32XSadd32Generator(uint seed) {
        ulong sm = ulong(seed) ^ 0xbb67ae8584caa73bul;
        st[0] = uint(prng32_seed_mix64_local(sm));
        st[1] = uint(prng32_seed_mix64_local(sm));
        st[2] = uint(prng32_seed_mix64_local(sm));
        st[3] = uint(prng32_seed_mix64_local(sm));
        if ((st[0] | st[1] | st[2] | st[3]) == 0u) {
            st[0] = 1u;
        }
        for (int i = 0; i < 8; ++i) {
            next();
        }
    }
    uint next() {
        uint t = st[0];
        t ^= t << 15u;
        t ^= t >> 18u;
        t ^= st[3] << 11u;
        st[0] = st[1];
        st[1] = st[2];
        st[2] = st[3];
        st[3] = t;
        return st[3] + st[2];
    }
};

template <typename Gen32>
static inline bool prng32_generate_entropy_no_filter(uint seed,
                                                     int entropy_len,
                                                     thread uchar* entropy,
                                                     int mode,
                                                     ulong skip32) {
    if (entropy_len <= 0 || entropy_len > 512) {
        return false;
    }
    Gen32 gen(seed);
    prng32_generate_entropy_shared(gen, entropy_len, entropy, mode, skip32);
    return entropy_len > 0;
}

