        buf[p1] = r;
        if (++p1 >= 17) p1 = 0;
        if (++p2 >= 17) p2 = 0;
        return r;
    }
};

class Prng32Ran2_32 {
    int idum1;
    int idum2;
    int iy;
    int iv[32];
public:
    explicit Prng32Ran2_32(uint seed) {
        int s = int(seed | 1u);
        idum1 = s;
        idum2 = s;
        iy = 0;
        for (int j = 39; j >= 0; --j) {
            int k = idum1 / 53668;
            idum1 = 40014 * (idum1 - k * 53668) - k * 12211;
            if (idum1 < 0) idum1 += 2147483563;
            if (j < 32) iv[j] = idum1;
        }
        iy = iv[0];
    }
    uint next() {
        int k = idum1 / 53668;
        idum1 = 40014 * (idum1 - k * 53668) - k * 12211;
        if (idum1 < 0) idum1 += 2147483563;
        k = idum2 / 52774;
        idum2 = 40692 * (idum2 - k * 52774) - k * 3791;
        if (idum2 < 0) idum2 += 2147483399;
        int j = iy / (1 + 2147483562 / 32);
        if (j > 31) j = 31;
        iy = iv[j] - idum2;
        iv[j] = idum1;
        if (iy < 1) iy += 2147483562;
        return uint(iy);
    }
};

class Prng32NRRan0_32 {
    int idum;
public:
    explicit Prng32NRRan0_32(uint seed) : idum(int(seed ? seed : 1u)) {}
    uint next() {
        const int IA = 16807;
        const int IM = 2147483647;
        const int IQ = 127773;
        const int IR = 2836;
        const int MASK = 123459876;
        idum ^= MASK;
        const int k = idum / IQ;
        idum = IA * (idum - k * IQ) - IR * k;
        if (idum < 0) idum += IM;
        const int ans = idum;
        idum ^= MASK;
        return uint(ans) << 1u;
    }
};

class Prng32NRRan1_32 {
    int idum;
    int iy;
    int iv[32];
public:
    explicit Prng32NRRan1_32(uint seed) {
        const int IA = 16807;
        const int IM = 2147483647;
        const int IQ = 127773;
        const int IR = 2836;
        idum = int(seed ? seed : 1u);
        if (idum < 0) idum = -idum;
        for (int j = 39; j >= 0; --j) {
            int k = idum / IQ;
            idum = IA * (idum - k * IQ) - IR * k;
            if (idum < 0) idum += IM;
            if (j < 32) iv[j] = idum;
        }
        iy = iv[0];
    }
    uint next() {
        const int IA = 16807;
        const int IM = 2147483647;
        const int IQ = 127773;
        const int IR = 2836;
        const int NDIV = 1 + (IM - 1) / 32;
        const int k = idum / IQ;
        idum = IA * (idum - k * IQ) - IR * k;
        if (idum < 0) idum += IM;
        int j = iy / NDIV;
        if (j < 0) j = 0;
        if (j >= 32) j = 31;
        iy = iv[j];
        iv[j] = idum;
        return uint(iy) << 1u;
    }
};

class Prng32JenkinsLookup3Counter32Generator {
    uint state;
