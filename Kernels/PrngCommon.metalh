class Prng32KISS07_32 {
    uint x, y, z, c;
public:
    explicit Prng32KISS07_32(uint seed) {
        x = seed | 1u;
        y = seed ^ 0x12345678u;
        z = seed * 3u + 1u;
        c = seed % 698769069u;
    }
    uint next() {
        x = 69069u * x + 12345u;
        y ^= y << 13u; y ^= y >> 17u; y ^= y << 5u;
        const ulong t = 698769069ul * ulong(z) + ulong(c);
        c = uint(t >> 32u);
        z = uint(t);
        return x + y + z;
    }
};

class Prng32MWC899 {
