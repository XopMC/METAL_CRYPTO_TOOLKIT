class Prng64Ranlux48Base64 {
    ulong st[12];
    int idx;
    ulong carry;

    ulong step48() {
        const ulong mod48 = (1ul << 48u);
        const int i = idx;
        int j = i + 12 - 5;
        if (j >= 12) j -= 12;
        const ulong x = st[j];
        const ulong y = st[i];
        const ulong yc = y + carry;
        ulong r;
        if (x >= yc) {
            r = x - yc;
            carry = 0ul;
        } else {
            r = mod48 + x - yc;
            carry = 1ul;
        }
        st[i] = r & 0xfffffffffffful;
        idx = i + 1;
        if (idx >= 12) idx = 0;
        return st[i];
    }

public:
    explicit Prng64Ranlux48Base64(ulong seed) : idx(0), carry(0ul) {
        ulong x = seed ? seed : 1ul;
        ulong nz = 0ul;
        for (int i = 0; i < 12; ++i) {
            x += 0x9e3779b97f4a7c15ul;
            ulong z = x;
            z = (z ^ (z >> 30u)) * 0xbf58476d1ce4e5b9ul;
            z = (z ^ (z >> 27u)) * 0x94d049bb133111ebul;
            z ^= z >> 31u;
            st[i] = z & 0xfffffffffffful;
            nz |= st[i];
        }
        if (nz == 0ul) st[0] = 1ul;
        carry = (st[11] == 0ul) ? 1ul : 0ul;
    }

    ulong next() {
        const ulong a = step48();
        const ulong b = step48();
        return (a << 16u) ^ (b & 0xfffful);
    }
};

class Prng64Ranlux48Std64 {
    Prng64Ranlux48Base64 core;
    int used;
public:
    explicit Prng64Ranlux48Std64(ulong seed) : core(seed), used(0) {}
    ulong next() {
        if (used >= 11) {
            for (int i = 0; i < 378; ++i) (void)core.next();
            used = 0;
        }
        ++used;
        return core.next();
    }
};

class Prng64KnuthB64Std {
    uint state;
    uint table[256];
    uint y;

    uint minstd_next() {
        const ulong p = 16807ul * ulong(state);
        state = uint(p % 2147483647ul);
        if (state == 0u) state = 1u;
        return state;
    }

    uint next31() {
        const uint j = y & 255u;
        y = table[j];
        table[j] = minstd_next();
        return y & 0x7fffffffu;
    }

public:
    explicit Prng64KnuthB64Std(ulong seed) {
        state = uint(seed % 2147483647ul);
        if (state == 0u) state = 1u;
        for (int i = 0; i < 256; ++i) table[i] = minstd_next();
        y = minstd_next();
    }

    ulong next() {
        const ulong hi = ulong(next31());
        const ulong lo = ulong(next31());
        return (hi << 33u) ^ (lo << 2u) ^ (hi >> 29u);
    }
};

