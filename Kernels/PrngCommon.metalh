public:
    explicit Prng32BaysDurhamLCG32(uint seed) {
        state = (seed % 2147483646u) + 1u;
        for (int i = 39; i >= 0; --i) {
            state = uint((ulong(48271u) * ulong(state)) % 2147483647ul);
            if (i < 32) tab[i] = state;
        }
        iy = tab[0];
    }
    uint next() {
        state = uint((ulong(48271u) * ulong(state)) % 2147483647ul);
        uint j = iy / (1u + (2147483647u - 1u) / 32u);
        if (j >= 32u) j = 31u;
        iy = tab[j];
        tab[j] = state;
        return iy << 1u;
    }
};

