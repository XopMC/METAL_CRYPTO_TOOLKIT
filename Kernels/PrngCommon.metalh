class Prng64TinyMT64 {
    ulong status[2];
    static ulong ini_func1(ulong x) { return (x ^ (x >> 59u)) * 2173292883993ul; }
    static ulong ini_func2(ulong x) { return (x ^ (x >> 59u)) * 58885565329898161ul; }
public:
    explicit Prng64TinyMT64(ulong seed) {
        (void)ini_func1(0ul);
        (void)ini_func2(0ul);
        status[0] = seed;
        status[1] = 0xfa051f40ul ^ 0xffd0fff4ul;
        for (int i = 1; i < 8; ++i) {
            const ulong x = 6364136223846793005ul * (status[(i - 1) & 1] ^ (status[(i - 1) & 1] >> 62u)) + ulong(i);
            status[i & 1] ^= x;
        }
        for (int i = 0; i < 8; ++i) (void)next();
    }
    ulong next() {
        ulong x = (status[0] & 0x7ffffffffffffffful) ^ status[1];
        x ^= x << 12u;
        x ^= x >> 32u;
        x ^= x << 32u;
        x ^= x << 11u;
        status[0] = status[1];
        status[1] = x;
        ulong y = status[0] + status[1];
        y ^= (y >> 8u) & 0x58d02ffeffbfffbcul;
        return y;
    }
};

template <int R, int M1, int M2, int M3>
class Prng64WELL64Core {
    ulong state[R];
    int idx;
    ulong mat(ulong v) {
        return (v & 0xffffffff80000000ul) ^ ((v << 16u) & 0x7fffffff0000ul);
    }
public:
    explicit Prng64WELL64Core(ulong seed) : idx(0) {
        ulong sm = seed;
        for (int i = 0; i < R; ++i) state[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong a = state[idx];
        const ulong b = state[(idx + M1) % R];
        const ulong c = state[(idx + M2) % R];
        const ulong d = state[(idx + M3) % R];
        const ulong e = mat(a) ^ mat(b);
        const ulong f = e ^ c ^ (c >> 11u);
        state[idx] = f ^ (d << 17u);
        idx = (idx + R - 1) % R;
        return state[idx];
    }
};

