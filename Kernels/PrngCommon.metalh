    }
};

static inline void prng32_provider_store_u32_be32(thread uchar* out, uint x) {
    out[0] = uchar(x >> 24u);
    out[1] = uchar(x >> 16u);
    out[2] = uchar(x >> 8u);
    out[3] = uchar(x);
}

static inline uint prng32_provider_load_u32_le32(thread const uchar* in) {
    return uint(in[0]) |
           (uint(in[1]) << 8u) |
           (uint(in[2]) << 16u) |
           (uint(in[3]) << 24u);
}

static inline void prng32_provider_be_add_right_aligned(thread uchar* dst,
                                                       int dst_len,
                                                       thread const uchar* src,
                                                       int src_len) {
    uint carry = 0u;
    int i = 0;
    for (; i < src_len && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const int si = src_len - 1 - i;
        const uint sum = uint(dst[di]) + uint(src[si]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
    for (; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = uint(dst[di]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
}

static inline void prng32_provider_be_add_u64(thread uchar* dst, int dst_len, ulong value) {
    uint carry = 0u;
    for (int i = 0; i < 8 && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const uint add = uint((value >> uint(i * 8)) & 0xfful);
        const uint sum = uint(dst[di]) + add + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
    for (int i = 8; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = uint(dst[di]) + carry;
        dst[di] = uchar(sum);
        carry = sum >> 8u;
    }
}

static inline void prng32_provider_hash_df_sha256(thread const uchar* input,
                                                 int input_len,
                                                 thread uchar* out,
                                                 int out_len) {
    uchar msg[128];
    uchar digest[32];
    const uint bits = uint(out_len * 8);
    int produced = 0;
    uchar counter = 1u;
    while (produced < out_len) {
        msg[0] = counter++;
        msg[1] = uchar(bits >> 24u);
        msg[2] = uchar(bits >> 16u);
        msg[3] = uchar(bits >> 8u);
        msg[4] = uchar(bits);
        memcpy(msg + 5, input, input_len);
        SHA256(msg, size_t(input_len + 5), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, take);
        produced += take;
    }
}

static inline void prng32_provider_hashgen_sha256(thread const uchar* value,
                                                 int value_len,
                                                 thread uchar* out,
                                                 int out_len) {
    uchar data[64];
    uchar digest[32];
    memcpy(data, value, value_len);
    int produced = 0;
    while (produced < out_len) {
        SHA256(data, size_t(value_len), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, take);
        produced += take;
        prng32_provider_be_add_u64(data, value_len, 1ul);
    }
}

static inline void prng32_provider_sha256_counter_kdf(thread const uchar* material,
                                                     int material_len,
                                                     uchar domain,
                                                     thread uchar* out,
                                                     int out_len) {
    uchar msg[128];
    uchar digest[32];
    memcpy(msg, material, material_len);
    int produced = 0;
    uchar counter = 0u;
    while (produced < out_len) {
        msg[material_len] = domain;
        msg[material_len + 1] = counter++;
        SHA256(msg, size_t(material_len + 2), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, take);
        produced += take;
    }
}

static inline uint prng32_provider_sha1_rotl32(uint x, uint r) {
    return (x << r) | (x >> (32u - r));
}

static inline void prng32_provider_sha1_compress_block32(thread uint state[5],
                                                       thread const uchar block[64]) {
    uint w[80];
    for (int i = 0; i < 16; ++i) {
        w[i] = prng32_provider_load_u32_be32(block + i * 4);
    }
    for (int i = 16; i < 80; ++i) {
        w[i] = prng32_provider_sha1_rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1u);
    }
    uint a = state[0];
    uint b = state[1];
    uint c = state[2];
    uint d = state[3];
    uint e = state[4];
    for (int i = 0; i < 80; ++i) {
        uint f;
        uint k;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5a827999u;
        } else if (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ed9eba1u;
        } else if (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdcu;
        } else {
            f = b ^ c ^ d;
            k = 0xca62c1d6u;
        }
        const uint temp = prng32_provider_sha1_rotl32(a, 5u) + f + e + k + w[i];
        e = d;
        d = c;
        c = prng32_provider_sha1_rotl32(b, 30u);
        b = a;
        a = temp;
    }
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
}

static inline void prng32_provider_sha1_hash32(thread const uchar* msg,
                                             int len,
                                             thread uchar out[20]) {
    uint state[5] = {
        0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u, 0xc3d2e1f0u
    };
    const int full_blocks = len / 64;
    const int rem = len % 64;
    for (int i = 0; i < full_blocks; ++i) {
        prng32_provider_sha1_compress_block32(state, msg + i * 64);
    }
    uchar block[64];
    memset(block, 0, sizeof(block));
    if (rem > 0) {
        memcpy(block, msg + full_blocks * 64, rem);
    }
    block[rem] = 0x80u;
    const ulong bit_len = ulong(uint(len)) * 8ul;
    if (rem >= 56) {
        prng32_provider_sha1_compress_block32(state, block);
        memset(block, 0, sizeof(block));
    }
    for (int i = 0; i < 8; ++i) {
        block[56 + i] = uchar(bit_len >> uint(56 - i * 8));
    }
    prng32_provider_sha1_compress_block32(state, block);
    for (int i = 0; i < 5; ++i) {
        out[i * 4 + 0] = uchar(state[i] >> 24u);
        out[i * 4 + 1] = uchar(state[i] >> 16u);
        out[i * 4 + 2] = uchar(state[i] >> 8u);
        out[i * 4 + 3] = uchar(state[i]);
    }
}

class Prng32POSIX_nrand48_32 {
    ulong x;
public:
    explicit Prng32POSIX_nrand48_32(uint seed) {
        const ulong x0 = ulong(seed & 0xffffu);
        const ulong x1 = ulong((seed >> 16u) & 0xffffu);
        const ulong x2 = ulong((seed ^ 0x330eu) & 0xffffu);
        x = (x2 << 32u) | (x1 << 16u) | x0;
    }
    uint next() {
        x = (x * 0x5deece66dul + 0xbul) & ((1ul << 48u) - 1ul);
        return uint(x >> 17u);
    }
};

template <int DEG, int SEP, int WARMUP>
class Prng32GlibcRandomFeedback32 {
    uint state[DEG];
    int fptr;
    int rptr;
public:
    explicit Prng32GlibcRandomFeedback32(uint seed) : fptr(SEP), rptr(0) {
        uint s = (seed != 0u) ? seed : 1u;
        state[0] = s;
        for (int i = 1; i < DEG; ++i) {
            state[i] = uint((ulong(16807u) * ulong(state[i - 1])) % 0x7ffffffful);
        }
        for (int i = 0; i < WARMUP; ++i) {
            (void)next();
        }
    }
    uint next() {
        const uint sum = state[fptr] + state[rptr];
        state[fptr] = sum;
        const uint result = sum >> 1u;
        if (++fptr >= DEG) fptr = 0;
        if (++rptr >= DEG) rptr = 0;
        return result;
    }
};

class Prng32GlibcRandomType1_32 {
    Prng32GlibcRandomFeedback32<7, 3, 70> core;
public:
    explicit Prng32GlibcRandomType1_32(uint seed) : core(seed) {}
    uint next() { return core.next(); }
};

