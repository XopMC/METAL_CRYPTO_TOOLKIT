class Prng32NumPyPCG64_32 {
    Prng32ProviderUint128 state;
    Prng32ProviderUint128 inc;
    uint cached_hi;
    bool have_cached_hi;
    ulong next64() {
        state = prng32_provider_pcg128_step_setseq(state, inc);
        return prng32_provider_pcg_xsl_rr_output(state);
    }
public:
    explicit Prng32NumPyPCG64_32(uint seed) : cached_hi(0u), have_cached_hi(false) {
        const ulong z = (ulong(seed) << 32u) ^ 0x4e50434736343332ul;
        const Prng32ProviderUint128 initstate = prng32_provider128_make(
            prng32_mix_stafford13_provider32(z),
            prng32_mix_murmur64_provider32(z + 0x9e3779b97f4a7c15ul));
        const Prng32ProviderUint128 initseq = prng32_provider128_make(
            prng32_mix_stafford13_provider32(z + 0x243f6a8885a308d3ul),
            prng32_mix_murmur64_provider32(z + 0xb7e151628aed2a6bul));
        state = prng32_provider128_make(0ul, 0ul);
        inc = prng32_provider128_lshift1_or1(initseq);
        state = prng32_provider_pcg128_step_setseq(state, inc);
        state = prng32_provider128_add(state, initstate);
        state = prng32_provider_pcg128_step_setseq(state, inc);
    }
    uint next() {
        if (have_cached_hi) {
            have_cached_hi = false;
            return cached_hi;
        }
        const ulong v = next64();
        cached_hi = uint(v >> 32u);
        have_cached_hi = true;
        return uint(v);
    }
};

class Prng32PHPRandomEnginePcgOneseq128XslRr64_32 {
    Prng32ProviderUint128 state;
    uint cached_hi;
    bool have_cached_hi;
    ulong next64() {
        state = prng32_provider_pcg128_step_oneseq(state);
        return prng32_provider_pcg_xsl_rr_output(state);
    }
public:
    explicit Prng32PHPRandomEnginePcgOneseq128XslRr64_32(uint seed) : cached_hi(0u), have_cached_hi(false) {
        const Prng32ProviderUint128 initseed = prng32_provider128_make(0ul, ulong(seed));
        state = prng32_provider128_make(0ul, 0ul);
        state = prng32_provider_pcg128_step_oneseq(state);
        state = prng32_provider128_add(state, initseed);
        state = prng32_provider_pcg128_step_oneseq(state);
    }
    uint next() {
        if (have_cached_hi) {
            have_cached_hi = false;
            return cached_hi;
        }
        const ulong v = next64();
        cached_hi = uint(v >> 32u);
        have_cached_hi = true;
        return uint(v);
    }
};


