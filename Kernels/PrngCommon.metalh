        b = ((s2 << 24u) ^ s2) >> 50u; s2 = ((s2 & 18446744073709551104ul) << 5u) ^ b;
        b = ((s3 << 3u) ^ s3) >> 23u; s3 = ((s3 & 18446744073709547520ul) << 29u) ^ b;
        b = ((s4 << 29u) ^ s4) >> 24u; s4 = ((s4 & 18446744073709420544ul) << 8u) ^ b;
