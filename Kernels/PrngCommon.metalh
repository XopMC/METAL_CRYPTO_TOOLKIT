class Prng32GMWC128Vigna32Generator {
    ulong x, c;
public:
    explicit Prng32GMWC128Vigna32Generator(uint seed) {
        ulong sm = ulong(seed) ^ 0x13198a2e03707344ul;
        x = prng32_seed_mix64_local(sm);
        c = prng32_seed_mix64_local(sm) | 1ul;
    }
    uint next() {
        ulong thi = 0ul;
        const ulong tlo = prng32_mul_add64_carry_local(0xff002aae7d81a646ul, x, c, thi);
        x = 0x9b1eea3792a42c61ul * tlo;
        const ulong mlo = 0x007d084a4d80885ful * x;
        const ulong mhi = prng32_umul64hi(0x007d084a4d80885ful, x);
        const ulong slo = tlo + mlo;
        c = thi + mhi + ((slo < tlo) ? 1ul : 0ul);
        return prng32_fold64_to32_local(x);
    }
};

