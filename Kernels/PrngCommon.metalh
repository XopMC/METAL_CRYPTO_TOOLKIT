        ss0 ^= ss0 >> 15u;
        s[p] = ss0 ^ s1;
        return s[p] * 826366247u;
    }
};

class Prng32Xoshiro64SS_Low32 {
    ulong s[4];
public:
    explicit Prng32Xoshiro64SS_Low32(uint seed) {
        ulong v = seed;
        for (int i = 0; i < 4; ++i) {
            v = v * 6364136223846793005ul + 1ul;
            s[i] = v;
        }
    }

    uint next() {
        ulong result = ((s[1] * 5ul) << 7u) | ((s[1] * 5ul) >> 57u);
        result *= 9ul;
        ulong t = s[1] << 17u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = (s[3] << 45u) | (s[3] >> 19u);
        return uint(result);
    }
};

class Prng32Xoroshiro64Plus_Low32 {
    ulong s[2];
public:
    explicit Prng32Xoroshiro64Plus_Low32(uint seed) {
        ulong v = ulong(seed) * 0x9e3779b97f4a7c15ul + 1ul;
        s[0] = v;
        s[1] = v ^ 0xd2b74407b1ce6e93ul;
    }

    uint next() {
        ulong result = s[0] + s[1];
        ulong t = s[0];
        s[1] ^= s[0];
        s[0] = (t << 24u) | ((t >> 40u) ^ s[1] ^ (s[1] << 16u));
        s[1] = (s[1] << 37u) | (s[1] >> 27u);
        return uint(result);
    }
};

class Prng32LXM32 {
    ulong lcg;
