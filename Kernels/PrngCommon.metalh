class Prng32MotherOfAll32 {
    uint s[5];
    uint carry;
public:
    explicit Prng32MotherOfAll32(uint seed) : carry(0u) {
        s[0] = seed;
        s[1] = seed * 29943829u + 1u;
        s[2] = s[1] * 29943829u + 1u;
        s[3] = s[2] * 29943829u + 1u;
        s[4] = s[3] * 29943829u + 1u;
        for (int i = 0; i < 19; ++i) next();
    }
    uint next() {
        const ulong sum = ulong(2111111111u) * ulong(s[0])
                        + ulong(1492u) * ulong(s[1])
                        + ulong(1776u) * ulong(s[2])
                        + ulong(5115u) * ulong(s[3])
                        + ulong(carry);
        s[0] = s[1];
        s[1] = s[2];
        s[2] = s[3];
        s[3] = uint(sum);
        carry = uint(sum >> 32u);
        return s[3];
    }
};

