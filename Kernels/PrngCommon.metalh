class Prng32XorShift32Star {
    uint state;
public:
    explicit Prng32XorShift32Star(uint seed) : state(seed ? seed : 1u) {}

    uint next() {
        uint x = state;
        x ^= x << 13u;
        x ^= x >> 17u;
        x ^= x << 5u;
        state = x;
        return x * 0x9e3779b9u;
    }
};

class Prng32XorShift32StarStar {
