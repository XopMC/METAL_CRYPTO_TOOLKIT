class Prng32XorshiftPlusGenerator {
    ulong s[2];
    static ulong splitmix32_to64(uint x) {
        return (ulong(x) << 32u) | ulong(x ^ 0x5a5a5a5au);
    }
public:
    explicit Prng32XorshiftPlusGenerator(uint seed) {
        s[0] = splitmix32_to64(seed);
        s[1] = splitmix32_to64(seed * 1664525u + 1013904223u);
    }
    ulong next64() {
        ulong x = s[0];
        const ulong y = s[1];
        s[0] = y;
        x ^= x << 23u;
        s[1] = x ^ y ^ (x >> 17u) ^ (y >> 26u);
        return s[1] + y;
    }
    uint next() {
        return uint(next64());
    }
};

class Prng32Xorshift32PlusGenerator {
