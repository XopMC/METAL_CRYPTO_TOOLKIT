struct Prng32ProviderUint128 {
    ulong hi;
    ulong lo;
};

static inline Prng32ProviderUint128 prng32_provider128_make(ulong hi, ulong lo) {
    Prng32ProviderUint128 out{ hi, lo };
    return out;
}

static inline Prng32ProviderUint128 prng32_provider128_add(Prng32ProviderUint128 a, Prng32ProviderUint128 b) {
    Prng32ProviderUint128 out;
    out.lo = a.lo + b.lo;
    out.hi = a.hi + b.hi + ((out.lo < a.lo) ? 1ul : 0ul);
    return out;
}

static inline Prng32ProviderUint128 prng32_provider128_mul(Prng32ProviderUint128 a, Prng32ProviderUint128 b) {
    Prng32ProviderUint128 out;
    const ulong x0 = a.lo & 0xfffffffful;
    const ulong x1 = a.lo >> 32u;
    const ulong y0 = b.lo & 0xfffffffful;
    const ulong y1 = b.lo >> 32u;
    const ulong t = x1 * y0 + ((x0 * y0) >> 32u);
    const ulong z0 = (t & 0xfffffffful) + x0 * y1;
    out.hi = a.hi * b.lo + a.lo * b.hi;
    out.lo = a.lo * b.lo;
    out.hi += x1 * y1 + (t >> 32u) + (z0 >> 32u);
    return out;
}

static inline Prng32ProviderUint128 prng32_provider128_lshift1_or1(Prng32ProviderUint128 a) {
    Prng32ProviderUint128 out;
    out.hi = (a.hi << 1u) | (a.lo >> 63u);
    out.lo = (a.lo << 1u) | 1ul;
    return out;
}

static inline ulong prng32_provider_pcg_xsl_rr_output(Prng32ProviderUint128 state) {
    const ulong value = state.hi ^ state.lo;
    const uint rot = uint(state.hi >> 58u);
    return (rot == 0u) ? value : ((value >> rot) | (value << (64u - rot)));
}

static inline Prng32ProviderUint128 prng32_provider_pcg128_step_setseq(Prng32ProviderUint128 state, Prng32ProviderUint128 inc) {
    const Prng32ProviderUint128 mult = prng32_provider128_make(2549297995355413924ul, 4865540595714422341ul);
    return prng32_provider128_add(prng32_provider128_mul(state, mult), inc);
}

static inline Prng32ProviderUint128 prng32_provider_pcg128_step_oneseq(Prng32ProviderUint128 state) {
    const Prng32ProviderUint128 mult = prng32_provider128_make(2549297995355413924ul, 4865540595714422341ul);
    const Prng32ProviderUint128 inc = prng32_provider128_make(6364136223846793005ul, 1442695040888963407ul);
    return prng32_provider128_add(prng32_provider128_mul(state, mult), inc);
}

class Prng32Lua54Xoshiro256StarStar32 {
    ulong s0, s1, s2, s3;
    uint cached_hi;
    bool have_cached_hi;
    ulong next64() {
        ulong a0 = s0;
        ulong a1 = s1;
        ulong a2 = s2;
        ulong a3 = s3;
        const ulong result = prng32_rotl64(a1 * 5ul, 7) * 9ul;
        const ulong t = a1 << 17u;
        a2 ^= a0;
        a3 ^= a1;
        a1 ^= a2;
        a0 ^= a3;
        a2 ^= t;
        a3 = prng32_rotl64(a3, 45);
        s0 = a0;
        s1 = a1;
        s2 = a2;
        s3 = a3;
        return result;
    }
public:
    explicit Prng32Lua54Xoshiro256StarStar32(uint seed) : cached_hi(0u), have_cached_hi(false) {
        s0 = ulong(seed);
        s1 = 0xfful;
        s2 = (ulong(seed) << 32u) ^ 0x4c55413534583230ul;
        s3 = 0ul;
        for (int i = 0; i < 16; ++i) (void)next64();
    }
    uint next() {
        if (have_cached_hi) {
            have_cached_hi = false;
            return cached_hi;
        }
        const ulong v = next64();
        cached_hi = uint(v >> 32u);
        have_cached_hi = true;
        return uint(v);
    }
};

class Prng32PHPCombinedLCG32 {
    int s1;
    int s2;
public:
    explicit Prng32PHPCombinedLCG32(uint seed) {
        s1 = int(((seed ? seed : 1u) % 2147483562u) + 1u);
        const uint seed2 = seed ^ 0x50485037u;
        s2 = int(((seed2 ? seed2 : 1u) % 2147483398u) + 1u);
    }
    uint next() {
        int q = s1 / 53668;
        s1 = 40014 * (s1 - 53668 * q) - 12211 * q;
        if (s1 < 0) s1 += 2147483563;
        q = s2 / 52774;
        s2 = 40692 * (s2 - 52774 * q) - 3791 * q;
        if (s2 < 0) s2 += 2147483399;
        int z = s1 - s2;
        if (z < 1) z += 2147483562;
        return uint(z);
    }
};

