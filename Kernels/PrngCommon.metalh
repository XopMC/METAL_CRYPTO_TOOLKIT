};

class Prng32CLCG2_32 {
    int s1;
    int s2;
public:
    explicit Prng32CLCG2_32(uint seed) {
        s1 = int((seed % 2147483562u) + 1u);
        s2 = int(((seed ^ 0x9e3779b9u) % 2147483398u) + 1u);
    }
    uint next() {
        int k = s1 / 53668;
        s1 = 40014 * (s1 - k * 53668) - k * 12211;
        if (s1 < 0) s1 += 2147483563;
        k = s2 / 52774;
        s2 = 40692 * (s2 - k * 52774) - k * 3791;
        if (s2 < 0) s2 += 2147483399;
        int z = s1 - s2;
        if (z < 1) z += 2147483562;
        return uint(z) << 1u;
    }
};

class Prng32CLCG4_32 {
    uint s1;
    uint s2;
    uint s3;
    uint s4;
public:
    explicit Prng32CLCG4_32(uint seed) {
        s1 = (seed % 2147483646u) + 1u;
        s2 = ((seed * 1664525u + 1013904223u) % 2147483542u) + 1u;
        s3 = ((seed * 22695477u + 1u) % 2147483422u) + 1u;
        s4 = ((seed * 1103515245u + 12345u) % 2147483322u) + 1u;
    }
    uint next() {
        s1 = uint((45991ul * ulong(s1)) % 2147483647ul);
        s2 = uint((207707ul * ulong(s2)) % 2147483543ul);
        s3 = uint((138556ul * ulong(s3)) % 2147483423ul);
        s4 = uint((49689ul * ulong(s4)) % 2147483323ul);
        long out = long(s1) - long(s2) + long(s3) - long(s4);
        out %= long(2147483647);
        if (out <= long(0)) out += long(2147483646);
        return uint(out) << 1u;
    }
};

class Prng32SobolSequenceGenerator {
    uint bits[32];
public:
    explicit Prng32SobolSequenceGenerator(uint seed) {
        for (int i = 0; i < 32; ++i) {
            bits[i] = (seed >> uint(i)) & 1u;
        }
    }
    uint next() {
        uint v = 0u;
        for (int i = 0; i < 32; ++i) {
            v |= bits[i] << uint(i);
        }
        for (int k = 0; k < 32; ++k) {
            bits[k] ^= bits[(k + 1) & 31] ^ bits[(k + 3) & 31];
        }
        return v;
    }
};

class Prng32HaltonSequenceGenerator {
    ulong index;
public:
    explicit Prng32HaltonSequenceGenerator(uint seed) : index(ulong(seed)) {}
    uint next() {
        ulong n = index++;
        ulong r = 0ul;
        ulong f = 1ul;
        const ulong base = 2ul;
        while (n != 0ul) {
            f *= base;
            r = r * base + (n % base);
            n /= base;
        }
        return uint(r);
    }
};

