class Prng64ISAAC64 {
    ulong mem[256];
    ulong rsl[256];
    ulong a;
    ulong b;
    ulong c;
    int idx;
    void mix(thread ulong& ma, thread ulong& mb, thread ulong& mc, thread ulong& md,
             thread ulong& me, thread ulong& mf, thread ulong& mg, thread ulong& mh) {
        ma ^= mb << 11u; md += ma; mb += mc;
        mb ^= mc >> 2u;  me += mb; mc += md;
        mc ^= md << 8u;  mf += mc; md += me;
        md ^= me >> 16u; mg += md; me += mf;
        me ^= mf << 10u; mh += me; mf += mg;
        mf ^= mg >> 4u;  ma += mf; mg += mh;
        mg ^= mh << 8u;  mb += mg; mh += ma;
        mh ^= ma >> 9u;  mc += mh; ma += mb;
    }
    void randinit(ulong seed) {
        ulong sm = seed;
        for (int i = 0; i < 256; ++i) mem[i] = prng64_splitmix64_next(sm);
        a = b = c = 0x9e3779b97f4a7c15ul;
        ulong d = a;
        ulong e = b;
        ulong f = c;
        ulong g = d;
        ulong h = e;
        for (int i = 0; i < 4; ++i) mix(a, b, c, d, e, f, g, h);
        for (int i = 0; i < 256; i += 8) {
            a += mem[i]; b += mem[i + 1]; c += mem[i + 2]; d += mem[i + 3];
            e += mem[i + 4]; f += mem[i + 5]; g += mem[i + 6]; h += mem[i + 7];
            mix(a, b, c, d, e, f, g, h);
            mem[i] = a; mem[i + 1] = b; mem[i + 2] = c; mem[i + 3] = d;
            mem[i + 4] = e; mem[i + 5] = f; mem[i + 6] = g; mem[i + 7] = h;
        }
        for (int i = 0; i < 256; i += 8) {
            a += mem[i]; b += mem[i + 1]; c += mem[i + 2]; d += mem[i + 3];
            e += mem[i + 4]; f += mem[i + 5]; g += mem[i + 6]; h += mem[i + 7];
            mix(a, b, c, d, e, f, g, h);
            mem[i] = a; mem[i + 1] = b; mem[i + 2] = c; mem[i + 3] = d;
            mem[i + 4] = e; mem[i + 5] = f; mem[i + 6] = g; mem[i + 7] = h;
        }
        isaac();
        idx = 256;
    }
    void isaac() {
        ++c;
        b += c;
        for (int i = 0; i < 256; ++i) {
            const ulong x = mem[i];
            switch (i & 3) {
                case 0: a ^= a << 13u; break;
                case 1: a ^= a >> 6u; break;
                case 2: a ^= a << 2u; break;
                default: a ^= a >> 16u; break;
            }
            a += mem[(i + 128) & 255];
            const ulong y = mem[(x >> 3u) & 255] + a + b;
            mem[i] = y;
            b = mem[(y >> 8u) & 255] + x;
            rsl[i] = b;
        }
        idx = 0;
    }
public:
    explicit Prng64ISAAC64(ulong seed) { randinit(seed); }
    ulong next() {
        if (idx >= 256) isaac();
        return rsl[idx++];
    }
};

