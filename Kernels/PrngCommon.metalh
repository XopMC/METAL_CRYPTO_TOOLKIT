class Prng32Ranrot32A {
    uint a;
    uint b;
    uint c;
public:
    explicit Prng32Ranrot32A(uint seed) {
        a = seed ? seed : 1u;
        b = a * 1664525u + 1013904223u;
        c = b * 1664525u + 1013904223u;
