    0xdc63152a, 0x3e12b7aa, 0x6e615927, 0xa14fb118,
    0xa151758d, 0xba81687b, 0xe152f0b3, 0x764254ed,
    0x34c77271, 0x0a31acab, 0x54f94aec, 0xb9e994cd,
    0x574d9e81, 0x5b623730, 0xce8a21e8, 0x37917f0b,
    0xe8a9b5d6, 0x9697adf8, 0xf3d30431, 0x5dcac921,
    0x76b35d46, 0xaa430a36, 0xc2194022, 0x22bca65e,
    0xdaec70ba, 0xdfaea8cc, 0x777bae8b, 0x242924d5,
    0x1f098a5a, 0x4b396b81, 0x55de2522, 0x435c1cb8,
    0xaeb8fe1d, 0x9db3c697, 0x5b164f83, 0xe0c16376,
    0xa319224c, 0xd0203b35, 0x433ac0fe, 0x1466a19a,
    0x45f0b24f, 0x51fda998, 0xc0d52d71, 0xfa0896a8,
    0xf9e6053f, 0xa4b0d300, 0xd499cbcc, 0xb95e3d40,
};

struct Prng64Sober128State {
    uint R[PRNG64_SOBER128_N64];
    uint initR[PRNG64_SOBER128_N64];
    uint konst;
    uint sbuf;
    int nbuf;
};

// Device helper: prng64_sober128_off_64.
static inline int prng64_sober128_off_64(int zero, int i) {
    int x = zero + i;
    return (x >= PRNG64_SOBER128_N64) ? (x - PRNG64_SOBER128_N64) : x;
}

// Device helper: prng64_sober128_ror32_64.
static inline uint prng64_sober128_ror32_64(uint x, unsigned r) {
    return (x >> r) | (x << (32u - r));
}

// Device helper: prng64_sober128_step_64.
static inline void prng64_sober128_step_64(thread uint* R, int z) {
    const int i0 = prng64_sober128_off_64(z, 0);
    const uint r0 = R[i0];
    R[i0] = R[prng64_sober128_off_64(z, 15)] ^
        R[prng64_sober128_off_64(z, 4)] ^
        (r0 << 8) ^
        PRNG64_SOBER128_Multab64[(r0 >> 24) & 0xff];
}

// Device helper: prng64_sober128_nlfunc_64.
static inline uint prng64_sober128_nlfunc_64(thread const Prng64Sober128State* st, int z) {
    uint t = st->R[prng64_sober128_off_64(z, 0)] + st->R[prng64_sober128_off_64(z, 16)];
    t ^= PRNG64_SOBER128_Sbox64[(t >> 24) & 0xff];
    t = prng64_sober128_ror32_64(t, 8);
    t = ((t + st->R[prng64_sober128_off_64(z, 1)]) ^ st->konst) + st->R[prng64_sober128_off_64(z, 6)];
    t ^= PRNG64_SOBER128_Sbox64[(t >> 24) & 0xff];
    t += st->R[prng64_sober128_off_64(z, 13)];
    return t;
}

// Device helper: prng64_sober128_cycle_64.
static inline void prng64_sober128_cycle_64(thread uint* R) {
    prng64_sober128_step_64(R, 0);
    const uint t = R[0];
    for (int i = 1; i < PRNG64_SOBER128_N64; ++i) {
        R[i - 1] = R[i];
    }
    R[PRNG64_SOBER128_N64 - 1] = t;
}

// Device helper: prng64_sober128_nltap_64.
static inline uint prng64_sober128_nltap_64(thread const Prng64Sober128State* st) {
    return prng64_sober128_nlfunc_64(st, 0);
}

// Device helper: prng64_sober128_dround_64.
static inline void prng64_sober128_dround_64(thread Prng64Sober128State* st, int z) {
    prng64_sober128_step_64(st->R, z);
    const uint t = prng64_sober128_nlfunc_64(st, z + 1);
    st->R[prng64_sober128_off_64(z + 1, PRNG64_SOBER128_Foldp64)] ^= t;
}

// Device helper: prng64_sober128_diffuse_64.
static inline void prng64_sober128_diffuse_64(thread Prng64Sober128State* st) {
    for (int z = 0; z < PRNG64_SOBER128_N64; ++z) {
        prng64_sober128_dround_64(st, z);
    }
}

// Device helper: prng64_sober128_save_state_64.
static inline void prng64_sober128_save_state_64(thread Prng64Sober128State* st) {
    memcpy(st->initR, st->R, sizeof(st->R));
}

// Device helper: prng64_sober128_reload_state_64.
static inline void prng64_sober128_reload_state_64(thread Prng64Sober128State* st) {
    memcpy(st->R, st->initR, sizeof(st->R));
}

// Device helper: prng64_sober128_gen_konst_64.
static inline void prng64_sober128_gen_konst_64(thread Prng64Sober128State* st) {
    uint new_konst = 0u;
    do {
        prng64_sober128_cycle_64(st->R);
        new_konst = prng64_sober128_nltap_64(st);
    } while ((new_konst & 0xff000000u) == 0u);
    st->konst = new_konst;
}

// Device helper: prng64_sober128_setup_64.
static inline void prng64_sober128_setup_64(thread Prng64Sober128State* st, thread const uchar* key, int key_len) {
    st->R[0] = 1u;
    st->R[1] = 1u;
    for (int i = 2; i < PRNG64_SOBER128_N64; ++i) {
        st->R[i] = st->R[i - 1] + st->R[i - 2];
    }
    st->konst = PRNG64_SOBER128_InitKonst64;
    for (int i = 0; i < key_len; i += 4) {
        const uint k = prng64_provider_load_u32_le(key + i);
        st->R[PRNG64_SOBER128_Keyp64] += k;
        prng64_sober128_cycle_64(st->R);
        st->R[PRNG64_SOBER128_Foldp64] ^= prng64_sober128_nltap_64(st);
    }
    st->R[PRNG64_SOBER128_Keyp64] += (uint)key_len;
    prng64_sober128_diffuse_64(st);
    prng64_sober128_gen_konst_64(st);
    prng64_sober128_save_state_64(st);
    st->sbuf = 0u;
    st->nbuf = 0;
}

// Device helper: prng64_sober128_setiv_64.
static inline void prng64_sober128_setiv_64(thread Prng64Sober128State* st, thread const uchar* iv, int iv_len) {
    prng64_sober128_reload_state_64(st);
    for (int i = 0; i < iv_len; i += 4) {
        const uint k = prng64_provider_load_u32_le(iv + i);
        st->R[PRNG64_SOBER128_Keyp64] += k;
        prng64_sober128_cycle_64(st->R);
        st->R[PRNG64_SOBER128_Foldp64] ^= prng64_sober128_nltap_64(st);
    }
    st->R[PRNG64_SOBER128_Keyp64] += (uint)iv_len;
    prng64_sober128_diffuse_64(st);
    st->sbuf = 0u;
    st->nbuf = 0;
}

// Device helper: prng64_sober128_keystream_64.
static inline void prng64_sober128_keystream_64(thread Prng64Sober128State* st, thread uchar* out, int out_len) {
    int pos = 0;
    while (st->nbuf != 0 && pos < out_len) {
        out[pos++] = (uchar)(st->sbuf & 0xffu);
        st->sbuf >>= 8;
        st->nbuf -= 8;
    }
    while (out_len - pos >= 4) {
        prng64_sober128_cycle_64(st->R);
        const uint t = prng64_sober128_nltap_64(st);
        out[pos + 0] = (uchar)(t);
        out[pos + 1] = (uchar)(t >> 8);
        out[pos + 2] = (uchar)(t >> 16);
        out[pos + 3] = (uchar)(t >> 24);
        pos += 4;
    }
    if (pos < out_len) {
        prng64_sober128_cycle_64(st->R);
        st->sbuf = prng64_sober128_nltap_64(st);
        st->nbuf = 32;
        while (st->nbuf != 0 && pos < out_len) {
            out[pos++] = (uchar)(st->sbuf & 0xffu);
            st->sbuf >>= 8;
            st->nbuf -= 8;
        }
    }
}

// LibTomCrypt sober128 is a real PRNG surface over the SOBER-128 stream generator.
class Prng64LibTomCryptSober128Prng {
    Prng64Sober128State st;
    uchar buffer[32];
    int index;
// Device helper: refill.
    void refill() {
        prng64_sober128_keystream_64(&st, buffer, (int)sizeof(buffer));
        index = 0;
    }
public:
    explicit Prng64LibTomCryptSober128Prng(ulong seed) : index(32) {
        uchar ent[40];
        uchar material[64];
        memset(ent, 0, sizeof(ent));
        prng64_provider_fill_material(seed, 0x4c5443534f424552ul, 0x31323850524e4736ul, material, (int)sizeof(material));
        for (int i = 0; i < (int)sizeof(material); ++i) {
            ent[i % (int)sizeof(ent)] ^= material[i];
        }
        memset(buffer, 0, sizeof(buffer));
        prng64_sober128_setup_64(&st, ent, 32);
        prng64_sober128_setiv_64(&st, ent + 32, 8);
    }
    ulong next() {
        if (index > 24) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(buffer + index);
        index += 8;
        return out;
    }
};

// Crypto++ RandomPool uses SHA-256 to stir entropy and AES-256 to emit bytes.
class Prng64CryptoPPRandomPool {
    uchar key[32];
    uchar seed_bytes[16];
    uchar block[16];
    uint round_keys[60];
    ulong tick_counter;
    bool key_set;
    int block_index;
// Device helper: incorporate_entropy.
    void incorporate_entropy(thread const uchar* input, int input_len) {
        uchar hash_input[96];
        memcpy(hash_input, key, 32);
        memcpy(hash_input + 32, input, input_len);
        SHA256(hash_input, (ulong)(32 + input_len), key);
        key_set = false;
    }
// Device helper: refill.
    void refill() {
        if (!key_set) {
            prng64_provider_aes_expand_key(key, round_keys);
            key_set = true;
        }
        prng64_provider_le_add_u64(seed_bytes + 0, 8, tick_counter);
        prng64_provider_le_add_u64(seed_bytes + 8, 8, tick_counter ^ 0x9e3779b97f4a7c15ul);
        ++tick_counter;
        prng64_provider_aes_encrypt_block(round_keys, seed_bytes, seed_bytes);
        memcpy(block, seed_bytes, sizeof(block));
        block_index = 0;
    }
public:
    explicit Prng64CryptoPPRandomPool(ulong seed) : tick_counter(1ul), key_set(false), block_index(16) {
        uchar material[48];
        memset(key, 0, sizeof(key));
        memset(seed_bytes, 0, sizeof(seed_bytes));
        memset(block, 0, sizeof(block));
        prng64_provider_fill_material(seed, 0x43505052414e4450ul, 0x4f4f4c5348413235ul, material, (int)sizeof(material));
        incorporate_entropy(material, (int)sizeof(material));
    }
    ulong next() {
        if (block_index > 8) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

// Device helper: provider_sha1_prng64_rotl64.
static inline uint provider_sha1_prng64_rotl64(uint x, unsigned r) {
    return (x << r) | (x >> (32u - r));
}

// Device helper: provider_sha1_compress_block64.
static inline void provider_sha1_compress_block64(thread uint state[5], thread const uchar block[64]) {
    uint w[80];
    for (int i = 0; i < 16; ++i) {
        w[i] = prng64_provider_load_u32_be(block + i * 4);
    }
    for (int i = 16; i < 80; ++i) {
        w[i] = provider_sha1_prng64_rotl64(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    }
    uint a = state[0];
    uint b = state[1];
    uint c = state[2];
    uint d = state[3];
    uint e = state[4];
    for (int i = 0; i < 80; ++i) {
        uint f;
        uint k;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5A827999u;
        }
        else if (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ED9EBA1u;
        }
        else if (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8F1BBCDCu;
        }
        else {
            f = b ^ c ^ d;
            k = 0xCA62C1D6u;
        }
        const uint temp = provider_sha1_prng64_rotl64(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = provider_sha1_prng64_rotl64(b, 30);
        b = a;
        a = temp;
    }
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
}

// Device helper: provider_sha1_hash64.
static inline void provider_sha1_hash64(thread const uchar* msg, int len, thread uchar out[20]) {
    uint state[5] = {
        0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u
    };
    const int ful_blocks = len / 64;
    const int rem = len % 64;
    for (int i = 0; i < ful_blocks; ++i) {
        provider_sha1_compress_block64(state, msg + i * 64);
    }
    uchar block[64];
    memset(block, 0, sizeof(block));
    if (rem > 0) {
        memcpy(block, msg + ful_blocks * 64, rem);
    }
    block[rem] = 0x80u;
    const ulong bit_len = (ulong)(unsigned int)len * 8ul;
    if (rem >= 56) {
        provider_sha1_compress_block64(state, block);
        memset(block, 0, sizeof(block));
    }
    for (int i = 0; i < 8; ++i) {
        block[56 + i] = (uchar)(bit_len >> (56 - i * 8));
    }
    provider_sha1_compress_block64(state, block);
    for (int i = 0; i < 5; ++i) {
        out[i * 4 + 0] = (uchar)(state[i] >> 24);
        out[i * 4 + 1] = (uchar)(state[i] >> 16);
        out[i * 4 + 2] = (uchar)(state[i] >> 8);
        out[i * 4 + 3] = (uchar)(state[i]);
    }
}

// Device helper: provider_mdc_sha1_encrypt_block64.
static inline void provider_mdc_sha1_encrypt_block64(thread const uchar key[64], thread const uchar in[20], thread uchar out[20]) {
    uint state[5];
    for (int i = 0; i < 5; ++i) {
        state[i] = prng64_provider_load_u32_be(in + i * 4);
    }
    provider_sha1_compress_block64(state, key);
    for (int i = 0; i < 5; ++i) {
        out[i * 4 + 0] = (uchar)(state[i] >> 24);
        out[i * 4 + 1] = (uchar)(state[i] >> 16);
        out[i * 4 + 2] = (uchar)(state[i] >> 8);
        out[i * 4 + 3] = (uchar)(state[i]);
    }
}

// Crypto++ OldRandomPool is the historical PGP-style MDC<SHA-1> compatibility generator.
class Prng64CryptoPPOldRandomPool {
    static constant int kPoolSize = 384;
    static constant int kBlockSize = 20;
    static constant int kKeySize = 64;
    uchar pool[kPoolSize];
    uchar key[kKeySize];
    int add_pos;
    int get_pos;
// Device helper: stir.
    void stir() {
        uchar feedback[kBlockSize];
        uchar keystream[kBlockSize];
        for (int round = 0; round < 2; ++round) {
            memcpy(feedback, pool + kPoolSize - kBlockSize, kBlockSize);
            for (int pos = 0; pos < kPoolSize; pos += kBlockSize) {
                const int chunk = ((pos + kBlockSize) <= kPoolSize) ? kBlockSize : (kPoolSize - pos);
                provider_mdc_sha1_encrypt_block64(key, feedback, keystream);
                for (int i = 0; i < chunk; ++i) {
                    pool[pos + i] ^= keystream[i];
                }
                if (chunk == kBlockSize) {
                    memcpy(feedback, pool + pos, kBlockSize);
                }
            }
            memcpy(key, pool, kKeySize);
        }
        add_pos = 0;
        get_pos = kKeySize;
    }
// Device helper: incorporate_entropy.
    void incorporate_entropy(thread const uchar* input, int input_len) {
        while (input_len > 0) {
            const int space = kPoolSize - add_pos;
            const int take = (input_len < space) ? input_len : space;
            for (int i = 0; i < take; ++i) {
                pool[add_pos + i] ^= input[i];
            }
            add_pos += take;
            input += take;
            input_len -= take;
            if (add_pos == kPoolSize) {
                get_pos = kPoolSize;
                if (input_len > 0) {
                    stir();
                }
            }
        }
        if (add_pos > 0) {
            get_pos = kPoolSize;
        }
    }
// Device helper: next_byte.
    uchar next_byte() {
        if (get_pos == kPoolSize) {
            stir();
        }
        return pool[get_pos++];
    }
public:
    explicit Prng64CryptoPPOldRandomPool(ulong seed) : add_pos(0), get_pos(kPoolSize) {
        uchar material[kPoolSize];
        memset(pool, 0, sizeof(pool));
        memset(key, 0, sizeof(key));
        prng64_provider_fill_material(seed, 0x4350504f4c445250ul, 0x4f4f4c5348413130ul, material, (int)sizeof(material));
        incorporate_entropy(material, (int)sizeof(material));
    }
    ulong next() {
        return ((ulong)next_byte() << 56) |
            ((ulong)next_byte() << 48) |
            ((ulong)next_byte() << 40) |
            ((ulong)next_byte() << 32) |
            ((ulong)next_byte() << 24) |
            ((ulong)next_byte() << 16) |
            ((ulong)next_byte() << 8) |
            ((ulong)next_byte());
    }
};

// Crypto++ X917RNG combines an AES block cipher, a seed vector, and a deterministic time vector.
class Prng64CryptoPPX917RNG {
    uchar key[32];
    uchar randseed[16];
    uchar timevec[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;
// Device helper: refill.
    void refill() {
        uchar datetime[16];
        uchar tmp[16];
        prng64_provider_aes_encrypt_block(round_keys, timevec, datetime);
        prng64_provider_inc_counter_be(timevec, 16);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(randseed[i] ^ datetime[i]);
        }
        prng64_provider_aes_encrypt_block(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(block[i] ^ datetime[i]);
        }
        prng64_provider_aes_encrypt_block(round_keys, tmp, randseed);
        block_index = 0;
    }
public:
    explicit Prng64CryptoPPX917RNG(ulong seed) : block_index(16) {
        uchar material[64];
        prng64_provider_fill_material(seed, 0x4350505839313752ul, 0x4e47414553323536ul, material, (int)sizeof(material));
        memcpy(key, material, 32);
        memcpy(randseed, material + 32, 16);
        memcpy(timevec, material + 48, 16);
        prng64_provider_aes_expand_key(key, round_keys);
    }
    ulong next() {
        if (block_index > 8) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

// Crypto++ LC_RNG is a historical non-cryptographic byte generator using Burton's 48271 constants.
class Prng64CryptoPPLC_RNG {
    uint seed_state;
// Device helper: next_byte.
    uchar next_byte() {
        const uint m = 2147483647u;
        const uint q = 44488u;
        const uint a = 48271u;
        const uint r = 3399u;
        const uint hi = seed_state / q;
        const uint lo = seed_state % q;
        const long test = (long)a * (long)lo - (long)r * (long)hi;
        seed_state = (test > 0) ? (uint)test : (uint)(test + m);
        return (uchar)(((seed_state >> 0) & 0xffu) ^
            ((seed_state >> 8) & 0xffu) ^
            ((seed_state >> 16) & 0xffu) ^
            ((seed_state >> 24) & 0xffu));
    }
public:
    explicit Prng64CryptoPPLC_RNG(ulong seed) {
        seed_state = (uint)((seed % 2147483646ul) + 1ul);
    }
    ulong next() {
        return ((ulong)next_byte() << 56) |
            ((ulong)next_byte() << 48) |
            ((ulong)next_byte() << 40) |
            ((ulong)next_byte() << 32) |
            ((ulong)next_byte() << 24) |
            ((ulong)next_byte() << 16) |
            ((ulong)next_byte() << 8) |
            ((ulong)next_byte());
    }
};

// Bitcoin Core FastRandomContext exposes ChaCha20-based fast randomness.
class Prng64BitcoinCoreFastRandom {
    Prng64ChaChaProviderCore core;
public:
// Device helper: Prng64BitcoinCoreFastRandom.
    explicit Prng64BitcoinCoreFastRandom(ulong seed) {
        core.init(seed, 20, 0x4254434641535436ul, false);
    }
// Device helper: next.
    ulong next() {
        return core.next64();
    }
};

// Bitcoin Core InsecureRandomContext is xoroshiro128++ seeded with SplitMix64.
class Prng64BitcoinCoreInsecureRandom {
    ulong s0, s1;
public:
// Device helper: Prng64BitcoinCoreInsecureRandom.
    explicit Prng64BitcoinCoreInsecureRandom(ulong seed) {
        ulong sm = seed ^ 0x425443494e534543ul;
        s0 = prng64_splitmix64_next(sm);
        s1 = prng64_splitmix64_next(sm);
        if ((s0 | s1) == 0ul) s0 = 1ul;
    }
// Device helper: next.
    ulong next() {
        ulong a0 = s0;
        ulong a1 = s1;
        const ulong result = prng64_rotl64(a0 + a1, 17) + a0;
        a1 ^= a0;
        s0 = prng64_rotl64(a0, 49) ^ a1 ^ (a1 << 21);
        s1 = prng64_rotl64(a1, 28);
        return result;
    }
};

// sjcl.random.randomWords() is a pooled AES-based browser PRNG used in wallet/browser crypto stacks such as BitGo.
class Prng64SjclRandomWords {
    uint key_words[8];
    uint counter_words[4];
    uint round_keys[60];
    uint block_words[4];
    int block_index;
// Device helper: set_key.
    void set_key(thread const uint words[8]) {
        memcpy(key_words, words, sizeof(key_words));
        prng64_provider_aes_expand_key_words64(key_words, round_keys);
    }
// Device helper: counter_increment.
    void counter_increment() {
        for (int i = 0; i < 4; ++i) {
            counter_words[i] += 1u;
            if (counter_words[i] != 0u) {
                break;
            }
        }
    }
// Device helper: gen4words.
    void gen4words(thread uint out[4]) {
        counter_increment();
        prng64_provider_aes_encrypt_words64(round_keys, counter_words, out);
    }
// Device helper: refill.
    void refill() {
        gen4words(block_words);
        block_index = 0;
    }
// Device helper: next_word.
    uint next_word() {
        if (block_index >= 4) {
            refill();
        }
        return block_words[block_index++];
    }
public:
    explicit Prng64SjclRandomWords(ulong seed) : block_index(4) {
        uchar material[196];
        uchar pool_digest[32];
        uchar key_digest[32];
        uint entropy_words[32];
        uint ambient_words[16];
        uint pool_words[38];
        uint reseed_words[25];
        uint key_material_words[33];
        uint init_key[8];
        memset(key_words, 0, sizeof(key_words));
        memset(counter_words, 0, sizeof(counter_words));
        memset(block_words, 0, sizeof(block_words));
        prng64_provider_fill_material(seed, 0x534a434c52414e44ul, 0x4f4d574f52445336ul, material, (int)sizeof(material));
        for (int i = 0; i < 32; ++i) {
            entropy_words[i] = prng64_provider_load_u32_be(material + i * 4);
        }
        const uint time_word = prng64_provider_load_u32_be(material + 128);
        for (int i = 0; i < 16; ++i) {
            ambient_words[i] = prng64_provider_load_u32_be(material + 132 + i * 4);
        }
        pool_words[0] = 0u;
        pool_words[1] = 0u;
        pool_words[2] = 2u;
        pool_words[3] = 1024u;
        pool_words[4] = time_word;
        pool_words[5] = 32u;
        memcpy(pool_words + 6, entropy_words, sizeof(entropy_words));
        prng64_provider_sha256_words_be(pool_words, 38, pool_digest);
        reseed_words[0] = time_word + 30000u;
        memcpy(reseed_words + 1, ambient_words, sizeof(ambient_words));
        for (int i = 0; i < 8; ++i) {
            reseed_words[17 + i] = prng64_provider_load_u32_be(pool_digest + i * 4);
        }
        memset(key_material_words, 0, sizeof(uint) * 8);
        memcpy(key_material_words + 8, reseed_words, sizeof(reseed_words));
        prng64_provider_sha256_words_be(key_material_words, 33, key_digest);
        for (int i = 0; i < 8; ++i) {
            init_key[i] = prng64_provider_load_u32_be(key_digest + i * 4);
        }
        set_key(init_key);
        counter_increment();
    }
    ulong next() {
        return ((ulong)next_word() << 32) | (ulong)next_word();
    }
};

static inline void prng64_provider_store_u32_le(thread uchar* out, uint x) {
    out[0] = uchar(x);
    out[1] = uchar(x >> 8u);
    out[2] = uchar(x >> 16u);
    out[3] = uchar(x >> 24u);
}

static inline uint prng64_provider_md5_rotl(uint x, uint r) {
    return (x << r) | (x >> (32u - r));
}

static inline void prng64_provider_md5_compress(thread uint state[4], thread const uchar block[64]) {
    const uint kTable[64] = {
        0xd76aa478u, 0xe8c7b756u, 0x242070dbu, 0xc1bdceeeu,
        0xf57c0fafu, 0x4787c62au, 0xa8304613u, 0xfd469501u,
        0x698098d8u, 0x8b44f7afu, 0xffff5bb1u, 0x895cd7beu,
        0x6b901122u, 0xfd987193u, 0xa679438eu, 0x49b40821u,
        0xf61e2562u, 0xc040b340u, 0x265e5a51u, 0xe9b6c7aau,
        0xd62f105du, 0x02441453u, 0xd8a1e681u, 0xe7d3fbc8u,
        0x21e1cde6u, 0xc33707d6u, 0xf4d50d87u, 0x455a14edu,
        0xa9e3e905u, 0xfcefa3f8u, 0x676f02d9u, 0x8d2a4c8au,
        0xfffa3942u, 0x8771f681u, 0x6d9d6122u, 0xfde5380cu,
        0xa4beea44u, 0x4bdecfa9u, 0xf6bb4b60u, 0xbebfbc70u,
        0x289b7ec6u, 0xeaa127fau, 0xd4ef3085u, 0x04881d05u,
        0xd9d4d039u, 0xe6db99e5u, 0x1fa27cf8u, 0xc4ac5665u,
        0xf4292244u, 0x432aff97u, 0xab9423a7u, 0xfc93a039u,
        0x655b59c3u, 0x8f0ccc92u, 0xffeff47du, 0x85845dd1u,
        0x6fa87e4fu, 0xfe2ce6e0u, 0xa3014314u, 0x4e0811a1u,
        0xf7537e82u, 0xbd3af235u, 0x2ad7d2bbu, 0xeb86d391u
    };
    const uchar kShift[64] = {
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
    };
    uint a = state[0], b = state[1], c = state[2], d = state[3];
    uint m[16];
    for (int i = 0; i < 16; ++i) m[i] = prng64_provider_load_u32_le(block + i * 4);
    for (int i = 0; i < 64; ++i) {
        uint f;
        int g;
        if (i < 16) {
            f = (b & c) | (~b & d); g = i;
        } else if (i < 32) {
            f = (d & b) | (~d & c); g = (5 * i + 1) & 15;
        } else if (i < 48) {
            f = b ^ c ^ d; g = (3 * i + 5) & 15;
        } else {
            f = c ^ (b | ~d); g = (7 * i) & 15;
        }
        const uint t = d;
        d = c;
        c = b;
        b = b + prng64_provider_md5_rotl(a + f + kTable[i] + m[g], uint(kShift[i]));
        a = t;
    }
    state[0] += a; state[1] += b; state[2] += c; state[3] += d;
}

static inline void prng64_provider_md5_hash(thread const uchar* msg, int len, thread uchar out[16]) {
    uint state[4] = { 0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u };
    const int full_blocks = len / 64;
    const int rem = len % 64;
    for (int i = 0; i < full_blocks; ++i) {
        prng64_provider_md5_compress(state, msg + i * 64);
    }
    uchar block[64];
    for (int i = 0; i < 64; ++i) block[i] = 0u;
    for (int i = 0; i < rem; ++i) block[i] = msg[full_blocks * 64 + i];
    block[rem] = 0x80u;
    const ulong bit_len = ulong(uint(len)) * 8ul;
    if (rem >= 56) {
        prng64_provider_md5_compress(state, block);
        for (int i = 0; i < 64; ++i) block[i] = 0u;
    }
    for (int i = 0; i < 8; ++i) block[56 + i] = uchar(bit_len >> uint(i * 8));
    prng64_provider_md5_compress(state, block);
    for (int i = 0; i < 4; ++i) {
        prng64_provider_store_u32_le(out + i * 4, state[i]);
    }
}

static inline int prng64_seedrandom_decimal(ulong seed, thread char out[21]) {
    char tmp[21];
    int len = 0;
    do {
        tmp[len++] = char('0' + (seed % 10ul));
        seed /= 10ul;
    } while (seed != 0ul);
    for (int i = 0; i < len; ++i) out[i] = tmp[len - 1 - i];
    return len;
}

static inline int prng64_seedrandom_mixkey(thread const char* seed, int seed_len, thread uchar key[256]) {
    for (int i = 0; i < 256; ++i) key[i] = 0u;
    uint smear = 0u;
    for (int j = 0; j < seed_len; ++j) {
        const int idx = j & 255;
        smear ^= uint(key[idx]) * 19u;
        key[idx] = uchar((smear + uchar(seed[j])) & 255u);
    }
    if (seed_len == 0) {
        key[0] = 0u;
        return 1;
    }
    return seed_len;
}

static inline uint prng64_seedrandom_mash(thread PrngSeedrandomMashDouble& n, thread const char* data, int len) {
    return prng_seedrandom_mash(n, data, len);
}

class Prng64LibbitcoinMilkSadMt19937 {
    Prng64Mt19937ProviderCore core;
    uchar next_byte() {
        const uint r = core.next32();
        return uchar(r >> 24u);
    }
public:
    explicit Prng64LibbitcoinMilkSadMt19937(ulong seed) : core(seed) {}
    ulong next() {
        ulong v = ulong(next_byte());
        v |= ulong(next_byte()) << 8u;
        v |= ulong(next_byte()) << 16u;
        v |= ulong(next_byte()) << 24u;
        v |= ulong(next_byte()) << 32u;
        v |= ulong(next_byte()) << 40u;
        v |= ulong(next_byte()) << 48u;
        v |= ulong(next_byte()) << 56u;
        return v;
    }
};

class Prng64TrustWalletMt19937 {
    Prng64Mt19937ProviderCore core;
public:
    explicit Prng64TrustWalletMt19937(ulong seed) : core(seed ? seed : 1ul) {}
    ulong next() {
        ulong lo = ulong(core.next32());
        ulong hi = ulong(core.next32());
        return (hi << 32u) | lo;
    }
};

struct Prng64ProviderV8MathRandom {
    ulong state0;
    ulong state1;
    explicit Prng64ProviderV8MathRandom(ulong seed) {
        state0 = prng64_mix_murmur64_provider(seed ^ 0x56384d4154483634ul);
        state1 = prng64_mix_murmur64_provider(state0);
        if ((state0 | state1) == 0ul) state1 = 1ul;
    }
    ulong next_u64() {
        ulong s1 = state0;
        ulong s0 = state1;
        state0 = s0;
        s1 ^= s1 << 23u;
        s1 ^= s1 >> 17u;
        s1 ^= s0;
        s1 ^= s0 >> 26u;
        state1 = s1;
        return s0 + s1;
    }
    ulong next_m53() {
        return next_u64() >> 11u;
    }
    float next_double() {
        return float(next_m53()) * (1.0 / 9007199254740992.0);
    }
    uint next_scaled(uint bound) {
        return prng_metal_double_m53_scaled_u32(next_m53(), bound);
    }
    bool next_gt_half() {
        return prng_metal_double_m53_gt_half(next_m53());
    }
};

static inline int prng64_v8_to_int32(float x) {
    return int(uint(long(x)));
}

class Prng64CryptoJSWordArrayRandomV8 {
    Prng64ProviderV8MathRandom js;
    ulong rcache_scaled;
    bool rcache_neg;
    bool have_rcache;
    ulong draw_scaled(thread int& m_w, thread int& m_z) {
        m_z = int(0x9069u * uint(m_z & 0xffff) + uint(m_z >> 16));
        m_w = int(0x4650u * uint(m_w & 0xffff) + uint(m_w >> 16));
        const uint result = uint((m_z << 16) + m_w);
        return ulong(result) + 0x80000000ul;
    }
    static uint signed_scaled_to_u32(bool neg, ulong scaled) {
        return uint(neg ? (0ul - scaled) : scaled);
    }
    uint next_word() {
        const bool use_cache = have_rcache && (rcache_scaled != 0ul);
        int m_w = use_cache
            ? int(signed_scaled_to_u32(rcache_neg, rcache_scaled))
            : int(prng_metal_double_m53_to_u32(js.next_m53()));
        int m_z = int(0x3ade68b1u);
        const ulong cache_draw = draw_scaled(m_w, m_z);
        rcache_neg = !js.next_gt_half();
        rcache_scaled = prng_round_u64_to_metal_double_integer(cache_draw * 0x3ade67b7ul);
        have_rcache = true;
        const ulong word_draw = draw_scaled(m_w, m_z);
        const bool word_neg = !js.next_gt_half();
        return signed_scaled_to_u32(word_neg, word_draw);
    }
public:
    explicit Prng64CryptoJSWordArrayRandomV8(ulong seed)
        : js(seed ^ 0x43525950544f4a53ul), rcache_scaled(0ul), rcache_neg(false), have_rcache(false) {}
    ulong next() {
        const ulong hi = ulong(next_word());
        const ulong lo = ulong(next_word());
        return (hi << 32u) | lo;
    }
};

struct Prng64NodeForgeAesPrngState {
    uint seed_words[4];
    uint round_keys[44];
    uchar block[16];
    int block_index;

    void store_be(thread uchar* out, uint x) {
        out[0] = uchar(x >> 24u); out[1] = uchar(x >> 16u);
        out[2] = uchar(x >> 8u); out[3] = uchar(x);
    }
    void init_from_digests(thread const uchar* key_bytes, thread const uchar* seed_bytes) {
        provider_aes_expand_key128(key_bytes, round_keys);
        for (int i = 0; i < 4; ++i) seed_words[i] = prng64_provider_load_u32_be(seed_bytes + i * 4);
        for (int i = 0; i < 16; ++i) block[i] = 0u;
        block_index = 16;
    }
    void init_legacy_sha1(thread const uchar pool0[32]) {
        uchar pool_digest[20], key_bytes[20], seed_bytes[20];
        prng64_provider_sha1_hash(pool0, 32, pool_digest);
        prng64_provider_sha1_hash(pool_digest, 20, key_bytes);
        prng64_provider_sha1_hash(key_bytes, 20, seed_bytes);
        init_from_digests(key_bytes, seed_bytes);
    }
    void init_modern_sha256(thread const uchar pool0[32]) {
        uchar pool_digest[32], key_bytes[32], seed_bytes[32];
        SHA256(pool0, 32, pool_digest);
        SHA256(pool_digest, sizeof(pool_digest), key_bytes);
        SHA256(key_bytes, sizeof(key_bytes), seed_bytes);
        init_from_digests(key_bytes, seed_bytes);
    }
    void refill() {
        uchar seed_bytes[16], next_key[16], next_seed[16];
        for (int i = 0; i < 4; ++i) store_be(seed_bytes + i * 4, seed_words[i]);
        provider_aes_encrypt_block128(round_keys, seed_bytes, block);
        ++seed_words[3];
        for (int i = 0; i < 4; ++i) store_be(seed_bytes + i * 4, seed_words[i]);
        provider_aes_encrypt_block128(round_keys, seed_bytes, next_key);
        provider_aes_expand_key128(next_key, round_keys);
        provider_aes_encrypt_block128(round_keys, seed_bytes, next_seed);
        for (int i = 0; i < 4; ++i) seed_words[i] = prng64_provider_load_u32_be(next_seed + i * 4);
        block_index = 0;
    }
    ulong next64() {
        if (block_index > 8) refill();
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

class Prng64NodeForgeAesPrngSha256 {
    Prng64NodeForgeAesPrngState core;
public:
    explicit Prng64NodeForgeAesPrngSha256(ulong seed) {
        uchar pool0[32];
        prng64_provider_fill_material(seed, 0x4e464f5247453235ul, 0x3653484132563430ul, pool0, int(sizeof(pool0)));
        core.init_modern_sha256(pool0);
    }
    ulong next() { return core.next64(); }
};

class Prng64NodeForgeLegacyAesPrngSha1 {
    Prng64NodeForgeAesPrngState core;
public:
    explicit Prng64NodeForgeLegacyAesPrngSha1(ulong seed) {
        uchar pool0[32];
        prng64_provider_fill_material(seed, 0x4e464f5247455348ul, 0x41314c4547414359ul, pool0, int(sizeof(pool0)));
        core.init_legacy_sha1(pool0);
    }
    ulong next() { return core.next64(); }
};

class Prng64KeypairNodeForgeMathRandomV8 {
    Prng64NodeForgeAesPrngState core;
    static uchar bug_byte(uint x) {
        return (x >= 48u && x <= 57u) ? uchar(x - 48u) : 0u;
    }
public:
    explicit Prng64KeypairNodeForgeMathRandomV8(ulong seed) {
        Prng64ProviderV8MathRandom js(seed ^ 0x4b45595041495231ul);
        uchar pool0[32];
        uint pm_seed = js.next_scaled(0xffffu);
        int produced = 0;
        int global_index = 0;
        while (produced < 32) {
            ulong lo = 16807ul * ulong(pm_seed & 0xffffu);
            ulong hi = 16807ul * ulong(pm_seed >> 16u);
            lo += (hi & 0x7ffful) << 16u;
            lo += hi >> 15u;
            lo = (lo & 0x7ffffffful) + (lo >> 31u);
            pm_seed = uint(lo);
            for (int i = 0; i < 3 && produced < 32; ++i) {
                uint next = pm_seed >> uint(i * 8);
                next ^= js.next_scaled(0xffu);
                if ((global_index & 31) == 0) pool0[produced++] = bug_byte(next & 0xffu);
                ++global_index;
            }
        }
        core.init_legacy_sha1(pool0);
    }
    ulong next() { return core.next64(); }
};

class Prng64RandomJsNativeMathV8 {
    Prng64ProviderV8MathRandom js;
    uint next_word() {
        return prng_metal_double_m53_to_u32(js.next_m53());
    }
public:
    explicit Prng64RandomJsNativeMathV8(ulong seed) : js(seed ^ 0x524a534e41544831ul) {}
    ulong next() { return (ulong(next_word()) << 32u) | ulong(next_word()); }
};

class Prng64RandomJsMt19937AutoSeed {
    static constant int N = 624;
    static constant int M = 397;
    uint mt[N];
    int idx;
    void init_genrand(uint s) {
        mt[0] = s;
        for (int i = 1; i < N; ++i) mt[i] = 1812433253u * (mt[i - 1] ^ (mt[i - 1] >> 30u)) + uint(i);
        idx = N;
    }
    void init_by_array(thread const uint* key, int key_len) {
        init_genrand(0x012bd6aau);
        int i = 1, j = 0, k = (N > key_len) ? N : key_len;
        for (; k; --k) {
            mt[i] = (mt[i] ^ ((mt[i - 1] ^ (mt[i - 1] >> 30u)) * 0x0019660du)) + key[j] + uint(j);
            ++i; ++j;
            if (i >= N) { mt[0] = mt[N - 1]; i = 1; }
            if (j >= key_len) j = 0;
        }
        for (k = N - 1; k; --k) {
            mt[i] = (mt[i] ^ ((mt[i - 1] ^ (mt[i - 1] >> 30u)) * 0x5d588b65u)) - uint(i);
            ++i;
            if (i >= N) { mt[0] = mt[N - 1]; i = 1; }
        }
        mt[0] = 0x80000000u;
        idx = N;
    }
    void twist() {
        for (int i = 0; i < N; ++i) {
            uint y = (mt[i] & 0x80000000u) | (mt[(i + 1) % N] & 0x7fffffffu);
            mt[i] = mt[(i + M) % N] ^ (y >> 1u) ^ ((y & 1u) ? 0x9908b0dfu : 0u);
        }
        idx = 0;
    }
    uint next_word() {
        if (idx >= N) twist();
        uint y = mt[idx++];
        y ^= y >> 11u; y ^= (y << 7u) & 0x9d2c5680u; y ^= (y << 15u) & 0xefc60000u; y ^= y >> 18u;
        return y;
    }
public:
    explicit Prng64RandomJsMt19937AutoSeed(ulong seed) : idx(N) {
        Prng64ProviderV8MathRandom js(seed ^ 0x524a534d54313939ul);
        uint key[16];
        key[0] = uint(seed) ^ uint(0x4352454154454555ul);
        for (int i = 1; i < 16; ++i) key[i] = prng_metal_double_m53_to_u32(js.next_m53());
        init_by_array(key, 16);
    }
    ulong next() { return (ulong(next_word()) << 32u) | ulong(next_word()); }
};

class Prng64ChanceJsMersenneTwisterV8 {
    Prng64Mt19937ProviderCore core;
    static ulong derive_seed(ulong seed) {
        Prng64ProviderV8MathRandom js(seed ^ 0x4348414e43454a53ul);
        return prng_metal_double_m53_scaled_u64(js.next_m53(), 10000000000000ul);
    }
public:
    explicit Prng64ChanceJsMersenneTwisterV8(ulong seed) : core(derive_seed(seed)) {}
    ulong next() { return (ulong(core.next32()) << 32u) | ulong(core.next32()); }
};

class Prng64JsrsasignSecureRandomV8 {
    uchar S[256];
    uchar i;
    uchar j;
    static void seed_int(thread uchar pool[256], thread int& pptr, uint x) {
        pool[pptr++] ^= uchar(x & 255u);
        pool[pptr++] ^= uchar((x >> 8u) & 255u);
        pool[pptr++] ^= uchar((x >> 16u) & 255u);
        pool[pptr++] ^= uchar((x >> 24u) & 255u);
        if (pptr >= 256) pptr -= 256;
    }
    uchar next_byte() {
        i = uchar(i + 1u);
        j = uchar(j + S[i]);
        uchar t = S[i]; S[i] = S[j]; S[j] = t;
        return S[uchar(t + S[i])];
    }
public:
    explicit Prng64JsrsasignSecureRandomV8(ulong seed) : i(0), j(0) {
        Prng64ProviderV8MathRandom js(seed ^ 0x4a53525341534947ul);
        uchar pool[256];
        int pptr = 0;
        while (pptr < 256) {
            const uint t = prng_metal_double_m53_to_u16(js.next_m53());
            pool[pptr++] = uchar(t >> 8u);
            pool[pptr++] = uchar(t & 255u);
        }
        pptr = 0;
        seed_int(pool, pptr, uint(seed) ^ uint(0x524e4754494d4531ul));
        for (int n = 0; n < 256; ++n) S[n] = uchar(n);
        uchar k = 0;
        for (int n = 0; n < 256; ++n) {
            k = uchar(k + S[n] + pool[n]);
            uchar t = S[n]; S[n] = S[k]; S[k] = t;
        }
    }
    ulong next() {
        ulong v = ulong(next_byte());
        v |= ulong(next_byte()) << 8u; v |= ulong(next_byte()) << 16u; v |= ulong(next_byte()) << 24u;
        v |= ulong(next_byte()) << 32u; v |= ulong(next_byte()) << 40u; v |= ulong(next_byte()) << 48u; v |= ulong(next_byte()) << 56u;
        return v;
    }
};

class Prng64FortiOsX931 {
    uchar state[16];
    uchar datetime[16];
    uchar block[16];
    uint round_keys[44];
    int block_index;
    void refill() {
        uchar enc_dt[16], tmp[16];
        provider_aes_encrypt_block128(round_keys, datetime, enc_dt);
        for (int i = 0; i < 16; ++i) tmp[i] = uchar(enc_dt[i] ^ state[i]);
        provider_aes_encrypt_block128(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) tmp[i] = uchar(enc_dt[i] ^ block[i]);
        provider_aes_encrypt_block128(round_keys, tmp, state);
        prng64_provider_inc_counter_be(datetime, 16);
        block_index = 0;
    }
public:
    explicit Prng64FortiOsX931(ulong seed) : block_index(16) {
        uchar material[32];
        uchar fixed_key[16] = { 0x6d, 0x66, 0xb1, 0xf3, 0x42, 0x72, 0x60, 0x13, 0xab, 0x1c, 0x06, 0xed, 0x02, 0x62, 0xd4, 0xb8 };
        prng64_provider_fill_material(seed, 0x464f5254494f5358ul, 0x3933314455484b36ul, material, int(sizeof(material)));
        for (int i = 0; i < 16; ++i) { state[i] = material[i]; datetime[i] = material[16 + i]; }
        provider_aes_expand_key128(fixed_key, round_keys);
    }
    ulong next() {
        if (block_index > 8) refill();
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

class Prng64NetscapeSslPrng {
    uchar seed_state[16];
    uchar block[16];
    int block_index;
    uint mklcpr(uint x) { return uint(((0xdeece66dul * ulong(x)) + 0x2bbb62dcul) >> 1u); }
    void refill() {
        prng64_provider_md5_hash(seed_state, int(sizeof(seed_state)), block);
        for (int i = 15; i >= 0; --i) {
            seed_state[i] = uchar(seed_state[i] + 1u);
            if (seed_state[i] != 0u) break;
        }
        block_index = 0;
    }
public:
    explicit Prng64NetscapeSslPrng(ulong seed) : block_index(16) {
        uchar material[16];
        uchar seed_material[8];
        prng64_provider_fill_material(seed, 0x4e45545343415045ul, 0x53534c50524e4736ul, material, int(sizeof(material)));
        const uint seconds = prng64_provider_load_u32_be(material + 0);
        const uint micros = prng64_provider_load_u32_be(material + 4) % 1000000u;
        const uint pid = prng64_provider_load_u32_be(material + 8) & 0x7fffu;
        const uint ppid = prng64_provider_load_u32_be(material + 12) & 0x7fffu;
        prng64_provider_store_u32_be(seed_material + 0, mklcpr(micros));
        prng64_provider_store_u32_be(seed_material + 4, mklcpr(pid + seconds + (ppid << 12u)));
        prng64_provider_md5_hash(seed_material, int(sizeof(seed_material)), seed_state);
        for (int i = 0; i < 16; ++i) block[i] = 0u;
    }
    ulong next() {
        if (block_index > 8) refill();
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

class Prng64OpenSslMdRandProviderCore {
    static constant int kStateSize = 1023;
    static constant int kDigestSize = 16;
    uchar state[kStateSize + kDigestSize];
    uchar md[kDigestSize];
    uchar block[kDigestSize];
    uint md_count0, md_count1, pid_word;
    int state_num, state_index, block_index;
    bool stirred;
    void add_seed_material(thread const uchar* input, int input_len) {
        int st_idx = state_index;
        uint md_c0 = md_count0, md_c1 = md_count1;
        uchar local_md[kDigestSize];
        for (int i = 0; i < kDigestSize; ++i) local_md[i] = md[i];
        state_index += input_len;
        if (state_index >= kStateSize) { state_index %= kStateSize; state_num = kStateSize; }
        else if (state_num < kStateSize && state_index > state_num) state_num = state_index;
        md_count1 += uint(input_len / kDigestSize) + uint((input_len % kDigestSize) > 0);
        int offset = 0;
        while (offset < input_len) {
            const int chunk = ((input_len - offset) > kDigestSize) ? kDigestSize : (input_len - offset);
            uchar msg[kDigestSize + kDigestSize + kDigestSize + 8];
            int p = 0;
            for (int i = 0; i < kDigestSize; ++i) msg[p++] = local_md[i];
            for (int i = 0; i < chunk; ++i) msg[p++] = state[(st_idx + i) % kStateSize];
            for (int i = 0; i < chunk; ++i) msg[p++] = input[offset + i];
            prng64_provider_store_u32_le(msg + p, md_c0); p += 4;
            prng64_provider_store_u32_le(msg + p, md_c1); p += 4;
            prng64_provider_md5_hash(msg, p, local_md);
            ++md_c1;
            offset += chunk;
            for (int i = 0; i < chunk; ++i) {
                state[st_idx] ^= local_md[i];
                if (++st_idx >= kStateSize) st_idx = 0;
            }
        }
        for (int i = 0; i < kDigestSize; ++i) md[i] ^= local_md[i];
    }
    void stir_pool() {
        uchar dummy[kDigestSize] = { '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.', '.' };
        int remaining = kStateSize;
        while (remaining > 0) { add_seed_material(dummy, kDigestSize); remaining -= kDigestSize; }
        stirred = true;
    }
    void fill_bytes(thread uchar* out, int out_len) {
        if (!stirred) stir_pool();
        const int out_chunk = kDigestSize / 2;
        const int st_num = state_num ? state_num : kStateSize;
        const int out_len_ceil = ((out_len + out_chunk - 1) / out_chunk) * out_chunk;
        int st_idx = state_index;
        uint md_c0 = md_count0, md_c1 = md_count1;
        uchar local_md[kDigestSize];
        for (int i = 0; i < kDigestSize; ++i) local_md[i] = md[i];
        state_index += out_len_ceil;
        if (state_index > st_num) state_index %= st_num;
        md_count0 += 1u;
        int offset = 0;
        bool first_round = true;
        while (offset < out_len) {
            const int chunk = ((out_len - offset) > out_chunk) ? out_chunk : (out_len - offset);
            uchar msg[4 + kDigestSize + 8 + out_chunk + out_chunk];
            int p = 0;
            if (first_round) { prng64_provider_store_u32_le(msg + p, pid_word); p += 4; first_round = false; }
            for (int i = 0; i < kDigestSize; ++i) msg[p++] = local_md[i];
            prng64_provider_store_u32_le(msg + p, md_c0); p += 4;
            prng64_provider_store_u32_le(msg + p, md_c1); p += 4;
            for (int i = 0; i < chunk; ++i) msg[p++] = out[offset + i];
            for (int i = 0; i < out_chunk; ++i) msg[p++] = state[(st_idx + i) % st_num];
            prng64_provider_md5_hash(msg, p, local_md);
            for (int i = 0; i < out_chunk; ++i) {
                state[st_idx] ^= local_md[i];
                if (++st_idx >= st_num) st_idx = 0;
                if (i < chunk) out[offset++] = local_md[i + out_chunk];
            }
        }
        uchar final_msg[8 + kDigestSize + kDigestSize];
        prng64_provider_store_u32_le(final_msg + 0, md_c0);
        prng64_provider_store_u32_le(final_msg + 4, md_c1);
        for (int i = 0; i < kDigestSize; ++i) final_msg[8 + i] = local_md[i];
        for (int i = 0; i < kDigestSize; ++i) final_msg[8 + kDigestSize + i] = md[i];
        prng64_provider_md5_hash(final_msg, int(sizeof(final_msg)), md);
    }
public:
    Prng64OpenSslMdRandProviderCore()
        : md_count0(0u), md_count1(0u), pid_word(0u), state_num(0), state_index(0), block_index(kDigestSize), stirred(false) {
        for (int i = 0; i < kStateSize + kDigestSize; ++i) state[i] = 0u;
        for (int i = 0; i < kDigestSize; ++i) { md[i] = 0u; block[i] = 0u; }
    }
    void init_full(ulong seed, ulong domain0, ulong domain1) {
        uchar material[64];
        prng64_provider_fill_material(seed, domain0, domain1, material, int(sizeof(material)));
        pid_word = prng64_provider_load_u32_le(material);
        add_seed_material(material, int(sizeof(material)));
    }
    void init_weak(ulong seed, ulong domain0, ulong domain1) {
        uchar material[16];
        prng64_provider_fill_material(seed, domain0, domain1, material, int(sizeof(material)));
        pid_word = prng64_provider_load_u32_le(material);
        add_seed_material(material, int(sizeof(material)));
    }
    ulong next() {
        if (block_index > 8) {
            fill_bytes(block, int(sizeof(block)));
            block_index = 0;
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

