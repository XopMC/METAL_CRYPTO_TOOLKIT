    Prng32GlibcRandomFeedback32<15, 1, 150> core;
public:
    explicit Prng32GlibcRandomType2_32(uint seed) : core(seed) {}
    uint next() { return core.next(); }
};

class Prng32GlibcRandomType4_32 {
    Prng32GlibcRandomFeedback32<63, 1, 630> core;
public:
    explicit Prng32GlibcRandomType4_32(uint seed) : core(seed) {}
    uint next() { return core.next(); }
};

class Prng32MT19937_Compat31 {
    uint mt[624];
    int idx;
    static uint f(uint x) { return 1812433253u * (x ^ (x >> 30u)) + 1u; }
    void seed_mt(uint seed) {
        mt[0] = seed;
        for (int i = 1; i < 624; ++i) {
            mt[i] = f(mt[i - 1]) + uint(i);
        }
        idx = 624;
    }
    void twist() {
        for (int i = 0; i < 624; ++i) {
            const uint y = (mt[i] & 0x80000000u) | (mt[(i + 1) % 624] & 0x7fffffffu);
            mt[i] = mt[(i + 397) % 624] ^ (y >> 1u);
            if ((y & 1u) != 0u) mt[i] ^= 0x9908b0dfu;
        }
        idx = 0;
    }
    uint extract() {
        if (idx >= 624) twist();
        uint y = mt[idx++];
        y ^= y >> 11u;
        y ^= (y << 7u) & 0x9d2c5680u;
        y ^= (y << 15u) & 0xefc60000u;
        y ^= y >> 18u;
        return y;
    }
public:
    explicit Prng32MT19937_Compat31(uint seed) { seed_mt(seed); }
    uint next() { return extract() >> 1u; }
};

class Prng32EntropyGeneratorPHP5 {
    uint mtState[624];
    int index;
    void generate_numbers_php5() {
        for (int i = 0; i < 624; ++i) {
            const uint u = mtState[i];
            const uint v = mtState[(i + 1) % 624];
            const uint m = mtState[(i + 397) % 624];
            const uint y = ((u & 0x80000000u) | (v & 0x7fffffffu)) >> 1u;
            const uint mask = ((u & 1u) != 0u) ? 0x9908b0dfu : 0u;
            mtState[i] = m ^ y ^ mask;
        }
        index = 0;
    }
public:
    explicit Prng32EntropyGeneratorPHP5(uint seed) : index(0) {
        mtState[0] = seed;
        for (int i = 1; i < 624; ++i) {
            const uint prev = mtState[i - 1];
            mtState[i] = 1812433253u * (prev ^ (prev >> 30u)) + uint(i);
        }
    }
    uint next() {
        if (index == 0) {
            generate_numbers_php5();
        }
        uint y = mtState[index];
        y ^= y >> 11u;
        y ^= (y << 7u) & 0x9d2c5680u;
        y ^= (y << 15u) & 0xefc60000u;
        y ^= y >> 18u;
        index = (index + 1) % 624;
        return y;
    }
};

class Prng32OpenJDKSHA1PRNG32 {
    uchar state[20];
    uchar remainder[20];
    int rem_count;
    void update_state(thread const uchar output[20]) {
        int carry = 1;
        bool changed = false;
        for (int i = 0; i < 20; ++i) {
            const int v = int(state[i]) + int(output[i]) + carry;
            const uchar t = uchar(v);
            changed = changed || (state[i] != t);
            state[i] = t;
            carry = v >> 8;
        }
        if (!changed) {
            state[0] = uchar(state[0] + 1u);
        }
    }
    void next_bytes(thread uchar* result, int result_len) {
        int index = 0;
        int todo;
        thread uchar* output = remainder;
        uchar digest[20];
        int r = rem_count;
        if (r > 0) {
            todo = ((result_len - index) < (20 - r)) ? (result_len - index) : (20 - r);
            for (int i = 0; i < todo; ++i) {
                result[i] = output[r];
                output[r++] = 0u;
            }
            rem_count += todo;
            index += todo;
        }
        while (index < result_len) {
            prng32_provider_sha1_hash32(state, 20, digest);
            update_state(digest);
            output = digest;
            todo = ((result_len - index) > 20) ? 20 : (result_len - index);
            for (int i = 0; i < todo; ++i) {
                result[index++] = output[i];
                output[i] = 0u;
            }
            rem_count += todo;
        }
        memcpy(remainder, output, sizeof(remainder));
        rem_count %= 20;
    }
public:
    explicit Prng32OpenJDKSHA1PRNG32(uint seed) : rem_count(0) {
        uchar material[20];
        memset(state, 0, sizeof(state));
        memset(remainder, 0, sizeof(remainder));
        prng32_provider_fill_material(seed, 0x4f4a444b53484131ul, 0x50524e4753454544ul, material, int(sizeof(material)));
        prng32_provider_sha1_hash32(material, int(sizeof(material)), state);
    }
    uint next() {
        uchar out[4];
        next_bytes(out, int(sizeof(out)));
        return (uint(out[0]) << 24u) |
               (uint(out[1]) << 16u) |
               (uint(out[2]) << 8u) |
                uint(out[3]);
    }
};

class Prng32OpenBSDArc4randomRC4_32 {
    uchar S[256];
    uchar i;
    uchar j;
    uchar next_byte() {
        i = uchar(i + 1u);
        j = uchar(j + S[i]);
        const uchar t = S[i];
        S[i] = S[j];
        S[j] = t;
        return S[uchar(S[i] + S[j])];
    }
public:
    explicit Prng32OpenBSDArc4randomRC4_32(uint seed) : i(0), j(0) {
        uchar key[40];
        ulong sm = ulong(seed) ^ 0x4f50454e42534434ul;
        for (int n = 0; n < 40; n += 8) {
            const ulong v = prng32_splitmix64_next_provider32(sm);
            for (int b = 0; b < 8 && (n + b) < 40; ++b) {
                key[n + b] = uchar(v >> uint(b * 8));
            }
        }
        for (int n = 0; n < 256; ++n) S[n] = uchar(n);
        uchar k = 0u;
        for (int n = 0; n < 256; ++n) {
            k = uchar(k + S[n] + key[n % 40]);
            const uchar t = S[n];
            S[n] = S[k];
            S[k] = t;
        }
        for (int n = 0; n < 1024; ++n) (void)next_byte();
    }
    uint next() {
        uint v = uint(next_byte());
        v |= uint(next_byte()) << 8u;
        v |= uint(next_byte()) << 16u;
        v |= uint(next_byte()) << 24u;
        return v;
    }
};

