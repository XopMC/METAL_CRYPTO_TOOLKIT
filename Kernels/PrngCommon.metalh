        ss2 = uint((ulong(40692u) * ulong(ss2)) % 2147483399ul);
        return (ss1 > ss2) ? (ss1 - ss2) : (ss1 + 2147483563u - ss2);
    }
};

class Prng32Ranlux24 {
    uint x[24];
    int i, j;
public:
    explicit Prng32Ranlux24(uint seed) : i(23), j(9) {
        for (int k = 0; k < 24; ++k) {
            seed = seed * 1664525u + 1013904223u;
            x[k] = seed;
        }
    }
    uint step() {
        const uint out = x[j] - x[i] - 1u;
        x[i] = out;
        if (--i < 0) { i = 23; }
        if (--j < 0) { j = 23; }
        return out;
    }
    uint next() {
        for (int skip = 0; skip < 24; ++skip) {
            step();
        }
        return step();
    }
};

class Prng32Taus88Single {
    uint s1, s2, s3;
    uint taus(thread uint& z, int s, int k, uint m) {
        const uint b = ((z << uint(s)) ^ z) >> uint(k);
        z = ((z & m) << uint(s)) ^ b;
        return z;
    }
public:
    explicit Prng32Taus88Single(uint seed) {
        s1 = seed | 1u;
        s2 = seed ^ 0xa5a5a5a5u;
        s3 = seed * 3u + 1u;
    }
    uint next() {
        return taus(s1, 13, 19, 4294967294u) ^
            taus(s2, 2, 25, 4294967288u) ^
            taus(s3, 3, 11, 4294967280u);
    }
};

