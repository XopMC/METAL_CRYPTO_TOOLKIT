class Prng32JavaSecureRandomHmacDrbg32 {
    Prng32HmacDrbgSha256Provider32Core core;
public:
    explicit Prng32JavaSecureRandomHmacDrbg32(uint seed) {
        uchar material[48];
        const ulong entropy = prng32_mix_stafford13_provider32(ulong(seed) ^ 0x4a415641484d4143ul);
        const ulong nonce = prng32_mix_murmur64_provider32(ulong(seed) ^ 0x4452424753454544ul);
        for (int i = 0; i < 8; ++i) {
            material[i] = uchar(entropy >> uint(i * 8));
            material[8 + i] = uchar((entropy ^ 0x9e3779b97f4a7c15ul) >> uint(i * 8));
            material[16 + i] = uchar(nonce >> uint(i * 8));
            material[24 + i] = uchar((nonce ^ 0x6a09e667f3bcc909ul) >> uint(i * 8));
        }
        uchar p[16] = { 'O','p','e','n','J','D','K','-','H','m','a','c','D','R','B','G' };
        prng32_copy16(material + 32, p);
        core.init(material, int(sizeof(material)));
    }
    uint next() { return core.next(); }
};

