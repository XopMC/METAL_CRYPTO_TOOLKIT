    }
    ulong next() {
        const int j = (i + 24 - 10) % 24;
        ulong t;
        if (x[j] >= x[i] + borrow) {
            t = x[j] - x[i] - borrow;
            borrow = 0ul;
        } else {
            t = (0xfffffffffffffffful - x[i] - borrow) + x[j] + 1ul;
            borrow = 1ul;
        }
        x[i] = t;
        if (++i == 24) i = 0;
        return t;
    }
};

class Prng64JSF64 {
    ulong a;
    ulong b;
    ulong c;
    ulong d;
public:
    explicit Prng64JSF64(ulong seed) {
        ulong sm = seed;
        a = prng64_splitmix64_next(sm);
        b = prng64_splitmix64_next(sm);
        c = prng64_splitmix64_next(sm);
        d = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong e = a - prng64_rotl64(b, 7);
        a = b ^ prng64_rotl64(c, 13);
        b = c + prng64_rotl64(d, 37);
        c = d + e;
        d = e + a;
        return d;
    }
};

class Prng64PosixRand48Core64 {
    ulong x;
public:
    explicit Prng64PosixRand48Core64(ulong seed) : x(((seed << 16u) | 0x330eul) & ((1ul << 48u) - 1ul)) {}
    ulong step() {
        x = (x * 0x5deece66dul + 0xbul) & ((1ul << 48u) - 1ul);
        return x;
    }
    uint lrand31() { return uint(step() >> 17u); }
    uint mrand32() { return uint(step() >> 16u); }
};

class Prng64POSIX_lrand48_64Packed {
    Prng64PosixRand48Core64 core;
public:
    explicit Prng64POSIX_lrand48_64Packed(ulong seed) : core(seed) {}
