            a += mem[(i + 64) & 127];
            const uint y = mem[(x >> 2u) & 127u] + a + b;
            mem[i] = y;
            b = mem[(y >> 10u) & 127u] + x;
            rsl[i] = b;
        }
        idx = 0;
