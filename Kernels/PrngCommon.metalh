            next();
        }
    }
    uint next() {
        uint t = s[i];
        t ^= t >> 7u;
        uint v = t ^ (t << 24u);
        t = s[(i + 1) & 7]; v ^= t ^ (t >> 10u);
        t = s[(i + 3) & 7]; v ^= t ^ (t >> 3u);
        t = s[(i + 4) & 7]; v ^= t ^ (t << 7u);
        t = s[(i + 7) & 7]; t ^= t << 13u; v ^= t ^ (t << 9u);
        s[i] = v;
        i = (i + 1) & 7;
        return v;
    }
};

