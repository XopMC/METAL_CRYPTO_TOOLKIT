#pragma unroll 1
        for (int i = 0; i < number_of_bytes; i++) {
            uint randomNumber = gen.next();
            uchar B0 = (uchar)(randomNumber & 0xFF);
            uchar B1 = (uchar)((randomNumber >> 8) & 0xFF);
            uchar B2 = (uchar)((randomNumber >> 16) & 0xFF);
            uchar B3 = (uchar)((randomNumber >> 24) & 0xFF);

            switch (mode)
            {

    default:
                entropy[i] = (uchar)(randomNumber >> 24);
                break;

    case 0:
                entropy[i] = (uchar)(randomNumber >> 24);
                break;

    case 1:
                entropy[i] = (uchar)(randomNumber);
                break;

    case 2:
                entropy[i] = (uchar)(((B0 + B1 + B2 + B3) & 0xFF));
                break;

    case 3:
                entropy[i] = (uchar)((B0 ^ B1 ^ B2 ^ B3) & 0xFF);
                break;

    case 4:
                entropy[i] = (uchar)(B1);
                break;

    case 5:
                entropy[i] = (uchar)(B2);
                break;

    case 6:
                entropy[i] = (uchar)(((B0 + B1 + B2 + B3) / 4) & 0xFF);
                break;

    case 7:
                entropy[i] = (uchar)(((B3 & 0xF0) | ((B1) & 0x0F)) & 0xFF);
                break;

    case 8:
                entropy[i] = (uchar)(~B0);
                break;

    case 9:
                entropy[i] = (uchar)((B0 ^ B1) & 0xFF);
                break;


            }
        }

    }

}

template <typename Gen32>
static inline bool prng32_generate_entropy_and_check(uint seed,
                                                     int entropy_len,
                                                     thread uchar* entropy,
                                                     int mode,
                                                     ulong skip32) {
    if (entropy_len <= 0 || entropy_len > 512) {
        return false;
    }
    Gen32 gen(seed);
    prng32_generate_entropy_shared(gen, entropy_len, entropy, mode, skip32);
    return prng32_is_unique_len_aware(entropy, entropy_len);
}


// PRNG32 METAL cases 101..150.
static inline int prng32_metal_v8_to_int32_32(float x) {
    return int(uint(long(x)));
}

struct Prng32MetalProviderV8MathRandom32 {
    ulong state0;
    ulong state1;

    explicit Prng32MetalProviderV8MathRandom32(uint seed) {
        state0 = prng32_mix_murmur64_provider32(ulong(seed) ^ 0x56384d4154483332ul);
        state1 = prng32_mix_murmur64_provider32(state0);
        if ((state0 | state1) == 0ul) {
            state1 = 1ul;
        }
    }

    ulong next_u64() {
        ulong s1 = state0;
        ulong s0 = state1;
        state0 = s0;
        s1 ^= s1 << 23u;
        s1 ^= s1 >> 17u;
        s1 ^= s0;
        s1 ^= s0 >> 26u;
        state1 = s1;
        return s0 + s1;
    }

    float next_double() {
        return float(next_m53()) * (1.0 / 9007199254740992.0);
    }

    ulong next_m53() {
        return next_u64() >> 11u;
    }

    uint next_scaled(uint bound) {
        return prng_metal_double_m53_scaled_u32(next_m53(), bound);
    }

    bool next_gt_half() {
        return prng_metal_double_m53_gt_half(next_m53());
    }
};

static inline int prng32_metal_seedrandom_decimal_u32(uint seed, thread char out[11]) {
    char tmp[11];
    int len = 0;
    do {
        tmp[len++] = char('0' + (seed % 10u));
        seed /= 10u;
    } while (seed != 0u);
    for (int i = 0; i < len; ++i) {
        out[i] = tmp[len - 1 - i];
    }
    return len;
}

static inline int prng32_metal_seedrandom_mixkey32(thread const char* seed, int seed_len, thread uchar key[256]) {
    memset(key, 0, 256);
    uint smear = 0u;
    for (int j = 0; j < seed_len; ++j) {
        const int idx = j & 255;
        smear ^= uint(key[idx]) * 19u;
        key[idx] = uchar((smear + uchar(seed[j])) & 255u);
    }
    if (seed_len == 0) {
        key[0] = 0u;
        return 1;
    }
    return seed_len;
}

static inline uint prng32_metal_seedrandom_mash32(thread PrngSeedrandomMashDouble& n, thread const char* data, int len) {
    return prng_seedrandom_mash(n, data, len);
}

class Prng32RandomJsNativeMathV8_32 {
    Prng32MetalProviderV8MathRandom32 js;
public:
    explicit Prng32RandomJsNativeMathV8_32(uint seed)
        : js(seed ^ uint(0x524a534e41544831ul)) {}

    uint next() {
        return prng_metal_double_m53_to_u32(js.next_m53());
    }
};

class Prng32RandomJsMt19937AutoSeed32 {
    static constant int N = 624;
    static constant int M = 397;
    uint mt[N];
    int idx;

    void init_genrand(uint s) {
        mt[0] = s;
        for (int i = 1; i < N; ++i) {
            mt[i] = 1812433253u * (mt[i - 1] ^ (mt[i - 1] >> 30u)) + uint(i);
        }
        idx = N;
    }

    void init_by_array(thread const uint* key, int key_len) {
        init_genrand(0x012bd6aau);
        int i = 1;
        int j = 0;
        int k = (N > key_len) ? N : key_len;
        for (; k; --k) {
            mt[i] = (mt[i] ^ ((mt[i - 1] ^ (mt[i - 1] >> 30u)) * 0x0019660du)) + key[j] + uint(j);
            ++i;
            ++j;
            if (i >= N) {
                mt[0] = mt[N - 1];
                i = 1;
            }
            if (j >= key_len) {
                j = 0;
            }
        }
        for (k = N - 1; k; --k) {
            mt[i] = (mt[i] ^ ((mt[i - 1] ^ (mt[i - 1] >> 30u)) * 0x5d588b65u)) - uint(i);
            ++i;
            if (i >= N) {
                mt[0] = mt[N - 1];
                i = 1;
            }
        }
        mt[0] = 0x80000000u;
        idx = N;
    }

    void twist() {
        for (int i = 0; i < N; ++i) {
            uint y = (mt[i] & 0x80000000u) | (mt[(i + 1) % N] & 0x7fffffffu);
            mt[i] = mt[(i + M) % N] ^ (y >> 1u) ^ ((y & 1u) ? 0x9908b0dfu : 0u);
        }
        idx = 0;
    }
public:
    explicit Prng32RandomJsMt19937AutoSeed32(uint seed) : idx(N) {
        Prng32MetalProviderV8MathRandom32 js(seed ^ uint(0x524a534d54313939ul));
        uint key[16];
        key[0] = seed ^ 0x4352454154454555u;
        for (int i = 1; i < 16; ++i) {
            key[i] = prng_metal_double_m53_to_u32(js.next_m53());
        }
        init_by_array(key, 16);
    }

    uint next() {
        if (idx >= N) {
            twist();
        }
        uint y = mt[idx++];
        y ^= y >> 11u;
        y ^= (y << 7u) & 0x9d2c5680u;
        y ^= (y << 15u) & 0xefc60000u;
        y ^= y >> 18u;
        return y;
    }
};

class Prng32ChanceJsMersenneTwisterV8_32 {
    Prng32EntropyGenerator core;

    static uint derive_seed(uint seed) {
        Prng32MetalProviderV8MathRandom32 js(seed ^ uint(0x4348414e43454a53ul));
        return uint(prng_metal_double_m53_scaled_u64(js.next_m53(), 10000000000000ul));
    }
public:
    explicit Prng32ChanceJsMersenneTwisterV8_32(uint seed) : core(derive_seed(seed)) {}

    uint next() {
        return core.next();
    }
};

class Prng32SeedrandomArc4Quick32 {
    uchar S[256];
    uchar i;
    uchar j;

    uchar next_byte() {
        uchar t = S[i = uchar(i + 1u)];
        S[i] = S[j = uchar(j + t)];
        S[j] = t;
        return S[uchar(S[i] + S[j])];
    }

    uint g(int count) {
        uint r = 0u;
        while (count-- > 0) {
            r = (r << 8u) | uint(next_byte());
        }
        return r;
    }
public:
    explicit Prng32SeedrandomArc4Quick32(uint seed) : i(0), j(0) {
        char seed_str[12];
        int seed_len = prng32_metal_seedrandom_decimal_u32(seed, seed_str);
        seed_str[seed_len++] = '\0';
        uchar key[256];
        const int key_len = prng32_metal_seedrandom_mixkey32(seed_str, seed_len, key);
        for (int n = 0; n < 256; ++n) {
            S[n] = uchar(n);
        }
        uchar jj = 0u;
        for (int n = 0; n < 256; ++n) {
            const uchar t = S[n];
            jj = uchar(jj + t + key[n % key_len]);
            S[n] = S[jj];
            S[jj] = t;
        }
        (void)g(256);
    }

    uint next() {
        return g(4);
    }
};

class Prng32SeedrandomAlea32 {
    uint s0;
    uint s1;
    uint s2;
    uint c;
public:
    explicit Prng32SeedrandomAlea32(uint seed) : c(1u) {
        char seed_str[11];
        const int seed_len = prng32_metal_seedrandom_decimal_u32(seed, seed_str);
        PrngSeedrandomMashDouble mash_state = prng_seedrandom_mash_from_u64(4022871197ul);
        const char space = ' ';
        s0 = prng32_metal_seedrandom_mash32(mash_state, &space, 1);
        s1 = prng32_metal_seedrandom_mash32(mash_state, &space, 1);
        s2 = prng32_metal_seedrandom_mash32(mash_state, &space, 1);
        s0 -= prng32_metal_seedrandom_mash32(mash_state, seed_str, seed_len);
        s1 -= prng32_metal_seedrandom_mash32(mash_state, seed_str, seed_len);
        s2 -= prng32_metal_seedrandom_mash32(mash_state, seed_str, seed_len);
    }

    uint next() {
        const ulong t = 2091639ul * ulong(s0) + ulong(c);
        s0 = s1;
        s1 = s2;
        c = uint(t >> 32u);
        s2 = uint(t);
        return s2;
    }
};

class Prng32Tychei32Generator {
    uint a;
    uint b;
    uint c;
    uint d;
public:
    explicit Prng32Tychei32Generator(ulong seed) {
        a = uint(seed >> 32u);
        b = uint(seed);
        c = 0x9e3779b9u;
        d = 0x517cc1b7u;
        for (int k = 0; k < 20; ++k) {
            (void)next();
        }
    }

    uint next() {
        uint bb = (b << 25u) ^ (b >> 7u) ^ c;
        uint cc = c - d;
        uint dd = (d << 24u) ^ (d >> 8u) ^ a;
        uint aa = a - bb;
        bb = (bb << 20u) ^ (bb >> 12u) ^ cc;
        cc = cc - dd;
        dd = (dd << 16u) ^ (cc >> 16u) ^ aa;
        aa = aa - bb;
        a = aa;
        b = bb;
        c = cc;
        d = dd;
        return a;
    }
};

class Prng32SeedrandomTychei32 {
    Prng32Tychei32Generator core;
public:
    explicit Prng32SeedrandomTychei32(uint seed) : core(ulong(seed)) {}

    uint next() {
        return core.next();
    }
};

class Prng32SeedrandomXor12832 {
    uint x;
    uint y;
    uint z;
    uint w;
public:
    explicit Prng32SeedrandomXor12832(uint seed) : x(seed), y(0u), z(0u), w(0u) {
        for (int k = 0; k < 64; ++k) {
            (void)next();
        }
    }

    uint next() {
        const uint t = x ^ (x << 11u);
        x = y;
        y = z;
        z = w;
        w ^= (w >> 19u) ^ t ^ (t >> 8u);
        return w;
    }
};

class Prng32SeedrandomXor4096_32 {
    uint X[128];
    uint i;
    uint w;

    uint next_raw() {
        w += 0x61c88647u;
        uint v = X[(i + 34u) & 127u];
        uint t = X[i = (i + 1u) & 127u];
        v ^= v << 13u;
        t ^= t << 17u;
        v ^= v >> 15u;
        t ^= t >> 12u;
        v = X[i] = v ^ t;
        return v + (w ^ (w >> 16u));
    }
public:
    explicit Prng32SeedrandomXor4096_32(uint seed) : i(127u), w(0u) {
        memset(X, 0, sizeof(X));
        uint v = seed;
        uint zeroes = 0u;
        for (int jj = -32; jj < 128; ++jj) {
            if (jj == 0) {
                w = v;
            }
            v ^= v << 10u;
            v ^= v >> 15u;
            v ^= v << 4u;
            v ^= v >> 13u;
            if (jj >= 0) {
                w += 0x61c88647u;
                const int idx = jj & 127;
                X[idx] ^= uint(v + w);
                zeroes = (X[idx] == 0u) ? (zeroes + 1u) : 0u;
            }
        }
        if (zeroes >= 128u) {
            X[0] = 0xffffffffu;
        }
        i = 127u;
        for (int jj = 0; jj < 512; ++jj) {
            uint v0 = X[(i + 34u) & 127u];
            uint t0 = X[i = (i + 1u) & 127u];
            v0 ^= v0 << 13u;
            t0 ^= t0 << 17u;
            v0 ^= v0 >> 15u;
            t0 ^= t0 >> 12u;
            X[i] = v0 ^ t0;
        }
    }

    uint next() {
        return next_raw();
    }
};

class Prng32SeedrandomXorShift7_32 {
    uint x[8];
    uint i;
public:
    explicit Prng32SeedrandomXorShift7_32(uint seed) : i(0u) {
        memset(x, 0, sizeof(x));
        x[0] = seed;
        bool all_zero = true;
        for (int jj = 0; jj < 8; ++jj) {
            all_zero &= (x[jj] == 0u);
        }
        if (all_zero) {
            x[7] = 0xffffffffu;
        }
        for (int jj = 0; jj < 256; ++jj) {
            (void)next();
        }
    }

    uint next() {
        uint t = x[i];
        t ^= t >> 7u;
        uint v = t ^ (t << 24u);
        t = x[(i + 1u) & 7u];
        v ^= t ^ (t >> 10u);
        t = x[(i + 3u) & 7u];
        v ^= t ^ (t >> 3u);
        t = x[(i + 4u) & 7u];
        v ^= t ^ (t << 7u);
        t = x[(i + 7u) & 7u];
        t ^= t << 13u;
        v ^= t ^ (t << 9u);
        x[i] = v;
        i = (i + 1u) & 7u;
        return v;
    }
};

class Prng32SeedrandomXorwow32 {
    uint x;
    uint y;
    uint z;
    uint w;
    uint v;
    uint d;
public:
    explicit Prng32SeedrandomXorwow32(uint seed)
        : x(seed), y(0u), z(0u), w(0u), v(0u), d((seed << 10u) ^ (seed >> 4u)) {
        for (int k = 0; k < 64; ++k) {
            (void)next();
        }
    }

    uint next() {
        const uint t = x ^ (x >> 2u);
        x = y;
        y = z;
        z = w;
        w = v;
        d += 362437u;
        v = (v ^ (v << 4u)) ^ (t ^ (t << 1u));
        return d + v;
    }
};

class Prng32SplitMix32Generator {
    uint state;

    static uint splitmix32(thread uint& x) {
        uint z = (x += 0x9e3779b9u);
        z = (z ^ (z >> 15u)) * 0x85ebca6bu;
        z = (z ^ (z >> 13u)) * 0xc2b2ae35u;
        return z ^ (z >> 16u);
    }
public:
    explicit Prng32SplitMix32Generator(uint seed) : state(seed) {}

    uint next() {
        return splitmix32(state);
    }
};

class Prng32SFC32Generator {
    uint a;
    uint b;
    uint c;
    uint d;
public:
    explicit Prng32SFC32Generator(uint seed)
        : a(seed), b(seed ^ 0x9e3779b9u), c(seed ^ 0x3c6ef372u), d(seed ^ 0xdaa66d2bu) {}

    uint next() {
        uint res = a + b + d++;
        a = b ^ (b >> 9u);
        b = c + (c << 3u);
        c = ((c << 21u) | (c >> 11u)) + res;
        return res;
    }
};

class Prng32MSWSGenerator {
    ulong x;
    ulong w;
public:
    explicit Prng32MSWSGenerator(uint seed) : x(seed), w(seed) {}

    uint next() {
        x *= x;
        w += 0xb5ad4eceda1ce2a9ul;
        x += w;
        return uint(x >> 32u) ^ uint(x);
    }
};

class Prng32WyRand32 {
    uint state;
public:
    explicit Prng32WyRand32(uint seed) : state(seed) {}

    uint next() {
        state += 0xa0761d65u;
        uint v = state;
        v ^= v >> 16u;
        v *= 0xe7037ed1u;
        v ^= v >> 16u;
        v *= 0x8ebc6af1u;
        return v ^ (v >> 16u);
    }
};

class Prng32RomuTrio32 {
    uint x;
    uint y;
    uint z;
public:
    explicit Prng32RomuTrio32(uint seed) {
        x = seed;
        y = seed ^ 0x9e3779b9u;
        z = seed * 0x41c64e6du + 0x6073u;
    }

    uint next() {
        uint xp = x;
        x = 3323815723u * z;
        y = prng32_rotl(y - xp, 12);
        z = prng32_rotl(z - y, 25);
        return xp;
    }
};

class Prng32RomuDual32 {
    uint x;
    uint y;
public:
    explicit Prng32RomuDual32(uint seed) {
        x = seed;
        y = seed ^ 0x51da5bbu;
    }

    uint next() {
        uint xp = x;
        x = 3323815723u * y;
        y = prng32_rotl(y - xp, 15);
        return xp;
    }
};

class Prng32RomuOne32 {
    uint x;
public:
    explicit Prng32RomuOne32(uint seed) : x(seed ? seed : 1u) {}

    uint next() {
        uint xp = x;
        x *= 3323815723u;
        x = prng32_rotl(x, 28);
        return xp;
    }
};

class Prng32Xoroshiro128PlusGenerator {
    uint ss0;
    uint ss1;
public:
    explicit Prng32Xoroshiro128PlusGenerator(uint seed) {
        ss0 = seed;
        ss1 = seed ^ 0x9e3779b9u;
    }

    uint next() {
        uint res = ss0 + ss1;
        ss1 ^= ss0;
        ss0 = (ss0 << 24u) | (ss0 >> 8u);
        ss0 ^= ss1 ^ (ss1 << 16u);
        ss1 = (ss1 << 13u) | (ss1 >> 19u);
        return res;
    }
};

class Prng32Xoroshiro128PlusPlusGenerator {
    uint ss0;
    uint ss1;
public:
    explicit Prng32Xoroshiro128PlusPlusGenerator(uint seed) {
        ss0 = seed;
        ss1 = seed ^ 0xbf58476du;
    }

    uint next() {
        uint sum = ss0 + ss1;
        uint res = (sum << 7u) | (sum >> 25u);
        ss1 ^= ss0;
        ss0 = (ss0 << 24u) | (ss0 >> 8u);
        ss0 ^= ss1 ^ (ss1 << 16u);
        ss1 = (ss1 << 13u) | (ss1 >> 19u);
        return res;
    }
};

class Prng32Xoroshiro128StarStarGenerator {
    uint ss0;
    uint ss1;
public:
    explicit Prng32Xoroshiro128StarStarGenerator(uint seed) {
        ss0 = seed;
        ss1 = seed ^ 0x94d049bbu;
    }

    uint next() {
        ulong prod = ulong(ss0) * 0x9e3779bbul;
        uint res = uint((prod << 5u) | (prod >> 27u));
        ss1 ^= ss0;
        ss0 = (ss0 << 24u) | (ss0 >> 8u);
        ss0 ^= ss1 ^ (ss1 << 16u);
        ss1 = (ss1 << 13u) | (ss1 >> 19u);
        return res;
    }
};

class Prng32Xoshiro128PlusGenerator {
    uint s[4];
public:
    explicit Prng32Xoshiro128PlusGenerator(uint seed) {
        s[0] = seed;
        for (int i = 1; i < 4; ++i) {
            s[i] = s[i - 1] ^ (s[i - 1] >> 30u);
        }
    }

    uint next() {
        uint res = s[0] + s[3];
        uint t = s[1] << 9u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = (s[3] << 11u) | (s[3] >> 21u);
        return res;
    }
};

class Prng32Xoshiro128PlusPlusGenerator {
    uint s[4];
public:
    explicit Prng32Xoshiro128PlusPlusGenerator(uint seed) {
        s[0] = seed;
        for (int i = 1; i < 4; ++i) {
            s[i] = s[i - 1] ^ (s[i - 1] >> 30u);
        }
    }

    uint next() {
        uint sum = s[0] + s[3];
        uint res = (sum << 7u) | (sum >> 25u);
        uint t = s[1] << 9u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = (s[3] << 11u) | (s[3] >> 21u);
        return res;
    }
};

class Prng32Xoshiro128StarStarGenerator {
    uint s[4];
public:
    explicit Prng32Xoshiro128StarStarGenerator(uint seed) {
        s[0] = seed;
        for (int i = 1; i < 4; ++i) {
            s[i] = s[i - 1] ^ (s[i - 1] >> 30u);
        }
    }

    uint next() {
        uint res = ((s[1] * 5u) << 7u) | ((s[1] * 5u) >> 25u);
        uint t = s[1] << 9u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = (s[3] << 11u) | (s[3] >> 21u);
        return res;
    }
};

static inline uint prng32_pcg_rotr(uint v, uint r) {
    const uint shift = r & 31u;
    return (v >> shift) | (v << ((0u - shift) & 31u));
}

class Prng32PCG32_XSH_RR {
    ulong state;
    ulong inc;
public:
    explicit Prng32PCG32_XSH_RR(uint seed) {
        state = 0ul;
        inc = (ulong(seed) << 1u) | 1ul;
        (void)next();
        state += 0x853c49e6748fea9bul;
        (void)next();
    }

    uint next() {
        ulong old = state;
        state = old * 6364136223846793005ul + inc;
        uint xorshifted = uint(((old >> 18u) ^ old) >> 27u);
        uint rot = uint(old >> 59u);
        return prng32_pcg_rotr(xorshifted, rot);
    }
};

class Prng32PCG32Generator {
    ulong state;
    ulong inc;

    static ulong make_seed(uint seed) {
        return (ulong(seed) << 1u) | 1ul;
    }
public:
    explicit Prng32PCG32Generator(uint seed) {
        state = 0ul;
        inc = (ulong(seed) << 1u) | 1ul;
        (void)next();
        state += make_seed(seed);
        (void)next();
    }

    uint next() {
        ulong oldstate = state;
        state = oldstate * 6364136223846793005ul + inc;
        uint xorshifted = uint(((oldstate >> 18u) ^ oldstate) >> 27u);
        uint rot = uint(oldstate >> 59u);
        return prng32_pcg_rotr(xorshifted, rot);
    }
};

class Prng32PCGRXSMXSGenerator {
