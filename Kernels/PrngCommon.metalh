        a = b;
        b = c;
        c = t;
        return uint(c);
    }
};

class Prng32LFSR113 {
    uint z1, z2, z3, z4;
    uint step_value(uint z, int s, int k, uint m) {
        const uint b = (((z << uint(s)) ^ z) >> uint(k));
        return ((z & m) << uint(s)) ^ b;
    }
public:
    explicit Prng32LFSR113(uint seed) {
        z1 = seed | 1u;
        z2 = (seed ^ 0x12345678u) | 2u;
        z3 = (seed + 1u) | 4u;
        z4 = (seed ^ 0xf1ea5eedu) | 8u;
    }
    uint next() {
        z1 = step_value(z1, 6, 13, 4294967294u);
        z2 = step_value(z2, 2, 27, 4294967288u);
        z3 = step_value(z3, 13, 21, 4294967280u);
        z4 = step_value(z4, 3, 12, 4294967168u);
        return z1 ^ z2 ^ z3 ^ z4;
    }
};

class Prng32LFSR258 {
    uint s1, s2, s3, s4, s5;
public:
    explicit Prng32LFSR258(uint seed) {
        s1 = seed | 1u;
        s2 = (seed ^ 0xa5a5a5a5u) | 2u;
        s3 = (seed + 1u) | 4u;
        s4 = (seed ^ 0x5e5e5e5eu) | 8u;
        s5 = (seed * 3u + 1u) | 16u;
    }
    uint next() {
        uint b;
        b = ((s1 << 1u) ^ s1) >> 30u; s1 = ((s1 & 0xfffffffeu) << 18u) ^ b;
        b = ((s2 << 24u) ^ s2) >> 30u; s2 = ((s2 & 0xfffffff8u) << 2u) ^ b;
        b = ((s3 << 3u) ^ s3) >> 27u; s3 = ((s3 & 0xfffffff0u) << 7u) ^ b;
        b = ((s4 << 5u) ^ s4) >> 29u; s4 = ((s4 & 0xffffff80u) << 13u) ^ b;
        b = ((s5 << 4u) ^ s5) >> 26u; s5 = ((s5 & 0xfffffe00u) << 3u) ^ b;
        return s1 ^ s2 ^ s3 ^ s4 ^ s5;
    }
};

class Prng32AWC32 {
    uint x[24];
    uint carry;
    int idx;
public:
    explicit Prng32AWC32(uint seed) : carry(0u), idx(0) {
        for (int i = 0; i < 24; ++i) {
            seed = seed * 1664525u + 1013904223u;
            x[i] = seed;
        }
    }
    uint next() {
        const ulong sum = ulong(x[idx]) + ulong(x[(idx + 14) % 24]) + ulong(carry);
        x[idx] = uint(sum);
        carry = uint(sum >> 32u);
        if (++idx == 24) {
            idx = 0;
        }
        return x[idx];
    }
};

class Prng32CMWC4096 {
