static inline uint prng32_mul32_hi(uint a, uint b) {
    return uint((ulong(a) * ulong(b)) >> 32u);
}

static inline ulong prng32_rotl64(ulong x, int r) {
    return (x << uint(r)) | (x >> uint(64 - r));
}

class Prng32Xoshiro256PlusPlusGen32 {
    ulong s[4];
public:
    explicit Prng32Xoshiro256PlusPlusGen32(uint seed) {
        s[0] = (ulong(seed) << 32u) | ulong(seed);
        s[1] = s[0] ^ 0x9e3779b97f4a7c15ul;
        s[2] = s[0] + 0x6a09e667f3bcc909ul;
        s[3] = s[1] + 0xbb67ae8584caa73bul;
    }
    uint next() {
        ulong res = s[0] + s[3];
        res = (res << 23u) | (res >> (64u - 23u));
        res += s[0];
        const ulong t = s[1] << 17u;
        s[2] ^= s[0]; s[3] ^= s[1]; s[1] ^= s[2]; s[0] ^= s[3];
        s[2] ^= t;
        s[3] = (s[3] << 45u) | (s[3] >> (64u - 45u));
        return uint(res);
    }
};

class Prng32SFC64_32Generator {
    ulong a, b, c, d;
public:
    explicit Prng32SFC64_32Generator(uint seed)
        : a(seed), b(ulong(seed) ^ 0x9e3779b97f4a7c15ul), c(ulong(seed) ^ 0xbf58476d1ce4e5b9ul), d(ulong(seed) ^ 0x94d049bb133111ebul) {}
    uint next() {
        const ulong res = a + b + c + d++;
        a = b ^ (b >> 11u);
        b = c + (c << 3u);
        c = ((c << 24u) | (c >> 40u)) + uint(res);
        return uint(res);
    }
};

class Prng32MRG32k3aGenerator {
    ulong x1[3], x2[3];
public:
    explicit Prng32MRG32k3aGenerator(uint seed) {
        for (int i = 0; i < 3; ++i) {
            x1[i] = ulong(seed + uint(i) + 1u);
            x2[i] = ulong(seed + uint(i) + 2u);
        }
    }
    uint next() {
        const ulong p1 = (1403580ul * x1[1] + 810728ul * x1[0]) % 4294967087ul;
        const ulong p2 = (527612ul * x2[2] + 1370589ul * x2[0]) % 4294944443ul;
        x1[0] = x1[1]; x1[1] = x1[2]; x1[2] = p1;
        x2[0] = x2[1]; x2[1] = x2[2]; x2[2] = p2;
        return uint((p1 > p2 ? p1 - p2 : p1 + 4294967087ul - p2) & 0xfffffffful);
    }
};

class Prng32MWC1616 {
    uint x, y;
public:
    explicit Prng32MWC1616(uint seed) {
        x = seed & 0xffffu;
        y = seed >> 16u;
    }
    uint next() {
        x = 18000u * (x & 0xffffu) + (x >> 16u);
        y = 36969u * (y & 0xffffu) + (y >> 16u);
        return (y << 16u) + x;
    }
};

class Prng32Philox4x32_10 {
    ulong ctr;
    uint key;
public:
    explicit Prng32Philox4x32_10(uint seed) : ctr(0ul), key(seed) {}
    uint next() {
        uint v0 = uint(ctr);
        uint v1 = uint(ctr >> 32u);
        uint v2 = key;
        uint v3 = key ^ 0x9e3779b9u;
        for (int r = 0; r < 10; ++r) {
            const uint hi0 = prng32_mul32_hi(v0, 0xd2511f53u);
            const uint lo0 = v0 * 0xd2511f53u;
            const uint hi1 = prng32_mul32_hi(v2, 0xcd9e8d57u);
            const uint lo1 = v2 * 0xcd9e8d57u;
            v3 ^= hi0;
            v1 ^= hi1;
            v0 = lo0;
            v2 = lo1;
        }
        ctr++;
        return v0;
    }
};

class Prng32WichmannHill32 {
    uint s1, s2, s3;
public:
    explicit Prng32WichmannHill32(uint seed) {
        s1 = (seed % 30000u) + 1u;
        s2 = ((seed >> 10u) % 30000u) + 1u;
        s3 = ((seed >> 20u) % 30000u) + 1u;
    }
    uint next() {
        s1 = (171u * s1) % 30269u;
        s2 = (172u * s2) % 30307u;
        s3 = (170u * s3) % 30323u;
        return uint((ulong(s1) * 141650963ul + ulong(s2) * 141561103ul + ulong(s3) * 141475377ul) >> 16u);
    }
};

class Prng32SuperDuper32 {
    uint cong, shr3;
public:
    explicit Prng32SuperDuper32(uint seed) : cong(seed ^ 0xa5366b4du), shr3(seed ? seed : 1u) {}
    uint next() {
        cong = 69069u * cong + 1234567u;
        shr3 ^= (shr3 << 13u);
        shr3 ^= (shr3 >> 17u);
        shr3 ^= (shr3 << 5u);
        return cong + shr3;
    }
};

class Prng32RngMinstdRand {
    uint seed_;
    static uint normalize_seed(uint s) {
        if (s == 0u) s = 1u;
        s %= 2147483647u;
        if (s == 0u) s = 1u;
        return s;
    }
public:
    explicit Prng32RngMinstdRand(uint seed = 1u) : seed_(normalize_seed(seed)) {}
    uint next() {
        const uint hi = seed_ / 44488u;
        const uint lo = seed_ % 44488u;
        int t = int(ulong(48271u) * ulong(lo) - ulong(3399u) * ulong(hi));
        if (t <= 0) t += 2147483647;
        seed_ = uint(t);
        return seed_;
    }
};

class Prng32PosixRand48Core32 {
    ulong x;
public:
    explicit Prng32PosixRand48Core32(uint seed)
        : x((ulong(seed) << 16u) | 0x330eul) {}
    ulong step() {
        x = (x * 0x5deece66dul + 0xbul) & ((1ul << 48u) - 1ul);
        return x;
    }
};

