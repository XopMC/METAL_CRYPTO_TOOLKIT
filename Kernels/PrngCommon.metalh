public:
    explicit Prng32JenkinsLookup3Counter32Generator(uint seed) : state(seed), salt(seed ^ 0x9e3779b9u) {}
    uint next() {
        uint a = 0xdeadbeefu + 4u + salt;
        uint b = a;
        uint c = a + state++;
        c ^= b; c -= prng32_rotl32(b, 14u);
        a ^= c; a -= prng32_rotl32(c, 11u);
        b ^= a; b -= prng32_rotl32(a, 25u);
        c ^= b; c -= prng32_rotl32(b, 16u);
        a ^= c; a -= prng32_rotl32(c, 4u);
        b ^= a; b -= prng32_rotl32(a, 14u);
        c ^= b; c -= prng32_rotl32(b, 24u);
        return c;
    }
};

