        state = state * 6364136223846793005ul + 0x632be5abul;
        ulong x = state;
        const ulong rot = x >> 59u;
        x ^= x >> 18u;
        return prng64_rotr64_compat(x >> 27u, rot);
    }
};

class Prng64Xoshiro256Plus {
