class Prng32SWB4096 {
    uint x[4096];
    uint borrow;
    int idx;
public:
    explicit Prng32SWB4096(uint seed) : borrow(0u), idx(0) {
        for (int i = 0; i < 4096; ++i) {
            seed = seed * 1664525u + 1013904223u;
            x[i] = seed;
        }
    }
    uint next() {
        const int j = (idx + 4086) % 4096;
        const ulong diff = ulong(x[j]) - ulong(x[idx]) - ulong(borrow);
        borrow = uint((diff >> 63u) & 1ul);
        const uint t = uint(diff);
        x[idx] = t;
        if (++idx == 4096) {
            idx = 0;
        }
        return t;
    }
};

class Prng32MRG32k5a {
    uint s[5];
public:
    explicit Prng32MRG32k5a(uint seed) {
        for (int i = 0; i < 5; ++i) {
            seed = seed * 1812433253u + uint(i);
            s[i] = seed % 4294967087u;
        }
    }
    uint next() {
        const ulong t = 107374182ul * ulong(s[0]) + 104480ul * ulong(s[4]);
        const uint r = uint(t % 4294944443ul);
        for (int i = 4; i > 0; --i) {
            s[i] = s[i - 1];
        }
        s[0] = r;
        return r;
    }
};

