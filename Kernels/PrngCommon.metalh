};

class Prng32Threefry2x32_J {
    uint ctr;
    uint key0, key1, key2;
public:
    explicit Prng32Threefry2x32_J(uint seed) {
        ctr = seed;
        key0 = seed ^ 0xdeadbeefu;
        key1 = 0x1bd11bdau;
        key2 = key0 ^ key1 ^ 0x1bd11bdau;
    }
    uint next() {
        uint x0 = ctr++;
        uint x1 = ~x0;
        x0 += key0;
        x1 += key1;
        for (int r = 0; r < 20; r += 4) {
            x0 += x1; x1 = prng32_rotl32(x1, 13u) ^ x0;
            x0 += x1; x1 = prng32_rotl32(x1, 15u) ^ x0;
        }
        return x0;
    }
};

