class Prng64DRand48_Glibc_48 {
    ulong state;
public:
    explicit Prng64DRand48_Glibc_48(ulong seed32) {
        const ulong s = seed32 & 0xfffffffful;
        state = ((s << 16u) | 0x330eul) & ((1ul << 48u) - 1ul);
    }
    ulong next() {
        state = (state * 0x5deece66dul + 0xbul) & ((1ul << 48u) - 1ul);
        return state;
    }
};

class Prng64SipHash24RNG64 {
    ulong k0;
    ulong k1;
    ulong counter;
public:
    explicit Prng64SipHash24RNG64(ulong seed) : counter(0ul) {
        if (seed == 0ul) seed = 0x0706050403020100ul;
        ulong sm = seed;
        k0 = prng64_splitmix64_next(sm);
        k1 = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong m = counter++;
        ulong v0 = 0x736f6d6570736575ul ^ k0;
        ulong v1 = 0x646f72616e646f6dul ^ k1;
        ulong v2 = 0x6c7967656e657261ul ^ k0;
        ulong v3 = 0x7465646279746573ul ^ k1;
        const ulong b = m ^ (8ul << 56u);
        v3 ^= b;
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        v0 ^= b;
        v2 ^= 0xfful;
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        prng64_cases151_siphash_round(v0, v1, v2, v3);
        return (v0 ^ v1) ^ (v2 ^ v3);
    }
};

class Prng64SQLite_PRNG64 {
    uchar sbox[256];
    uchar i_idx;
    uchar j_idx;
    uchar nextByte() {
        i_idx = uchar(i_idx + uchar(1));
        j_idx = uchar(j_idx + sbox[int(i_idx)]);
        const uchar t = sbox[int(i_idx)];
        sbox[int(i_idx)] = sbox[int(j_idx)];
        sbox[int(j_idx)] = t;
        return sbox[int(uchar(sbox[int(i_idx)] + sbox[int(j_idx)]))];
    }
public:
    explicit Prng64SQLite_PRNG64(ulong seed) : i_idx(0), j_idx(0) {
        for (int n = 0; n < 256; ++n) sbox[n] = uchar(n);
        uchar j = 0;
        for (int n = 0; n < 256; ++n) {
            const uchar key_byte = uchar((seed >> uint((n & 7) * 8)) & 0xfful);
            j = uchar(j + sbox[n] + key_byte);
            const uchar t = sbox[n];
            sbox[n] = sbox[int(j)];
            sbox[int(j)] = t;
        }
        for (int n = 0; n < 256; ++n) (void)nextByte();
    }
    ulong next() {
        ulong r = 0ul;
        for (int k = 0; k < 8; ++k) {
            r |= ulong(nextByte()) << uint(8 * k);
        }
        return r;
    }
};

class Prng64Ranecu64 {
    ulong s1;
    ulong s2;
public:
    explicit Prng64Ranecu64(ulong seed) {
        s1 = seed % 2147483563ul;
        s2 = (seed ^ 0x5deece66dul) % 2147483399ul;
        if (s1 == 0ul) s1 = 1ul;
        if (s2 == 0ul) s2 = 1ul;
    }
    ulong next() {
        s1 = (40014ul * s1) % 2147483563ul;
        s2 = (40692ul * s2) % 2147483399ul;
        return (s1 > s2) ? (s1 - s2) : (s1 - s2 + 2147483563ul);
    }
};

class Prng64LFIB4_64 {
    ulong x[256];
    int i;
public:
    explicit Prng64LFIB4_64(ulong seed) : i(0) {
        ulong sm = seed;
        for (int k = 0; k < 256; ++k) x[k] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong t = x[i] = x[i] + x[(i + 58) % 256] + x[(i + 119) % 256] + x[(i + 178) % 256];
        if (++i == 256) i = 0;
        return t;
    }
};

class Prng64LaggedFibonacciAdd64 {
    ulong x[55];
    int i;
public:
    explicit Prng64LaggedFibonacciAdd64(ulong seed) : i(0) {
        ulong sm = seed;
        for (int k = 0; k < 55; ++k) x[k] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const int j = (i + 55 - 24) % 55;
        const ulong t = x[i] + x[j];
        x[i] = t;
        if (++i == 55) i = 0;
        return t;
    }
};

class Prng64Squares64 {
    ulong ctr;
    ulong key;
public:
    explicit Prng64Squares64(ulong seed) : ctr(0ul), key(seed | 1ul) {}
    ulong next() {
        ulong x;
        ulong y;
        ulong z;
        y = x = ctr * key;
        z = y + key;
        x = x * x + y; x = (x >> 32u) | (x << 32u);
        x = x * x + z; x = (x >> 32u) | (x << 32u);
        x = x * x + y; x = (x >> 32u) | (x << 32u);
        ++ctr;
        return (x * x + z) >> 32u;
    }
};

