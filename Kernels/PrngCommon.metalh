class Prng32TinyMT32 {
    uint status[4];
public:
    explicit Prng32TinyMT32(uint seed) {
        status[0] = seed;
        status[1] = 0x8f7011eeu;
        status[2] = 0xfc78ff1fu;
        status[3] = 0x3793fdffu;
        for (int i = 1; i < 8; ++i) {
            const uint x = 1812433253u * (status[i & 3] ^ (status[i & 3] >> 30u)) + uint(i);
            status[i & 3] ^= x;
        }
        for (int i = 0; i < 8; ++i) {
            next();
        }
    }
    void next_state() {
        uint x = (status[0] & 0x7fffffffu) ^ status[1] ^ status[2];
        x ^= x << 1u;
        x ^= x >> 1u;
        x ^= status[3] >> 1u;
        status[0] = status[1];
        status[1] = status[2];
        status[2] = x;
        status[3] = (status[3] & 1u) ? (status[0] ^ 0x8f7011eeu) : status[0];
    }
    uint next() {
        next_state();
        uint y = status[3] + status[2];
        y ^= y >> 8u;
        return y;
    }
};

class Prng32ISAAC32 {
    uint mem[256];
    uint rsl[256];
    uint a, b, c;
    int idx;
    void mix(thread uint& aa, thread uint& bb, thread uint& cc, thread uint& dd, thread uint& ee, thread uint& ff, thread uint& gg, thread uint& hh) {
        aa ^= bb << 11u; dd += aa; bb += cc;
        bb ^= cc >> 2u;  ee += bb; cc += dd;
        cc ^= dd << 8u;  ff += cc; dd += ee;
        dd ^= ee >> 16u; gg += dd; ee += ff;
        ee ^= ff << 10u; hh += ee; ff += gg;
        ff ^= gg >> 4u;  aa += ff; gg += hh;
        gg ^= hh << 8u;  bb += gg; hh += aa;
        hh ^= aa >> 9u;  cc += hh; aa += bb;
    }
    void isaac() {
        c++;
        b += c;
        for (int i = 0; i < 256; ++i) {
            const uint x = mem[i];
            uint y;
            switch (i & 3) {
                case 0: a ^= a << 13u; break;
                case 1: a ^= a >> 6u; break;
                case 2: a ^= a << 2u; break;
                default: a ^= a >> 16u; break;
            }
            a += mem[(i + 128) & 255];
            y = mem[(x >> 2u) & 255u] + a + b;
            mem[i] = y;
            b = mem[(y >> 10u) & 255u] + x;
            rsl[i] = b;
        }
        idx = 0;
    }
public:
    explicit Prng32ISAAC32(uint seed) {
        for (int i = 0; i < 256; ++i) {
            mem[i] = seed ^ uint(i);
            rsl[i] = seed ^ uint(i);
        }
        a = b = c = 0x9e3779b9u;
        for (int i = 0; i < 4; ++i) {
            uint d = a, e = b, f = c, g = d, h = e;
            mix(a, b, c, d, e, f, g, h);
        }
        isaac();
        idx = 256;
    }
    uint next() {
        if (idx >= 256) {
            isaac();
        }
        return rsl[idx++];
    }
};

class Prng32ISAAC_Lite32 {
    uint mem[128];
