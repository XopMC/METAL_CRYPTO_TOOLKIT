        uchar material[48];
        prng32_provider_fill_material(seed, 0x424f554e43594354ul, 0x5250383030393041ul, material, 32);
        const char kPersonalization[16] = "BouncyCtrDRBG";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material), 0x42u);
    }
     uint next() {
        return core.next();
    }
};

// Bouncy Castle C# SecureRandom() defaults to SHA-256 DigestRandomGenerator with auto-seed.
class Prng32BouncyDigestRandomSha256_32 {
    uchar state[32];
    uchar seed_bytes[32];
    uchar block[32];
    ulong state_counter;
    ulong seed_counter;
    int block_index;
     void digest_counter_le_then_buffers(ulong counter, thread const uchar* a, int a_len, thread const uchar* b, int b_len, thread uchar out[32]) {
        uchar msg[128];
        int off = 0;
        for (int i = 0; i < 8; ++i) {
            msg[off++] = (uchar)(counter >> (i * 8));
        }
        if (a_len > 0) {
            memcpy(msg + off, a, (size_t)a_len);
            off += a_len;
        }
        if (b_len > 0) {
            memcpy(msg + off, b, (size_t)b_len);
            off += b_len;
        }
        SHA256(msg, (size_t)off, out);
    }
     void digest_buffers_then_counter(thread const uchar* a, int a_len, ulong counter, thread uchar out[32]) {
        uchar msg[128];
        int off = 0;
        if (a_len > 0) {
            memcpy(msg + off, a, (size_t)a_len);
            off += a_len;
        }
        for (int i = 0; i < 8; ++i) {
            msg[off++] = (uchar)(counter >> (i * 8));
        }
        SHA256(msg, (size_t)off, out);
    }
     void add_seed_material_bytes(thread const uchar* material, int material_len) {
        uchar msg[128];
        memcpy(msg, material, (size_t)material_len);
        memcpy(msg + material_len, seed_bytes, sizeof(seed_bytes));
        SHA256(msg, (size_t)(material_len + (int)sizeof(seed_bytes)), seed_bytes);
    }
     void add_seed_material_u64(ulong value) {
        digest_counter_le_then_buffers(value, seed_bytes, (int)sizeof(seed_bytes), nullptr, 0, seed_bytes);
    }
     void cycle_seed() {
        digest_buffers_then_counter(seed_bytes, (int)sizeof(seed_bytes), seed_counter++, seed_bytes);
    }
     void refill() {
        digest_counter_le_then_buffers(state_counter++, state, (int)sizeof(state), seed_bytes, (int)sizeof(seed_bytes), state);
        if ((state_counter % 10ul) == 0ul) {
            cycle_seed();
        }
        memcpy(block, state, sizeof(block));
        block_index = 0;
    }
public:
     explicit Prng32BouncyDigestRandomSha256_32(uint seed) : state_counter(1ul), seed_counter(1ul), block_index((int)sizeof(block)) {
        memset(state, 0, sizeof(state));
        memset(seed_bytes, 0, sizeof(seed_bytes));
        memset(block, 0, sizeof(block));
        add_seed_material_u64(((ulong)seed) ^ 0x42435352414e4432ul);
        uchar material[64];
        prng32_provider_fill_material(seed, 0x424f554e43594449ul, 0x4745535453484132ul, material, (int)sizeof(material));
        add_seed_material_bytes(material, (int)sizeof(material));
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            ((uint)block[block_index] << 24) |
            ((uint)block[block_index + 1] << 16) |
            ((uint)block[block_index + 2] << 8) |
            ((uint)block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

// Bouncy Castle C# ArbitraryRandom uses SecureRandom(new VmpcRandomGenerator(), 16).
class Prng32BouncyVmpcRandom32 {
    uchar P[256];
    uchar s;
    uchar n;
    uchar block[32];
    int block_index;
     void init_state() {
        const uchar kInitP[256] = {
            0xbb,0x2c,0x62,0x7f,0xb5,0xaa,0xd4,0x0d,0x81,0xfe,0xb2,0x82,0xcb,0xa0,0xa1,0x08,
            0x18,0x71,0x56,0xe8,0x49,0x02,0x10,0xc4,0xde,0x35,0xa5,0xec,0x80,0x12,0xb8,0x69,
            0xda,0x2f,0x75,0xcc,0xa2,0x09,0x36,0x03,0x61,0x2d,0xfd,0xe0,0xdd,0x05,0x43,0x90,
            0xad,0xc8,0xe1,0xaf,0x57,0x9b,0x4c,0xd8,0x51,0xae,0x50,0x85,0x3c,0x0a,0xe4,0xf3,
            0x9c,0x26,0x23,0x53,0xc9,0x83,0x97,0x46,0xb1,0x99,0x64,0x31,0x77,0xd5,0x1d,0xd6,
            0x78,0xbd,0x5e,0xb0,0x8a,0x22,0x38,0xf8,0x68,0x2b,0x2a,0xc5,0xd3,0xf7,0xbc,0x6f,
            0xdf,0x04,0xe5,0x95,0x3e,0x25,0x86,0xa6,0x0b,0x8f,0xf1,0x24,0x0e,0xd7,0x40,0xb3,
            0xcf,0x7e,0x06,0x15,0x9a,0x4d,0x1c,0xa3,0xdb,0x32,0x92,0x58,0x11,0x27,0xf4,0x59,
            0xd0,0x4e,0x6a,0x17,0x5b,0xac,0xff,0x07,0xc0,0x65,0x79,0xfc,0xc7,0xcd,0x76,0x42,
            0x5d,0xe7,0x3a,0x34,0x7a,0x30,0x28,0x0f,0x73,0x01,0xf9,0xd1,0xd2,0x19,0xe9,0x91,
            0xb9,0x5a,0xed,0x41,0x6d,0xb4,0xc3,0x9e,0xbf,0x63,0xfa,0x1f,0x33,0x60,0x47,0x89,
            0xf0,0x96,0x1a,0x5f,0x93,0x3d,0x37,0x4b,0xd9,0xa8,0xc1,0x1b,0xf6,0x39,0x8b,0xb7,
            0x0c,0x20,0xce,0x88,0x6e,0xb6,0x74,0x8e,0x8d,0x16,0x29,0xf2,0x87,0xf5,0xeb,0x70,
            0xe3,0xfb,0x55,0x9f,0xc6,0x44,0x4a,0x45,0x7d,0xe2,0x6b,0x5c,0x6c,0x66,0xa9,0x8c,
            0xee,0x84,0x13,0xa7,0x1e,0x9d,0xdc,0x67,0x48,0xba,0x2e,0xe6,0xa4,0xab,0x7c,0x94,
            0x00,0x21,0xef,0xea,0xbe,0xca,0x72,0x4f,0x52,0x98,0x3f,0xc2,0x14,0x7b,0x3b,0x54
        };
        memcpy(P, kInitP, sizeof(P));
        s = 0xbeu;
        n = 0u;
        memset(block, 0, sizeof(block));
        block_index = (int)sizeof(block);
    }
     void add_seed_material_bytes(thread const uchar* material, int material_len) {
        for (int m = 0; m < material_len; ++m) {
            s = P[(uchar)(s + P[n] + material[m])];
            const uchar temp = P[n];
            P[n] = P[s];
            P[s] = temp;
            n = (uchar)(n + 1u);
        }
    }
     void add_seed_material_u64(ulong value) {
        uchar material[8];
        for (int i = 0; i < 8; ++i) {
            material[7 - i] = (uchar)(value >> (i * 8));
        }
        add_seed_material_bytes(material, (int)sizeof(material));
    }
     void refill() {
        for (int i = 0; i < (int)sizeof(block); ++i) {
            s = P[(uchar)(s + P[n])];
            block[i] = P[(uchar)(P[(uchar)P[s]] + 1u)];
            const uchar temp = P[n];
            P[n] = P[s];
            P[s] = temp;
            n = (uchar)(n + 1u);
        }
        block_index = 0;
    }
public:
     explicit Prng32BouncyVmpcRandom32(uint seed) {
        init_state();
        add_seed_material_u64(((ulong)seed) ^ 0x4243564d5043524eul);
        uchar material[16];
        prng32_provider_fill_material(seed, 0x424f554e4359564dul, 0x504352414e444f4dul, material, (int)sizeof(material));
        add_seed_material_bytes(material, (int)sizeof(material));
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            ((uint)block[block_index] << 24) |
            ((uint)block[block_index + 1] << 16) |
            ((uint)block[block_index + 2] << 8) |
            ((uint)block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

// mbedtls_hmac_drbg.c implements HMAC_DRBG over SHA-256.
class Prng32MbedTlsHmacDrbg32 {
    Prng32HmacDrbgSha256Provider32Core core;
public:
     explicit Prng32MbedTlsHmacDrbg32(uint seed) {
        uchar material[48];
        prng32_provider_fill_material(seed, 0x4d424544484d4143ul, 0x4452424753484132ul, material, 32);
        const char kPersonalization[16] = "mbedTLSHMACDRBG";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material));
    }
     uint next() {
        return core.next();
    }
};

// Botan HMAC_DRBG uses HMAC(SHA-256) with provider-specific state management.
class Prng32BotanHmacRng32 {
    uchar prf_key[64];
    uchar extractor_key[32];
    uchar K[32];
    int block_index;
    uint counter;
    ulong clock_now;
    ulong clock_step;
    uint output_since_reseed;
     void hmac_prf(thread const uchar* label, int label_len) {
        uchar msg[64];
        memcpy(msg, K, sizeof(K));
        memcpy(msg + 32, label, size_t(label_len));
        const size_t off = 32 + (size_t)label_len;
        msg[off + 0] = (uchar)(counter >> 24);
        msg[off + 1] = (uchar)(counter >> 16);
        msg[off + 2] = (uchar)(counter >> 8);
        msg[off + 3] = (uchar)counter;
        prng32_provider_sha512_store_u64_be32(msg + off + 4, clock_now);
        hmac_sha256(prf_key, sizeof(prf_key), msg, off + 12, K);
        ++counter;
        clock_now += clock_step;
    }
     void reseed(thread const uchar* extra, int extra_len) {
        uchar accum[160];
        int acc_len = 0;
        if (extra != nullptr && extra_len > 0) {
            memcpy(accum, extra, (size_t)extra_len);
            acc_len += extra_len;
        }
        thread uchar label_rng[3] = { uchar('r'), uchar('n'), uchar('g') };
        hmac_prf(label_rng, 3);
        memcpy(accum + acc_len, K, sizeof(K));
        acc_len += (int)sizeof(K);
        thread uchar label_reseed[6] = { uchar('r'), uchar('e'), uchar('s'), uchar('e'), uchar('e'), uchar('d') };
        hmac_prf(label_reseed, 6);
        memcpy(accum + acc_len, K, sizeof(K));
        acc_len += (int)sizeof(K);
        prng32_provider_hmac_sha512_32(extractor_key, sizeof(extractor_key), accum, (size_t)acc_len, prf_key);
        thread uchar label_xts[3] = { uchar('x'), uchar('t'), uchar('s') };
        hmac_prf(label_xts, 3);
        memcpy(extractor_key, K, sizeof(extractor_key));
        memset(K, 0, sizeof(K));
        block_index = (int)sizeof(K);
        counter = 0u;
        output_since_reseed = 0u;
    }
public:
     explicit Prng32BotanHmacRng32(uint seed)
        : block_index(32), counter(0u), output_since_reseed(0u) {
        uchar kInitLabel[18] = {
            uchar('B'), uchar('o'), uchar('t'), uchar('a'), uchar('n'), uchar(' '), uchar('H'), uchar('M'),
            uchar('A'), uchar('C'), uchar('_'), uchar('R'), uchar('N'), uchar('G'), uchar(' '), uchar('X'),
            uchar('T'), uchar('S')
        };
        uchar material[64];
        memset(prf_key, 0, sizeof(prf_key));
        memset(K, 0, sizeof(K));
        hmac_sha256(prf_key, sizeof(prf_key), kInitLabel, sizeof(kInitLabel), extractor_key);
        prng32_provider_fill_material(seed, 0x424f54414e484d52ul, 0x4e47534841353132ul, material, (int)sizeof(material));
        clock_now = prng32_mix_stafford13_provider32(((ulong)seed) ^ 0x484d524e47434c4bul);
        clock_step = prng32_mix_murmur64_provider32(((ulong)seed) ^ 0x484d525354455031ul) | 1ul;
        reseed(material, (int)sizeof(material));
    }
     uint next() {
        if (block_index > 28) {
            if (output_since_reseed >= 512u) {
                reseed(nullptr, 0);
            }
            thread uchar label_rng[3] = { uchar('r'), uchar('n'), uchar('g') };
        hmac_prf(label_rng, 3);
            block_index = 0;
            output_since_reseed += 32u;
        }
        const uint out = prng32_provider_load_u32_be32(K + block_index);
        block_index += 4;
        return out;
    }
};

// Botan HMAC_DRBG uses HMAC(SHA-256) with provider-specific state management.
class Prng32BotanHmacDrbg32 {
    Prng32HmacDrbgSha256Provider32Core core;
public:
     explicit Prng32BotanHmacDrbg32(uint seed) {
        uchar material[48];
        prng32_provider_fill_material(seed, 0x424f54414e484d41ul, 0x435f445242475332ul, material, 32);
        const char kPersonalization[16] = "BotanHMACDRBG32";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material));
    }
     uint next() {
        return core.next();
    }
};

static inline void prng32_provider_inc_counter_be32(thread uchar* v, int len) {
    for (int i = len - 1; i >= 0; --i) {
        v[i] = (uchar)(v[i] + 1u);
        if (v[i] != 0u) {
            break;
        }
    }
}

static inline void prng32_provider_inc_counter_le32(thread uchar* v, int len) {
    for (int i = 0; i < len; ++i) {
        v[i] = (uchar)(v[i] + 1u);
        if (v[i] != 0u) {
            break;
        }
    }
}

static inline void prng32_provider_le_add_u64_32(thread uchar* dst, int dst_len, ulong value) {
    uint carry = 0u;
    for (int i = 0; i < 8 && i < dst_len; ++i) {
        const uint add = (uint)((value >> (i * 8)) & 0xffu);
        const uint sum = (uint)dst[i] + add + carry;
        dst[i] = (uchar)sum;
        carry = sum >> 8;
    }
    for (int i = 8; i < dst_len && carry != 0u; ++i) {
        const uint sum = (uint)dst[i] + carry;
        dst[i] = (uchar)sum;
        carry = sum >> 8;
    }
}

static inline void prng32_provider_chacha_init_material32(thread uint state[16], thread const uchar* material40) {
    state[0] = 0x61707865u;
    state[1] = 0x3320646eu;
    state[2] = 0x79622d32u;
    state[3] = 0x6b206574u;
    for (int i = 0; i < 8; ++i) {
        state[4 + i] = prng32_provider_load_u32_le32(material40 + i * 4);
    }
    state[12] = 0u;
    state[13] = 0u;
    state[14] = prng32_provider_load_u32_le32(material40 + 32);
    state[15] = prng32_provider_load_u32_le32(material40 + 36);
}

// Botan ChaCha_RNG uses HMAC(SHA-256) to rekey a ChaCha20 byte stream and consumes
// the first 32 stream bytes as the next HMAC key.
class Prng32BotanChaChaRng32 {
    uchar hmac_key[32];
    uint state[16];
    uchar block[64];
    int block_index;
     void set_chacha_key(thread const uchar key[32]) {
        uchar material[40];
        memcpy(material, key, 32);
        memset(material + 32, 0, 8);
        prng32_provider_chacha_init_material32(state, material);
        block_index = (int)sizeof(block);
    }
     void refill() {
        uint words[16];
        prng32_chacha_block_provider32(state, words, 20);
        ulong ctr = ((ulong)state[13] << 32) | (ulong)state[12];
        ++ctr;
        state[12] = (uint)ctr;
        state[13] = (uint)(ctr >> 32);
        for (int i = 0; i < 16; ++i) {
            const uint w = words[i];
            block[i * 4 + 0] = (uchar)w;
            block[i * 4 + 1] = (uchar)(w >> 8);
            block[i * 4 + 2] = (uchar)(w >> 16);
            block[i * 4 + 3] = (uchar)(w >> 24);
        }
        block_index = 0;
    }
     void generate_bytes(thread uchar* out, int out_len) {
        int produced = 0;
        while (produced < out_len) {
            if (block_index >= (int)sizeof(block)) {
                refill();
            }
            const int take = ((int)sizeof(block) - block_index < out_len - produced) ?
                ((int)sizeof(block) - block_index) : (out_len - produced);
            memcpy(out + produced, block + block_index, (size_t)take);
            block_index += take;
            produced += take;
        }
    }
     void clear_state() {
        const uchar kEmpty[1] = {0};
        uchar chacha_key[32];
        memset(hmac_key, 0, sizeof(hmac_key));
        hmac_sha256(hmac_key, sizeof(hmac_key), kEmpty, 0, chacha_key);
        set_chacha_key(chacha_key);
    }
     void update(thread const uchar* input, int input_len) {
        uchar chacha_key[32];
        uchar next_hmac_key[32];
        hmac_sha256(hmac_key, sizeof(hmac_key), input, (size_t)input_len, chacha_key);
        set_chacha_key(chacha_key);
        generate_bytes(next_hmac_key, (int)sizeof(next_hmac_key));
        memcpy(hmac_key, next_hmac_key, sizeof(hmac_key));
    }
public:
     explicit Prng32BotanChaChaRng32(uint seed) {
        uchar material[32];
        prng32_provider_fill_material(seed, 0x424f54414e434841ul, 0x524e473332534545ul, material, (int)sizeof(material));
        clear_state();
        update(material, (int)sizeof(material));
    }
     uint next() {
        uchar out[4];
        generate_bytes(out, (int)sizeof(out));
        return prng32_provider_load_u32_be32(out);
    }
};

class Prng32NettleYarrow256_32 {
    uchar key[32];
    uchar counter[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
     void increment_counter() {
        for (int i = 15; i >= 0; --i) {
            counter[i] = (uchar)(counter[i] + 1u);
            if (counter[i] != 0u) {
                break;
            }
        }
    }
     void generate_block(thread uchar out[16]) {
        provider_aes_encrypt_block(round_keys, counter, out);
        increment_counter();
    }
     void iterate_digest(thread uchar digest[32]) {
        uchar v0[32];
        memcpy(v0, digest, sizeof(v0));
        for (uint i = 1; i < 1500u; ++i) {
            uchar msg[68];
            memcpy(msg + 0, digest, 32);
            memcpy(msg + 32, v0, 32);
            msg[64] = (uchar)(i >> 24);
            msg[65] = (uchar)(i >> 16);
            msg[66] = (uchar)(i >> 8);
            msg[67] = (uchar)i;
            SHA256(msg, sizeof(msg), digest);
        }
    }
     void gate() {
        uchar new_key[32];
        generate_block(new_key + 0);
        generate_block(new_key + 16);
        memcpy(key, new_key, sizeof(key));
        provider_aes_expand_key(key, round_keys);
    }
     void fast_reseed(thread const uchar* seed_file, int seed_len) {
        uchar digest[32];
        SHA256(seed_file, (size_t)seed_len, digest);
        iterate_digest(digest);
        memcpy(key, digest, sizeof(key));
        provider_aes_expand_key(key, round_keys);
        memset(counter, 0, sizeof(counter));
        provider_aes_encrypt_block(round_keys, counter, counter);
        block_index = (int)sizeof(block);
    }
     void refill() {
        generate_block(block + 0);
        generate_block(block + 16);
        gate();
        block_index = 0;
    }
public:
     explicit Prng32NettleYarrow256_32(uint seed) : block_index(32) {
        uchar seed_file[32];
        memset(key, 0, sizeof(key));
        memset(counter, 0, sizeof(counter));
        memset(block, 0, sizeof(block));
        prng32_provider_fill_material(seed, 0x4e4554544c455941ul, 0x52524f5732353632ul, seed_file, (int)sizeof(seed_file));
        fast_reseed(seed_file, (int)sizeof(seed_file));
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            ((uint)block[block_index] << 24) |
            ((uint)block[block_index + 1] << 16) |
            ((uint)block[block_index + 2] << 8) |
            ((uint)block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

// GNU Nettle drbg_ctr_aes256 public DRBG surface with direct 48-byte seed material.
class Prng32NettleCtrDrbgAes256_32 {
    uchar key[32];
    uchar value[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
     void expand_key() {
        provider_aes_expand_key(key, round_keys);
    }
     void increment_value() {
        for (int i = 15; i >= 0; --i) {
            value[i] = (uchar)(value[i] + 1u);
            if (value[i] != 0u) {
                break;
            }
        }
    }
     void output_bytes(int n, thread uchar* dst) {
        while (n >= 16) {
            increment_value();
            provider_aes_encrypt_block(round_keys, value, dst);
            dst += 16;
            n -= 16;
        }
        if (n > 0) {
            uchar temp[16];
            increment_value();
            provider_aes_encrypt_block(round_keys, value, temp);
            memcpy(dst, temp, n);
        }
    }
     void update(thread const uchar* provided_data) {
        uchar temp[48];
        output_bytes((int)sizeof(temp), temp);
        if (provided_data != nullptr) {
            for (int i = 0; i < 48; ++i) {
                temp[i] ^= provided_data[i];
            }
        }
        memcpy(key, temp, 32);
        memcpy(value, temp + 32, 16);
        expand_key();
    }
     void init(thread const uchar seed_material[48]) {
        memset(key, 0, sizeof(key));
        memset(value, 0, sizeof(value));
        memset(block, 0, sizeof(block));
        expand_key();
        update(seed_material);
        block_index = (int)sizeof(block);
    }
     void refill() {
        output_bytes((int)sizeof(block), block);
        update(nullptr);
        block_index = 0;
    }
public:
     explicit Prng32NettleCtrDrbgAes256_32(uint seed) : block_index(32) {
        uchar seed_material[48];
        prng32_provider_fill_material(seed, 0x4e4554544c454354ul, 0x5244524247414553ul, seed_material, (int)sizeof(seed_material));
        init(seed_material);
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            ((uint)block[block_index] << 24) |
            ((uint)block[block_index + 1] << 16) |
            ((uint)block[block_index + 2] << 8) |
            ((uint)block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

// LibTomCrypt Fortuna PRNG uses SHA-256 pools and AES-CTR output with periodic rekey.
class Prng32LibTomCryptFortuna32 {
    uchar key[32];
    uchar iv[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
     void refill() {
        provider_aes_encrypt_block(round_keys, iv, block + 0);
        prng32_provider_inc_counter_le32(iv, 16);
        provider_aes_encrypt_block(round_keys, iv, block + 16);
        prng32_provider_inc_counter_le32(iv, 16);
        provider_aes_encrypt_block(round_keys, iv, key + 0);
        prng32_provider_inc_counter_le32(iv, 16);
        provider_aes_encrypt_block(round_keys, iv, key + 16);
        prng32_provider_inc_counter_le32(iv, 16);
        provider_aes_expand_key(key, round_keys);
        block_index = 0;
    }
public:
     explicit Prng32LibTomCryptFortuna32(uint seed) : block_index(32) {
        uchar material[32];
        uchar pool_input[34];
        uchar pool_digest[32];
        uchar reseed_input[64];
        prng32_provider_fill_material(seed, 0x4c5443464f525455ul, 0x4e4150524e473332ul, material, 32);
        pool_input[0] = 0u;
        pool_input[1] = (uchar)sizeof(material);
        memcpy(pool_input + 2, material, sizeof(material));
        SHA256(pool_input, sizeof(pool_input), pool_digest);
        memset(reseed_input, 0, 32);
        memcpy(reseed_input + 32, pool_digest, 32);
        SHA256(reseed_input, sizeof(reseed_input), key);
        memset(iv, 0, sizeof(iv));
        memset(block, 0, sizeof(block));
        prng32_provider_inc_counter_le32(iv, 16);
        provider_aes_expand_key(key, round_keys);
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// LibTomCrypt Yarrow PRNG defaults to SHA-256 + AES-CTR with a little-endian counter.
class Prng32LibTomCryptYarrow32 {
    uchar counter[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
     void refill() {
        provider_aes_encrypt_block(round_keys, counter, block + 0);
        prng32_provider_inc_counter_le32(counter, 16);
        provider_aes_encrypt_block(round_keys, counter, block + 16);
        prng32_provider_inc_counter_le32(counter, 16);
        block_index = 0;
    }
public:
     explicit Prng32LibTomCryptYarrow32(uint seed) : block_index(32) {
        uchar material[48];
        uchar hash_input[80];
        uchar pool[32];
        prng32_provider_fill_material(seed, 0x4c5443594152524ful, 0x5750524e47534841ul, material, 48);
        memset(hash_input, 0, 32);
        memcpy(hash_input + 32, material, sizeof(material));
        SHA256(hash_input, sizeof(hash_input), pool);
        memcpy(counter, pool, sizeof(counter));
        memset(block, 0, sizeof(block));
        provider_aes_expand_key(pool, round_keys);
    }
     uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

class Prng32CryptoPPRandomPool32 {
    uchar key[32];
    uchar seed_bytes[16];
    uchar block[16];
    uint round_keys[60];
    ulong tick_counter;
    bool key_set;
    int block_index;
     void incorporate_entropy(thread const uchar* input, int input_len) {
        uchar hash_input[96];
        memcpy(hash_input, key, 32);
        memcpy(hash_input + 32, input, input_len);
        SHA256(hash_input, (size_t)(32 + input_len), key);
        key_set = false;
    }
     void refill() {
        if (!key_set) {
            provider_aes_expand_key(key, round_keys);
            key_set = true;
        }
        prng32_provider_le_add_u64_32(seed_bytes + 0, 8, tick_counter);
        prng32_provider_le_add_u64_32(seed_bytes + 8, 8, tick_counter ^ 0x9e3779b97f4a7c15ul);
        ++tick_counter;
        provider_aes_encrypt_block(round_keys, seed_bytes, seed_bytes);
        memcpy(block, seed_bytes, sizeof(block));
        block_index = 0;
    }
public:
     explicit Prng32CryptoPPRandomPool32(uint seed) : tick_counter(1ul), key_set(false), block_index(16) {
        uchar material[48];
        memset(key, 0, sizeof(key));
        memset(seed_bytes, 0, sizeof(seed_bytes));
        memset(block, 0, sizeof(block));
        prng32_provider_fill_material(seed, 0x43505052414e4450ul, 0x4f4f4c5348413235ul, material, (int)sizeof(material));
        incorporate_entropy(material, (int)sizeof(material));
    }
     uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

static inline void prng32_provider_mdc_sha1_encrypt_block32(thread const uchar key[64], thread const uchar in[20], thread uchar out[20]) {
    uint state[5];
    for (int i = 0; i < 5; ++i) {
        state[i] = prng32_provider_load_u32_be32(in + i * 4);
    }
    prng32_provider_sha1_compress_block32(state, key);
    for (int i = 0; i < 5; ++i) {
        out[i * 4 + 0] = (uchar)(state[i] >> 24);
        out[i * 4 + 1] = (uchar)(state[i] >> 16);
        out[i * 4 + 2] = (uchar)(state[i] >> 8);
        out[i * 4 + 3] = (uchar)(state[i]);
    }
}

// Crypto++ OldRandomPool is the historical PGP-style MDC<SHA-1> compatibility generator.
class Prng32CryptoPPOldRandomPool32 {
    static constant int kPoolSize = 384;
    static constant int kBlockSize = 20;
    static constant int kKeySize = 64;
    uchar pool[kPoolSize];
    uchar key[kKeySize];
    int add_pos;
    int get_pos;
     void stir() {
        uchar feedback[kBlockSize];
        uchar keystream[kBlockSize];
        for (int round = 0; round < 2; ++round) {
            memcpy(feedback, pool + kPoolSize - kBlockSize, kBlockSize);
            for (int pos = 0; pos < kPoolSize; pos += kBlockSize) {
                const int chunk = ((pos + kBlockSize) <= kPoolSize) ? kBlockSize : (kPoolSize - pos);
                prng32_provider_mdc_sha1_encrypt_block32(key, feedback, keystream);
                for (int i = 0; i < chunk; ++i) {
                    pool[pos + i] ^= keystream[i];
                }
                if (chunk == kBlockSize) {
                    memcpy(feedback, pool + pos, kBlockSize);
                }
            }
            memcpy(key, pool, kKeySize);
        }
        add_pos = 0;
        get_pos = kKeySize;
    }
     void incorporate_entropy(thread const uchar* input, int input_len) {
        while (input_len > 0) {
            const int space = kPoolSize - add_pos;
            const int take = (input_len < space) ? input_len : space;
            for (int i = 0; i < take; ++i) {
                pool[add_pos + i] ^= input[i];
            }
            add_pos += take;
            input += take;
            input_len -= take;
            if (add_pos == kPoolSize) {
                get_pos = kPoolSize;
                if (input_len > 0) {
                    stir();
                }
            }
        }
        if (add_pos > 0) {
            get_pos = kPoolSize;
        }
    }
     uchar next_byte() {
        if (get_pos == kPoolSize) {
            stir();
        }
        return pool[get_pos++];
    }
public:
     explicit Prng32CryptoPPOldRandomPool32(uint seed) : add_pos(0), get_pos(kPoolSize) {
        uchar material[kPoolSize];
        memset(pool, 0, sizeof(pool));
        memset(key, 0, sizeof(key));
        prng32_provider_fill_material(seed, 0x4350504f4c445250ul, 0x4f4f4c5348413130ul, material, (int)sizeof(material));
        incorporate_entropy(material, (int)sizeof(material));
    }
     uint next() {
        return ((uint)next_byte() << 24) |
            ((uint)next_byte() << 16) |
            ((uint)next_byte() << 8) |
            ((uint)next_byte());
    }
};

// Crypto++ X917RNG combines an AES block cipher, a seed vector, and a deterministic time vector.
class Prng32CryptoPPX917RNG32 {
    uchar key[32];
    uchar randseed[16];
    uchar timevec[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;
     void refill() {
        uchar datetime[16];
        uchar tmp[16];
        provider_aes_encrypt_block(round_keys, timevec, datetime);
        prng32_provider_inc_counter_be32(timevec, 16);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(randseed[i] ^ datetime[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(block[i] ^ datetime[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, randseed);
        block_index = 0;
    }
public:
     explicit Prng32CryptoPPX917RNG32(uint seed) : block_index(16) {
        uchar material[64];
        prng32_provider_fill_material(seed, 0x4350505839313752ul, 0x4e47414553323536ul, material, (int)sizeof(material));
        memcpy(key, material, 32);
        memcpy(randseed, material + 32, 16);
        memcpy(timevec, material + 48, 16);
        provider_aes_expand_key(key, round_keys);
    }
     uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// Crypto++ LC_RNG is a historical non-cryptographic byte generator using Burton's 48271 constants.
class Prng32CryptoPPLC_RNG32 {
    uint seed_state;
     uchar next_byte() {
        const uint m = 2147483647u;
        const uint q = 44488u;
        const uint a = 48271u;
        const uint r = 3399u;
        const uint hi = seed_state / q;
        const uint lo = seed_state % q;
        const long test = (long)a * (long)lo - (long)r * (long)hi;
        seed_state = (test > 0) ? (uint)test : (uint)(test + m);
        return (uchar)(((seed_state >> 0) & 0xffu) ^
            ((seed_state >> 8) & 0xffu) ^
            ((seed_state >> 16) & 0xffu) ^
            ((seed_state >> 24) & 0xffu));
    }
public:
     explicit Prng32CryptoPPLC_RNG32(uint seed) {
        seed_state = (seed % 2147483646u) + 1u;
    }
     uint next() {
        return ((uint)next_byte() << 24) |
            ((uint)next_byte() << 16) |
            ((uint)next_byte() << 8) |
            ((uint)next_byte());
    }
};

// Adapters/reused helpers for METAL PRNG32 cases 81..100. Insert before the classes below.
static inline void prng32_provider_store_u32_le32(thread uchar* out, uint x) {
    out[0] = uchar(x);
    out[1] = uchar(x >> 8u);
    out[2] = uchar(x >> 16u);
    out[3] = uchar(x >> 24u);
}

static inline void prng32_provider_md5_store_u32_le32(thread uchar* out, uint x) {
    prng32_provider_store_u32_le32(out, x);
}

static inline void prng32_provider_md5_hash32(thread const uchar* msg, int len, thread uchar out[16]) {
    MD5(msg, size_t(len), out);
}

static inline void prng32_provider_sha256_words_be32(thread const uint* words, int word_count, thread uchar out[32]) {
    uchar msg[256];
    for (int i = 0; i < word_count; ++i) prng32_provider_store_u32_be32(msg + i * 4, words[i]);
    SHA256(msg, size_t(word_count * 4), out);
}

static inline void prng32_provider_aes_expand_key_words32(thread const uint words[8], thread uint round_keys[60]) {
    uchar key[32];
    for (int i = 0; i < 8; ++i) prng32_provider_store_u32_be32(key + i * 4, words[i]);
    provider_aes_expand_key(key, round_keys);
}

static inline void prng32_provider_aes_encrypt_words32(thread const uint round_keys[60], thread const uint in_words[4], thread uint out_words[4]) {
    uchar in[16];
    uchar out[16];
    for (int i = 0; i < 4; ++i) prng32_provider_store_u32_be32(in + i * 4, in_words[i]);
    provider_aes_encrypt_block(round_keys, in, out);
    for (int i = 0; i < 4; ++i) out_words[i] = prng32_provider_load_u32_be32(out + i * 4);
}

static inline int prng32_provider_v8_to_int32_32(float x) {
    return int(uint(long(x)));
}

//Prng32DebianOpenSSL2008_Weak
class Prng32DebianOpenSSL2008_Weak {
    uint s;
public:
// Device helper: Prng32DebianOpenSSL2008_Weak.
    explicit Prng32DebianOpenSSL2008_Weak(uint pid) {
        s = (pid & 0x7fffu) | 1u;
    }
// Device helper: next.
    uint next() {
        s = (1103515245u * s + 12345u) & 0x7fffffffu;
        return s;
    }
};

// Bitcoin Core FastRandomContext uses a ChaCha20-based keystream.
class Prng32BitcoinCoreFastRandom32 {
    Prng32ChaChaProvider32Core core;
public:
    explicit Prng32BitcoinCoreFastRandom32(uint seed) {
        core.init(seed, 20, 0x4254434641535432ul, false);
    }
    uint next() {
        return core.next32();
    }
};

// Bitcoin Core InsecureRandomContext is xoroshiro128++ seeded through SplitMix64.
class Prng32BitcoinCoreInsecureRandom32 {
    ulong s0, s1;
    uint cached_hi;
    bool have_cached_hi;
// Device helper: next64raw.
    ulong next64raw() {
        ulong a0 = s0;
        ulong a1 = s1;
        const ulong result = prng32_rotl64(a0 + a1, 17) + a0;
        a1 ^= a0;
        s0 = prng32_rotl64(a0, 49) ^ a1 ^ (a1 << 21);
        s1 = prng32_rotl64(a1, 28);
        return result;
    }
public:
    explicit Prng32BitcoinCoreInsecureRandom32(uint seed) : cached_hi(0u), have_cached_hi(false) {
        ulong sm = ((ulong)seed) ^ 0x425443494e534543ul;
        s0 = prng32_splitmix64_next_provider32(sm);
        s1 = prng32_splitmix64_next_provider32(sm);
        if ((s0 | s1) == 0ul) s0 = 1ul;
    }
    uint next() {
        if (have_cached_hi) {
            have_cached_hi = false;
            return cached_hi;
        }
        ulong v = next64raw();
        cached_hi = (uint)(v >> 32);
        have_cached_hi = true;
        return (uint)v;
    }
};

// JSBN/bitaddress.org SecureRandom used an Arcfour pool in old browser wallets.
class Prng32JSBNSecureRandom32 {
    uchar S[256];
    uchar i, j;
// Device helper: next_byte.
    uchar next_byte() {
        i = (uchar)(i + 1);
        j = (uchar)(j + S[i]);
        uchar t = S[i]; S[i] = S[j]; S[j] = t;
        return S[(uchar)(S[i] + S[j])];
    }
public:
    explicit Prng32JSBNSecureRandom32(uint seed) : i(0), j(0) {
        uchar pool[256];
        ulong sm = ((ulong)seed) ^ 0x4a53424e41524334ul;
        for (int n = 0; n < 256; n += 8) {
            ulong v = prng32_splitmix64_next_provider32(sm);
            for (int b = 0; b < 8; ++b) pool[n + b] = (uchar)(v >> (b * 8));
        }
        for (int n = 0; n < 256; ++n) {
            pool[n] ^= (uchar)((seed >> ((n & 3) * 8)) + n);
            S[n] = (uchar)n;
        }
        uchar k = 0;
        for (int n = 0; n < 256; ++n) {
            k = (uchar)(k + S[n] + pool[n]);
            uchar t = S[n]; S[n] = S[k]; S[k] = t;
        }
        for (int n = 0; n < 256; ++n) (void)next_byte();
    }
    uint next() {
        uint v = (uint)next_byte();
        v |= (uint)next_byte() << 8;
        v |= (uint)next_byte() << 16;
        v |= (uint)next_byte() << 24;
        return v;
    }
};

// Libbitcoin Explorer bx seed / Milk Sad incident: clock-seeded mt19937 with byte-sized draws.
class Prng32LibbitcoinMilkSadMt19937_32 {
    Prng32EntropyGenerator core;
// Device helper: next_byte.
    uchar next_byte() {
        const uint r = core.next();
        return (uchar)(r >> 24);
    }
public:
    explicit Prng32LibbitcoinMilkSadMt19937_32(uint seed) : core(seed) {}
    uint next() {
        uint v = (uint)next_byte();
        v |= (uint)next_byte() << 8;
        v |= (uint)next_byte() << 16;
        v |= (uint)next_byte() << 24;
        return v;
    }
};

// Randstorm browser-wallet class: V8 MWC1616-backed Math.random() filled a JSBN ARC4 SecureRandom pool.
class Prng32RandstormMWC1616Arc4_32 {
    uint state0;
    uint state1;
    uchar S[256];
    uchar i;
    uchar j;
// Device helper: math_random_u16.
    ushort math_random_u16() {
        state0 = 18030u * (state0 & 0xFFFFu) + (state0 >> 16);
        state1 = 36969u * (state1 & 0xFFFFu) + (state1 >> 16);
        const uint x = (state0 << 16) + (state1 & 0xFFFFu);
        return (ushort)(x >> 16);
    }
// Device helper: seed_int.
    void seed_int(thread uchar pool[256], thread int& pptr, uint x) {
        pool[pptr++] ^= (uchar)(x & 255u);
        pool[pptr++] ^= (uchar)((x >> 8) & 255u);
        pool[pptr++] ^= (uchar)((x >> 16) & 255u);
        pool[pptr++] ^= (uchar)((x >> 24) & 255u);
        if (pptr >= 256) {
            pptr -= 256;
        }
    }
// Device helper: next_byte.
    uchar next_byte() {
        i = (uchar)(i + 1u);
        j = (uchar)(j + S[i]);
        uchar t = S[i]; S[i] = S[j]; S[j] = t;
        return S[(uchar)(S[i] + S[j])];
    }
public:
    explicit Prng32RandstormMWC1616Arc4_32(uint seed) : i(0), j(0) {
        uchar pool[256];
        ulong sm = ((ulong)seed) ^ 0x52414e4453544f52ul;
        state0 = (uint)prng32_splitmix64_next_provider32(sm);
        state1 = (uint)prng32_splitmix64_next_provider32(sm);
        if ((state0 & 0xFFFFu) == 0u) state0 ^= 0x1a2b3c4du;
        if ((state1 & 0xFFFFu) == 0u) state1 ^= 0x5e6f7789u;
        int pptr = 0;
        while (pptr < 256) {
            const ushort t = math_random_u16();
            pool[pptr++] = (uchar)(t >> 8);
            pool[pptr++] = (uchar)(t & 255u);
        }
        pptr = 0;
        seed_int(pool, pptr, seed);
        for (int n = 0; n < 256; ++n) {
            S[n] = (uchar)n;
        }
        uchar k = 0;
        for (int n = 0; n < 256; ++n) {
            k = (uchar)(k + S[n] + pool[n]);
            uchar t = S[n]; S[n] = S[k]; S[k] = t;
        }
    }
    uint next() {
        uint v = (uint)next_byte();
        v |= (uint)next_byte() << 8;
        v |= (uint)next_byte() << 16;
        v |= (uint)next_byte() << 24;
        return v;
    }
};

// FortiOS 4.3.x DUHK incident surface: ANSI X9.31 RNG on AES-128 with the hard-coded test key from the DUHK paper.
class Prng32FortiOsX931_32 {
    uchar state[16];
    uchar datetime[16];
    uchar block[16];
    uint round_keys[44];
    int block_index;
// Device helper: refill.
    void refill() {
        uchar enc_dt[16];
        uchar tmp[16];
        provider_aes_encrypt_block128(round_keys, datetime, enc_dt);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(enc_dt[i] ^ state[i]);
        }
        provider_aes_encrypt_block128(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(enc_dt[i] ^ block[i]);
        }
        provider_aes_encrypt_block128(round_keys, tmp, state);
        prng32_provider_inc_counter_be32(datetime, 16);
        block_index = 0;
    }
public:
    explicit Prng32FortiOsX931_32(uint seed) : block_index(16) {
        uchar material[32];
        const uchar fixed_key[16] = {
            0x6d, 0x66, 0xb1, 0xf3, 0x42, 0x72, 0x60, 0x13,
            0xab, 0x1c, 0x06, 0xed, 0x02, 0x62, 0xd4, 0xb8
        };
        prng32_provider_fill_material(seed, 0x464f5254494f5358ul, 0x3933314455484b32ul, material, (int)sizeof(material));
        memcpy(state, material, 16);
        memcpy(datetime, material + 16, 16);
        provider_aes_expand_key128(fixed_key, round_keys);
    }
    uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// Historical V8/Node Math.random() helper for source-backed JS wallet/library fallbacks.
struct Prng32ProviderV8MathRandom32 {
    ulong state0;
    ulong state1;
    explicit Prng32ProviderV8MathRandom32(uint seed) {
        state0 = prng32_mix_murmur64_provider32(((ulong)seed) ^ 0x56384d4154483332ul);
        state1 = prng32_mix_murmur64_provider32(state0);
        if ((state0 | state1) == 0ul) {
            state1 = 1ul;
        }
    }
    ulong next_u64() {
        ulong s1 = state0;
        ulong s0 = state1;
        state0 = s0;
        s1 ^= s1 << 23;
        s1 ^= s1 >> 17;
        s1 ^= s0;
        s1 ^= s0 >> 26;
        state1 = s1;
        return s0 + s1;
    }
    ulong next_m53() {
        return next_u64() >> 11u;
    }
    float next_double() {
        return (float)next_m53() * (1.0 / 9007199254740992.0);
    }
    uint next_scaled(uint bound) {
        return prng_metal_double_m53_scaled_u32(next_m53(), bound);
    }
    bool next_gt_half() {
        return prng_metal_double_m53_gt_half(next_m53());
    }
};

// Historical node-forge AES-128 counter PRNG core shared by old forge.random/keypair paths.
struct Prng32NodeForgeAesPrngState32 {
    uint seed_words[4];
    uint round_keys[44];
    uchar block[16];
    int block_index;
    void store_be(thread uchar* out, uint x) {
        out[0] = (uchar)(x >> 24);
        out[1] = (uchar)(x >> 16);
        out[2] = (uchar)(x >> 8);
        out[3] = (uchar)x;
    }
    void init_from_digests(thread const uchar* key_bytes, thread const uchar* seed_bytes) {
        provider_aes_expand_key128(key_bytes, round_keys);
        for (int i = 0; i < 4; ++i) {
            seed_words[i] = prng32_provider_load_u32_be32(seed_bytes + i * 4);
        }
        memset(block, 0, sizeof(block));
        block_index = (int)sizeof(block);
    }
    void init_legacy_sha1(thread const uchar pool0[32]) {
        uchar pool_digest[20];
        uchar key_bytes[20];
        uchar seed_bytes[20];
        prng32_provider_sha1_hash32(pool0, 32, pool_digest);
        prng32_provider_sha1_hash32(pool_digest, 20, key_bytes);
        prng32_provider_sha1_hash32(key_bytes, 20, seed_bytes);
        init_from_digests(key_bytes, seed_bytes);
    }
    void init_modern_sha256(thread const uchar pool0[32]) {
        uchar pool_digest[32];
        uchar key_bytes[32];
        uchar seed_bytes[32];
        SHA256(pool0, 32, pool_digest);
        SHA256(pool_digest, sizeof(pool_digest), key_bytes);
        SHA256(key_bytes, sizeof(key_bytes), seed_bytes);
        init_from_digests(key_bytes, seed_bytes);
    }
    void refill() {
        uchar seed_bytes[16];
        uchar next_key[16];
        uchar next_seed[16];
        for (int i = 0; i < 4; ++i) {
            store_be(seed_bytes + i * 4, seed_words[i]);
        }
        provider_aes_encrypt_block128(round_keys, seed_bytes, block);
        ++seed_words[3];
        for (int i = 0; i < 4; ++i) {
            store_be(seed_bytes + i * 4, seed_words[i]);
        }
        provider_aes_encrypt_block128(round_keys, seed_bytes, next_key);
        provider_aes_expand_key128(next_key, round_keys);
        provider_aes_encrypt_block128(round_keys, seed_bytes, next_seed);
        for (int i = 0; i < 4; ++i) {
            seed_words[i] = prng32_provider_load_u32_be32(next_seed + i * 4);
        }
        block_index = 0;
    }
    uint next32() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// node-forge random.js / forge.random.createInstance() uses AES-128 with SHA-256 pool reseeding.
class Prng32NodeForgeAesPrngSha256_32 {
    Prng32NodeForgeAesPrngState32 core;
public:
    explicit Prng32NodeForgeAesPrngSha256_32(uint seed) {
        uchar pool0[32];
        prng32_provider_fill_material(seed, 0x4e464f5247453235ul, 0x3653484132563430ul, pool0, (int)sizeof(pool0));
        core.init_modern_sha256(pool0);
    }
    uint next() {
        return core.next32();
    }
};

// Legacy node-forge/keypair bundled forge.random path used AES-128 with SHA-1 pool reseeding.
class Prng32NodeForgeLegacyAesPrngSha1_32 {
    Prng32NodeForgeAesPrngState32 core;
public:
    explicit Prng32NodeForgeLegacyAesPrngSha1_32(uint seed) {
        uchar pool0[32];
        prng32_provider_fill_material(seed, 0x4e464f5247455348ul, 0x41314c4547414359ul, pool0, (int)sizeof(pool0));
        core.init_legacy_sha1(pool0);
    }
    uint next() {
        return core.next32();
    }
};

// keypair <= 1.0.3 fell back to forge.random with a broken Math.random-seeded Lehmer path in browsers/Node bundles.
class Prng32KeypairNodeForgeMathRandomV8_32 {
    Prng32NodeForgeAesPrngState32 core;
    static uchar bug_byte(uint x) {
        return (x >= 48u && x <= 57u) ? (uchar)(x - 48u) : 0u;
    }
public:
    explicit Prng32KeypairNodeForgeMathRandomV8_32(uint seed) {
        Prng32ProviderV8MathRandom32 js(seed ^ 0x4b45595041495231u);
        uchar pool0[32];
        uint pm_seed = js.next_scaled(0xFFFFu);
        int produced = 0;
        int global_index = 0;
        while (produced < 32) {
            ulong lo = 16807ul * (ulong)(pm_seed & 0xFFFFu);
            ulong hi = 16807ul * (ulong)(pm_seed >> 16);
            lo += (hi & 0x7FFFul) << 16;
            lo += hi >> 15;
            lo = (lo & 0x7FFFFFFFul) + (lo >> 31);
            pm_seed = (uint)lo;
            for (int i = 0; i < 3 && produced < 32; ++i) {
                uint next = pm_seed >> (i * 8);
                next ^= js.next_scaled(0xFFu);
                if ((global_index & 31) == 0) {
                    pool0[produced++] = bug_byte(next & 0xFFu);
                }
                ++global_index;
            }
        }
        core.init_legacy_sha1(pool0);
    }
    uint next() {
        return core.next32();
    }
};

// CryptoJS 3.1.x WordArray.random() mixed V8 Math.random() with an internal MWC-like closure.
class Prng32CryptoJSWordArrayRandomV8_32 {
    Prng32ProviderV8MathRandom32 js;
    ulong rcache_scaled;
    bool rcache_neg;
    bool have_rcache;
    ulong draw_scaled(thread int& m_w, thread int& m_z) {
        m_z = int(0x9069u * uint(m_z & 0xFFFF) + uint(m_z >> 16));
        m_w = int(0x4650u * uint(m_w & 0xFFFF) + uint(m_w >> 16));
        const uint result = uint((m_z << 16) + m_w);
        return ulong(result) + 0x80000000ul;
    }
    static uint signed_scaled_to_u32(bool neg, ulong scaled) {
        return uint(neg ? (0ul - scaled) : scaled);
    }
    uint next_word() {
        const bool use_cache = have_rcache && (rcache_scaled != 0ul);
        int m_w = use_cache
            ? int(signed_scaled_to_u32(rcache_neg, rcache_scaled))
            : int(prng_metal_double_m53_to_u32(js.next_m53()));
        int m_z = int(0x3ade68b1u);
        const ulong cache_draw = draw_scaled(m_w, m_z);
        rcache_neg = !js.next_gt_half();
        rcache_scaled = prng_round_u64_to_metal_double_integer(cache_draw * 0x3ade67b7ul);
        have_rcache = true;
        const ulong word_draw = draw_scaled(m_w, m_z);
        const bool word_neg = !js.next_gt_half();
        return signed_scaled_to_u32(word_neg, word_draw);
    }
public:
    explicit Prng32CryptoJSWordArrayRandomV8_32(uint seed)
        : js(seed ^ uint(0x43525950544f4a53ul)), rcache_scaled(0ul), rcache_neg(false), have_rcache(false) {}
    uint next() { return next_word(); }
};

// jsrsasign SecureRandom bundles Tom Wu's rng.js/prng4.js: Math.random()-filled pool, rng_seed_time(), then Arcfour nextBytes().
class Prng32JsrsasignSecureRandomV8_32 {
    uchar S[256];
    uchar i, j;
    static void seed_int(thread uchar pool[256], thread int& pptr, uint x) {
        pool[pptr++] ^= (uchar)(x & 255u);
        pool[pptr++] ^= (uchar)((x >> 8) & 255u);
        pool[pptr++] ^= (uchar)((x >> 16) & 255u);
        pool[pptr++] ^= (uchar)((x >> 24) & 255u);
        if (pptr >= 256) {
            pptr -= 256;
        }
    }
    uchar next_byte() {
        i = (uchar)(i + 1u);
        j = (uchar)(j + S[i]);
        uchar t = S[i]; S[i] = S[j]; S[j] = t;
        return S[(uchar)(t + S[i])];
    }
public:
    explicit Prng32JsrsasignSecureRandomV8_32(uint seed) : i(0), j(0) {
        Prng32ProviderV8MathRandom32 js(seed ^ 0x4a53525341534947ul);
        uchar pool[256];
        int pptr = 0;
        while (pptr < 256) {
            const uint t = prng_metal_double_m53_to_u16(js.next_m53());
            pool[pptr++] = (uchar)(t >> 8);
            pool[pptr++] = (uchar)(t & 255u);
        }
        pptr = 0;
        seed_int(pool, pptr, seed ^ 0x524e4754494d4531ul); // Deterministic stand-in for rng_seed_time().
        for (int n = 0; n < 256; ++n) {
            S[n] = (uchar)n;
        }
        uchar k = 0;
        for (int n = 0; n < 256; ++n) {
            k = (uchar)(k + S[n] + pool[n]);
            uchar t = S[n]; S[n] = S[k]; S[k] = t;
        }
    }
    uint next() {
        uint v = (uint)next_byte();
        v |= (uint)next_byte() << 8;
        v |= (uint)next_byte() << 16;
        v |= (uint)next_byte() << 24;
        return v;
    }
};

// sjcl.random.randomWords() is a pooled AES-based browser PRNG used in wallet/browser crypto stacks such as BitGo.
class Prng32SjclRandomWords32 {
    uint key_words[8];
    uint counter_words[4];
    uint round_keys[60];
    uint block_words[4];
    int block_index;
// Device helper: set_key.
    void set_key(thread const uint words[8]) {
        memcpy(key_words, words, sizeof(key_words));
        prng32_provider_aes_expand_key_words32(key_words, round_keys);
    }
// Device helper: counter_increment.
    void counter_increment() {
        for (int i = 0; i < 4; ++i) {
            counter_words[i] += 1u;
            if (counter_words[i] != 0u) {
                break;
            }
        }
    }
// Device helper: gen4words.
    void gen4words(thread uint out[4]) {
        counter_increment();
        prng32_provider_aes_encrypt_words32(round_keys, counter_words, out);
    }
// Device helper: refill.
    void refill() {
        gen4words(block_words);
        block_index = 0;
    }
public:
    explicit Prng32SjclRandomWords32(uint seed) : block_index(4) {
        uchar material[196];
        uchar pool_digest[32];
        uchar key_digest[32];
        uint entropy_words[32];
        uint ambient_words[16];
        uint pool_words[38];
        uint reseed_words[25];
        uint key_material_words[33];
        uint init_key[8];
        memset(key_words, 0, sizeof(key_words));
        memset(counter_words, 0, sizeof(counter_words));
        memset(block_words, 0, sizeof(block_words));
        prng32_provider_fill_material(seed, 0x534a434c52414e44ul, 0x4f4d574f52445332ul, material, (int)sizeof(material));
        for (int i = 0; i < 32; ++i) {
            entropy_words[i] = prng32_provider_load_u32_be32(material + i * 4);
        }
        const uint time_word = prng32_provider_load_u32_be32(material + 128);
        for (int i = 0; i < 16; ++i) {
            ambient_words[i] = prng32_provider_load_u32_be32(material + 132 + i * 4);
        }
        pool_words[0] = 0u;
        pool_words[1] = 0u;
        pool_words[2] = 2u;
        pool_words[3] = 1024u;
        pool_words[4] = time_word;
        pool_words[5] = 32u;
        memcpy(pool_words + 6, entropy_words, sizeof(entropy_words));
        prng32_provider_sha256_words_be32(pool_words, 38, pool_digest);
        reseed_words[0] = time_word + 30000u;
        memcpy(reseed_words + 1, ambient_words, sizeof(ambient_words));
        for (int i = 0; i < 8; ++i) {
            reseed_words[17 + i] = prng32_provider_load_u32_be32(pool_digest + i * 4);
        }
        memset(key_material_words, 0, sizeof(uint) * 8);
        memcpy(key_material_words + 8, reseed_words, sizeof(reseed_words));
        prng32_provider_sha256_words_be32(key_material_words, 33, key_digest);
        for (int i = 0; i < 8; ++i) {
            init_key[i] = prng32_provider_load_u32_be32(key_digest + i * 4);
        }
        set_key(init_key);
        counter_increment();
    }
    uint next() {
        if (block_index >= 4) {
            refill();
        }
        return block_words[block_index++];
    }
};

// Historical OpenSSL/SSLeay RAND_SSLeay md_rand.c provider core using a 1023-byte MD5-mixed pool.
class Prng32OpenSslMdRandProvider32Core {
    static constant int kStateSize = 1023;
    static constant int kDigestSize = 16;
    uchar state[kStateSize + kDigestSize];
    uchar md[kDigestSize];
    uchar block[kDigestSize];
    uint md_count0;
    uint md_count1;
    uint pid_word;
    int state_num;
    int state_index;
    int block_index;
    bool stirred;
// Device helper: add_seed_material.
    void add_seed_material(thread const uchar* input, int input_len) {
        int st_idx = state_index;
        uint md_c0 = md_count0;
        uint md_c1 = md_count1;
        uchar local_md[kDigestSize];
        memcpy(local_md, md, sizeof(local_md));

        state_index += input_len;
        if (state_index >= kStateSize) {
            state_index %= kStateSize;
            state_num = kStateSize;
        } else if (state_num < kStateSize && state_index > state_num) {
            state_num = state_index;
        }
        md_count1 += (uint)(input_len / kDigestSize) + (uint)((input_len % kDigestSize) > 0);

        int offset = 0;
        while (offset < input_len) {
            const int chunk = ((input_len - offset) > kDigestSize) ? kDigestSize : (input_len - offset);
            uchar msg[kDigestSize + kDigestSize + kDigestSize + 8];
            int p = 0;
            memcpy(msg + p, local_md, kDigestSize);
            p += kDigestSize;
            for (int i = 0; i < chunk; ++i) {
                msg[p++] = state[(st_idx + i) % kStateSize];
            }
            memcpy(msg + p, input + offset, chunk);
            p += chunk;
            prng32_provider_md5_store_u32_le32(msg + p, md_c0);
            p += 4;
            prng32_provider_md5_store_u32_le32(msg + p, md_c1);
            p += 4;
            prng32_provider_md5_hash32(msg, p, local_md);
            ++md_c1;
            offset += chunk;
            for (int i = 0; i < chunk; ++i) {
                state[st_idx] ^= local_md[i];
                if (++st_idx >= kStateSize) {
                    st_idx = 0;
                }
            }
        }
        for (int i = 0; i < kDigestSize; ++i) {
            md[i] ^= local_md[i];
        }
    }
// Device helper: stir_pool.
    void stir_pool() {
        const uchar kDummySeed[kDigestSize] = {
            '.', '.', '.', '.', '.', '.', '.', '.',
            '.', '.', '.', '.', '.', '.', '.', '.'
        };
        int remaining = kStateSize;
        while (remaining > 0) {
            add_seed_material(kDummySeed, kDigestSize);
            remaining -= kDigestSize;
        }
        stirred = true;
    }
// Device helper: fill_bytes.
    void fill_bytes(thread uchar* out, int out_len) {
        if (!stirred) {
            stir_pool();
        }
        const int out_chunk = kDigestSize / 2;
        const int st_num = state_num ? state_num : kStateSize;
        const int out_len_ceil = ((out_len + out_chunk - 1) / out_chunk) * out_chunk;
        int st_idx = state_index;
        uint md_c0 = md_count0;
        uint md_c1 = md_count1;
        uchar local_md[kDigestSize];
        memcpy(local_md, md, sizeof(local_md));

        state_index += out_len_ceil;
        if (state_index > st_num) {
            state_index %= st_num;
        }
        md_count0 += 1u;

        int offset = 0;
        bool first_round = true;
        while (offset < out_len) {
            const int chunk = ((out_len - offset) > out_chunk) ? out_chunk : (out_len - offset);
            uchar msg[4 + kDigestSize + 8 + out_chunk + out_chunk];
            int p = 0;
            if (first_round) {
                prng32_provider_md5_store_u32_le32(msg + p, pid_word);
                p += 4;
                first_round = false;
            }
            memcpy(msg + p, local_md, kDigestSize);
            p += kDigestSize;
            prng32_provider_md5_store_u32_le32(msg + p, md_c0);
            p += 4;
            prng32_provider_md5_store_u32_le32(msg + p, md_c1);
            p += 4;
            memcpy(msg + p, out + offset, chunk);
            p += chunk;
            for (int i = 0; i < out_chunk; ++i) {
                msg[p++] = state[(st_idx + i) % st_num];
            }
            prng32_provider_md5_hash32(msg, p, local_md);
            for (int i = 0; i < out_chunk; ++i) {
                state[st_idx] ^= local_md[i];
                if (++st_idx >= st_num) {
                    st_idx = 0;
                }
                if (i < chunk) {
                    out[offset++] = local_md[i + out_chunk];
                }
            }
        }

        uchar final_msg[8 + kDigestSize + kDigestSize];
        prng32_provider_md5_store_u32_le32(final_msg + 0, md_c0);
        prng32_provider_md5_store_u32_le32(final_msg + 4, md_c1);
        memcpy(final_msg + 8, local_md, kDigestSize);
        memcpy(final_msg + 8 + kDigestSize, md, kDigestSize);
        prng32_provider_md5_hash32(final_msg, (int)sizeof(final_msg), md);
    }
public:
    Prng32OpenSslMdRandProvider32Core()
        : md_count0(0u), md_count1(0u), pid_word(0u), state_num(0), state_index(0), block_index(kDigestSize), stirred(false) {
        memset(state, 0, sizeof(state));
        memset(md, 0, sizeof(md));
        memset(block, 0, sizeof(block));
    }
    void init_ful(uint seed, ulong domain0, ulong domain1) {
        uchar material[64];
        prng32_provider_fill_material(seed, domain0, domain1, material, (int)sizeof(material));
        pid_word = prng32_provider_load_u32_le32(material);
        add_seed_material(material, (int)sizeof(material));
    }
    void init_weak(uint seed, ulong domain0, ulong domain1) {
        uchar material[16];
        prng32_provider_fill_material(seed, domain0, domain1, material, (int)sizeof(material));
        pid_word = prng32_provider_load_u32_le32(material);
        add_seed_material(material, (int)sizeof(material));
    }
    uint next() {
        if (block_index > 12) {
            fill_bytes(block, (int)sizeof(block));
            block_index = 0;
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// Android 4.2/4.3 "Crypto" provider incident: OpenSSL RAND_bytes with weak application-driven seeding.
class Prng32AndroidBitcoinWalletSecureRandomBug32 {
    Prng32OpenSslMdRandProvider32Core core;
public:
    explicit Prng32AndroidBitcoinWalletSecureRandomBug32(uint seed) {
        core.init_weak(seed, 0x414e44524f494453ul, 0x4543525950544f32ul);
    }
    uint next() {
        return core.next();
    }
};

// Netscape 1.1 SSL PRNG from Goldberg/Wagner: MD5(seed) with seed = MD5(mklcpr(micros), mklcpr(pid+seconds+(ppid<<12))).
class Prng32NetscapeSslPrng32 {
    uchar seed_state[16];
    uchar block[16];
    int block_index;
// Device helper: store_u32_be.
    void store_u32_be(thread uchar* out, uint x) {
        out[0] = (uchar)(x >> 24);
        out[1] = (uchar)(x >> 16);
        out[2] = (uchar)(x >> 8);
        out[3] = (uchar)(x);
    }
// Device helper: mklcpr.
    uint mklcpr(uint x) {
        return (uint)(((0xdeece66dul * (ulong)x) + 0x2bbb62dcul) >> 1);
    }
// Device helper: refill.
    void refill() {
        prng32_provider_md5_hash32(seed_state, (int)sizeof(seed_state), block);
        for (int i = 15; i >= 0; --i) {
            seed_state[i] = (uchar)(seed_state[i] + 1u);
            if (seed_state[i] != 0u) {
                break;
            }
        }
        block_index = 0;
    }
public:
    explicit Prng32NetscapeSslPrng32(uint seed) : block_index(16) {
        uchar material[16];
        uchar seed_material[8];
        prng32_provider_fill_material(seed, 0x4e45545343415045ul, 0x53534c50524e4732ul, material, (int)sizeof(material));
        const uint seconds = prng32_provider_load_u32_be32(material + 0);
        const uint micros = prng32_provider_load_u32_be32(material + 4) % 1000000u;
        const uint pid = prng32_provider_load_u32_be32(material + 8) & 0x7fffu;
        const uint ppid = prng32_provider_load_u32_be32(material + 12) & 0x7fffu;
        store_u32_be(seed_material + 0, mklcpr(micros));
        store_u32_be(seed_material + 4, mklcpr(pid + seconds + (ppid << 12)));
        prng32_provider_md5_hash32(seed_material, (int)sizeof(seed_material), seed_state);
        memset(block, 0, sizeof(block));
    }
    uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// Historical OpenSSL/SSLeay RAND_SSLeay md_rand.c provider path before the DRBG rewrite.
class Prng32OpenSslMdRand32 {
    Prng32OpenSslMdRandProvider32Core core;
public:
    explicit Prng32OpenSslMdRand32(uint seed) {
        core.init_ful(seed, 0x4f50454e53534c4dul, 0x4452414e444d4435ul);
    }
    uint next() {
        return core.next();
    }
};

// indutny/elliptic + hmac-drbg in old EtherWallet/MEW bundles used SHA-256 HMAC_DRBG.
class Prng32EllipticHmacDrbg32 {
    Prng32HmacDrbgSha256Provider32Core core;
public:
    explicit Prng32EllipticHmacDrbg32(uint seed) {
        uchar material[48];
        prng32_provider_fill_material(seed, 0x454c4c4950544943ul, 0x484d414344524247ul, material, 32);
        const uchar kSecp256k1Nonce[16] = {
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
            0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b
        };
        memcpy(material + 32, kSecp256k1Nonce, sizeof(kSecp256k1Nonce));
        core.init(material, (int)sizeof(material));
    }
    uint next() {
        return core.next();
    }
};

// LibTomCrypt RC4 PRNG buffers entropy, runs RC4 KSA, then drops 3072 bytes.
class Prng32LibTomCryptRC4Prng32 {
    uchar S[256];
    uchar i;
    uchar j;
// Device helper: next_byte.
    uchar next_byte() {
        i = (uchar)(i + 1u);
        j = (uchar)(j + S[i]);
        uchar t = S[i];
        S[i] = S[j];
        S[j] = t;
        return S[(uchar)(S[i] + S[j])];
    }
public:
    explicit Prng32LibTomCryptRC4Prng32(uint seed) : i(0), j(0) {
        uchar ent[256];
        prng32_provider_fill_material(seed, 0x4c54435243345052ul, 0x4e47424954534f55ul, ent, (int)sizeof(ent));
        for (int n = 0; n < 256; ++n) {
            S[n] = (uchar)n;
        }
        uchar k = 0u;
        for (int n = 0; n < 256; ++n) {
            k = (uchar)(k + S[n] + ent[n]);
            uchar t = S[n];
            S[n] = S[k];
            S[k] = t;
        }
        for (int n = 0; n < 3072; ++n) {
            (void)next_byte();
        }
    }
    uint next() {
        return ((uint)next_byte() << 24) |
            ((uint)next_byte() << 16) |
            ((uint)next_byte() << 8) |
            ((uint)next_byte());
    }
};

// LibTomCrypt ChaCha20 PRNG fills a 40-byte entropy buffer and runs ChaCha20 with an 8-byte IV.
class Prng32LibTomCryptChaCha20Prng32 {
    uint state[16];
    uint buffer[16];
    int idx;
// Device helper: refill.
    void refill() {
        prng32_chacha_block_provider32(state, buffer, 20);
        ulong ctr = ((ulong)state[13] << 32) | (ulong)state[12];
        ++ctr;
        state[12] = (uint)ctr;
        state[13] = (uint)(ctr >> 32);
        idx = 0;
    }
public:
    explicit Prng32LibTomCryptChaCha20Prng32(uint seed) : idx(16) {
        uchar ent[40];
        prng32_provider_fill_material(seed, 0x4c54434348413230ul, 0x50524e47454e5434ul, ent, (int)sizeof(ent));
        prng32_provider_chacha_init_material32(state, ent);
    }
    uint next() {
        if (idx >= 16) {
            refill();
        }
        return buffer[idx++];
    }
};

static constant int kPrng32Sober128N32 = 17;

static constant uint kPrng32Sober128InitKonst32 = 0x6996c53au;

