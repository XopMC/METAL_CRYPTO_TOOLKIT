        w = seed ^ 0x56a3u;
        c = seed | 1u;
    }
    uint next() {
        const ulong t = 698769069ul * ulong(x) + ulong(c);
        c = uint(t >> 32u);
        x = uint(t);
        y ^= y << 13u; y ^= y >> 17u; y ^= y << 5u;
        z = 1103515245u * z + 12345u;
        return x + y + z;
    }
};

class Prng32MRG31k3p {
    uint s10, s11, s12, s20, s21, s22;
public:
    explicit Prng32MRG31k3p(uint seed) {
        s10 = seed % 2147483647u;
        s11 = (seed ^ 12345u) % 2147483647u;
        s12 = (seed | 1u) % 2147483647u;
        s20 = seed % 2147462579u;
        s21 = (seed * 3u) % 2147462579u;
        s22 = (seed + 1u) % 2147462579u;
    }
    uint next() {
        const uint p1 = uint((ulong(1403580u) * ulong(s11) + ulong(4294156359u) * ulong(s10)) % 2147483647ul);
        s10 = s11; s11 = s12; s12 = p1;
        const uint p2 = uint((ulong(527612u) * ulong(s22) + ulong(4294584393u) * ulong(s20)) % 2147462579ul);
        s20 = s21; s21 = s22; s22 = p2;
        int z = int(p1) - int(p2);
        if (z < 0) {
            z += 2147483647;
        }
        return uint(z);
    }
};

class Prng32MRG63k3a {
