        reg = (reg >> 1u) | (bit << 31u);
        return reg;
    }
};

class Prng32KISS99_32 {
    uint z, w, jsr, jcong;
public:
    explicit Prng32KISS99_32(uint seed) {
        z = seed ^ 362436069u;
        w = seed * 521288629u + 1u;
        jsr = seed ^ 123456789u;
        jcong = seed * 380116160u + 1u;
    }
    uint next() {
        z = 36969u * (z & 0xffffu) + (z >> 16u);
        w = 18000u * (w & 0xffffu) + (w >> 16u);
        const uint mwc = (z << 16u) + w;
        jcong = 69069u * jcong + 1234567u;
        jsr ^= jsr << 17u; jsr ^= jsr >> 13u; jsr ^= jsr << 5u;
        return (mwc ^ jcong) + jsr;
    }
};

