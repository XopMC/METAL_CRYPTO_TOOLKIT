// Botan HMAC_RNG uses HMAC(SHA-256) and HMAC(SHA-512) with provider-specific state management.
class BotanHmacRng64 {
    uchar prf_key[64];
    uchar extractor_key[32];
    uchar K[32];
    int block_index;
    uint counter;
    ulong clock_now;
    ulong clock_step;
    uint output_since_reseed;

    void hmac_prf(constant uchar* label, int label_len) {
        uchar msg[64];
        for (int i = 0; i < 32; ++i) {
            msg[i] = K[i];
        }
        for (int i = 0; i < label_len; ++i) {
            msg[32 + i] = label[i];
        }
        const int off = 32 + label_len;
        msg[off + 0] = uchar(counter >> 24u);
        msg[off + 1] = uchar(counter >> 16u);
        msg[off + 2] = uchar(counter >> 8u);
        msg[off + 3] = uchar(counter);
        prng64_provider_sha512_store_u64_be_local(msg + off + 4, clock_now);
        hmac_sha256(prf_key, sizeof(prf_key), msg, size_t(off + 12), K);
        ++counter;
        clock_now += clock_step;
    }

    void reseed(thread const uchar* extra, int extra_len) {
        uchar accum[160];
        int acc_len = 0;
        if (extra_len > 0) {
            memcpy(accum, extra, size_t(extra_len));
            acc_len += extra_len;
        }
        hmac_prf(PRNG64_BOTAN_HMAC_RNG_LABEL_RNG, 3);
        memcpy(accum + acc_len, K, sizeof(K));
        acc_len += int(sizeof(K));
        hmac_prf(PRNG64_BOTAN_HMAC_RNG_LABEL_RESEED, 6);
        memcpy(accum + acc_len, K, sizeof(K));
        acc_len += int(sizeof(K));
        prng64_provider_hmac_sha512_64(extractor_key, sizeof(extractor_key), accum, size_t(acc_len), prf_key);
        hmac_prf(PRNG64_BOTAN_HMAC_RNG_LABEL_XTS, 3);
        memcpy(extractor_key, K, sizeof(extractor_key));
        memset(K, 0, sizeof(K));
        block_index = int(sizeof(K));
        counter = 0u;
        output_since_reseed = 0u;
    }

public:
    explicit BotanHmacRng64(ulong seed)
        : block_index(32), counter(0u), output_since_reseed(0u) {
        uchar init_label[18];
        uchar material[64];
        memset(prf_key, 0, sizeof(prf_key));
        memset(K, 0, sizeof(K));
        prng64_case53_60_copy_const(init_label, PRNG64_BOTAN_HMAC_RNG_INIT_LABEL, 18);
        hmac_sha256(prf_key, sizeof(prf_key), init_label, size_t(sizeof(init_label)), extractor_key);
        prng64_provider_fill_material(seed, 0x424f54414e484d52ul, 0x4e47534841353132ul, material, int(sizeof(material)));
        clock_now = prng64_mix_stafford13_provider(seed ^ 0x484d524e47434c4bul);
        clock_step = prng64_mix_murmur64_provider(seed ^ 0x484d525354455031ul) | 1ul;
        reseed(material, int(sizeof(material)));
    }

    ulong next() {
        if (block_index > 24) {
            if (output_since_reseed >= 512u) {
                reseed(K, 0);
            }
            hmac_prf(PRNG64_BOTAN_HMAC_RNG_LABEL_RNG, 3);
            block_index = 0;
            output_since_reseed += 32u;
        }
        const ulong out = prng64_provider_load_u64_be(K + block_index);
        block_index += 8;
        return out;
    }
};

// Botan HMAC_DRBG uses HMAC(SHA-256) with provider-specific state management.
class BotanHmacDrbg64 {
    HmacDrbgSha256Provider64Core core;
public:
    explicit BotanHmacDrbg64(ulong seed) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x424f54414e484d41ul, 0x435f445242475332ul, material, 32);
        prng64_case43_52_copy16(material + 32, PRNG64_PERS_BOTAN_HMAC_DRBG);
        core.init(material, int(sizeof(material)));
    }
    ulong next() { return core.next(); }
};

static inline void prng64_case53_60_chacha_init_material(thread uint state[16],
                                                         thread const uchar* material40) {
    state[0] = 0x61707865u;
    state[1] = 0x3320646eu;
    state[2] = 0x79622d32u;
    state[3] = 0x6b206574u;
    for (int i = 0; i < 8; ++i) {
        state[4 + i] = prng64_case53_60_load_u32_le(material40 + i * 4);
    }
    state[12] = 0u;
    state[13] = 0u;
    state[14] = prng64_case53_60_load_u32_le(material40 + 32);
    state[15] = prng64_case53_60_load_u32_le(material40 + 36);
}

// Botan ChaCha_RNG uses HMAC(SHA-256) to rekey a ChaCha20 byte stream and consumes
// the first 32 stream bytes as the next HMAC key.
class BotanChaChaRng64 {
    uchar hmac_key[32];
    uint state[16];
    uchar block[64];
    int block_index;

    void set_chacha_key(thread const uchar key[32]) {
        uchar material[40];
        memcpy(material, key, 32);
        memset(material + 32, 0, 8);
        prng64_case53_60_chacha_init_material(state, material);
        block_index = int(sizeof(block));
    }

    void refill() {
        uint words[16];
        prng64_chacha_block_generic(state, words, 20);
        ulong ctr = (ulong(state[13]) << 32u) | ulong(state[12]);
        ++ctr;
        state[12] = uint(ctr);
        state[13] = uint(ctr >> 32u);
        for (int i = 0; i < 16; ++i) {
            const uint w = words[i];
            block[i * 4 + 0] = uchar(w);
            block[i * 4 + 1] = uchar(w >> 8u);
            block[i * 4 + 2] = uchar(w >> 16u);
            block[i * 4 + 3] = uchar(w >> 24u);
        }
        block_index = 0;
    }

    void generate_bytes(thread uchar* out, int out_len) {
        int produced = 0;
        while (produced < out_len) {
            if (block_index >= int(sizeof(block))) {
                refill();
            }
            const int take = (int(sizeof(block)) - block_index < out_len - produced) ?
                (int(sizeof(block)) - block_index) : (out_len - produced);
            memcpy(out + produced, block + block_index, size_t(take));
            block_index += take;
            produced += take;
        }
    }

    void clear_state() {
        uchar empty[1];
        uchar chacha_key[32];
        empty[0] = 0u;
        memset(hmac_key, 0, sizeof(hmac_key));
        hmac_sha256(hmac_key, sizeof(hmac_key), empty, 0, chacha_key);
        set_chacha_key(chacha_key);
    }

    void update(thread const uchar* input, int input_len) {
        uchar chacha_key[32];
        uchar next_hmac_key[32];
        hmac_sha256(hmac_key, sizeof(hmac_key), input, size_t(input_len), chacha_key);
        set_chacha_key(chacha_key);
        generate_bytes(next_hmac_key, int(sizeof(next_hmac_key)));
        memcpy(hmac_key, next_hmac_key, sizeof(hmac_key));
    }

public:
    explicit BotanChaChaRng64(ulong seed) {
        uchar material[32];
        prng64_provider_fill_material(seed, 0x424f54414e434841ul, 0x524e473634534545ul, material, int(sizeof(material)));
        clear_state();
        update(material, int(sizeof(material)));
    }

    ulong next() {
        uchar out[8];
        generate_bytes(out, int(sizeof(out)));
        return prng64_provider_load_u64_be(out);
    }
};

// Bouncy Castle CTRSP800DRBG via SP800SecureRandomBuilder.
class BouncyCtrSP800Drbg64 {
    CtrDrbgAes256Provider64Core core;
