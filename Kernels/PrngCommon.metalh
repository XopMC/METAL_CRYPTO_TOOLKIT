class Prng32XorShift96 {
    uint a;
    uint b;
    uint c;
public:
    explicit Prng32XorShift96(uint seed) {
        a = seed;
        b = seed ^ 0x9e3779b9u;
        c = seed * 1664525u + 1013904223u;
    }

    uint next() {
        uint t = a;
        t ^= t << 3u;
        t ^= t >> 19u;
        t ^= t << 6u;
        a = b;
        b = c;
        c = t;
        return c;
    }
};

class Prng32XorShift256Plus {
    uint s[8];
    int p;
public:
    explicit Prng32XorShift256Plus(uint seed) : p(0) {
        for (int i = 0; i < 8; ++i) {
            seed = seed * 1664525u + 1013904223u;
            s[i] = seed;
        }
    }

    uint next() {
        uint ss0 = s[p];
        uint s1 = s[p = (p + 1) & 7];
        s1 ^= s1 << 15u;
        s1 ^= s1 >> 18u;
        ss0 ^= ss0 >> 11u;
        s[p] = ss0 ^ s1;
        return s[p] + s1;
    }
};

class Prng32XorShift1024Star {
    uint s[32];
    int p;
public:
    explicit Prng32XorShift1024Star(uint seed) : p(0) {
        for (int i = 0; i < 32; ++i) {
            seed = seed * 1664525u + 1013904223u;
            s[i] = seed;
        }
    }

    uint next() {
        uint ss0 = s[p];
        uint s1 = s[p = (p + 1) & 31];
        s1 ^= s1 << 31u;
        s1 ^= s1 >> 11u;
        ss0 ^= ss0 >> 30u;
        s[p] = ss0 ^ s1;
        return s[p] * 118178349u;
    }
};

class Prng32XorShift4096Star {
    uint s[128];
    int p;
public:
    explicit Prng32XorShift4096Star(uint seed) : p(0) {
        for (int i = 0; i < 128; ++i) {
            seed = seed * 1664525u + 1013904223u;
