    explicit JavaSecureRandomCtrDrbg64(ulong seed) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x4a41564143545244ul, 0x5242474145533235ul, material, 32);
        prng64_case43_52_copy16(material + 32, PRNG64_PERS_OPENJDK_CTR_DRBG);
        core.init(material, int(sizeof(material)), 0x4au);
    }
    ulong next() { return core.next(); }
};

// case 44
class JavaSecureRandomHmacDrbg64 {
    HmacDrbgSha256Provider64Core core;
public:
    explicit JavaSecureRandomHmacDrbg64(ulong seed) {
        uchar material[48];
        const ulong entropy0 = prng64_mix_stafford13_provider(seed ^ 0x4a415641484d4143ul);
        const ulong entropy1 = prng64_mix_murmur64_provider(seed ^ 0x4452424753454544ul);
        const ulong nonce0 = prng64_mix_stafford13_provider(seed + 0x6a09e667f3bcc909ul);
        const ulong nonce1 = prng64_mix_murmur64_provider(seed + 0xbb67ae8584caa73bul);
        prng64_store64_le(material + 0, entropy0);
        prng64_store64_le(material + 8, entropy1);
        prng64_store64_le(material + 16, nonce0);
        prng64_store64_le(material + 24, nonce1);
        prng64_case43_52_copy16(material + 32, PRNG64_PERS_OPENJDK_HMAC_DRBG);
        core.init(material, int(sizeof(material)));
    }
    ulong next() { return core.next(); }
};

