            q[j] = seed;
        }
    }
    uint next() {
        i = (i + 1) & 4095;
        const ulong t = 18782ul * ulong(q[i]) + ulong(c);
        c = uint(t >> 32u);
        const uint x = 0xfffffffeu - uint(t);
        q[i] = x;
        return x;
    }
};

