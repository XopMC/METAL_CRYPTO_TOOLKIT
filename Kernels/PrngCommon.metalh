class Prng64RustSmallRng {
    ulong s[4];
public:
    explicit Prng64RustSmallRng(ulong seed) {
        ulong z = seed;
        for (int i = 0; i < 4; ++i) {
            z += 0x9E3779B97F4A7C15ul;
            ulong t = z;
            t = (t ^ (t >> 30u)) * 0xBF58476D1CE4E5B9ul;
            t = (t ^ (t >> 27u)) * 0x94D049BB133111EBul;
            s[i] = t ^ (t >> 31u);
        }
    }
    ulong next() {
        const ulong result = prng64_rotl64(s[0] + s[3], 23) + s[0];
        const ulong t = s[1] << 17u;
        s[2] ^= s[0]; s[3] ^= s[1]; s[1] ^= s[2]; s[0] ^= s[3];
        s[2] ^= t;
        s[3] = prng64_rotl64(s[3], 45);
        return result;
    }
};

class Prng64V8XorShift128Plus {
    ulong s0;
    ulong s1;
public:
    explicit Prng64V8XorShift128Plus(ulong seed) {
        ulong x = seed ^ 0x56384d4154483634ul;
        x = prng64_mix_stafford13_provider(x);
        s0 = x;
        s1 = prng64_mix_murmur64_provider(x + 0x9e3779b97f4a7c15ul);
        if ((s0 | s1) == 0ul) s0 = 1ul;
    }
    ulong next() {
        ulong x = s0;
        const ulong y = s1;
        s0 = y;
        x ^= x << 23u;
        x ^= x >> 17u;
        x ^= y ^ (y >> 26u);
        s1 = x;
        return x + y;
    }
};

class Prng64SpiderMonkeyMathRandom {
    ulong state0;
    ulong state1;
    ulong next_u64() {
        ulong s1 = state0;
        const ulong s0 = state1;
        state0 = s0;
        s1 ^= s1 << 23u;
        s1 ^= s1 >> 17u;
        s1 ^= s0;
        s1 ^= s0 >> 26u;
        state1 = s1;
        return s0 + s1;
    }
    uint next_word() {
        const ulong mantissa = next_u64() & 0x001FFFFFFFFFFFFFul;
        return uint(mantissa >> 21u);
    }
public:
    explicit Prng64SpiderMonkeyMathRandom(ulong seed) {
        uchar material[16];
        prng64_provider_fill_material(seed, 0x5350494445524d4bul, 0x45594d4154483634ul, material, 16);
        state0 = prng64_provider_load_u64_be(material);
        state1 = prng64_provider_load_u64_be(material + 8);
        if ((state0 | state1) == 0ul) {
            state1 = 1ul;
        }
    }
    ulong next() {
        return (ulong(next_word()) << 32u) | ulong(next_word());
    }
};

static inline uint prng64_provider_sha1_rotl(uint x, uint r) {
    return (x << r) | (x >> (32u - r));
}

static inline void prng64_provider_sha1_compress(thread uint state[5], thread const uchar block[64]) {
    uint w[80];
    for (int i = 0; i < 16; ++i) {
        w[i] = prng64_provider_load_u32_be(block + i * 4);
    }
    for (int i = 16; i < 80; ++i) {
        w[i] = prng64_provider_sha1_rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1u);
    }

    uint a = state[0];
    uint b = state[1];
    uint c = state[2];
    uint d = state[3];
    uint e = state[4];

    for (int i = 0; i < 80; ++i) {
        uint f;
        uint k;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5a827999u;
        } else if (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ed9eba1u;
        } else if (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdcu;
        } else {
            f = b ^ c ^ d;
            k = 0xca62c1d6u;
        }
        const uint temp = prng64_provider_sha1_rotl(a, 5u) + f + e + k + w[i];
        e = d;
        d = c;
        c = prng64_provider_sha1_rotl(b, 30u);
        b = a;
        a = temp;
    }

    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
}

static inline void prng64_provider_sha1_hash(thread const uchar* msg, int len, thread uchar out[20]) {
    uint state[5] = {
        0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u, 0xc3d2e1f0u
    };
    const int full_blocks = len / 64;
    const int rem = len % 64;
    for (int i = 0; i < full_blocks; ++i) {
        prng64_provider_sha1_compress(state, msg + i * 64);
    }

    uchar block[64];
    for (int i = 0; i < 64; ++i) block[i] = 0u;
    for (int i = 0; i < rem; ++i) block[i] = msg[full_blocks * 64 + i];
    block[rem] = 0x80u;

    const ulong bit_len = ulong(uint(len)) * 8ul;
    if (rem >= 56) {
        prng64_provider_sha1_compress(state, block);
        for (int i = 0; i < 64; ++i) block[i] = 0u;
    }
    for (int i = 0; i < 8; ++i) {
        block[56 + i] = uchar(bit_len >> uint(56 - i * 8));
    }
    prng64_provider_sha1_compress(state, block);

    for (int i = 0; i < 5; ++i) {
        out[i * 4 + 0] = uchar(state[i] >> 24u);
        out[i * 4 + 1] = uchar(state[i] >> 16u);
        out[i * 4 + 2] = uchar(state[i] >> 8u);
        out[i * 4 + 3] = uchar(state[i]);
    }
}

class Prng64Xoshiro256StarStar {
    ulong s[4];
public:
    explicit Prng64Xoshiro256StarStar(ulong seed) {
        ulong sm = seed;
        for (int i = 0; i < 4; ++i) s[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong result = prng64_rotl64(s[1] * 5ul, 7) * 9ul;
        const ulong t = s[1] << 17u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = prng64_rotl64(s[3], 45);
        return result;
    }
};

class Prng64Xoshiro256PlusPlus {
    ulong s[4];
public:
    explicit Prng64Xoshiro256PlusPlus(ulong seed) {
        ulong sm = seed;
        for (int i = 0; i < 4; ++i) s[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong result = prng64_rotl64(s[0] + s[3], 23) + s[0];
        const ulong t = s[1] << 17u;
        s[2] ^= s[0];
        s[3] ^= s[1];
        s[1] ^= s[2];
        s[0] ^= s[3];
        s[2] ^= t;
        s[3] = prng64_rotl64(s[3], 45);
        return result;
    }
};

class Prng64SFC64 {
    ulong a;
    ulong b;
    ulong c;
    uint d;
public:
    explicit Prng64SFC64(ulong seed) {
        ulong sm = seed;
        a = prng64_splitmix64_next(sm);
        b = prng64_splitmix64_next(sm);
        c = prng64_splitmix64_next(sm);
        d = 1u;
    }
    ulong next() {
        const ulong res = a + b + ulong(d++);
        a = b ^ (b >> 11u);
        b = c + (c << 3u);
        c = prng64_rotl64(c, 24) + res;
        return res;
    }
};

class Prng64Philox4x64_10 {
    ulong ctr;
    ulong key;
public:
    explicit Prng64Philox4x64_10(ulong seed) : ctr(0ul), key(seed) {}
    ulong next() {
        const ulong hi = prng64_mul64_hi(ctr, 0x0d2e7470ul);
        const ulong lo = ctr * 0xca5a826bul;
        ++ctr;
        return hi ^ key ^ lo;
    }
};

class Prng64MRG32k3a {
    ulong s10, s11, s12, s20, s21, s22;
public:
    explicit Prng64MRG32k3a(ulong seed) {
        ulong sm = seed;
        s10 = prng64_splitmix64_next(sm) % 4294967087ul;
        s11 = prng64_splitmix64_next(sm) % 4294967087ul;
        s12 = prng64_splitmix64_next(sm) % 4294967087ul;
        s20 = prng64_splitmix64_next(sm) % 4294944443ul;
        s21 = prng64_splitmix64_next(sm) % 4294944443ul;
        s22 = prng64_splitmix64_next(sm) % 4294944443ul;
    }
    ulong next() {
        const ulong p1 = (1403580ul * s11 + 810728ul * s10) % 4294967087ul;
        s10 = s11; s11 = s12; s12 = p1;
        const ulong p2 = (527612ul * s22 + 1370589ul * s20) % 4294944443ul;
        s20 = s21; s21 = s22; s22 = p2;
        return (p1 >= p2) ? (p1 - p2) : (p1 + 4294967087ul - p2);
    }
};

class Prng64SuperDuper {
    ulong cong;
    ulong shr;
public:
    explicit Prng64SuperDuper(ulong seed) : cong(seed ^ 0x0a5366b4d1234567ul), shr(seed ? seed : 1ul) {}
    ulong next() {
        cong = 6906969069ul * cong + 1234567ul;
        shr ^= shr << 13u;
        shr ^= shr >> 7u;
        shr ^= shr << 17u;
        return cong + shr;
    }
};

class Prng64WichmannHill1982 {
    uint x;
    uint y;
    uint z;
    uint next32() {
        x = (171u * x) % 30269u;
        y = (172u * y) % 30307u;
        z = (170u * z) % 30323u;
        ulong r = (ulong(x) * 4294967296ul) / 30269ul;
        r += (ulong(y) * 4294967296ul) / 30307ul;
        r += (ulong(z) * 4294967296ul) / 30323ul;
        return uint(r);
    }
public:
    explicit Prng64WichmannHill1982(ulong seed) {
        const uint s = uint(seed);
        x = (s % 30268u) + 1u;
        y = ((s / 30268u) % 30306u) + 1u;
        z = ((s / 917u) % 30322u) + 1u;
    }
    ulong next() {
        const ulong hi = ulong(next32());
        const ulong lo = ulong(next32());
        return (hi << 32u) | lo;
    }
};

struct Prng64ProviderUint128 {
    ulong hi;
    ulong lo;
};

static inline Prng64ProviderUint128 prng64_provider128_make(ulong hi, ulong lo) {
    Prng64ProviderUint128 out = { hi, lo };
    return out;
}

static inline Prng64ProviderUint128 prng64_provider128_add(Prng64ProviderUint128 a, Prng64ProviderUint128 b) {
    Prng64ProviderUint128 out;
    out.lo = a.lo + b.lo;
    out.hi = a.hi + b.hi + ((out.lo < a.lo) ? 1ul : 0ul);
    return out;
}

static inline Prng64ProviderUint128 prng64_provider128_mul(Prng64ProviderUint128 a, Prng64ProviderUint128 b) {
    Prng64ProviderUint128 out;
    const ulong x0 = a.lo & 0xfffffffful;
    const ulong x1 = a.lo >> 32u;
    const ulong y0 = b.lo & 0xfffffffful;
    const ulong y1 = b.lo >> 32u;
    const ulong t = x1 * y0 + ((x0 * y0) >> 32u);
    const ulong z0 = (t & 0xfffffffful) + x0 * y1;
    out.hi = a.hi * b.lo + a.lo * b.hi;
    out.lo = a.lo * b.lo;
    out.hi += x1 * y1 + (t >> 32u) + (z0 >> 32u);
    return out;
}

static inline Prng64ProviderUint128 prng64_provider128_lshift1_or1(Prng64ProviderUint128 a) {
    Prng64ProviderUint128 out;
    out.hi = (a.hi << 1u) | (a.lo >> 63u);
    out.lo = (a.lo << 1u) | 1ul;
    return out;
}

static inline ulong prng64_provider_pcg_xsl_rr_output(Prng64ProviderUint128 state) {
    const ulong value = state.hi ^ state.lo;
    const ulong rot = state.hi >> 58u;
    return (value >> uint(rot)) | (value << uint((0ul - rot) & 63ul));
}

static inline Prng64ProviderUint128 prng64_provider_pcg128_step_setseq(Prng64ProviderUint128 state, Prng64ProviderUint128 inc) {
    const Prng64ProviderUint128 mult = prng64_provider128_make(2549297995355413924ul, 4865540595714422341ul);
    return prng64_provider128_add(prng64_provider128_mul(state, mult), inc);
}

static inline Prng64ProviderUint128 prng64_provider_pcg128_step_oneseq(Prng64ProviderUint128 state) {
    const Prng64ProviderUint128 mult = prng64_provider128_make(2549297995355413924ul, 4865540595714422341ul);
    const Prng64ProviderUint128 inc = prng64_provider128_make(6364136223846793005ul, 1442695040888963407ul);
    return prng64_provider128_add(prng64_provider128_mul(state, mult), inc);
}

class Prng64WebKitWeakRandom {
    uint seed_word;
    ulong low;
    ulong high;
    static ulong next_state(ulong x, ulong y) {
        x ^= x << 23u;
        x ^= x >> 17u;
        x ^= y ^ (y >> 26u);
        return x;
    }
    ulong advance() {
        const ulong x = low;
        const ulong y = high;
        low = y;
        high = next_state(x, y);
        return high + low;
    }
public:
    explicit Prng64WebKitWeakRandom(ulong seed) {
        seed_word = uint(prng64_mix_stafford13_provider(seed ^ 0x5745424b4954524eul));
        if (seed_word == 0u) seed_word = 1u;
        low = seed_word;
        high = seed_word;
        (void)advance();
    }
    ulong next() {
        return advance();
    }
};

class Prng64ChakraMathRandom {
    ulong seed0;
    ulong seed1;
    ulong next_mantissa52() {
        ulong s1 = seed0;
        const ulong s0 = seed1;
        seed0 = s0;
        s1 ^= s1 << 23u;
        s1 ^= s1 >> 17u;
        s1 ^= s0;
        s1 ^= s0 >> 26u;
        seed1 = s1;
        return (seed0 + seed1) & 0x000ffffffffffffful;
    }
    uint next_word() {
        return uint(next_mantissa52() >> 20u);
    }
public:
    explicit Prng64ChakraMathRandom(ulong seed) {
        uchar material[16];
        prng64_provider_fill_material(seed, 0x4348414b52414d54ul, 0x4852414e444f4d36ul, material, 16);
        seed0 = prng64_provider_load_u64_be(material);
        seed1 = prng64_provider_load_u64_be(material + 8);
        if ((seed0 | seed1) == 0ul) seed1 = 1ul;
    }
    ulong next() {
        return (ulong(next_word()) << 32u) | ulong(next_word());
    }
};

class Prng64NumPyRandomState {
    Prng64Mt19937ProviderCore core;
public:
    explicit Prng64NumPyRandomState(ulong seed) : core(seed ^ 0x4e505952414e4436ul) {}
    ulong next() {
        const ulong lo = ulong(core.next32());
        const ulong hi = ulong(core.next32());
        return (hi << 32u) | lo;
    }
};

class Prng64NumPyPCG64 {
    Prng64ProviderUint128 state;
    Prng64ProviderUint128 inc;
public:
    explicit Prng64NumPyPCG64(ulong seed) {
        const ulong z = seed ^ 0x4e554d5059434736ul;
        const Prng64ProviderUint128 initstate = prng64_provider128_make(
            prng64_mix_stafford13_provider(z),
            prng64_mix_murmur64_provider(z + 0x9e3779b97f4a7c15ul));
        const Prng64ProviderUint128 initseq = prng64_provider128_make(
            prng64_mix_stafford13_provider(z + 0x243f6a8885a308d3ul),
            prng64_mix_murmur64_provider(z + 0xb7e151628aed2a6bul));
        state = prng64_provider128_make(0ul, 0ul);
        inc = prng64_provider128_lshift1_or1(initseq);
        state = prng64_provider_pcg128_step_setseq(state, inc);
        state = prng64_provider128_add(state, initstate);
        state = prng64_provider_pcg128_step_setseq(state, inc);
    }
    ulong next() {
        state = prng64_provider_pcg128_step_setseq(state, inc);
        return prng64_provider_pcg_xsl_rr_output(state);
    }
};

class Prng64NumPyPCG64_DXSM {
    ulong state_lo;
    ulong state_hi;
    void mul128(ulong a_lo, ulong a_hi, ulong b_lo, ulong b_hi, thread ulong& r_lo, thread ulong& r_hi) {
        r_lo = a_lo * b_lo;
        r_hi = prng64_mul64_hi(a_lo, b_lo) + a_lo * b_hi + a_hi * b_lo;
    }
    void add128(thread ulong& lo, thread ulong& hi, ulong b_lo, ulong b_hi) {
        const ulong old = lo;
        lo += b_lo;
        hi += b_hi + ((lo < old) ? 1ul : 0ul);
    }
public:
    explicit Prng64NumPyPCG64_DXSM(ulong seed) {
        state_lo = seed;
        state_hi = seed * 0x2d99787926d46932ul;
    }
    ulong next() {
        const ulong old_lo = state_lo;
        const ulong old_hi = state_hi;
        ulong r_lo;
        ulong r_hi;
        mul128(old_lo, old_hi, 0x4385df649fccf645ul, 0x2360ed051fc65da4ul, r_lo, r_hi);
        add128(r_lo, r_hi, 1ul, 0ul);
        state_lo = r_lo;
        state_hi = r_hi;
        ulong hi = old_hi;
        const ulong lo = old_lo | 1ul;
        hi ^= hi >> 32u;
        hi *= 0xda942042e4dd58b5ul;
        hi ^= hi >> 48u;
        hi *= lo;
        return hi;
    }
};

