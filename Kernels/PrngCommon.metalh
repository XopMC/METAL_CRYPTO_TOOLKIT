        uchar material[48];
        prng64_provider_fill_material(seed, 0x424f554e43594354ul, 0x5250383030393041ul, material, 32);
        prng64_case43_52_copy16(material + 32, PRNG64_PERS_BOUNCY_CTR_DRBG);
        core.init(material, int(sizeof(material)), 0x42u);
    }
    ulong next() { return core.next(); }
};

// Device helper: prng64_provider_be_add_right_aligned.
static inline void prng64_provider_be_add_right_aligned(thread uchar* dst, int dst_len, thread const uchar* src, int src_len) {
    uint carry = 0u;
    int i = 0;
    for (; i < src_len && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const int si = src_len - 1 - i;
        const uint sum = (uint)dst[di] + (uint)src[si] + carry;
        dst[di] = (uchar)sum;
        carry = sum >> 8;
    }
    for (; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = (uint)dst[di] + carry;
        dst[di] = (uchar)sum;
        carry = sum >> 8;
    }
}

// Device helper: prng64_provider_be_add_u64.
static inline void prng64_provider_be_add_u64(thread uchar* dst, int dst_len, ulong value) {
    uint carry = 0u;
    for (int i = 0; i < 8 && i < dst_len; ++i) {
        const int di = dst_len - 1 - i;
        const uint add = (uint)((value >> (i * 8)) & 0xffu);
        const uint sum = (uint)dst[di] + add + carry;
        dst[di] = (uchar)sum;
        carry = sum >> 8;
    }
    for (int i = 8; i < dst_len && carry != 0u; ++i) {
        const int di = dst_len - 1 - i;
        const uint sum = (uint)dst[di] + carry;
        dst[di] = (uchar)sum;
        carry = sum >> 8;
    }
}

// Device helper: prng64_provider_hash_df_sha256.
static inline void prng64_provider_hash_df_sha256(thread const uchar* input, int input_len, thread uchar* out, int out_len) {
    uchar msg[128];
    uchar digest[32];
    const uint bits = (uint)(out_len * 8);
    int produced = 0;
    uchar counter = 1u;
    while (produced < out_len) {
        msg[0] = counter++;
        msg[1] = (uchar)(bits >> 24);
        msg[2] = (uchar)(bits >> 16);
        msg[3] = (uchar)(bits >> 8);
        msg[4] = (uchar)(bits);
        memcpy(msg + 5, input, input_len);
        SHA256(msg, (ulong)(input_len + 5), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, (ulong)take);
        produced += take;
    }
}

// Device helper: prng64_provider_hashgen_sha256.
static inline void prng64_provider_hashgen_sha256(thread const uchar* value, int value_len, thread uchar* out, int out_len) {
    uchar data[64];
    uchar digest[32];
    memcpy(data, value, (ulong)value_len);
    int produced = 0;
    while (produced < out_len) {
        SHA256(data, (ulong)value_len, digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, (ulong)take);
        produced += take;
        prng64_provider_be_add_u64(data, value_len, 1ul);
    }
}

// Device helper: prng64_provider_sha256_counter_kdf.
static inline void prng64_provider_sha256_counter_kdf(thread const uchar* material, int material_len, uchar domain, thread uchar* out, int out_len) {
    uchar msg[128];
    uchar digest[32];
    memcpy(msg, material, (ulong)material_len);
    int produced = 0;
    uchar counter = 0u;
    while (produced < out_len) {
        msg[material_len] = domain;
        msg[material_len + 1] = counter++;
        SHA256(msg, (ulong)(material_len + 2), digest);
        const int take = (out_len - produced < 32) ? (out_len - produced) : 32;
        memcpy(out + produced, digest, (ulong)take);
        produced += take;
    }
}

// Source-backed Hash_DRBG wrapper core over SHA-256 for OpenJDK/Bouncy provider models.
class Prng64HashDrbgSha256ProviderCore {
    static constant int kSeedLen = 55;
    uchar value[kSeedLen];
    uchar constant_c[kSeedLen];
    uchar block[32];
    ulong reseed_counter;
    int block_index;
// Device helper: post_generate_update.
    void post_generate_update() {
        uchar msg[kSeedLen + 1];
        uchar h[32];
        msg[0] = 0x03;
        memcpy(msg + 1, value, kSeedLen);
        SHA256(msg, sizeof(msg), h);
        prng64_provider_be_add_right_aligned(value, kSeedLen, h, 32);
        prng64_provider_be_add_right_aligned(value, kSeedLen, constant_c, kSeedLen);
        prng64_provider_be_add_u64(value, kSeedLen, reseed_counter);
        ++reseed_counter;
    }
// Device helper: refill.
    void refill() {
        prng64_provider_hashgen_sha256(value, kSeedLen, block, (int)sizeof(block));
        post_generate_update();
        block_index = 0;
    }
public:
// Device helper: init.
    void init(thread const uchar* material, int material_len) {
        uchar tmp[kSeedLen + 1];
        prng64_provider_hash_df_sha256(material, material_len, value, kSeedLen);
        tmp[0] = 0x00;
        memcpy(tmp + 1, value, kSeedLen);
        prng64_provider_hash_df_sha256(tmp, (int)sizeof(tmp), constant_c, kSeedLen);
        memset(block, 0, sizeof(block));
        reseed_counter = 1ul;
        block_index = (int)sizeof(block);
    }
// Device helper: next.
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// Device helper: prng64_provider_aes_rotword.
static inline uint prng64_provider_aes_rotword(uint w) {
    return (w << 8) | (w >> 24);
}

// Device helper: prng64_provider_aes_subword.
static inline uint prng64_provider_aes_subword(uint w) {
    return ((uint)kProviderAesSbox[(w >> 24) & 0xff] << 24) |
        ((uint)kProviderAesSbox[(w >> 16) & 0xff] << 16) |
        ((uint)kProviderAesSbox[(w >> 8) & 0xff] << 8) |
        ((uint)kProviderAesSbox[w & 0xff]);
}

// Device helper: prng64_provider_aes_xtime.
static inline uchar prng64_provider_aes_xtime(uchar x) {
    return (uchar)((x << 1) ^ ((x & 0x80u) ? 0x1bu : 0x00u));
}

// Device helper: prng64_provider_aes_expand_key.
static inline void prng64_provider_aes_expand_key(thread const uchar key[32], thread uint round_keys[60]) {
    for (int i = 0; i < 8; ++i) {
        round_keys[i] =
            ((uint)key[i * 4] << 24) |
            ((uint)key[i * 4 + 1] << 16) |
            ((uint)key[i * 4 + 2] << 8) |
            ((uint)key[i * 4 + 3]);
    }
    for (int i = 8; i < 60; ++i) {
        uint temp = round_keys[i - 1];
        if ((i & 7) == 0) {
            temp = prng64_provider_aes_subword(prng64_provider_aes_rotword(temp)) ^
                ((uint)kProviderAesRcon[(i / 8) - 1] << 24);
        }
        else if ((i & 7) == 4) {
            temp = prng64_provider_aes_subword(temp);
        }
        round_keys[i] = round_keys[i - 8] ^ temp;
    }
}

// Device helper: prng64_provider_aes_expand_key128.
static inline void prng64_provider_aes_expand_key128(thread const uchar key[16], thread uint round_keys[44]) {
    for (int i = 0; i < 4; ++i) {
        round_keys[i] =
            ((uint)key[i * 4] << 24) |
            ((uint)key[i * 4 + 1] << 16) |
            ((uint)key[i * 4 + 2] << 8) |
            ((uint)key[i * 4 + 3]);
    }
    for (int i = 4; i < 44; ++i) {
        uint temp = round_keys[i - 1];
        if ((i & 3) == 0) {
            temp = prng64_provider_aes_subword(prng64_provider_aes_rotword(temp)) ^
                ((uint)kProviderAesRcon[(i / 4) - 1] << 24);
        }
        round_keys[i] = round_keys[i - 4] ^ temp;
    }
}

// Device helper: prng64_provider_aes_add_round_key.
static inline void prng64_provider_aes_add_round_key(thread uchar state[16], thread const uint round_keys[60], int round) {
    for (int col = 0; col < 4; ++col) {
        const uint rk = round_keys[round * 4 + col];
        state[col * 4 + 0] ^= (uchar)(rk >> 24);
        state[col * 4 + 1] ^= (uchar)(rk >> 16);
        state[col * 4 + 2] ^= (uchar)(rk >> 8);
        state[col * 4 + 3] ^= (uchar)(rk);
    }
}

// Device helper: prng64_provider_aes_sub_bytes.
static inline void prng64_provider_aes_sub_bytes(thread uchar state[16]) {
    for (int i = 0; i < 16; ++i) {
        state[i] = kProviderAesSbox[state[i]];
    }
}

// Device helper: prng64_provider_aes_shift_rows.
static inline void prng64_provider_aes_shift_rows(thread uchar state[16]) {
    uchar t[16];
    t[0] = state[0];   t[4] = state[4];   t[8] = state[8];    t[12] = state[12];
    t[1] = state[5];   t[5] = state[9];   t[9] = state[13];   t[13] = state[1];
    t[2] = state[10];  t[6] = state[14];  t[10] = state[2];   t[14] = state[6];
    t[3] = state[15];  t[7] = state[3];   t[11] = state[7];   t[15] = state[11];
    memcpy(state, t, sizeof(t));
}

// Device helper: prng64_provider_aes_mix_columns.
static inline void prng64_provider_aes_mix_columns(thread uchar state[16]) {
    for (int col = 0; col < 4; ++col) {
        const int i = col * 4;
        const uchar a0 = state[i + 0];
        const uchar a1 = state[i + 1];
        const uchar a2 = state[i + 2];
        const uchar a3 = state[i + 3];
        const uchar m0 = prng64_provider_aes_xtime(a0);
        const uchar m1 = prng64_provider_aes_xtime(a1);
        const uchar m2 = prng64_provider_aes_xtime(a2);
        const uchar m3 = prng64_provider_aes_xtime(a3);
        state[i + 0] = (uchar)(m0 ^ (m1 ^ a1) ^ a2 ^ a3);
        state[i + 1] = (uchar)(a0 ^ m1 ^ (m2 ^ a2) ^ a3);
        state[i + 2] = (uchar)(a0 ^ a1 ^ m2 ^ (m3 ^ a3));
        state[i + 3] = (uchar)((m0 ^ a0) ^ a1 ^ a2 ^ m3);
    }
}

// Device helper: prng64_provider_aes_encrypt_block.
static inline void prng64_provider_aes_encrypt_block(thread const uint round_keys[60], thread const uchar in[16], thread uchar out[16]) {
    uchar state[16];
    memcpy(state, in, sizeof(state));
    prng64_provider_aes_add_round_key(state, round_keys, 0);
    for (int round = 1; round < 14; ++round) {
        prng64_provider_aes_sub_bytes(state);
        prng64_provider_aes_shift_rows(state);
        prng64_provider_aes_mix_columns(state);
        prng64_provider_aes_add_round_key(state, round_keys, round);
    }
    prng64_provider_aes_sub_bytes(state);
    prng64_provider_aes_shift_rows(state);
    prng64_provider_aes_add_round_key(state, round_keys, 14);
    memcpy(out, state, sizeof(state));
}

// Device helper: prng64_provider_aes_encrypt_block128.
static inline void prng64_provider_aes_encrypt_block128(thread const uint round_keys[44], thread const uchar in[16], thread uchar out[16]) {
    uchar state[16];
    memcpy(state, in, sizeof(state));
    prng64_provider_aes_add_round_key(state, round_keys, 0);
    for (int round = 1; round < 10; ++round) {
        prng64_provider_aes_sub_bytes(state);
        prng64_provider_aes_shift_rows(state);
        prng64_provider_aes_mix_columns(state);
        prng64_provider_aes_add_round_key(state, round_keys, round);
    }
    prng64_provider_aes_sub_bytes(state);
    prng64_provider_aes_shift_rows(state);
    prng64_provider_aes_add_round_key(state, round_keys, 10);
    memcpy(out, state, sizeof(state));
}

// Device helper: prng64_provider_store_u32_be.
static inline void prng64_provider_store_u32_be(thread uchar* out, uint x) {
    out[0] = (uchar)(x >> 24);
    out[1] = (uchar)(x >> 16);
    out[2] = (uchar)(x >> 8);
    out[3] = (uchar)x;
}

// Device helper: prng64_provider_sha256_words_be.
static inline void prng64_provider_sha256_words_be(thread const uint* words, int word_count, thread uchar out[32]) {
    uchar msg[256];
    for (int i = 0; i < word_count; ++i) {
        prng64_provider_store_u32_be(msg + i * 4, words[i]);
    }
    SHA256(msg, (ulong)(word_count * 4), out);
}

// Device helper: prng64_provider_aes_expand_key_words64.
static inline void prng64_provider_aes_expand_key_words64(thread const uint words[8], thread uint round_keys[60]) {
    uchar key[32];
    for (int i = 0; i < 8; ++i) {
        prng64_provider_store_u32_be(key + i * 4, words[i]);
    }
    prng64_provider_aes_expand_key(key, round_keys);
}

// Device helper: prng64_provider_aes_encrypt_words64.
static inline void prng64_provider_aes_encrypt_words64(thread const uint round_keys[60], thread const uint in_words[4], thread uint out_words[4]) {
    uchar in[16];
    uchar out[16];
    for (int i = 0; i < 4; ++i) {
        prng64_provider_store_u32_be(in + i * 4, in_words[i]);
    }
    prng64_provider_aes_encrypt_block(round_keys, in, out);
    for (int i = 0; i < 4; ++i) {
        out_words[i] = prng64_provider_load_u32_be(out + i * 4);
    }
}

// Source-backed CTR_DRBG wrapper core over AES-256 for OpenJDK/Bouncy/Mbed TLS provider models.
class Prng64CtrDrbgAes256ProviderCore {
    uchar key[32];
    uchar value[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
// Device helper: expand_key.
    void expand_key() {
        prng64_provider_aes_expand_key(key, round_keys);
    }
// Device helper: increment_value.
    void increment_value() {
        for (int i = 15; i >= 0; --i) {
            value[i] = (uchar)(value[i] + 1u);
            if (value[i] != 0u) {
                break;
            }
        }
    }
// Device helper: update.
    void update(thread const uchar* provided_data) {
        uchar temp[48];
        for (int i = 0; i < 3; ++i) {
            increment_value();
            prng64_provider_aes_encrypt_block(round_keys, value, temp + i * 16);
        }
        if (provided_data != nullptr) {
            for (int i = 0; i < 48; ++i) {
                temp[i] ^= provided_data[i];
            }
        }
        memcpy(key, temp, 32);
        memcpy(value, temp + 32, 16);
        expand_key();
    }
// Device helper: refill.
    void refill() {
        increment_value();
        prng64_provider_aes_encrypt_block(round_keys, value, block + 0);
        increment_value();
        prng64_provider_aes_encrypt_block(round_keys, value, block + 16);
        update(nullptr);
        block_index = 0;
    }
public:
// Device helper: init.
    void init(thread const uchar* material, int material_len, uchar domain_tag) {
        uchar seed[48];
        memset(key, 0, sizeof(key));
        memset(value, 0, sizeof(value));
        memset(block, 0, sizeof(block));
        expand_key();
        prng64_provider_sha256_counter_kdf(material, material_len, domain_tag, seed, (int)sizeof(seed));
        update(seed);
        block_index = (int)sizeof(block);
    }
// Device helper: next.
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

class Prng64HmacDrbgSha256ProviderCore {
    uchar key[32];
    uchar value[32];
    uchar block[32];
    int block_index;
// Device helper: update.
    void update(thread const uchar* provided, int provided_len) {
        uchar msg[96];
        uchar out[32];
        memcpy(msg, value, 32);
        msg[32] = 0x00;
        if (provided_len > 0) {
            memcpy(msg + 33, provided, provided_len);
        }
        hmac_sha256(key, 32, msg, (ulong)(33 + provided_len), out);
        memcpy(key, out, 32);
        hmac_sha256(key, 32, value, 32, out);
        memcpy(value, out, 32);
        if (provided_len > 0) {
            memcpy(msg, value, 32);
            msg[32] = 0x01;
            memcpy(msg + 33, provided, provided_len);
            hmac_sha256(key, 32, msg, (ulong)(33 + provided_len), out);
            memcpy(key, out, 32);
            hmac_sha256(key, 32, value, 32, out);
            memcpy(value, out, 32);
        }
    }
// Device helper: refill.
    void refill() {
        hmac_sha256(key, 32, value, 32, block);
        memcpy(value, block, 32);
        update(nullptr, 0);
        block_index = 0;
    }
public:
// Device helper: init.
    void init(thread const uchar* material, int material_len) {
        memset(key, 0, sizeof(key));
        memset(value, 0x01, sizeof(value));
        memset(block, 0, sizeof(block));
        block_index = 32;
        update(material, material_len);
    }
// Device helper: next.
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// Bouncy Castle X931SecureRandom on AESEngine uses a fixed DT vector and entropy-source-backed V updates.
class Prng64BouncyX931SecureRandom {
    uchar dt[16];
    uchar v[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;
// Device helper: refill.
    void refill() {
        uchar i[16];
        uchar tmp[16];
        prng64_provider_aes_encrypt_block(round_keys, dt, i);
        for (int n = 0; n < 16; ++n) {
            tmp[n] = (uchar)(i[n] ^ v[n]);
        }
        prng64_provider_aes_encrypt_block(round_keys, tmp, block);
        for (int n = 0; n < 16; ++n) {
            tmp[n] = (uchar)(block[n] ^ i[n]);
        }
        prng64_provider_aes_encrypt_block(round_keys, tmp, v);
        for (int n = 15; n >= 0; --n) {
            dt[n] = (uchar)(dt[n] + 1u);
            if (dt[n] != 0u) {
                break;
            }
        }
        block_index = 0;
    }
public:
    explicit Prng64BouncyX931SecureRandom(ulong seed) : block_index(16) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x424f554e43595839ul, 0x333153525f414553ul, material, (int)sizeof(material));
        memset(dt, 0, sizeof(dt));
        const ulong millis = prng64_mix_stafford13_provider(seed ^ 0x4258435552524d53ul);
        prng64_store64_be(dt, millis);
        memcpy(v, material + 32, 16);
        prng64_provider_aes_expand_key(material, round_keys);
    }
    ulong next() {
        if (block_index > 8) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

// Bouncy Castle HashSP800DRBG via SP800SecureRandomBuilder.
class Prng64BouncyHashSP800Drbg {
    Prng64HashDrbgSha256ProviderCore core;
public:
    explicit Prng64BouncyHashSP800Drbg(ulong seed) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x424f554e43594841ul, 0x5348503830303930ul, material, 32);
        const char kPersonalization[16] = "BouncyHashDRBG";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material));
    }
    ulong next() {
        return core.next();
    }
};

// Bouncy Castle HMacSP800DRBG via SP800SecureRandomBuilder.
class Prng64BouncyHmacSP800Drbg {
    Prng64HmacDrbgSha256ProviderCore core;
public:
    explicit Prng64BouncyHmacSP800Drbg(ulong seed) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x424f554e4359484dul, 0x4143503830303930ul, material, 32);
        const char kPersonalization[16] = "BouncyHMacDRBG";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material));
    }
    ulong next() {
        return core.next();
    }
};

// Bouncy Castle C# SecureRandom() defaults to SHA-256 DigestRandomGenerator with auto-seed.
class Prng64BouncyDigestRandomSha256 {
    uchar state[32];
    uchar seed_bytes[32];
    uchar block[32];
    ulong state_counter;
    ulong seed_counter;
    int block_index;
// Device helper: digest_counter_le_then_buffers.
    void digest_counter_le_then_buffers(ulong counter, thread const uchar* a, int a_len, thread const uchar* b, int b_len, thread uchar out[32]) {
        uchar msg[128];
        int off = 0;
        for (int i = 0; i < 8; ++i) {
            msg[off++] = (uchar)(counter >> (i * 8));
        }
        if (a_len > 0) {
            memcpy(msg + off, a, (ulong)a_len);
            off += a_len;
        }
        if (b_len > 0) {
            memcpy(msg + off, b, (ulong)b_len);
            off += b_len;
        }
        SHA256(msg, (ulong)off, out);
    }
// Device helper: digest_buffers_then_counter.
    void digest_buffers_then_counter(thread const uchar* a, int a_len, ulong counter, thread uchar out[32]) {
        uchar msg[128];
        int off = 0;
        if (a_len > 0) {
            memcpy(msg + off, a, (ulong)a_len);
            off += a_len;
        }
        for (int i = 0; i < 8; ++i) {
            msg[off++] = (uchar)(counter >> (i * 8));
        }
        SHA256(msg, (ulong)off, out);
    }
// Device helper: add_seed_material_bytes.
    void add_seed_material_bytes(thread const uchar* material, int material_len) {
        uchar msg[128];
        memcpy(msg, material, (ulong)material_len);
        memcpy(msg + material_len, seed_bytes, sizeof(seed_bytes));
        SHA256(msg, (ulong)(material_len + (int)sizeof(seed_bytes)), seed_bytes);
    }
// Device helper: add_seed_material_u64.
    void add_seed_material_u64(ulong value) {
        digest_counter_le_then_buffers(value, seed_bytes, (int)sizeof(seed_bytes), nullptr, 0, seed_bytes);
    }
// Device helper: cycle_seed.
    void cycle_seed() {
        digest_buffers_then_counter(seed_bytes, (int)sizeof(seed_bytes), seed_counter++, seed_bytes);
    }
// Device helper: refill.
    void refill() {
        digest_counter_le_then_buffers(state_counter++, state, (int)sizeof(state), seed_bytes, (int)sizeof(seed_bytes), state);
        if ((state_counter % 10ul) == 0ul) {
            cycle_seed();
        }
        memcpy(block, state, sizeof(block));
        block_index = 0;
    }
public:
    explicit Prng64BouncyDigestRandomSha256(ulong seed) : state_counter(1ul), seed_counter(1ul), block_index((int)sizeof(block)) {
        memset(state, 0, sizeof(state));
        memset(seed_bytes, 0, sizeof(seed_bytes));
        memset(block, 0, sizeof(block));
        add_seed_material_u64(seed ^ 0x42435352414e4436ul);
        uchar material[64];
        prng64_provider_fill_material(seed, 0x424f554e43594449ul, 0x4745535453484132ul, material, (int)sizeof(material));
        add_seed_material_bytes(material, (int)sizeof(material));
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// Bouncy Castle C# ArbitraryRandom uses SecureRandom(new VmpcRandomGenerator(), 16).
class Prng64BouncyVmpcRandom {
    uchar P[256];
    uchar s;
    uchar n;
    uchar block[32];
    int block_index;
// Device helper: init_state.
    void init_state() {
        const uchar kInitP[256] = {
            0xbb,0x2c,0x62,0x7f,0xb5,0xaa,0xd4,0x0d,0x81,0xfe,0xb2,0x82,0xcb,0xa0,0xa1,0x08,
            0x18,0x71,0x56,0xe8,0x49,0x02,0x10,0xc4,0xde,0x35,0xa5,0xec,0x80,0x12,0xb8,0x69,
            0xda,0x2f,0x75,0xcc,0xa2,0x09,0x36,0x03,0x61,0x2d,0xfd,0xe0,0xdd,0x05,0x43,0x90,
            0xad,0xc8,0xe1,0xaf,0x57,0x9b,0x4c,0xd8,0x51,0xae,0x50,0x85,0x3c,0x0a,0xe4,0xf3,
            0x9c,0x26,0x23,0x53,0xc9,0x83,0x97,0x46,0xb1,0x99,0x64,0x31,0x77,0xd5,0x1d,0xd6,
            0x78,0xbd,0x5e,0xb0,0x8a,0x22,0x38,0xf8,0x68,0x2b,0x2a,0xc5,0xd3,0xf7,0xbc,0x6f,
            0xdf,0x04,0xe5,0x95,0x3e,0x25,0x86,0xa6,0x0b,0x8f,0xf1,0x24,0x0e,0xd7,0x40,0xb3,
            0xcf,0x7e,0x06,0x15,0x9a,0x4d,0x1c,0xa3,0xdb,0x32,0x92,0x58,0x11,0x27,0xf4,0x59,
            0xd0,0x4e,0x6a,0x17,0x5b,0xac,0xff,0x07,0xc0,0x65,0x79,0xfc,0xc7,0xcd,0x76,0x42,
            0x5d,0xe7,0x3a,0x34,0x7a,0x30,0x28,0x0f,0x73,0x01,0xf9,0xd1,0xd2,0x19,0xe9,0x91,
            0xb9,0x5a,0xed,0x41,0x6d,0xb4,0xc3,0x9e,0xbf,0x63,0xfa,0x1f,0x33,0x60,0x47,0x89,
            0xf0,0x96,0x1a,0x5f,0x93,0x3d,0x37,0x4b,0xd9,0xa8,0xc1,0x1b,0xf6,0x39,0x8b,0xb7,
            0x0c,0x20,0xce,0x88,0x6e,0xb6,0x74,0x8e,0x8d,0x16,0x29,0xf2,0x87,0xf5,0xeb,0x70,
            0xe3,0xfb,0x55,0x9f,0xc6,0x44,0x4a,0x45,0x7d,0xe2,0x6b,0x5c,0x6c,0x66,0xa9,0x8c,
            0xee,0x84,0x13,0xa7,0x1e,0x9d,0xdc,0x67,0x48,0xba,0x2e,0xe6,0xa4,0xab,0x7c,0x94,
            0x00,0x21,0xef,0xea,0xbe,0xca,0x72,0x4f,0x52,0x98,0x3f,0xc2,0x14,0x7b,0x3b,0x54
        };
        memcpy(P, kInitP, sizeof(P));
        s = 0xbeu;
        n = 0u;
        memset(block, 0, sizeof(block));
        block_index = (int)sizeof(block);
    }
// Device helper: add_seed_material_bytes.
    void add_seed_material_bytes(thread const uchar* material, int material_len) {
        for (int m = 0; m < material_len; ++m) {
            s = P[(uchar)(s + P[n] + material[m])];
            const uchar temp = P[n];
            P[n] = P[s];
            P[s] = temp;
            n = (uchar)(n + 1u);
        }
    }
// Device helper: add_seed_material_u64.
    void add_seed_material_u64(ulong value) {
        uchar material[8];
        prng64_store64_be(material, value);
        add_seed_material_bytes(material, (int)sizeof(material));
    }
// Device helper: refill.
    void refill() {
        for (int i = 0; i < (int)sizeof(block); ++i) {
            s = P[(uchar)(s + P[n])];
            block[i] = P[(uchar)(P[(uchar)P[s]] + 1u)];
            const uchar temp = P[n];
            P[n] = P[s];
            P[s] = temp;
            n = (uchar)(n + 1u);
        }
        block_index = 0;
    }
public:
    explicit Prng64BouncyVmpcRandom(ulong seed) {
        init_state();
        add_seed_material_u64(seed ^ 0x4243564d5043524eul);
        uchar material[16];
        prng64_provider_fill_material(seed, 0x424f554e4359564dul, 0x504352414e444f4dul, material, (int)sizeof(material));
        add_seed_material_bytes(material, (int)sizeof(material));
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// Device helper: prng64_provider_inc_counter_be.
static inline void prng64_provider_inc_counter_be(thread uchar* v, int len) {
    for (int i = len - 1; i >= 0; --i) {
        v[i] = (uchar)(v[i] + 1u);
        if (v[i] != 0u) {
            break;
        }
    }
}

// Device helper: prng64_provider_inc_counter_le.
static inline void prng64_provider_inc_counter_le(thread uchar* v, int len) {
    for (int i = 0; i < len; ++i) {
        v[i] = (uchar)(v[i] + 1u);
        if (v[i] != 0u) {
            break;
        }
    }
}

// Device helper: prng64_provider_le_add_u64.
static inline void prng64_provider_le_add_u64(thread uchar* dst, int dst_len, ulong value) {
    uint carry = 0u;
    for (int i = 0; i < 8 && i < dst_len; ++i) {
        const uint add = (uint)((value >> (i * 8)) & 0xffu);
        const uint sum = (uint)dst[i] + add + carry;
        dst[i] = (uchar)sum;
        carry = sum >> 8;
    }
    for (int i = 8; i < dst_len && carry != 0u; ++i) {
        const uint sum = (uint)dst[i] + carry;
        dst[i] = (uchar)sum;
        carry = sum >> 8;
    }
}

// Device helper: prng64_provider_load_u32_le.
static inline uint prng64_provider_load_u32_le(thread const uchar* in) {
    return ((uint)in[0]) |
        ((uint)in[1] << 8) |
        ((uint)in[2] << 16) |
        ((uint)in[3] << 24);
}

// Device helper: prng64_provider_chacha_init_material.
static inline void prng64_provider_chacha_init_material(thread uint state[16], thread const uchar* material40) {
    state[0] = 0x61707865u;
    state[1] = 0x3320646eu;
    state[2] = 0x79622d32u;
    state[3] = 0x6b206574u;
    for (int i = 0; i < 8; ++i) {
        state[4 + i] = prng64_provider_load_u32_le(material40 + i * 4);
    }
    state[12] = 0u;
    state[13] = 0u;
    state[14] = prng64_provider_load_u32_le(material40 + 32);
    state[15] = prng64_provider_load_u32_le(material40 + 36);
}

// GNU Nettle yarrow256 public PRNG surface based on SHA-256 pools and AES-256 output.
class Prng64NettleYarrow256 {
    uchar key[32];
    uchar counter[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
// Device helper: increment_counter.
    void increment_counter() {
        for (int i = 15; i >= 0; --i) {
            counter[i] = (uchar)(counter[i] + 1u);
            if (counter[i] != 0u) {
                break;
            }
        }
    }
// Device helper: generate_block.
    void generate_block(thread uchar out[16]) {
        prng64_provider_aes_encrypt_block(round_keys, counter, out);
        increment_counter();
    }
// Device helper: iterate_digest.
    void iterate_digest(thread uchar digest[32]) {
        uchar v0[32];
        memcpy(v0, digest, sizeof(v0));
        for (uint i = 1; i < 1500u; ++i) {
            uchar msg[68];
            memcpy(msg + 0, digest, 32);
            memcpy(msg + 32, v0, 32);
            msg[64] = (uchar)(i >> 24);
            msg[65] = (uchar)(i >> 16);
            msg[66] = (uchar)(i >> 8);
            msg[67] = (uchar)i;
            SHA256(msg, sizeof(msg), digest);
        }
    }
// Device helper: gate.
    void gate() {
        uchar new_key[32];
        generate_block(new_key + 0);
        generate_block(new_key + 16);
        memcpy(key, new_key, sizeof(key));
        prng64_provider_aes_expand_key(key, round_keys);
    }
// Device helper: fast_reseed.
    void fast_reseed(thread const uchar* seed_file, int seed_len) {
        uchar digest[32];
        SHA256(seed_file, (ulong)seed_len, digest);
        iterate_digest(digest);
        memcpy(key, digest, sizeof(key));
        prng64_provider_aes_expand_key(key, round_keys);
        memset(counter, 0, sizeof(counter));
        prng64_provider_aes_encrypt_block(round_keys, counter, counter);
        block_index = (int)sizeof(block);
    }
// Device helper: refill.
    void refill() {
        generate_block(block + 0);
        generate_block(block + 16);
        gate();
        block_index = 0;
    }
public:
    explicit Prng64NettleYarrow256(ulong seed) : block_index(32) {
        uchar seed_file[32];
        memset(key, 0, sizeof(key));
        memset(counter, 0, sizeof(counter));
        memset(block, 0, sizeof(block));
        prng64_provider_fill_material(seed, 0x4e4554544c455941ul, 0x52524f5732353634ul, seed_file, (int)sizeof(seed_file));
        fast_reseed(seed_file, (int)sizeof(seed_file));
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// GNU Nettle drbg_ctr_aes256 public DRBG surface with direct 48-byte seed material.
class Prng64NettleCtrDrbgAes256 {
    uchar key[32];
    uchar value[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
// Device helper: expand_key.
    void expand_key() {
        prng64_provider_aes_expand_key(key, round_keys);
    }
// Device helper: increment_value.
    void increment_value() {
        for (int i = 15; i >= 0; --i) {
            value[i] = (uchar)(value[i] + 1u);
            if (value[i] != 0u) {
                break;
            }
        }
    }
// Device helper: output_bytes.
    void output_bytes(int n, thread uchar* dst) {
        while (n >= 16) {
            increment_value();
            prng64_provider_aes_encrypt_block(round_keys, value, dst);
            dst += 16;
            n -= 16;
        }
        if (n > 0) {
            uchar temp[16];
            increment_value();
            prng64_provider_aes_encrypt_block(round_keys, value, temp);
            memcpy(dst, temp, n);
        }
    }
// Device helper: update.
    void update(thread const uchar* provided_data) {
        uchar temp[48];
        output_bytes((int)sizeof(temp), temp);
        if (provided_data != nullptr) {
            for (int i = 0; i < 48; ++i) {
                temp[i] ^= provided_data[i];
            }
        }
        memcpy(key, temp, 32);
        memcpy(value, temp + 32, 16);
        expand_key();
    }
// Device helper: init.
    void init(thread const uchar seed_material[48]) {
        memset(key, 0, sizeof(key));
        memset(value, 0, sizeof(value));
        memset(block, 0, sizeof(block));
        expand_key();
        update(seed_material);
        block_index = (int)sizeof(block);
    }
// Device helper: refill.
    void refill() {
        output_bytes((int)sizeof(block), block);
        update(nullptr);
        block_index = 0;
    }
public:
    explicit Prng64NettleCtrDrbgAes256(ulong seed) : block_index(32) {
        uchar seed_material[48];
        prng64_provider_fill_material(seed, 0x4e4554544c454354ul, 0x5244524247414553ul, seed_material, (int)sizeof(seed_material));
        init(seed_material);
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        ulong out = 0ul;
        for (int i = 0; i < 8; ++i) {
            out = (out << 8) | (ulong)block[block_index + i];
        }
        block_index += 8;
        return out;
    }
};

// indutny/elliptic + hmac-drbg in old EtherWallet/MEW bundles used SHA-256 HMAC_DRBG.
class Prng64EllipticHmacDrbg {
    Prng64HmacDrbgSha256ProviderCore core;
public:
    explicit Prng64EllipticHmacDrbg(ulong seed) {
        uchar material[48];
        prng64_provider_fill_material(seed, 0x454c4c4950544943ul, 0x484d414344524247ul, material, 32);
        const uchar kSecp256k1Nonce[16] = {
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
            0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b
        };
        memcpy(material + 32, kSecp256k1Nonce, sizeof(kSecp256k1Nonce));
        core.init(material, (int)sizeof(material));
    }
    ulong next() {
        return core.next();
    }
};

// LibTomCrypt Fortuna PRNG uses SHA-256 pools and AES-CTR output with periodic rekey.
class Prng64LibTomCryptFortuna {
    uchar key[32];
    uchar iv[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
// Device helper: refill.
    void refill() {
        prng64_provider_aes_encrypt_block(round_keys, iv, block + 0);
        prng64_provider_inc_counter_le(iv, 16);
        prng64_provider_aes_encrypt_block(round_keys, iv, block + 16);
        prng64_provider_inc_counter_le(iv, 16);
        prng64_provider_aes_encrypt_block(round_keys, iv, key + 0);
        prng64_provider_inc_counter_le(iv, 16);
        prng64_provider_aes_encrypt_block(round_keys, iv, key + 16);
        prng64_provider_inc_counter_le(iv, 16);
        prng64_provider_aes_expand_key(key, round_keys);
        block_index = 0;
    }
public:
    explicit Prng64LibTomCryptFortuna(ulong seed) : block_index(32) {
        uchar material[32];
        uchar pool_input[34];
        uchar pool_digest[32];
        uchar reseed_input[64];
        prng64_provider_fill_material(seed, 0x4c5443464f525455ul, 0x4e4150524e473634ul, material, 32);
        pool_input[0] = 0u;
        pool_input[1] = (uchar)sizeof(material);
        memcpy(pool_input + 2, material, sizeof(material));
        SHA256(pool_input, sizeof(pool_input), pool_digest);
        memset(reseed_input, 0, 32);
        memcpy(reseed_input + 32, pool_digest, 32);
        SHA256(reseed_input, sizeof(reseed_input), key);
        memset(iv, 0, sizeof(iv));
        memset(block, 0, sizeof(block));
        prng64_provider_inc_counter_le(iv, 16);
        prng64_provider_aes_expand_key(key, round_keys);
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

// LibTomCrypt Yarrow PRNG defaults to SHA-256 + AES-CTR with a little-endian counter.
class Prng64LibTomCryptYarrow {
    uchar counter[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
// Device helper: refill.
    void refill() {
        prng64_provider_aes_encrypt_block(round_keys, counter, block + 0);
        prng64_provider_inc_counter_le(counter, 16);
        prng64_provider_aes_encrypt_block(round_keys, counter, block + 16);
        prng64_provider_inc_counter_le(counter, 16);
        block_index = 0;
    }
public:
    explicit Prng64LibTomCryptYarrow(ulong seed) : block_index(32) {
        uchar material[48];
        uchar hash_input[80];
        uchar pool[32];
        prng64_provider_fill_material(seed, 0x4c5443594152524ful, 0x5750524e47534841ul, material, 48);
        memset(hash_input, 0, 32);
        memcpy(hash_input + 32, material, sizeof(material));
        SHA256(hash_input, sizeof(hash_input), pool);
        memcpy(counter, pool, sizeof(counter));
        memset(block, 0, sizeof(block));
        prng64_provider_aes_expand_key(pool, round_keys);
    }
    ulong next() {
        if (block_index > 24) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

// LibTomCrypt RC4 PRNG buffers entropy, runs RC4 KSA, then drops 3072 bytes.
class Prng64LibTomCryptRC4Prng {
    uchar S[256];
    uchar i;
    uchar j;
// Device helper: next_byte.
    uchar next_byte() {
        i = (uchar)(i + 1u);
        j = (uchar)(j + S[i]);
        uchar t = S[i];
        S[i] = S[j];
        S[j] = t;
        return S[(uchar)(S[i] + S[j])];
    }
public:
    explicit Prng64LibTomCryptRC4Prng(ulong seed) : i(0), j(0) {
        uchar ent[256];
        prng64_provider_fill_material(seed, 0x4c54435243345052ul, 0x4e47424954534f55ul, ent, (int)sizeof(ent));
        for (int n = 0; n < 256; ++n) {
            S[n] = (uchar)n;
        }
        uchar k = 0u;
        for (int n = 0; n < 256; ++n) {
            k = (uchar)(k + S[n] + ent[n]);
            uchar t = S[n];
            S[n] = S[k];
            S[k] = t;
        }
        for (int n = 0; n < 3072; ++n) {
            (void)next_byte();
        }
    }
    ulong next() {
        return ((ulong)next_byte() << 56) |
            ((ulong)next_byte() << 48) |
            ((ulong)next_byte() << 40) |
            ((ulong)next_byte() << 32) |
            ((ulong)next_byte() << 24) |
            ((ulong)next_byte() << 16) |
            ((ulong)next_byte() << 8) |
            ((ulong)next_byte());
    }
};

// LibTomCrypt ChaCha20 PRNG fills a 40-byte entropy buffer and runs ChaCha20 with an 8-byte IV.
class Prng64LibTomCryptChaCha20Prng {
    uint state[16];
    uint buffer[16];
    int idx;
// Device helper: refill.
    void refill() {
        prng64_chacha_block_generic(state, buffer, 20);
        ulong ctr = ((ulong)state[13] << 32) | (ulong)state[12];
        ++ctr;
        state[12] = (uint)ctr;
        state[13] = (uint)(ctr >> 32);
        idx = 0;
    }
public:
    explicit Prng64LibTomCryptChaCha20Prng(ulong seed) : idx(16) {
        uchar ent[40];
        prng64_provider_fill_material(seed, 0x4c54434348413230ul, 0x50524e47454e5434ul, ent, (int)sizeof(ent));
        prng64_provider_chacha_init_material(state, ent);
    }
    ulong next() {
        if (idx >= 16) {
            refill();
        }
        const ulong lo = (ulong)buffer[idx];
        const ulong hi = (ulong)buffer[idx + 1];
        idx += 2;
        return (hi << 32) | lo;
    }
};

