class Prng32LFSRGenerator {
    uint state;
public:
    explicit Prng32LFSRGenerator(uint seed) : state(seed ? seed : 1u) {}
    uint next() {
        const uint lsb = state & 1u;
        state >>= 1u;
        if (lsb) {
            state ^= 0xd0000001u;
        }
        return state;
    }
};

class Prng32LFSR4TapGenerator {
    uint state;
public:
    explicit Prng32LFSR4TapGenerator(uint seed) : state(seed ? seed : 1u) {}
    uint next() {
        const uint bit = ((state >> 0u) ^ (state >> 5u) ^ (state >> 9u) ^ (state >> 25u)) & 1u;
        state = (state >> 1u) | (bit << 31u);
        return state;
    }
};

class Prng32Shishua32 {
    uint a, b, c, d;
public:
    explicit Prng32Shishua32(uint seed) {
        a = seed;
        b = seed ^ 0x9e3779b9u;
        c = seed * 0xbea225f9u + 1u;
        d = seed ^ 0x41c64e6du;
    }
    uint next() {
        const uint e = a - prng32_rotl32(b, 27u);
        a = b ^ prng32_rotl32(c, 17u);
        b = c + d;
        c = d + e;
        d = e + a;
        return d;
    }
};

class Prng32Tyche32 {
    uint a, b, c, d;
public:
    explicit Prng32Tyche32(uint seed) {
        a = 0xf1ea5eedu;
        b = c = d = seed;
        for (int i = 0; i < 20; ++i) {
            next();
        }
    }
    uint next() {
        uint e = a - prng32_rotl32(b, 27u);
        a = b ^ prng32_rotl32(c, 17u);
        b = c + d;
        c = d + e;
        d = e + a;
        return d;
    }
};

class Prng32JKISS32 {
    uint x, y, z, c;
public:
    explicit Prng32JKISS32(uint seed) {
        x = seed * 314527869u + 12345u;
        y = seed ^ 0x5a5a5a5au;
        z = seed * 69069u + 1u;
        c = seed | 1u;
    }
    uint next() {
        x = 314527869u * x + 12345u;
        y ^= y << 5u; y ^= y >> 7u; y ^= y << 22u;
        const ulong t = 4294584393ul * ulong(z) + ulong(c);
        c = uint(t >> 32u);
        z = uint(t);
        return x + y + z;
    }
};

class Prng32KISS2012_32 {
