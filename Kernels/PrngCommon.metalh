class Prng64PHPCombinedLCG {
    int s1;
    int s2;
    uint draw31() {
        int q = s1 / 53668;
        s1 = 40014 * (s1 - 53668 * q) - 12211 * q;
        if (s1 < 0) s1 += 2147483563;
        q = s2 / 52774;
        s2 = 40692 * (s2 - 52774 * q) - 3791 * q;
        if (s2 < 0) s2 += 2147483399;
        int z = s1 - s2;
        if (z < 1) z += 2147483562;
        return uint(z);
    }
public:
    explicit Prng64PHPCombinedLCG(ulong seed) {
        s1 = int((((seed != 0ul) ? seed : 1ul) % 2147483562ul) + 1ul);
        const ulong s = seed ^ 0x5048504c43473634ul;
        s2 = int((((s != 0ul) ? s : 1ul) % 2147483398ul) + 1ul);
    }
    ulong next() {
        const ulong lo = ulong(draw31());
        const ulong hi = ulong(draw31());
        return (hi << 32u) | lo;
    }
};

