class Prng64AWC64 {
    ulong x[24];
    ulong c;
    int i;
public:
    explicit Prng64AWC64(ulong seed) : c(0ul), i(0) {
        ulong sm = seed;
        for (int k = 0; k < 24; ++k) x[k] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        const ulong lhs = x[i];
        const ulong rhs = x[(i + 10) % 24];
        const ulong sum_ab = lhs + rhs;
        const ulong carry_ab = (sum_ab < lhs) ? 1ul : 0ul;
        const ulong sum = sum_ab + c;
        const ulong carry_c = (sum < sum_ab) ? 1ul : 0ul;
        x[i] = sum;
        c = carry_ab + carry_c;
        if (++i == 24) i = 0;
        return x[i];
    }
};

class Prng64SWB64 {
