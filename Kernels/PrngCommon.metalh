class Prng32HashDrbgSha256Provider32Core {
    uchar value[55];
    uchar constant_c[55];
    uchar block[32];
    ulong reseed_counter;
    int block_index;
    void post_generate_update() {
        uchar msg[56];
        uchar h[32];
        msg[0] = 0x03u;
        memcpy(msg + 1, value, 55);
        SHA256(msg, sizeof(msg), h);
        prng32_provider_be_add_right_aligned(value, 55, h, 32);
        prng32_provider_be_add_right_aligned(value, 55, constant_c, 55);
        prng32_provider_be_add_u64(value, 55, reseed_counter);
        ++reseed_counter;
    }
    void refill() {
        prng32_provider_hashgen_sha256(value, 55, block, int(sizeof(block)));
        post_generate_update();
        block_index = 0;
    }
public:
    void init(thread const uchar* material, int material_len) {
        uchar tmp[56];
        prng32_provider_hash_df_sha256(material, material_len, value, 55);
        tmp[0] = 0x00u;
        memcpy(tmp + 1, value, 55);
        prng32_provider_hash_df_sha256(tmp, int(sizeof(tmp)), constant_c, 55);
        memset(block, 0, sizeof(block));
        reseed_counter = 1ul;
        block_index = int(sizeof(block));
    }
    uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            (uint(block[block_index]) << 24u) |
            (uint(block[block_index + 1]) << 16u) |
            (uint(block[block_index + 2]) << 8u) |
             uint(block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

class Prng32CtrDrbgAes256Provider32Core {
    uchar key[32];
    uchar value[16];
    uchar block[32];
    uint round_keys[60];
    int block_index;
    void expand_key() {
        provider_aes_expand_key(key, round_keys);
    }
    void increment_value() {
        for (int i = 15; i >= 0; --i) {
            value[i] = uchar(value[i] + 1u);
            if (value[i] != 0u) break;
        }
    }
    void update(thread const uchar* provided_data, bool has_provided_data) {
        uchar temp[48];
        for (int i = 0; i < 3; ++i) {
            increment_value();
            provider_aes_encrypt_block(round_keys, value, temp + i * 16);
        }
        if (has_provided_data) {
            for (int i = 0; i < 48; ++i) {
                temp[i] ^= provided_data[i];
            }
        }
        memcpy(key, temp, 32);
        memcpy(value, temp + 32, 16);
        expand_key();
    }
    void refill() {
        increment_value();
        provider_aes_encrypt_block(round_keys, value, block + 0);
        increment_value();
        provider_aes_encrypt_block(round_keys, value, block + 16);
        update(block, false);
        block_index = 0;
    }
public:
    void init(thread const uchar* material, int material_len, uchar domain_tag) {
        uchar seed[48];
        memset(key, 0, sizeof(key));
        memset(value, 0, sizeof(value));
        memset(block, 0, sizeof(block));
        expand_key();
        prng32_provider_sha256_counter_kdf(material, material_len, domain_tag, seed, int(sizeof(seed)));
        update(seed, true);
        block_index = int(sizeof(block));
    }
    uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            (uint(block[block_index]) << 24u) |
            (uint(block[block_index + 1]) << 16u) |
            (uint(block[block_index + 2]) << 8u) |
             uint(block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

class Prng32HmacDrbgSha256Provider32Core {
    uchar key[32];
    uchar value[32];
    uchar block[32];
    int block_index;
    void update(thread const uchar* provided, int provided_len) {
        uchar msg[96];
        uchar out[32];
        memcpy(msg, value, 32);
        msg[32] = 0x00u;
        if (provided_len > 0) {
            memcpy(msg + 33, provided, provided_len);
        }
        hmac_sha256(key, 32, msg, size_t(33 + provided_len), out);
        memcpy(key, out, 32);
        hmac_sha256(key, 32, value, 32, out);
        memcpy(value, out, 32);
        if (provided_len > 0) {
            memcpy(msg, value, 32);
            msg[32] = 0x01u;
            memcpy(msg + 33, provided, provided_len);
            hmac_sha256(key, 32, msg, size_t(33 + provided_len), out);
            memcpy(key, out, 32);
            hmac_sha256(key, 32, value, 32, out);
            memcpy(value, out, 32);
        }
    }
    void refill() {
        hmac_sha256(key, 32, value, 32, block);
        memcpy(value, block, 32);
        update(value, 0);
        block_index = 0;
    }
public:
    void init(thread const uchar* material, int material_len) {
        memset(key, 0, sizeof(key));
        memset(value, 0x01, sizeof(value));
        memset(block, 0, sizeof(block));
        block_index = 32;
        update(material, material_len);
    }
    uint next() {
        if (block_index > 28) {
            refill();
        }
        const uint out =
            (uint(block[block_index]) << 24u) |
            (uint(block[block_index + 1]) << 16u) |
            (uint(block[block_index + 2]) << 8u) |
             uint(block[block_index + 3]);
        block_index += 4;
        return out;
    }
};

static inline void prng32_copy16(thread uchar* dst, thread const uchar src[16]) {
    for (int i = 0; i < 16; ++i) dst[i] = src[i];
}

class Prng32TrezorHmacDrbg32 {
    Prng32HmacDrbgSha256Provider32Core core;
public:
    explicit Prng32TrezorHmacDrbg32(uint seed) {
        uchar material[32];
        const ulong mix0 = prng32_mix_stafford13_provider32(ulong(seed) ^ 0x54525a4854523332ul);
        const ulong mix1 = prng32_mix_murmur64_provider32((ulong(seed) << 1u) ^ 0x484d414344524247ul);
        for (int i = 0; i < 8; ++i) {
            material[i] = uchar(mix0 >> uint(i * 8));
            material[8 + i] = uchar(mix1 >> uint(i * 8));
            material[16 + i] = uchar((mix0 ^ 0xa5a5a5a5a5a5a5a5ul) >> uint(i * 8));
            material[24 + i] = uchar((mix1 ^ 0x3c6ef372fe94f82bul) >> uint(i * 8));
        }
        core.init(material, int(sizeof(material)));
    }
    uint next() { return core.next(); }
};

