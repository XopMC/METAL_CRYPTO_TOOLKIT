class Prng64POSIX_nrand48_64Packed {
    ulong x;
    ulong step() {
        x = (x * 0x5deece66dul + 0xbul) & ((1ul << 48u) - 1ul);
        return x;
    }
public:
    explicit Prng64POSIX_nrand48_64Packed(ulong seed) {
        const ulong x0 = seed & 0xfffful;
        const ulong x1 = (seed >> 16u) & 0xfffful;
        const ulong x2 = ((seed >> 32u) ^ 0x330eul) & 0xfffful;
        x = (x2 << 32u) | (x1 << 16u) | x0;
    }
    ulong next() {
        const ulong hi = step() >> 17u;
        const ulong lo = step() >> 17u;
        return (hi << 33u) ^ lo;
    }
};

template <int DEG, int SEP, int WARMUP>
class Prng64GlibcRandomFeedback64Core {
    uint state[DEG];
    int fptr;
    int rptr;
public:
    explicit Prng64GlibcRandomFeedback64Core(ulong seed) : fptr(SEP), rptr(0) {
        uint s = uint(seed);
        if (s == 0u) s = 1u;
        state[0] = s;
        for (int i = 1; i < DEG; ++i) {
            state[i] = uint((ulong(16807u) * ulong(state[i - 1])) % 0x7ffffffful);
        }
        for (int i = 0; i < WARMUP; ++i) (void)next31();
    }
    uint next31() {
        const uint sum = state[fptr] + state[rptr];
        state[fptr] = sum;
        const uint result = sum >> 1u;
        if (++fptr >= DEG) fptr = 0;
        if (++rptr >= DEG) rptr = 0;
        return result;
    }
};

