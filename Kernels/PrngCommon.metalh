        w = (w ^ (w >> 19u)) ^ (t ^ (t >> 8u));
        return w;
    }
};

class Prng32ChaCha8Generator {
    uint state[16];
    void qr(thread uint* x, int a, int b, int d) {
        x[a] += x[b];
        x[d] = prng32_rotl32(x[d] ^ x[a], 16u);
    }
public:
    explicit Prng32ChaCha8Generator(uint seed) {
        state[0] = 0x61707865u;
        state[1] = 0x3320646eu;
        state[2] = 0x79622d32u;
        state[3] = 0x6b206574u;
        for (int i = 4; i < 16; ++i) {
            state[i] = seed + uint(i);
        }
    }
    uint next() {
        uint x[16];
        for (int i = 0; i < 16; ++i) {
            x[i] = state[i];
        }
        for (int r = 0; r < 8; r += 2) {
            qr(x, 0, 4, 12); qr(x, 1, 5, 13); qr(x, 2, 6, 14); qr(x, 3, 7, 15);
            qr(x, 0, 5, 15); qr(x, 1, 6, 12); qr(x, 2, 7, 13); qr(x, 3, 4, 14);
        }
        state[12]++;
        return x[0] ^ x[5] ^ x[10] ^ x[15];
    }
};

class Prng32ChaCha20BlockGenerator {
    uint state[16];
    void qr(thread uint* x, int a, int b, int d) {
        x[a] += x[b];
        x[d] = prng32_rotl32(x[d] ^ x[a], 16u);
    }
public:
    explicit Prng32ChaCha20BlockGenerator(uint seed) {
        state[0] = 0x61707865u;
        state[1] = 0x3320646eu;
        state[2] = 0x79622d32u;
        state[3] = 0x6b206574u;
        for (int i = 4; i < 16; ++i) {
            state[i] = seed + uint(i);
        }
    }
    uint next() {
        uint x[16];
        for (int i = 0; i < 16; ++i) {
            x[i] = state[i];
        }
        qr(x, 0, 4, 12); qr(x, 1, 5, 13); qr(x, 2, 6, 14); qr(x, 3, 7, 15);
        qr(x, 0, 5, 15); qr(x, 1, 6, 12); qr(x, 2, 7, 13); qr(x, 3, 4, 14);
        state[12]++;
        return x[0] ^ x[5] ^ x[10] ^ x[15];
    }
};

class Prng32XXHash32AvalancheGenerator {
    uint ctr;
public:
    explicit Prng32XXHash32AvalancheGenerator(uint seed) : ctr(seed) {}
    uint next() {
        uint h = ctr += 0x9e3779b1u;
        h ^= h >> 15u;
        h *= 0x85ebca77u;
        h ^= h >> 13u;
        h *= 0xc2b2ae3du;
        h ^= h >> 16u;
        return h;
    }
};

class Prng32KnuthSubtractiveGenerator {
    uint s[56];
    int idx;
public:
    explicit Prng32KnuthSubtractiveGenerator(uint seed) : idx(0) {
        s[55] = seed;
        for (int i = 0; i < 55; ++i) {
            s[i] = 21u * (s[55] ^ uint(i + 1));
        }
    }
    uint next() {
        const int j = (idx + 31) % 56;
        const uint x = (s[j] >= s[idx]) ? (s[j] - s[idx]) : (s[j] + 0xffffffffu - s[idx]);
        s[idx] = x;
        idx = (idx + 1) % 56;
        return x;
    }
};

class Prng32Xor128Marsaglia32Generator {
    uint x, y, z, w;
public:
    explicit Prng32Xor128Marsaglia32Generator(uint seed) {
        ulong s = ulong(seed) ^ 0x9e3779b97f4a7c15ul;
        x = prng32_seed_step32_local(s);
        y = prng32_seed_step32_local(s);
        z = prng32_seed_step32_local(s);
        w = prng32_seed_step32_local(s);
        if ((x | y | z | w) == 0u) {
            w = 1u;
        }
        for (int i = 0; i < 64; ++i) {
            next();
        }
    }
    uint next() {
        const uint t = x ^ (x << 11u);
        x = y;
        y = z;
        z = w;
        w ^= (w >> 19u) ^ t ^ (t >> 8u);
        return w;
    }
};

class Prng32Xor4096Brent32Generator {
    uint X[128];
    uint i, w;
public:
    explicit Prng32Xor4096Brent32Generator(uint seed) : i(127u) {
        ulong sm = ulong(seed) ^ 0x94d049bb133111ebul;
        for (int k = 0; k < 128; ++k) {
            X[k] = prng32_seed_step32_local(sm);
        }
        w = prng32_seed_step32_local(sm);
        for (int k = 0; k < 512; ++k) {
            next();
        }
    }
    uint next() {
        w += 0x61c88647u;
        uint v = X[(i + 34u) & 127u];
        uint t = X[i = (i + 1u) & 127u];
        v ^= v << 13u;
        t ^= t << 17u;
        v ^= v >> 15u;
        t ^= t >> 12u;
        v = X[i] = v ^ t;
        return v + (w ^ (w >> 16u));
    }
};

class Prng32GFSRGenerator {
    uint s[55];
    int idx;
public:
    explicit Prng32GFSRGenerator(uint seed) : idx(0) {
        s[0] = seed;
        for (int i = 1; i < 55; ++i) {
            s[i] = 69069u * s[i - 1] + 12345u;
        }
    }
    uint next() {
        const uint x = s[idx] ^ s[(idx + 31) % 55];
        s[idx] = x;
        idx = (idx + 1) % 55;
        return x;
    }
};

class Prng32AdditiveCongruentialGenerator {
    uint state, inc;
public:
    explicit Prng32AdditiveCongruentialGenerator(uint seed) : state(seed), inc(0x269ec3u) {}
    uint next() {
        state += inc;
        return state;
    }
};

class Prng32SWC4096 {
    uint x[4096];
    uint carry;
    int idx;
public:
    explicit Prng32SWC4096(uint seed) : carry(0u), idx(0) {
        for (int i = 0; i < 4096; ++i) {
            seed = seed * 1664525u + 1013904223u;
            x[i] = seed;
        }
    }
    uint next() {
        const int j = (idx + 4096 - 15) % 4096;
        const ulong sum = ulong(x[j]) + ulong(x[idx]) + ulong(carry);
        carry = uint(sum >> 32u);
        const uint t = uint(sum);
        x[idx] = t;
        if (++idx == 4096) {
            idx = 0;
        }
        return t;
    }
};

class Prng32SubtractWithBorrow32 {
    uint x[24];
    int ip, jp, borrow;
public:
    explicit Prng32SubtractWithBorrow32(uint seed) : ip(23), jp(13), borrow(0) {
        uint s = seed;
        for (int i = 0; i < 24; ++i) {
            s = 69069u * s + 1u;
            x[i] = s & 0xffffffu;
        }
    }
    uint next() {
        int diff = int(x[ip]) - int(x[jp]) - borrow;
        if (diff < 0) {
            diff += (1 << 24);
            borrow = 1;
        } else {
            borrow = 0;
        }
        x[ip] = uint(diff);
        const uint result = uint(diff);
        if (--ip < 0) { ip = 23; }
        if (--jp < 0) { jp = 23; }
        return result << 8u;
    }
};

class Prng32ICG32 {
    uint state;
    uint modinv(uint a) {
        ulong t = 0ul;
        ulong newt = 1ul;
        ulong r = 2147483647ul;
        ulong newr = ulong(a);
        while (newr != 0ul) {
            const ulong q = r / newr;
            const ulong tmp = newt;
            newt = t - q * newt;
            t = tmp;
            const ulong tmp2 = newr;
            newr = r - q * newr;
            r = tmp2;
        }
        return uint((t + 2147483647ul) % 2147483647ul);
    }
public:
    explicit Prng32ICG32(uint seed) : state(seed % 2147483647u) {
        if (state == 0u) {
            state = 1u;
        }
    }
    uint next() {
        state = uint((ulong(170u) * ulong(modinv(state)) + 31ul) % 2147483647ul);
        return state << 1u;
    }
};

class Prng32FibonacciGenerator {
    ulong a, b;
public:
    explicit Prng32FibonacciGenerator(uint seed) : a(ulong(seed)), b(~ulong(seed)) {}
    uint next() {
        const ulong c = a + b;
        a = b;
        b = c;
        return uint(c);
    }
};

class Prng32LFIB4_32 {
    uint x[256];
    int idx;
public:
    explicit Prng32LFIB4_32(uint seed) : idx(0) {
        for (int i = 0; i < 256; ++i) {
            seed = seed * 1664525u + 1013904223u;
            x[i] = seed;
        }
    }
    uint next() {
        const uint t = x[idx] = x[idx] + x[(idx + 58) % 256] + x[(idx + 119) % 256] + x[(idx + 178) % 256];
        if (++idx == 256) {
            idx = 0;
        }
        return t;
    }
};

class Prng32LaggedFIB607_273 {
    uint s[607];
    int p;
public:
    explicit Prng32LaggedFIB607_273(uint seed) : p(0) {
        for (int i = 0; i < 607; ++i) {
            seed = seed * 1664525u + 1013904223u;
            s[i] = seed;
        }
    }
    uint next() {
        const int q = (p + 607 - 273) % 607;
        const uint t = s[p] + s[q];
        s[p] = t;
        if (++p == 607) {
            p = 0;
        }
        return t;
    }
};

class Prng32Squares32 {
    ulong ctr;
    ulong key;
public:
    explicit Prng32Squares32(uint seed) : ctr(0ul) {
        key = (ulong(seed) << 32u) | 0xbea225f9ul;
        if ((key & 1ul) == 0ul) {
            key |= 1ul;
        }
    }
    uint next() {
        ulong x;
        ulong y;
        ulong z;
        y = x = ctr * key;
        z = y + key;
        x = x * x + y; x = (x >> 32u) | (x << 32u);
        x = x * x + z; x = (x >> 32u) | (x << 32u);
        x = x * x + y; x = (x >> 32u) | (x << 32u);
        ++ctr;
        return uint((x * x + z) >> 32u);
    }
};

class Prng32BlumBlumShubGenerator {
    ulong state;
public:
    explicit Prng32BlumBlumShubGenerator(uint seed)
        : state((ulong(seed) * ulong(seed)) % 1009840029511ul) {}
    uint next() {
        state = (state * state) % 1009840029511ul;
        return uint(state);
    }
};

class Prng32TEAGenerator {
    uint v0, v1, sum;
public:
    explicit Prng32TEAGenerator(uint seed) : v0(seed), v1(seed ^ 0x9e3779b9u), sum(0u) {}
    uint next() {
        sum += 0x9e3779b9u;
        v0 += ((v1 << 4u) + 0xa341316cu) ^ (v1 + sum) ^ ((v1 >> 5u) + 0xc8013ea4u);
        v1 += ((v0 << 4u) + 0xad90777du) ^ (v0 + sum) ^ ((v0 >> 5u) + 0x7e95761eu);
        return v0;
    }
};

class Prng32XTEAGenerator {
    uint v0, v1, sum;
public:
    explicit Prng32XTEAGenerator(uint seed) : v0(seed), v1(seed ^ 0x9e3779b9u), sum(0u) {}
    uint next() {
        for (int i = 0; i < 32; ++i) {
            v0 += (((v1 << 4u) ^ (v1 >> 5u)) + v1) ^ (sum + 0x9e3779b9u);
            sum += 0x9e3779b9u;
            v1 += (((v0 << 4u) ^ (v0 >> 5u)) + v0) ^ (sum + 0x9e3779b9u);
        }
        return v0;
    }
};

class Prng32LFGGenerator {
    uint s[55];
    int idx;
public:
    explicit Prng32LFGGenerator(uint seed) : idx(0) {
        s[0] = seed;
        for (int i = 1; i < 55; ++i) {
            s[i] = 1812433253u * (s[i - 1] ^ (s[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const uint x = s[(idx + 55 - 24) % 55] + s[idx];
        s[idx] = x;
        idx = (idx + 1) % 55;
        return x;
    }
};

class Prng32LFG58119Generator {
    uint s[119];
    int idx;
public:
    explicit Prng32LFG58119Generator(uint seed) : idx(0) {
        s[0] = seed;
        for (int i = 1; i < 119; ++i) {
            s[i] = 1812433253u * (s[i - 1] ^ (s[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const uint x = s[(idx + 119 - 58) % 119] + s[idx];
        s[idx] = x;
        idx = (idx + 1) % 119;
        return x;
    }
};

class Prng32SubtractiveBorrowGenerator {
    uint s[7], borrow;
    int idx;
public:
    explicit Prng32SubtractiveBorrowGenerator(uint seed) : borrow(0u), idx(0) {
        s[0] = seed;
        for (int i = 1; i < 7; ++i) {
            s[i] = 1812433253u * (s[i - 1] ^ (s[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const int jdx = (idx + 7 - 23) % 7;
        const long diff = long(s[jdx]) - long(s[idx]) - long(borrow);
        borrow = (diff < 0) ? 1u : 0u;
        const uint r = uint(diff);
        s[idx] = r;
        idx = (idx + 1) % 7;
        return r;
    }
};

class Prng32RANMAR {
    float u[97];
    int i97, j97;
    uint c;
public:
    explicit Prng32RANMAR(uint seed) {
        const int ij = int(seed % 31328u);
        const int kl = int((seed >> 16u) % 30081u);
        int i = ij / 177;
        int j = ij % 177;
        int k = kl / 169;
        int l = kl % 169;
        for (int ii = 0; ii < 97; ++ii) {
            float s = 0.0f;
            float t = 0.5f;
            for (int jj = 0; jj < 24; ++jj) {
                const int m = (((i * i) % 179) * k) % 179;
                i = j;
                j = k;
                k = m;
                l = (53 * l + 1) % 169;
                if (((l * m) % 64) >= 32) {
                    s += t;
                }
                t *= 0.5f;
            }
            u[ii] = s;
        }
        i97 = 96;
        j97 = 32;
        c = seed & 0xffffu;
    }
    uint next() {
        float uni = u[i97] - u[j97];
        if (uni < 0.0f) {
            uni += 1.0f;
        }
        u[i97] = uni;
        if (--i97 < 0) {
            i97 = 96;
        }
        if (--j97 < 0) {
            j97 = 96;
        }
        c = (c + 1u) % 16777216u;
        uni -= float(c) * (1.0f / 16777216.0f);
        if (uni < 0.0f) {
            uni += 1.0f;
        }
        return uint(uni * 4294967296.0f);
    }
};

class Prng32CONG32 {
    uint state;
public:
    explicit Prng32CONG32(uint seed) : state(seed) {}
    uint next() {
        state = 69069u * state + 12345u;
        return state;
    }
};

class Prng32SHR3 {
    uint state;
public:
    explicit Prng32SHR3(uint seed) : state(seed) {}
    uint next() {
        state ^= state << 17u;
        state ^= state >> 13u;
        state ^= state << 5u;
        return state;
    }
};

static inline bool prng32_entropy_fill(int entropy_len,
                                       thread uchar* entropy,
                                       uint seed_l,
                                       int mode,
                                       int gen,
                                       ulong skip32) {
    if (entropy_len <= 0 || entropy_len > 512) {
        return false;
    }
    switch (gen) {
        case 0:
            return prng32_generate_entropy_and_check<Prng32EntropyGenerator>(seed_l, entropy_len, entropy, mode, skip32);
        case 1:
            return prng32_generate_entropy_and_check<Prng32LmgGen>(seed_l, entropy_len, entropy, mode, skip32);
        case 2:
            return prng32_generate_entropy_and_check<Prng32LcgGen>(seed_l, entropy_len, entropy, mode, skip32);
        case 3:
            return prng32_generate_entropy_and_check<Prng32SplitMix64AltGenerator>(seed_l, entropy_len, entropy, mode, skip32);
        case 4:
            return prng32_generate_entropy_and_check<Prng32JavaLcg>(seed_l, entropy_len, entropy, mode, skip32);
        case 5:
            return prng32_generate_entropy_and_check<Prng32DotNetRandom32>(seed_l, entropy_len, entropy, mode, skip32);
        case 6:
            return prng32_generate_entropy_and_check<Prng32DotNetXoshiro128StarStar32>(seed_l, entropy_len, entropy, mode, skip32);
        case 7:
            return prng32_generate_entropy_and_check<Prng32GoRand32>(seed_l, entropy_len, entropy, mode, skip32);
        case 8:
            return prng32_generate_entropy_and_check<Prng32GoMathRandV2PCG32>(seed_l, entropy_len, entropy, mode, skip32);
        case 9:
            return prng32_generate_entropy_and_check<Prng32GoChaCha8Global32>(seed_l, entropy_len, entropy, mode, skip32);
        case 10:
            return prng32_generate_entropy_and_check<Prng32PythonRandom32>(seed_l, entropy_len, entropy, mode, skip32);
        case 11:
            return prng32_generate_entropy_and_check<Prng32V8XorShift128Plus32>(seed_l, entropy_len, entropy, mode, skip32);
        case 12:
            return prng32_generate_entropy_and_check<Prng32SpiderMonkeyMathRandom32>(seed_l, entropy_len, entropy, mode, skip32);
