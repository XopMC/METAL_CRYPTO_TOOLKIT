class Prng32MWC64Generator {
    ulong x, c;
public:
    explicit Prng32MWC64Generator(uint seed) : x(ulong(seed)), c(ulong((seed >> 1u) | 1u)) {}
    uint next() {
        const ulong mul = 0xfffffffffffffff1ul;
        const ulong lo = mul * x;
        const ulong hi = prng32_umul64hi(mul, x);
        const ulong newLo = lo + c;
        const ulong carry = (newLo < lo) ? 1ul : 0ul;
        const ulong newHi = hi + carry;
        c = newHi;
        x = newLo;
        return uint(x);
    }
};

class Prng32MWC256Generator {
    uint Q[256];
    uint c;
    int i;
public:
    explicit Prng32MWC256Generator(uint seed) : c(123456u), i(255) {
        for (int j = 0; j < 256; ++j) {
            Q[j] = seed ^ (uint(j) + 0x9e3779b9u);
        }
    }
    uint next() {
        i = (i + 1) & 255;
        const ulong t = 809430660ul * ulong(Q[i]) + ulong(c);
        c = uint(t >> 32u);
        Q[i] = uint(t);
        return Q[i];
    }
};

class Prng32CMWC3Generator {
    uint Q[3];
    uint c;
    int i;
public:
    explicit Prng32CMWC3Generator(uint seed) : c(362436u), i(2) {
        for (int j = 0; j < 3; ++j) {
            Q[j] = seed ^ (seed << uint(j + 1));
        }
    }
    uint next() {
        i = (i + 1) & 2;
        const ulong t = 18782ul * ulong(Q[i]) + ulong(c);
        c = uint(t >> 32u);
        uint x = uint(t) + c;
        if (x < c) {
            x++;
            c++;
        }
        Q[i] = 0xfffffffeu - x;
        return Q[i];
    }
};

class Prng32MWC128Vigna32Generator {
    ulong x, c;
public:
    explicit Prng32MWC128Vigna32Generator(uint seed) {
        ulong sm = ulong(seed) ^ 0x510e527fade682d1ul;
        x = prng32_seed_mix64_local(sm);
        c = prng32_seed_mix64_local(sm) | 1ul;
    }
    uint next() {
        const ulong result = x ^ (x << 32u);
        ulong hi = 0ul;
        x = prng32_mul_add64_carry_local(0xffebb71d94fcdaf9ul, x, c, hi);
        c = hi;
        return prng32_fold64_to32_local(result);
    }
};

class Prng32MWC192Vigna32Generator {
