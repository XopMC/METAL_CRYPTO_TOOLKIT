class Prng64CLCG2_64 {
    int s1;
    int s2;
    uint next32() {
        int k = s1 / 53668;
        s1 = 40014 * (s1 - k * 53668) - k * 12211;
        if (s1 < 0) s1 += 2147483563;
        k = s2 / 52774;
        s2 = 40692 * (s2 - k * 52774) - k * 3791;
        if (s2 < 0) s2 += 2147483399;
        int z = s1 - s2;
        if (z < 1) z += 2147483562;
        return uint(z) << 1u;
    }
public:
    explicit Prng64CLCG2_64(ulong seed) {
        const uint s = uint(seed);
        s1 = int((s % 2147483562u) + 1u);
        s2 = int(((s ^ 0x9e3779b9u) % 2147483398u) + 1u);
    }
    ulong next() {
        const ulong hi = ulong(next32());
        const ulong lo = ulong(next32());
        return (hi << 32u) | lo;
    }
};

// Switch entries for prng64_entropy_fill main switch, before case 211.

static inline bool prng64_entropy_fill(int entropy_len,
                                       thread uchar* entropy,
                                       ulong seed_l,
                                       int mode,
                                       int gen,
                                       ulong skip64) {
    if (entropy_len <= 0 || entropy_len > 512) {
        return false;
    }
    if (mode == 217) {
        switch (gen) {
            case 216:
                return (entropy_len == 32)
                    ? prng64_mvw_web3_mathrandom_account_private<Prng64RandstormV8_2015Profile>(entropy_len, entropy, seed_l, skip64)
                    : prng64_rn_getrandomvalues_mathrandom32_fill<Prng64RandstormV8_2015Profile>(entropy_len, entropy, seed_l, skip64);
            case 217:
                return (entropy_len == 32)
                    ? prng64_mvw_web3_mathrandom_account_private<Prng64RandstormSpiderMonkeyLcg48Profile>(entropy_len, entropy, seed_l, skip64)
                    : prng64_rn_getrandomvalues_mathrandom32_fill<Prng64RandstormSpiderMonkeyLcg48Profile>(entropy_len, entropy, seed_l, skip64);
            case 218:
                return (entropy_len == 32)
                    ? prng64_mvw_web3_mathrandom_account_private<Prng64RandstormJscWeakRandomProfile>(entropy_len, entropy, seed_l, skip64)
                    : prng64_rn_getrandomvalues_mathrandom32_fill<Prng64RandstormJscWeakRandomProfile>(entropy_len, entropy, seed_l, skip64);
            case 219:
                return (entropy_len == 32)
                    ? prng64_mvw_web3_mathrandom_account_private<Prng64RandstormLcg32Profile>(entropy_len, entropy, seed_l, skip64)
                    : prng64_rn_getrandomvalues_mathrandom32_fill<Prng64RandstormLcg32Profile>(entropy_len, entropy, seed_l, skip64);
            default:
                return false;
        }
    }

    switch (gen) {
        case 0:
            return prng64_generate_entropy_and_check<Prng64JavaUtilRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 1:
            return prng64_generate_entropy_and_check<Prng64DotNetRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 2:
            return prng64_generate_entropy_and_check<Prng64DotNetXoshiro256StarStar>(seed_l, entropy_len, entropy, mode, skip64);
        case 3:
            return prng64_generate_entropy_and_check<Prng64JavaThreadLocalRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 4:
            return prng64_generate_entropy_and_check<Prng64JavaSplittableRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 5:
            return prng64_generate_entropy_and_check<Prng64L64X128StarStarRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 6:
            return prng64_generate_entropy_and_check<Prng64L64X256MixRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 7:
            return prng64_generate_entropy_and_check<Prng64JavaL64X1024MixRandom>(seed_l, entropy_len, entropy, mode, skip64);
        case 8:
            return prng64_generate_entropy_and_check<Prng64L128X128MixRandom>(seed_l, entropy_len, entropy, mode, skip64);
