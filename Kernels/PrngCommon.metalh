        for (int i = 0; i < number_of_bytes; i++) {
            ulong bits63 = gen.next() >> 1;
            ulong idx = (bound * bits63) >> 63;
            entropy[i] = (uchar)idx;
        }
        return;
    }
    else if (mode == 256) {
        // Go Int63n(64)-style power-of-two fast path (masking).
        const ulong mask = 64ul - 1ul;
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)((gen.next() >> 1) & mask);
        }
        return;
    }
    else if (mode == 257) {
        // Rust Uniform<u8>-style Lemire lane (bound=64, top-32 slice).
        const uint bound = 64u;
        const uint threshold = (uint)(-bound) % bound;
        for (int i = 0; i < number_of_bytes; i++) {
            uint x, lo;
            ulong m;
            m = prng64_guarded_lemire_product_u32_top32(gen, bound, threshold);
            entropy[i] = (uchar)(m >> 32);
        }
        return;
    }
    else if (mode == 258) {
        // .NET NextInt64(64)-style power-of-two mask lane.
        const ulong mask = 64ul - 1ul;
        for (int i = 0; i < number_of_bytes; i++) {
            entropy[i] = (uchar)((gen.next() >> 1) & mask);
        }
        return;
    }
    else if (mode == 259) {
        // C++ uniform_int_distribution<int>(0,63)-style rejection lane on int63.
        const ulong bound = 64ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(r % bound);
        }
        return;
    }
    else if (mode == 260) {
        // Java nextLong(2048)-style power-of-two fast lane via multiply-high scaling.
        const ulong bound = 2048ul;
        for (int i = 0; i < number_of_bytes; i++) {
            ulong bits63 = gen.next() >> 1;
            ulong idx = (bound * bits63) >> 63;
            entropy[i] = (uchar)((idx >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 261) {
        // Go Int63n(2048)-style power-of-two fast path (masking).
        const ulong mask = 2048ul - 1ul;
        for (int i = 0; i < number_of_bytes; i++) {
            ulong idx = (gen.next() >> 1) & mask;
            entropy[i] = (uchar)((idx >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 262) {
        // arc4random_uniform(2048)-style threshold lane on uint64.
        const ulong bound = 2048ul;
        const ulong min = (ulong)(-bound) % bound;
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_ge_min(gen, min);
            entropy[i] = (uchar)(((r % bound) >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 263) {
        // libsodium randombytes_uniform(2048)-style top-32 rejection lane.
        const uint bound = 2048u;
        const uint min = (uint)(-bound) % bound;
        for (int i = 0; i < number_of_bytes; i++) {
            uint r;
            r = prng64_guarded_draw_ge_min_u32_from_top32(gen, min);
            entropy[i] = (uchar)(((r % bound) >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 264) {
        // .NET NextInt64(2048)-style rejection lane.
        const ulong bound = 2048ul;
        const ulong limit = 0x7ffffffffffffffful - (0x7ffffffffffffffful % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_draw_lt_shift(gen, limit, 1);
            entropy[i] = (uchar)(((r % bound) >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 265) {
        // Rust Uniform<u16>-style Lemire lane (bound=2048, top-32 slice).
        const uint bound = 2048u;
        const uint threshold = (uint)(-bound) % bound;
        for (int i = 0; i < number_of_bytes; i++) {
            uint x, lo;
            ulong m;
            m = prng64_guarded_lemire_product_u32_top32(gen, bound, threshold);
            entropy[i] = (uchar)(((m >> 32) & 0x7FFu) >> 3);
        }
        return;
    }
    else if (mode == 266) {
        // Python secrets.randbelow(2048)-style masked lane.
        const ulong mask = 2048ul - 1ul;
        for (int i = 0; i < number_of_bytes; i++) {
            ulong idx = gen.next() & mask;
            entropy[i] = (uchar)((idx >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 267) {
        // Node.js crypto.randomInt(2048)-style 48-bit rejection lane.
        const ulong bound = 2048ul;
        const ulong max48 = (1ul << 48) - 1ul;
        const ulong limit = max48 - (max48 % bound);
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r;
            r = prng64_guarded_u48_draw_lt_limit(gen, max48, limit);
            entropy[i] = (uchar)(((r % bound) >> 3) & 0xFFu);
        }
        return;
    }
    else if (mode == 268) {
        // Base58 index lane from a BIP39-style 11-bit reservoir.
        ulong pool = 0ul;
        int bits = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            while (bits < 11) {
                pool |= (gen.next() << bits);
                bits += 64;
            }
            uint idx = (uint)(pool & 0x7FFu);
            pool >>= 11;
            bits -= 11;
            entropy[i] = (uchar)(idx % 58u);
        }
        return;
    }
    else if (mode == 269) {
        // Strict BIP39 reservoir lane: raw low byte of 11-bit indices.
        ulong pool = 0ul;
        int bits = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            while (bits < 11) {
                pool |= (gen.next() << bits);
                bits += 64;
            }
            uint idx = (uint)(pool & 0x7FFu);
            pool >>= 11;
            bits -= 11;
            entropy[i] = (uchar)(idx & 0xFFu);
        }
        return;
    }
    else if (mode == 270) {
        // ethers v4 weak randomBytes shim: 20 rounds of Math.trunc(256 * Math.random()),
        // assigning on the first round and XORing all subsequent rounds.
        for (int zero_i = 0; zero_i < number_of_bytes; ++zero_i) { entropy[zero_i] = 0u; }
        for (int round = 0; round < 20; ++round) {
            ulong r = 0ul;
            int lane = 4;
            for (int i = 0; i < number_of_bytes; ++i) {
                if (lane >= 4) {
                    r = gen.next();
                    lane = 0;
                }
                const uchar b = (uchar)((r >> (8 + (lane * 16))) & 0xFFu);
                if (round == 0) {
                    entropy[i] = b;
                }
                else {
                    entropy[i] ^= b;
                }
                ++lane;
            }
        }
        return;
    }

    else if (mode >= 0 && mode <= 7) {
        const int pick = mode; // 0..7
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = prng64_byte_of_u64(r, pick);
        }
        return;
    }

    else if (mode == 8) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = prng64_xor8(r);
        }
        return;
    }

    else if (mode == 9) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = prng64_sum8(r);
        }
        return;
    }

    else if (mode == 10) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            uchar s = prng64_sum8(r);
            entropy[i] = (uchar)(s >> 3);
        }
        return;
    }

    else if (mode == 11) {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            uchar b7 = (uchar)(r >> 56);
            uchar b0 = (uchar)(r);
            uchar b3 = (uchar)(r >> 24);
            entropy[i] = (uchar)((b7 ^ b0) ^ b3);
        }
        return;
    }

    else if (mode == 12) {
        ulong r = 0;
        for (int i = 0; i < number_of_bytes; i++) {
            int sh = (i & 7) * 8;
            if ((i & 7) == 0) r = gen.next();
            entropy[i] = (uchar)((r >> sh) & 0xFFu);
        }
        return;
    }
    else {
        for (int i = 0; i < number_of_bytes; i++) {
            ulong r = gen.next();
            entropy[i] = (uchar)(r >> 56);
        }
    }

}


template <typename Gen64>
static inline bool prng64_generate_entropy_and_check(ulong seed,
                                                     int entropy_len,
                                                     thread uchar* entropy,
                                                     int mode,
                                                     ulong skip64) {
    Gen64 gen(seed);
    prng64_generate_entropy_shared(gen, entropy_len, entropy, mode, skip64);
    if (mode == 216) {
        return true;
    }
    return prng64_is_unique_len_aware(entropy, entropy_len);
}

template <typename Profile>
static inline bool prng64_rn_getrandomvalues_mathrandom32_fill(int entropy_len,
                                                               thread uchar* entropy,
                                                               ulong math_random_state,
                                                               ulong skip64) {
    Profile profile(math_random_state);
    for (ulong n = 0ul; n < skip64; ++n) {
        (void)prng64_rn_word32(profile);
    }
    int out = 0;
    while (out < entropy_len) {
        const uint word = prng64_rn_word32(profile);
        entropy[out++] = uchar(word & 0xffu);
        if (out < entropy_len) entropy[out++] = uchar((word >> 8u) & 0xffu);
        if (out < entropy_len) entropy[out++] = uchar((word >> 16u) & 0xffu);
        if (out < entropy_len) entropy[out++] = uchar((word >> 24u) & 0xffu);
    }
    return true;
}

template <typename Profile>
static inline bool prng64_mvw_web3_mathrandom_account_private(int entropy_len,
                                                              thread uchar* entropy,
                                                              ulong math_random_state,
                                                              ulong skip64) {
    if (entropy_len < 32) return false;

    Profile profile(math_random_state);
    for (ulong n = 0ul; n < skip64; ++n) {
        (void)prng64_browserify_byte1(profile);
    }

    uchar entropy_hex[32];
    uchar inner_random[32];
    uchar middle_left[32];
    uchar middle_right[32];
    for (int i = 0; i < 32; ++i) entropy_hex[i] = prng64_browserify_byte1(profile);
    for (int i = 0; i < 32; ++i) inner_random[i] = prng64_browserify_byte1(profile);
    for (int i = 0; i < 32; ++i) middle_left[i] = prng64_browserify_byte1(profile);
    for (int i = 0; i < 32; ++i) middle_right[i] = prng64_browserify_byte1(profile);

    uchar inner_msg[64];
    for (int i = 0; i < 32; ++i) inner_msg[i] = inner_random[i];
    for (int i = 0; i < 32; ++i) inner_msg[32 + i] = entropy_hex[i];

    uchar inner_hash[32];
    keccak(reinterpret_cast<thread const char*>(inner_msg), 64, inner_hash, 32);

    uchar outer_msg[96];
    for (int i = 0; i < 32; ++i) outer_msg[i] = middle_left[i];
    for (int i = 0; i < 32; ++i) outer_msg[32 + i] = inner_hash[i];
    for (int i = 0; i < 32; ++i) outer_msg[64 + i] = middle_right[i];

    if (entropy_len > 32) {
        for (int i = 0; i < entropy_len - 32; ++i) entropy[i] = 0u;
    }
    keccak(reinterpret_cast<thread const char*>(outer_msg), 96, entropy + (entropy_len - 32), 32);
    return true;
}

// PRNG64 provider-backed cases 53..60.
// PRNG64 cases 53..60 and their helper classes.
// MbedTlsCtrDrbg64, MbedTlsHmacDrbg64, BotanAnsiX931Rng64,
// BotanHmacRng64, BotanRandpool64, BotanChaChaRng64,
// BotanHmacDrbg64, BouncyCtrSP800Drbg64.

constant uchar PRNG64_PERS_MBEDTLS_HMAC_DRBG[16] = {
    'm','b','e','d','T','L','S','H','M','A','C','D','R','B','G',0
};

