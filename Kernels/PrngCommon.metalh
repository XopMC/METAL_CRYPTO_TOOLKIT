    uint next() {
        lcg = lcg * 6364136223846793005ul + 1442695040888963407ul;
        x ^= x << 13u;
        x ^= x >> 17u;
        x ^= x << 15u;
        return uint(lcg + x);
    }
};

class Prng32KnuthB32Std {
    static constant uint PM_A = 16807u;
    static constant uint PM_M = 2147483647u;
    uint state;
    uint table[256];
    uint y;

    uint minstd_next() {
        ulong p = ulong(PM_A) * ulong(state);
        state = uint(p % PM_M);
        if (state == 0u) {
            state = 1u;
        }
        return state;
    }
public:
    explicit Prng32KnuthB32Std(uint seed) {
        state = seed % PM_M;
        if (state == 0u) {
            state = 1u;
        }
        for (int i = 0; i < 256; ++i) {
            table[i] = minstd_next();
        }
        y = minstd_next();
    }

    uint next() {
        uint j = y & 255u;
        y = table[j];
        table[j] = minstd_next();
        return (y << 1u) | (y >> 30u);
    }
};

class Prng32Ranlux24Base32 {
    uint st[24];
    int idx;
    uint carry;

    uint step24() {
        const uint MOD24 = 1u << 24u;
        int i = idx;
        int j = i + 24 - 10;
        if (j >= 24) {
            j -= 24;
        }
        uint x = st[j];
        uint y = st[i];
        uint r;
        uint yc = y + carry;
        if (x >= yc) {
            r = x - yc;
            carry = 0u;
        } else {
            r = MOD24 + x - yc;
            carry = 1u;
        }
        st[i] = r & 0xffffffu;
        idx = i + 1;
        if (idx >= 24) {
            idx = 0;
        }
        return st[i];
    }
public:
    explicit Prng32Ranlux24Base32(uint seed) : idx(0), carry(0u) {
        uint x = seed ? seed : 1u;
        uint nz = 0u;
        for (int i = 0; i < 24; ++i) {
            x = x * 1664525u + 1013904223u;
            st[i] = (x >> 8u) & 0xffffffu;
            nz |= st[i];
        }
        if (nz == 0u) {
            st[0] = 1u;
        }
        carry = (st[23] == 0u) ? 1u : 0u;
    }

    uint next() {
        uint a = step24();
        uint b = step24();
        return (a << 8u) ^ (b & 0xffu);
    }
};

class Prng32Ranlux24Std32 {
    Prng32Ranlux24Base32 core;
    int used;
public:
    explicit Prng32Ranlux24Std32(uint seed) : core(seed), used(0) {}

    uint next() {
        if (used >= 23) {
            for (int i = 0; i < 200; ++i) {
                (void)core.next();
            }
            used = 0;
        }
        used++;
        return core.next();
    }
};

class Prng32XORWOWGenerator {
    uint x;
    uint y;
    uint z;
    uint w;
    uint v;
    uint d;
public:
    explicit Prng32XORWOWGenerator(uint seed)
        : x(seed), y((seed << 1u) | 1u), z((seed << 2u) | 1u), w((seed << 3u) | 1u), v((seed << 4u) | 1u), d(0u) {}

    uint next() {
        uint t = x ^ (x >> 2u);
        x = y;
        y = z;
        z = w;
        w = v;
        v = (v ^ (v << 4u)) ^ (t ^ (t << 1u));
        d += 362437u;
        return v + d;
    }
};

class Prng32ARC4Generator {
    uchar S[256];
    uchar i;
    uchar j;
public:
    explicit Prng32ARC4Generator(uint seed) : i(0), j(0) {
        for (int n = 0; n < 256; ++n) {
            S[n] = uchar(n);
        }
        uchar j2 = 0u;
        for (int n = 0; n < 256; ++n) {
            j2 += S[n] + uchar((seed >> uint((n & 3) * 8)) & 0xffu);
            uchar tmp = S[n];
            S[n] = S[j2];
            S[j2] = tmp;
        }
    }

    uint next() {
        i++;
        j += S[i];
        uchar tmp = S[i];
        S[i] = S[j];
        S[j] = tmp;
        return uint(S[(S[i] + S[j]) & 0xffu]);
    }
};

class Prng32SosemanukGenerator {
    uint ss1;
    uint ss2;
    uint s3;
    uint s4;
public:
    explicit Prng32SosemanukGenerator(uint seed)
        : ss1(seed), ss2(seed ^ 0xdeadbeefu), s3(seed + 0x9e3779b9u), s4(~seed) {}

    uint next() {
        uint z = ss1 + s4;
        uint t = ss2 ^ (ss2 << 11u);
        ss2 = s3;
        s3 = s4;
        s4 = z ^ (t ^ (t >> 8u));
        ss1 = (ss1 << 7u) | (ss1 >> 25u);
        return ss1 + ss2 + s3 + s4;
    }
};

static inline uint prng32_seed_step32_local(thread ulong& s) {
    s = s * 6364136223846793005ul + 1442695040888963407ul;
    return uint(s >> 32u);
}

static inline ulong prng32_seed_mix64_local(thread ulong& x) {
    x += 0x9e3779b97f4a7c15ul;
    ulong z = x;
    z = (z ^ (z >> 30u)) * 0xbf58476d1ce4e5b9ul;
    z = (z ^ (z >> 27u)) * 0x94d049bb133111ebul;
    return z ^ (z >> 31u);
}

static inline uint prng32_fold64_to32_local(ulong x) {
    return uint(x) ^ uint(x >> 32u);
}

static inline ulong prng32_mul_add64_carry_local(ulong a, ulong b, ulong c, thread ulong& hi) {
    const ulong lo = a * b;
    ulong h = prng32_umul64hi(a, b);
    const ulong out = lo + c;
    h += (out < lo) ? 1ul : 0ul;
    hi = h;
    return out;
}

class Prng32Philox4x32Generator {
    uint ctr[4];
public:
    explicit Prng32Philox4x32Generator(uint seed) {
        for (int i = 0; i < 4; ++i) {
            ctr[i] = seed + uint(i);
        }
    }
    uint next() {
        const uint W0 = 0x9e3779b9u;
        const uint W1 = 0xbb67ae85u;
        for (int r = 0; r < 4; ++r) {
            const ulong m0 = ulong(ctr[0]) * 0xd256d193ul;
            const ulong m1 = ulong(ctr[2]) * 0xcd9e8d57ul;
            const uint hi0 = uint(m0 >> 32u);
            const uint hi1 = uint(m1 >> 32u);
            ctr[0] = hi1;
            ctr[1] ^= ctr[3] ^ W0;
            ctr[2] = hi0;
            ctr[3] ^= ctr[1] ^ W1;
        }
        return ctr[0];
    }
};

class Prng32Philox2x32_10 {
    ulong ctr;
    uint key;
public:
    explicit Prng32Philox2x32_10(uint seed) : ctr(0ul), key(seed ^ 0x9e3779b9u) {}
    uint next() {
        const uint hi = prng32_mul32_hi(uint(ctr), 0xd256d193u);
        const uint lo = uint(ctr) * 0x9e3779b9u;
        ctr++;
        return hi ^ key ^ lo;
    }
};

class Prng32Threefry2x32Generator {
    uint x0, x1;
public:
    explicit Prng32Threefry2x32Generator(uint seed) : x0(seed), x1(~seed) {}
    uint next() {
        x0 += x1; x1 = prng32_rotl32(x1, 13u) ^ x0;
        x0 += x1; x1 = prng32_rotl32(x1, 16u) ^ x0;
        return x0;
    }
};

class Prng32Threefry4x32_4RGenerator {
    uint x[4];
public:
    explicit Prng32Threefry4x32_4RGenerator(uint seed) {
        for (int i = 0; i < 4; ++i) {
            x[i] = seed + 0x9e3779b9u * uint(i);
        }
    }
    uint next() {
        for (int r = 0; r < 4; ++r) {
            x[0] += x[1]; x[1] = prng32_rotl32(x[1], 13u) ^ x[0];
            x[2] += x[3]; x[3] = prng32_rotl32(x[3], 16u) ^ x[2];
            if ((r & 1) == 0) {
                x[0] += x[3];
                x[3] = prng32_rotl32(x[3], 23u) ^ x[0];
            }
        }
        return x[0];
    }
};

class Prng32Threefry4x32_20 {
    uint ctr[4];
    uint key[5];
public:
    explicit Prng32Threefry4x32_20(uint seed) {
        ctr[0] = seed;
        ctr[1] = seed ^ 0x9e3779b9u;
        ctr[2] = seed * 3u + 1u;
        ctr[3] = seed * 7u + 1u;
        key[0] = seed;
        key[1] = 0x1bd11bdau;
        key[2] = 0xa9fc1a22u;
        key[3] = 0xc6e00bf3u;
        key[4] = key[0] ^ key[1] ^ key[2] ^ key[3] ^ 0x1bd11bdau;
    }
    uint next() {
        uint x = ctr[0] += 0x9e3779b9u;
        x ^= prng32_rotl32(x + key[(ctr[0] + ctr[1]) & 3u], 13u);
        return x;
    }
};

class Prng32WELL512Generator {
    uint state[16];
    int idx;
public:
    explicit Prng32WELL512Generator(uint seed) : idx(0) {
        state[0] = seed;
        for (int i = 1; i < 16; ++i) {
            state[i] = 1812433253u * (state[i - 1] ^ (state[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const uint a = state[idx];
        const uint b = state[(idx + 13) & 15];
        const uint c = state[(idx + 9) & 15];
        const uint d = state[(idx + 15) & 15];
        const uint e = a ^ b ^ (a << 16u) ^ (b << 15u);
        const uint f = c ^ (c >> 11u);
        const uint g = e ^ f;
        const uint h = d ^ (d >> 2u) ^ g;
        state[idx] = h;
        idx = (idx + 15) & 15;
        return state[idx];
    }
};

class Prng32WELL1024Generator {
    uint state[32];
    int idx;
public:
    explicit Prng32WELL1024Generator(uint seed) : idx(0) {
        state[0] = seed;
        for (int i = 1; i < 32; ++i) {
            state[i] = 1812433253u * (state[i - 1] ^ (state[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const uint a = state[idx];
        const uint b = state[(idx + 3) & 31];
        const uint c = state[(idx + 24) & 31];
        const uint d = state[(idx + 31) & 31];
        const uint e = a ^ b ^ (a << 8u) ^ (b << 19u);
        const uint f = c ^ (c >> 11u);
        const uint g = e ^ f;
        const uint h = d ^ (d >> 2u) ^ g;
        state[idx] = h;
        idx = (idx + 31) & 31;
        return state[idx];
    }
};

class Prng32WELL19937aGenerator {
    uint state[312];
    int idx;
public:
    explicit Prng32WELL19937aGenerator(uint seed) : idx(0) {
        state[0] = seed;
        for (int i = 1; i < 312; ++i) {
            state[i] = 1812433253u * (state[i - 1] ^ (state[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        const uint a = state[idx];
        const uint b = state[(idx + 151) % 312];
        const uint c = state[(idx + 10) % 312];
        const uint z = a ^ (a << 8u) ^ b ^ (b << 14u) ^ c ^ (c >> 11u);
        state[idx] = z;
        idx = (idx + 1) % 312;
        return z;
    }
};

class Prng32WELL607a {
    uint state[19];
    int idx;
    uint mat0(uint v) { return (v & 0x80000000u) ^ (v << 16u); }
public:
    explicit Prng32WELL607a(uint seed) : idx(0) {
        for (int i = 0; i < 19; ++i) {
            seed = seed * 1664525u + 1013904223u;
            state[i] = seed;
        }
    }
    uint next() {
        const uint a = state[idx];
        const uint b = state[(idx + 3) % 19];
        const uint c = state[(idx + 13) % 19];
        const uint d = state[(idx + 16) % 19];
        const uint e = mat0(a) ^ mat0(b);
        const uint f = e ^ c ^ (c >> 11u);
        state[idx] = f ^ (d << 13u);
        idx = (idx + 18) % 19;
        return state[idx];
    }
};

class Prng32WELL44497a {
