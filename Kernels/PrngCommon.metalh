class Prng64OpenJDKSHA1PRNG {
    uchar state[20];
    uchar remainder[20];
    int rem_count;
    void update_state(thread const uchar output[20]) {
        int carry = 1;
        bool changed = false;
        for (int i = 0; i < 20; ++i) {
            const int v = int(state[i]) + int(output[i]) + carry;
            const uchar t = uchar(v);
            changed = changed || (state[i] != t);
            state[i] = t;
            carry = v >> 8;
        }
        if (!changed) state[0] = uchar(state[0] + 1u);
    }
    void next_bytes(thread uchar* result, int result_len) {
        int index = 0;
        int todo;
        thread uchar* output = remainder;
        uchar digest[20];
        int r = rem_count;
        if (r > 0) {
            todo = ((result_len - index) < (20 - r)) ? (result_len - index) : (20 - r);
            for (int i = 0; i < todo; ++i) {
                result[i] = output[r];
                output[r++] = 0u;
            }
            rem_count += todo;
            index += todo;
        }
        while (index < result_len) {
            prng64_provider_sha1_hash(state, 20, digest);
            update_state(digest);
            output = digest;
            todo = ((result_len - index) > 20) ? 20 : (result_len - index);
            for (int i = 0; i < todo; ++i) {
                result[index++] = output[i];
                output[i] = 0u;
            }
            rem_count += todo;
        }
        for (int i = 0; i < 20; ++i) remainder[i] = output[i];
        rem_count %= 20;
    }
public:
    explicit Prng64OpenJDKSHA1PRNG(ulong seed) : rem_count(0) {
        uchar material[20];
        for (int i = 0; i < 20; ++i) {
            state[i] = 0u;
            remainder[i] = 0u;
        }
        prng64_provider_fill_material(seed, 0x4f4a444b53484131ul, 0x50524e4753454544ul, material, 20);
        prng64_provider_sha1_hash(material, 20, state);
    }
    ulong next() {
        uchar out[8];
        next_bytes(out, 8);
        ulong value = 0ul;
        for (int i = 0; i < 8; ++i) {
            value = (value << 8u) | ulong(out[i]);
        }
        return value;
    }
};

class Prng64JavaUtilRandom {
    ulong state;
public:
    explicit Prng64JavaUtilRandom(ulong seed) {
        state = (seed ^ 0x5DEECE66Dul) & PRNG64_JAVA_MASK48;
    }
    uint next32() {
        state = (state * 25214903917ul + 11ul) & PRNG64_JAVA_MASK48;
        return uint(state >> 16u);
    }
    ulong next() {
        const ulong hi = ulong(next32());
        const ulong lo = ulong(next32());
        return (hi << 32u) | lo;
    }
};

class Prng64JavaUtilRandomNextBytes {
    ulong state;
public:
    explicit Prng64JavaUtilRandomNextBytes(ulong seed) {
        state = (seed ^ 0x5DEECE66Dul) & PRNG64_JAVA_MASK48;
    }
    uint next32() {
        state = (state * 25214903917ul + 11ul) & PRNG64_JAVA_MASK48;
        return uint(state >> 16u);
    }
    ulong next() {
        const ulong lo = ulong(next32());
        const ulong hi = ulong(next32());
        return lo | (hi << 32u);
    }
};

class Prng64AlphaWalletTinyMT32 {
    uint status[4];
public:
    explicit Prng64AlphaWalletTinyMT32(ulong seed) {
        const uint seed32 = uint(seed);
        status[0] = seed32;
        status[1] = 0x8f7011eeu;
        status[2] = 0xfc78ff1fu;
        status[3] = 0x3793fdffu;
        for (int i = 1; i < 8; ++i) {
            const uint x = 1812433253u * (status[uint(i) & 3u] ^ (status[uint(i) & 3u] >> 30u)) + uint(i);
            status[uint(i) & 3u] ^= x;
        }
        for (int i = 0; i < 8; ++i) {
            (void)next32();
        }
    }
    uint next32() {
        uint x = (status[0] & 0x7fffffffu) ^ status[1] ^ status[2];
        x ^= x << 1u;
        x ^= x >> 1u;
        x ^= status[3] >> 1u;
        status[0] = status[1];
        status[1] = status[2];
        status[2] = x;
        status[3] = (status[3] & 1u) ? (status[0] ^ 0x8f7011eeu) : status[0];
        uint y = status[3] + status[2];
        y ^= y >> 8u;
        return y;
    }
    ulong next() {
        const ulong lo = ulong(next32());
        const ulong hi = ulong(next32());
        return lo | (hi << 32u);
    }
};

class Prng64RandstormMWC1616Arc4 {
    uint state0;
    uint state1;
    uchar S[256];
    uchar i;
    uchar j;
public:
    explicit Prng64RandstormMWC1616Arc4(ulong seed) : i(0), j(0) {
        uchar pool[256];
        ulong sm = seed ^ 0x52414e4453544f52ul;
        state0 = uint(rng_splitmix64(sm));
        state1 = uint(rng_splitmix64(sm));
        if ((state0 & 0xffffu) == 0u) state0 ^= 0x1a2b3c4du;
        if ((state1 & 0xffffu) == 0u) state1 ^= 0x5e6f7789u;

        int pptr = 0;
        while (pptr < 256) {
            const ushort t = math_random_u16();
            pool[pptr++] = uchar(t >> 8u);
            pool[pptr++] = uchar(t & 255u);
        }
        pptr = 0;
        seed_int(pool, pptr, uint(seed));
        for (uint n = 0u; n < 256u; ++n) {
            S[n] = uchar(n);
        }
        uchar k = 0u;
        for (uint n = 0u; n < 256u; ++n) {
            k = uchar(k + S[n] + pool[n]);
            const uchar t = S[n];
            S[n] = S[k];
            S[k] = t;
        }
    }
    ushort math_random_u16() {
        state0 = 18030u * (state0 & 0xffffu) + (state0 >> 16u);
        state1 = 36969u * (state1 & 0xffffu) + (state1 >> 16u);
        const uint x = (state0 << 16u) + (state1 & 0xffffu);
        return ushort(x >> 16u);
    }
    void seed_int(thread uchar pool[256], thread int& pptr, uint x) {
        pool[pptr++] ^= uchar(x & 255u);
        pool[pptr++] ^= uchar((x >> 8u) & 255u);
        pool[pptr++] ^= uchar((x >> 16u) & 255u);
        pool[pptr++] ^= uchar((x >> 24u) & 255u);
        if (pptr >= 256) {
            pptr -= 256;
        }
    }
    uchar next_byte() {
        i = uchar(i + 1u);
        j = uchar(j + S[i]);
        const uchar t = S[i];
        S[i] = S[j];
        S[j] = t;
        return S[uchar(S[i] + S[j])];
    }
    ulong next() {
        ulong v = ulong(next_byte());
        v |= ulong(next_byte()) << 8u;
        v |= ulong(next_byte()) << 16u;
        v |= ulong(next_byte()) << 24u;
        v |= ulong(next_byte()) << 32u;
        v |= ulong(next_byte()) << 40u;
        v |= ulong(next_byte()) << 48u;
        v |= ulong(next_byte()) << 56u;
        return v;
    }
};

static constant ulong PRNG64_RANDSTORM_48_MASK = (1ul << 48u) - 1ul;

struct Prng64RandstormV8_2015Profile {
    ushort a;
    ushort b;
    ushort c;
    ushort d;
    explicit Prng64RandstormV8_2015Profile(ulong seed) {
        a = ushort(seed & 0xffffu);
        b = ushort((seed >> 16u) & 0xffffu);
        c = ushort((seed >> 32u) & 0xffffu);
        d = ushort((seed >> 48u) & 0xffffu);
        if (a < 2u) a = 1u;
        if (b < 2u) b = 1u;
        if (c < 2u) c = 1u;
        if (d < 2u) d = 1u;
    }
    ushort next_pool_u16() {
        const uint r0 = 18030u * uint(a) + uint(b);
        const uint r1 = 36969u * uint(c) + uint(d);
        a = ushort(r0 & 0xffffu);
        b = ushort(r0 >> 16u);
        c = ushort(r1 & 0xffffu);
        d = ushort(r1 >> 16u);
        return ushort((r0 ^ r1) >> 4u);
    }
    ulong next() {
        ulong v = ulong(next_pool_u16());
        v |= ulong(next_pool_u16()) << 16u;
        v |= ulong(next_pool_u16()) << 32u;
        v |= ulong(next_pool_u16()) << 48u;
        return v;
    }
};

struct Prng64RandstormV8_2011Profile {
    uint hi;
    uint lo;
    explicit Prng64RandstormV8_2011Profile(ulong seed) {
        hi = uint(seed >> 32u);
        lo = uint(seed);
        if (hi == 0u) hi = 1u;
        if (lo == 0u) lo = 1u;
    }
    ushort next_pool_u16() {
        hi = 36969u * (hi & 0xffffu) + (hi >> 16u);
        lo = 18273u * (lo & 0xffffu) + (lo >> 16u);
        const uint random_bits = (hi << 16u) + (lo & 0xffffu);
        return ushort((random_bits & 0x3fffffffu) >> 14u);
    }
    ulong next() {
        ulong v = ulong(next_pool_u16());
        v |= ulong(next_pool_u16()) << 16u;
        v |= ulong(next_pool_u16()) << 32u;
        v |= ulong(next_pool_u16()) << 48u;
        return v;
    }
};

struct Prng64RandstormSpiderMonkeyLcg48Profile {
    ulong state;
    explicit Prng64RandstormSpiderMonkeyLcg48Profile(ulong seed)
        : state(seed & PRNG64_RANDSTORM_48_MASK) {
        if (state == 0ul) state = 1ul;
    }
    ushort next_pool_u16() {
        state = (state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
        const ushort out = ushort((state >> 32u) & 0xffffu);
        state = (state * 0x5DEECE66Dul + 0xBul) & PRNG64_RANDSTORM_48_MASK;
        return out;
    }
    ulong next() {
        ulong v = ulong(next_pool_u16());
        v |= ulong(next_pool_u16()) << 16u;
        v |= ulong(next_pool_u16()) << 32u;
        v |= ulong(next_pool_u16()) << 48u;
        return v;
    }
};

struct Prng64RandstormJscWeakRandomProfile {
    uint low;
    uint high;
    explicit Prng64RandstormJscWeakRandomProfile(ulong seed)
        : low(uint(seed) ^ 0x49616E42u), high(uint(seed)) {}
    ushort next_pool_u16() {
        high = (high << 16u) + (high >> 16u);
        high += low;
        low += high;
        return ushort(high >> 16u);
    }
    ulong next() {
        ulong v = ulong(next_pool_u16());
        v |= ulong(next_pool_u16()) << 16u;
        v |= ulong(next_pool_u16()) << 32u;
        v |= ulong(next_pool_u16()) << 48u;
        return v;
    }
};

