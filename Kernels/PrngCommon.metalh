};

class Prng32TT800_32 {
    uint x[25];
    int idx;
public:
    explicit Prng32TT800_32(uint seed) : idx(25) {
        x[0] = seed ? seed : 1u;
        for (int i = 1; i < 25; ++i) {
            x[i] = 1812433253u * (x[i - 1] ^ (x[i - 1] >> 30u)) + uint(i);
        }
    }
    uint next() {
        if (idx >= 25) {
            for (int i = 0; i < 18; ++i) {
                x[i] = x[i + 7] ^ (x[i] >> 1u) ^ ((x[i] & 1u) ? 0x8ebfd028u : 0u);
            }
            for (int i = 18; i < 25; ++i) {
                x[i] = x[i - 18] ^ (x[i] >> 1u) ^ ((x[i] & 1u) ? 0x8ebfd028u : 0u);
            }
            idx = 0;
        }
        uint y = x[idx++];
        y ^= (y << 7u) & 0x2b5b2500u;
        y ^= (y << 15u) & 0xdb8b0000u;
        y ^= y >> 16u;
        return y;
    }
};

