static inline ulong prng32_provider_sha512_rotr32(ulong x, int n) {
    return (x >> n) | (x << (64 - n));
}

static inline ulong prng32_provider_sha512_load_u64_be32(thread const uchar* in) {
    return ((ulong)in[0] << 56) | ((ulong)in[1] << 48) | ((ulong)in[2] << 40) | ((ulong)in[3] << 32) |
        ((ulong)in[4] << 24) | ((ulong)in[5] << 16) | ((ulong)in[6] << 8) | (ulong)in[7];
}

static inline void prng32_provider_sha512_store_u64_be32(thread uchar* out, ulong x) {
    out[0] = (uchar)(x >> 56);
    out[1] = (uchar)(x >> 48);
    out[2] = (uchar)(x >> 40);
    out[3] = (uchar)(x >> 32);
    out[4] = (uchar)(x >> 24);
    out[5] = (uchar)(x >> 16);
    out[6] = (uchar)(x >> 8);
    out[7] = (uchar)x;
}

static inline void prng32_provider_sha512_hash32_local(thread const uchar* msg, size_t len, thread uchar out[64]) {
    ulong h0 = 0x6a09e667f3bcc908ul;
    ulong h1 = 0xbb67ae8584caa73bul;
    ulong h2 = 0x3c6ef372fe94f82bul;
    ulong h3 = 0xa54ff53a5f1d36f1ul;
    ulong h4 = 0x510e527fade682d1ul;
    ulong h5 = 0x9b05688c2b3e6c1ful;
    ulong h6 = 0x1f83d9abfb41bd6bul;
    ulong h7 = 0x5be0cd19137e2179ul;
    uchar padded[512];
    memset(padded, 0, sizeof(padded));
    memcpy(padded, msg, len);
    padded[len] = 0x80u;
    const ulong bit_len = (ulong)len * 8ul;
    size_t total = ((len + 1 + 16 + 127) / 128) * 128;
    if (total > sizeof(padded)) {
        total = sizeof(padded);
    }
    prng32_provider_sha512_store_u64_be32(padded + total - 8, bit_len);
    for (size_t off = 0; off < total; off += 128) {
        ulong w[80];
        for (int i = 0; i < 16; ++i) {
            w[i] = prng32_provider_sha512_load_u64_be32(padded + off + i * 8);
        }
        for (int i = 16; i < 80; ++i) {
            const ulong s0 = prng32_provider_sha512_rotr32(w[i - 15], 1) ^ prng32_provider_sha512_rotr32(w[i - 15], 8) ^ (w[i - 15] >> 7);
            const ulong s1 = prng32_provider_sha512_rotr32(w[i - 2], 19) ^ prng32_provider_sha512_rotr32(w[i - 2], 61) ^ (w[i - 2] >> 6);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        ulong a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;
        for (int i = 0; i < 80; ++i) {
            const ulong S1 = prng32_provider_sha512_rotr32(e, 14) ^ prng32_provider_sha512_rotr32(e, 18) ^ prng32_provider_sha512_rotr32(e, 41);
            const ulong ch = (e & f) ^ ((~e) & g);
            const ulong temp1 = h + S1 + ch + kPrng32ProviderSha512K32[i] + w[i];
            const ulong S0 = prng32_provider_sha512_rotr32(a, 28) ^ prng32_provider_sha512_rotr32(a, 34) ^ prng32_provider_sha512_rotr32(a, 39);
            const ulong maj = (a & b) ^ (a & c) ^ (b & c);
            const ulong temp2 = S0 + maj;
            h = g; g = f; f = e; e = d + temp1;
            d = c; c = b; b = a; a = temp1 + temp2;
        }
        h0 += a; h1 += b; h2 += c; h3 += d;
        h4 += e; h5 += f; h6 += g; h7 += h;
    }
    prng32_provider_sha512_store_u64_be32(out + 0, h0);
    prng32_provider_sha512_store_u64_be32(out + 8, h1);
    prng32_provider_sha512_store_u64_be32(out + 16, h2);
    prng32_provider_sha512_store_u64_be32(out + 24, h3);
    prng32_provider_sha512_store_u64_be32(out + 32, h4);
    prng32_provider_sha512_store_u64_be32(out + 40, h5);
    prng32_provider_sha512_store_u64_be32(out + 48, h6);
    prng32_provider_sha512_store_u64_be32(out + 56, h7);
}

static inline void prng32_provider_hmac_sha512_32(thread const uchar* key, size_t key_len,
    thread const uchar* msg, size_t msg_len,
    thread uchar out_mac[64]) {
    uchar key_block[128];
    uchar inner[512];
    uchar inner_hash[64];
    memset(key_block, 0, sizeof(key_block));
    if (key_len > sizeof(key_block)) {
        prng32_provider_sha512_hash32_local(key, key_len, key_block);
    } else if (key_len > 0) {
        memcpy(key_block, key, key_len);
    }
    for (int i = 0; i < 128; ++i) {
        inner[i] = (uchar)(key_block[i] ^ 0x36u);
    }
    memcpy(inner + 128, msg, msg_len);
    prng32_provider_sha512_hash32_local(inner, 128 + msg_len, inner_hash);
    for (int i = 0; i < 128; ++i) {
        inner[i] = (uchar)(key_block[i] ^ 0x5cu);
    }
    memcpy(inner + 128, inner_hash, sizeof(inner_hash));
    prng32_provider_sha512_hash32_local(inner, 128 + sizeof(inner_hash), out_mac);
}

// Bouncy Castle X931SecureRandom on AESEngine uses a fixed DT vector and entropy-source-backed V updates.
class Prng32BouncyX931SecureRandom32 {
    uchar dt[16];
    uchar v[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;
     void refill() {
        uchar i[16];
        uchar tmp[16];
        provider_aes_encrypt_block(round_keys, dt, i);
        for (int n = 0; n < 16; ++n) {
            tmp[n] = (uchar)(i[n] ^ v[n]);
        }
        provider_aes_encrypt_block(round_keys, tmp, block);
        for (int n = 0; n < 16; ++n) {
            tmp[n] = (uchar)(block[n] ^ i[n]);
        }
        provider_aes_encrypt_block(round_keys, tmp, v);
        for (int n = 15; n >= 0; --n) {
            dt[n] = (uchar)(dt[n] + 1u);
            if (dt[n] != 0u) {
                break;
            }
        }
        block_index = 0;
    }
public:
     explicit Prng32BouncyX931SecureRandom32(uint seed) : block_index(16) {
        uchar material[48];
        prng32_provider_fill_material(seed, 0x424f554e43595839ul, 0x333153525f414553ul, material, (int)sizeof(material));
        memset(dt, 0, sizeof(dt));
        const ulong millis = prng32_mix_stafford13_provider32(((ulong)seed) ^ 0x4258435552524d53ul);
        prng32_provider_sha512_store_u64_be32(dt, millis);
        memcpy(v, material + 32, 16);
        provider_aes_expand_key(material, round_keys);
    }
     uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

class Prng32BotanRandpool32 {
    static constant int kPoolBytes = 512;
    static constant int kBlockBytes = 16;
    uchar mac_key[32];
    int mac_key_len;
    uint round_keys[60];
    uchar pool[kPoolBytes];
    uchar buffer[kBlockBytes];
    uchar counter[12];
    int buffer_index;
     void hmac_tagged(uchar tag, thread const uchar* data, int data_len, thread uchar out[32]) {
        uchar msg[1 + kPoolBytes];
        msg[0] = tag;
        if (data_len > 0) {
            memcpy(msg + 1, data, (size_t)data_len);
        }
        hmac_sha256(mac_key, (size_t)mac_key_len, msg, (size_t)(data_len + 1), out);
    }
     void expand_cipher_key(thread const uchar key[32]) {
        provider_aes_expand_key(key, round_keys);
    }
     void encrypt_block_in_place(thread uchar* block) {
        uchar out[16];
        provider_aes_encrypt_block(round_keys, block, out);
        memcpy(block, out, 16);
    }
     void increment_counter() {
        for (int i = 0; i < 12; ++i) {
            counter[i] = (uchar)(counter[i] + 1u);
            if (counter[i] != 0u) {
                break;
            }
        }
    }
     void mix_pool() {
        uchar new_mac_key[32];
        uchar new_cipher_key[32];
        hmac_tagged(1u, pool, kPoolBytes, new_mac_key);
        memcpy(mac_key, new_mac_key, sizeof(mac_key));
        mac_key_len = 32;
        hmac_tagged(0u, pool, kPoolBytes, new_cipher_key);
        expand_cipher_key(new_cipher_key);
        for (int i = 0; i < kBlockBytes; ++i) {
            pool[i] ^= buffer[i];
        }
        encrypt_block_in_place(pool);
        for (int block = 1; block < kPoolBytes / kBlockBytes; ++block) {
            thread uchar* current = pool + block * kBlockBytes;
            thread const uchar* prev = current - kBlockBytes;
            for (int i = 0; i < kBlockBytes; ++i) {
                current[i] ^= prev[i];
            }
            encrypt_block_in_place(current);
        }
        uchar mac_val[32];
        increment_counter();
        hmac_tagged(2u, counter, 12, mac_val);
        for (int i = 0; i < 32; ++i) {
            buffer[i % kBlockBytes] ^= mac_val[i];
        }
        encrypt_block_in_place(buffer);
        buffer_index = 0;
    }
     void add_entropy_material(thread const uchar* input, int input_len) {
        uchar mac_val[32];
        hmac_sha256(mac_key, (size_t)mac_key_len, input, (size_t)input_len, mac_val);
        for (int i = 0; i < 32; ++i) {
            pool[i] ^= mac_val[i];
        }
        mix_pool();
    }
     void update_buffer() {
        uchar mac_val[32];
        increment_counter();
        hmac_tagged(2u, counter, 12, mac_val);
        for (int i = 0; i < 32; ++i) {
            buffer[i % kBlockBytes] ^= mac_val[i];
        }
        encrypt_block_in_place(buffer);
        if ((counter[0] & 127u) == 0u) {
            mix_pool();
        } else {
            buffer_index = 0;
        }
    }
public:
     explicit Prng32BotanRandpool32(uint seed) : mac_key_len(0), buffer_index(0) {
        uchar material[64];
        memset(mac_key, 0, sizeof(mac_key));
        memset(pool, 0, sizeof(pool));
        memset(buffer, 0, sizeof(buffer));
        memset(counter, 0, sizeof(counter));
        prng32_provider_fill_material(seed, 0x424f544152414e44ul, 0x504f4f4c33325348ul, material, (int)sizeof(material));
        add_entropy_material(material, (int)sizeof(material));
    }
     uint next() {
        if (buffer_index > 12) {
            update_buffer();
        }
        const uint out = prng32_provider_load_u32_be32(buffer + buffer_index);
        buffer_index += 4;
        return out;
    }
};

// Botan 1.10 global RNG wrapped Randpool with ANSI X9.31(AES-256) as the default public surface.
class Prng32BotanAnsiX931Rng32 {
    Prng32BotanRandpool32 prng;
    uchar state[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;
     void draw_bytes(thread uchar* out, int len) {
        int off = 0;
        while (off < len) {
            const uint word = prng.next();
            const int remaining = len - off;
            if (remaining >= 4) {
                prng32_provider_store_u32_be32(out + off, word);
                off += 4;
            } else {
                uchar tmp[4];
                prng32_provider_store_u32_be32(tmp, word);
                memcpy(out + off, tmp, (size_t)remaining);
                break;
            }
        }
    }
     void refill() {
        uchar dt[16];
        uchar enc_dt[16];
        uchar tmp[16];
        draw_bytes(dt, 16);
        provider_aes_encrypt_block(round_keys, dt, enc_dt);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(state[i] ^ enc_dt[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = (uchar)(block[i] ^ enc_dt[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, state);
        block_index = 0;
    }
public:
     explicit Prng32BotanAnsiX931Rng32(uint seed)
        : prng(seed ^ 0x424f54414e583931ul), block_index(16) {
        uchar key[32];
        draw_bytes(key, 32);
        draw_bytes(state, 16);
        provider_aes_expand_key(key, round_keys);
    }
     uint next() {
        if (block_index > 12) {
            refill();
        }
        const uint out = prng32_provider_load_u32_be32(block + block_index);
        block_index += 4;
        return out;
    }
};

// Bouncy Castle HashSP800DRBG via SP800SecureRandomBuilder.
class Prng32BouncyHashSP800Drbg32 {
    Prng32HashDrbgSha256Provider32Core core;
public:
     explicit Prng32BouncyHashSP800Drbg32(uint seed) {
        uchar material[48];
        prng32_provider_fill_material(seed, 0x424f554e43594841ul, 0x5348503830303930ul, material, 32);
        const char kPersonalization[16] = "BouncyHashDRBG";
        memcpy(material + 32, kPersonalization, sizeof(kPersonalization));
        core.init(material, (int)sizeof(material));
    }
     uint next() {
        return core.next();
    }
};

