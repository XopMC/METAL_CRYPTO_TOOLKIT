inline uint random_state_next(device RandomStateData& state, uint id) {
    const ulong seq = ulong(atomic_fetch_add_explicit(&state.counter, 1u, memory_order_relaxed));
    ulong local = state.seed ^ ((seq + 1ul) * 0x9E3779B97F4A7C15ul) ^ ulong(id);
    return uint(rng_splitmix64(local));
}

inline void random32(device RandomStateData& state, thread uint32_t* output, int size, uint id) {
    for (int i = 0; i < size / 4; i++) {
        output[i] = random_state_next(state, id) ^ id;
    }
}

