    'B','o','t','a','n','H','M','A','C','D','R','B','G','6','4',0
};

constant uchar PRNG64_PERS_BOUNCY_CTR_DRBG[16] = {
    'B','o','u','n','c','y','C','t','r','D','R','B','G',0,0,0
};

constant uchar PRNG64_BOTAN_HMAC_RNG_INIT_LABEL[18] = {
    'B','o','t','a','n',' ','H','M','A','C','_','R','N','G',' ','X','T','S'
};

constant uchar PRNG64_BOTAN_HMAC_RNG_LABEL_RNG[3] = { 'r','n','g' };
constant uchar PRNG64_BOTAN_HMAC_RNG_LABEL_RESEED[6] = { 'r','e','s','e','e','d' };

constant uchar PRNG64_BOTAN_HMAC_RNG_LABEL_XTS[3] = { 'x','t','s' };

constant ulong PRNG64_PROVIDER_SHA512_K64[80] = {
    0x428a2f98d728ae22ul, 0x7137449123ef65cdul, 0xb5c0fbcfec4d3b2ful, 0xe9b5dba58189dbbcul,
    0x3956c25bf348b538ul, 0x59f111f1b605d019ul, 0x923f82a4af194f9bul, 0xab1c5ed5da6d8118ul,
    0xd807aa98a3030242ul, 0x12835b0145706fbeul, 0x243185be4ee4b28cul, 0x550c7dc3d5ffb4e2ul,
    0x72be5d74f27b896ful, 0x80deb1fe3b1696b1ul, 0x9bdc06a725c71235ul, 0xc19bf174cf692694ul,
    0xe49b69c19ef14ad2ul, 0xefbe4786384f25e3ul, 0x0fc19dc68b8cd5b5ul, 0x240ca1cc77ac9c65ul,
    0x2de92c6f592b0275ul, 0x4a7484aa6ea6e483ul, 0x5cb0a9dcbd41fbd4ul, 0x76f988da831153b5ul,
    0x983e5152ee66dfabul, 0xa831c66d2db43210ul, 0xb00327c898fb213ful, 0xbf597fc7beef0ee4ul,
    0xc6e00bf33da88fc2ul, 0xd5a79147930aa725ul, 0x06ca6351e003826ful, 0x142929670a0e6e70ul,
    0x27b70a8546d22ffcul, 0x2e1b21385c26c926ul, 0x4d2c6dfc5ac42aedul, 0x53380d139d95b3dful,
    0x650a73548baf63deul, 0x766a0abb3c77b2a8ul, 0x81c2c92e47edaee6ul, 0x92722c851482353bul,
    0xa2bfe8a14cf10364ul, 0xa81a664bbc423001ul, 0xc24b8b70d0f89791ul, 0xc76c51a30654be30ul,
    0xd192e819d6ef5218ul, 0xd69906245565a910ul, 0xf40e35855771202aul, 0x106aa07032bbd1b8ul,
    0x19a4c116b8d2d0c8ul, 0x1e376c085141ab53ul, 0x2748774cdf8eeb99ul, 0x34b0bcb5e19b48a8ul,
    0x391c0cb3c5c95a63ul, 0x4ed8aa4ae3418acbul, 0x5b9cca4f7763e373ul, 0x682e6ff3d6b2b8a3ul,
    0x748f82ee5defb2fcul, 0x78a5636f43172f60ul, 0x84c87814a1f0ab72ul, 0x8cc702081a6439ecul,
    0x90befffa23631e28ul, 0xa4506cebde82bde9ul, 0xbef9a3f7b2c67915ul, 0xc67178f2e372532bul,
    0xca273eceea26619cul, 0xd186b8c721c0c207ul, 0xeada7dd6cde0eb1eul, 0xf57d4f7fee6ed178ul,
    0x06f067aa72176fbaul, 0x0a637dc5a2c898a6ul, 0x113f9804bef90daeul, 0x1b710b35131c471bul,
    0x28db77f523047d84ul, 0x32caab7b40c72493ul, 0x3c9ebe0a15c9bebcul, 0x431d67c49c100d4cul,
    0x4cc5d4becb3e42b6ul, 0x597f299cfc657e2aul, 0x5fcb6fab3ad6faecul, 0x6c44198c4a475817ul
};

static inline void prng64_case53_60_copy_const(thread uchar* dst, constant uchar* src, int len) {
    for (int i = 0; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline uint prng64_case53_60_load_u32_le(thread const uchar* in) {
    return uint(in[0]) |
        (uint(in[1]) << 8u) |
        (uint(in[2]) << 16u) |
        (uint(in[3]) << 24u);
}

static inline ulong prng64_provider_sha512_rotr64_local(ulong x, int n) {
    return (x >> uint(n)) | (x << uint(64 - n));
}

static inline ulong prng64_provider_sha512_load_u64_be_local(thread const uchar* in) {
    return (ulong(in[0]) << 56u) | (ulong(in[1]) << 48u) |
        (ulong(in[2]) << 40u) | (ulong(in[3]) << 32u) |
        (ulong(in[4]) << 24u) | (ulong(in[5]) << 16u) |
        (ulong(in[6]) << 8u) | ulong(in[7]);
}

static inline void prng64_provider_sha512_store_u64_be_local(thread uchar* out, ulong x) {
    out[0] = uchar(x >> 56u);
    out[1] = uchar(x >> 48u);
    out[2] = uchar(x >> 40u);
    out[3] = uchar(x >> 32u);
    out[4] = uchar(x >> 24u);
    out[5] = uchar(x >> 16u);
    out[6] = uchar(x >> 8u);
    out[7] = uchar(x);
}

static inline void prng64_provider_sha512_hash64_local(thread const uchar* msg,
                                                       size_t len,
                                                       thread uchar out[64]) {
    ulong h0 = 0x6a09e667f3bcc908ul;
    ulong h1 = 0xbb67ae8584caa73bul;
    ulong h2 = 0x3c6ef372fe94f82bul;
    ulong h3 = 0xa54ff53a5f1d36f1ul;
    ulong h4 = 0x510e527fade682d1ul;
    ulong h5 = 0x9b05688c2b3e6c1ful;
    ulong h6 = 0x1f83d9abfb41bd6bul;
    ulong h7 = 0x5be0cd19137e2179ul;
    uchar padded[512];
    memset(padded, 0, sizeof(padded));
    memcpy(padded, msg, len);
    padded[len] = 0x80u;
    const ulong bit_len = ulong(len) * 8ul;
    size_t total = ((len + 1 + 16 + 127) / 128) * 128;
    if (total > sizeof(padded)) {
        total = sizeof(padded);
    }
    prng64_provider_sha512_store_u64_be_local(padded + total - 8, bit_len);
    for (size_t off = 0; off < total; off += 128) {
        ulong w[80];
        for (int i = 0; i < 16; ++i) {
            w[i] = prng64_provider_sha512_load_u64_be_local(padded + off + size_t(i * 8));
        }
        for (int i = 16; i < 80; ++i) {
            const ulong s0 = prng64_provider_sha512_rotr64_local(w[i - 15], 1) ^
                prng64_provider_sha512_rotr64_local(w[i - 15], 8) ^
                (w[i - 15] >> 7u);
            const ulong s1 = prng64_provider_sha512_rotr64_local(w[i - 2], 19) ^
                prng64_provider_sha512_rotr64_local(w[i - 2], 61) ^
                (w[i - 2] >> 6u);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        ulong a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;
        for (int i = 0; i < 80; ++i) {
            const ulong S1 = prng64_provider_sha512_rotr64_local(e, 14) ^
                prng64_provider_sha512_rotr64_local(e, 18) ^
                prng64_provider_sha512_rotr64_local(e, 41);
            const ulong ch = (e & f) ^ ((~e) & g);
            const ulong temp1 = h + S1 + ch + PRNG64_PROVIDER_SHA512_K64[i] + w[i];
            const ulong S0 = prng64_provider_sha512_rotr64_local(a, 28) ^
                prng64_provider_sha512_rotr64_local(a, 34) ^
                prng64_provider_sha512_rotr64_local(a, 39);
            const ulong maj = (a & b) ^ (a & c) ^ (b & c);
            const ulong temp2 = S0 + maj;
            h = g; g = f; f = e; e = d + temp1;
            d = c; c = b; b = a; a = temp1 + temp2;
        }
        h0 += a; h1 += b; h2 += c; h3 += d;
        h4 += e; h5 += f; h6 += g; h7 += h;
    }
    prng64_provider_sha512_store_u64_be_local(out + 0, h0);
    prng64_provider_sha512_store_u64_be_local(out + 8, h1);
    prng64_provider_sha512_store_u64_be_local(out + 16, h2);
    prng64_provider_sha512_store_u64_be_local(out + 24, h3);
    prng64_provider_sha512_store_u64_be_local(out + 32, h4);
    prng64_provider_sha512_store_u64_be_local(out + 40, h5);
    prng64_provider_sha512_store_u64_be_local(out + 48, h6);
    prng64_provider_sha512_store_u64_be_local(out + 56, h7);
}

static inline void prng64_provider_hmac_sha512_64(thread const uchar* key,
                                                  size_t key_len,
                                                  thread const uchar* msg,
                                                  size_t msg_len,
                                                  thread uchar out_mac[64]) {
    uchar key_block[128];
    uchar inner[512];
    uchar inner_hash[64];
    memset(key_block, 0, sizeof(key_block));
    if (key_len > sizeof(key_block)) {
        prng64_provider_sha512_hash64_local(key, key_len, key_block);
    } else if (key_len > 0) {
        memcpy(key_block, key, key_len);
    }
    for (int i = 0; i < 128; ++i) {
        inner[i] = uchar(key_block[i] ^ 0x36u);
    }
    memcpy(inner + 128, msg, msg_len);
    prng64_provider_sha512_hash64_local(inner, 128 + msg_len, inner_hash);
    for (int i = 0; i < 128; ++i) {
        inner[i] = uchar(key_block[i] ^ 0x5cu);
    }
    memcpy(inner + 128, inner_hash, sizeof(inner_hash));
    prng64_provider_sha512_hash64_local(inner, 128 + sizeof(inner_hash), out_mac);
}

// Botan 1.10 Randpool was the library's primary PRNG, using AES-256 and HMAC(SHA-256).
class BotanRandpool64 {
    static constant int kPoolBytes = 512;
    static constant int kBlockBytes = 16;
    uchar mac_key[32];
    int mac_key_len;
    uint round_keys[60];
    uchar pool[kPoolBytes];
    uchar buffer[kBlockBytes];
    uchar counter[12];
    int buffer_index;

    void hmac_tagged(uchar tag, thread const uchar* data, int data_len, thread uchar out[32]) {
        uchar msg[1 + kPoolBytes];
        msg[0] = tag;
        if (data_len > 0) {
            memcpy(msg + 1, data, size_t(data_len));
        }
        hmac_sha256(mac_key, size_t(mac_key_len), msg, size_t(data_len + 1), out);
    }

    void expand_cipher_key(thread const uchar key[32]) {
        provider_aes_expand_key(key, round_keys);
    }

    void encrypt_block_in_place(thread uchar* block) {
        uchar out[16];
        provider_aes_encrypt_block(round_keys, block, out);
        memcpy(block, out, 16);
    }

    void increment_counter() {
        for (int i = 0; i < 12; ++i) {
            counter[i] = uchar(counter[i] + 1u);
            if (counter[i] != 0u) {
                break;
            }
        }
    }

    void mix_pool() {
        uchar new_mac_key[32];
        uchar new_cipher_key[32];
        hmac_tagged(1u, pool, kPoolBytes, new_mac_key);
        memcpy(mac_key, new_mac_key, sizeof(mac_key));
        mac_key_len = 32;
        hmac_tagged(0u, pool, kPoolBytes, new_cipher_key);
        expand_cipher_key(new_cipher_key);
        for (int i = 0; i < kBlockBytes; ++i) {
            pool[i] ^= buffer[i];
        }
        encrypt_block_in_place(pool);
        for (int block = 1; block < kPoolBytes / kBlockBytes; ++block) {
            thread uchar* current = pool + block * kBlockBytes;
            thread const uchar* prev = current - kBlockBytes;
            for (int i = 0; i < kBlockBytes; ++i) {
                current[i] ^= prev[i];
            }
            encrypt_block_in_place(current);
        }
        uchar mac_val[32];
        increment_counter();
        hmac_tagged(2u, counter, 12, mac_val);
        for (int i = 0; i < 32; ++i) {
            buffer[i % kBlockBytes] ^= mac_val[i];
        }
        encrypt_block_in_place(buffer);
        buffer_index = 0;
    }

    void add_entropy_material(thread const uchar* input, int input_len) {
        uchar mac_val[32];
        hmac_sha256(mac_key, size_t(mac_key_len), input, size_t(input_len), mac_val);
        for (int i = 0; i < 32; ++i) {
            pool[i] ^= mac_val[i];
        }
        mix_pool();
    }

    void update_buffer() {
        uchar mac_val[32];
        increment_counter();
        hmac_tagged(2u, counter, 12, mac_val);
        for (int i = 0; i < 32; ++i) {
            buffer[i % kBlockBytes] ^= mac_val[i];
        }
        encrypt_block_in_place(buffer);
        if ((counter[0] & 127u) == 0u) {
            mix_pool();
        } else {
            buffer_index = 0;
        }
    }

public:
    explicit BotanRandpool64(ulong seed) : mac_key_len(0), buffer_index(0) {
        uchar material[64];
        memset(mac_key, 0, sizeof(mac_key));
        memset(pool, 0, sizeof(pool));
        memset(buffer, 0, sizeof(buffer));
        memset(counter, 0, sizeof(counter));
        prng64_provider_fill_material(seed, 0x424f544152414e44ul, 0x504f4f4c36345348ul, material, int(sizeof(material)));
        add_entropy_material(material, int(sizeof(material)));
    }

    ulong next() {
        if (buffer_index > 8) {
            update_buffer();
        }
        const ulong out = prng64_provider_load_u64_be(buffer + buffer_index);
        buffer_index += 8;
        return out;
    }
};

// Botan 1.10 global RNG wrapped Randpool with ANSI X9.31(AES-256) as the default public surface.
class BotanAnsiX931Rng64 {
    BotanRandpool64 prng;
    uchar state[16];
    uchar block[16];
    uint round_keys[60];
    int block_index;

    void draw_bytes(thread uchar* out, int len) {
        int off = 0;
        while (off < len) {
            const ulong word = prng.next();
            const int remaining = len - off;
            if (remaining >= 8) {
                prng64_store64_be(out + off, word);
                off += 8;
            } else {
                uchar tmp[8];
                prng64_store64_be(tmp, word);
                memcpy(out + off, tmp, size_t(remaining));
                break;
            }
        }
    }

    void refill() {
        uchar dt[16];
        uchar enc_dt[16];
        uchar tmp[16];
        draw_bytes(dt, 16);
        provider_aes_encrypt_block(round_keys, dt, enc_dt);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = uchar(state[i] ^ enc_dt[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, block);
        for (int i = 0; i < 16; ++i) {
            tmp[i] = uchar(block[i] ^ enc_dt[i]);
        }
        provider_aes_encrypt_block(round_keys, tmp, state);
        block_index = 0;
    }

public:
    explicit BotanAnsiX931Rng64(ulong seed)
        : prng(seed ^ 0x424f54414e583931ul), block_index(16) {
        uchar key[32];
        draw_bytes(key, 32);
        draw_bytes(state, 16);
        provider_aes_expand_key(key, round_keys);
    }

    ulong next() {
        if (block_index > 8) {
            refill();
        }
        const ulong out = prng64_provider_load_u64_be(block + block_index);
        block_index += 8;
        return out;
    }
};

