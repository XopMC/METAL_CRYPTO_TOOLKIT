class Prng32Xorshift128Generator {
    uint x, y, z, w;
public:
    explicit Prng32Xorshift128Generator(uint seed)
        : x(seed), y(seed ^ 0x6c078965u), z(seed ^ 0x714acb41u), w(seed ^ 0x5d588b65u) {}
    uint next() {
        const uint t = x ^ (x << 11u);
        x = y;
        y = z;
