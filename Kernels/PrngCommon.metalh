class Prng64Xoroshiro1024Star {
    ulong s[16];
    int p;
public:
    explicit Prng64Xoroshiro1024Star(ulong seed) : p(0) {
        ulong sm = seed;
        for (int i = 0; i < 16; ++i) s[i] = prng64_splitmix64_next(sm);
    }
    ulong next() {
        ulong s0 = s[p];
        ulong s1 = s[p = (p + 1) & 15];
        s1 ^= s1 << 31u;
        s1 ^= s1 >> 11u;
        s0 ^= s0 >> 30u;
        s[p] = s0 ^ s1;
