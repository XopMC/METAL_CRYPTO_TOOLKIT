class Prng32GeffeGenerator {
    uint ss0;
    uint ss1;
    uint ss2;

    uint lfsr(thread uint& s) {
        s = (s << 1u) ^ (uint(-int(s >> 31u)) & 0x80000057u);
        return s & 1u;
    }
public:
    explicit Prng32GeffeGenerator(uint seed) : ss0(seed | 1u), ss1(seed ^ 0xa5a5a5a5u), ss2(seed ^ 0x5a5a5a5au) {}
    uint next() {
        const uint b0 = lfsr(ss0);
        const uint b1 = lfsr(ss1);
        const uint b2 = lfsr(ss2);
        return (b0 & b1) ^ ((~b0) & b2);
    }
};

class Prng32BaysDurhamLCG32 {
    uint state;
