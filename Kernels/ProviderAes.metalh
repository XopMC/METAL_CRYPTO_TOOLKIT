#ifndef METAL_CRYPTO_PROVIDER_AES_METALH
#define METAL_CRYPTO_PROVIDER_AES_METALH

#include <metal_stdlib>

using namespace metal;

constant uchar kProviderAesSbox[256] = {
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16
};

constant uchar kProviderAesRcon[10] = {
    0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36
};

static inline uint provider_aes_rotword(uint w) {
    return (w << 8u) | (w >> 24u);
}

static inline uint provider_aes_subword(uint w) {
    return (uint(kProviderAesSbox[(w >> 24u) & 0xffu]) << 24u) |
           (uint(kProviderAesSbox[(w >> 16u) & 0xffu]) << 16u) |
           (uint(kProviderAesSbox[(w >> 8u) & 0xffu]) << 8u) |
            uint(kProviderAesSbox[w & 0xffu]);
}

static inline uchar provider_aes_xtime(uchar x) {
    return uchar((x << 1u) ^ ((x & 0x80u) ? 0x1bu : 0x00u));
}

static inline void provider_aes_expand_key(const thread uchar key[32], thread uint round_keys[60]) {
    for (int i = 0; i < 8; ++i) {
        round_keys[i] =
            (uint(key[i * 4]) << 24u) |
            (uint(key[i * 4 + 1]) << 16u) |
            (uint(key[i * 4 + 2]) << 8u) |
             uint(key[i * 4 + 3]);
    }
    for (int i = 8; i < 60; ++i) {
        uint temp = round_keys[i - 1];
        if ((i & 7) == 0) {
            temp = provider_aes_subword(provider_aes_rotword(temp)) ^
                (uint(kProviderAesRcon[(i / 8) - 1]) << 24u);
        } else if ((i & 7) == 4) {
            temp = provider_aes_subword(temp);
        }
        round_keys[i] = round_keys[i - 8] ^ temp;
    }
}

static inline void provider_aes_expand_key128(const thread uchar key[16], thread uint round_keys[44]) {
    for (int i = 0; i < 4; ++i) {
        round_keys[i] =
            (uint(key[i * 4]) << 24u) |
            (uint(key[i * 4 + 1]) << 16u) |
            (uint(key[i * 4 + 2]) << 8u) |
             uint(key[i * 4 + 3]);
    }
    for (int i = 4; i < 44; ++i) {
        uint temp = round_keys[i - 1];
        if ((i & 3) == 0) {
            temp = provider_aes_subword(provider_aes_rotword(temp)) ^
                (uint(kProviderAesRcon[(i / 4) - 1]) << 24u);
        }
        round_keys[i] = round_keys[i - 4] ^ temp;
    }
}

static inline void provider_aes_add_round_key(thread uchar state[16], const thread uint* round_keys, int round) {
    for (int col = 0; col < 4; ++col) {
        const uint rk = round_keys[round * 4 + col];
        state[col * 4 + 0] ^= uchar(rk >> 24u);
        state[col * 4 + 1] ^= uchar(rk >> 16u);
        state[col * 4 + 2] ^= uchar(rk >> 8u);
        state[col * 4 + 3] ^= uchar(rk);
    }
}

static inline void provider_aes_sub_bytes(thread uchar state[16]) {
    for (int i = 0; i < 16; ++i) {
        state[i] = kProviderAesSbox[state[i]];
    }
}

static inline void provider_aes_shift_rows(thread uchar state[16]) {
    uchar t[16];
    t[0] = state[0];   t[4] = state[4];   t[8] = state[8];    t[12] = state[12];
    t[1] = state[5];   t[5] = state[9];   t[9] = state[13];   t[13] = state[1];
    t[2] = state[10];  t[6] = state[14];  t[10] = state[2];   t[14] = state[6];
    t[3] = state[15];  t[7] = state[3];   t[11] = state[7];   t[15] = state[11];
    for (int i = 0; i < 16; ++i) state[i] = t[i];
}

static inline void provider_aes_mix_columns(thread uchar state[16]) {
    for (int col = 0; col < 4; ++col) {
        const int i = col * 4;
        const uchar a0 = state[i + 0];
        const uchar a1 = state[i + 1];
        const uchar a2 = state[i + 2];
        const uchar a3 = state[i + 3];
        const uchar m0 = provider_aes_xtime(a0);
        const uchar m1 = provider_aes_xtime(a1);
        const uchar m2 = provider_aes_xtime(a2);
        const uchar m3 = provider_aes_xtime(a3);
        state[i + 0] = uchar(m0 ^ (m1 ^ a1) ^ a2 ^ a3);
        state[i + 1] = uchar(a0 ^ m1 ^ (m2 ^ a2) ^ a3);
        state[i + 2] = uchar(a0 ^ a1 ^ m2 ^ (m3 ^ a3));
        state[i + 3] = uchar((m0 ^ a0) ^ a1 ^ a2 ^ m3);
    }
}

static inline void provider_aes_encrypt_block(const thread uint round_keys[60],
                                              const thread uchar in[16],
                                              thread uchar out[16]) {
    uchar state[16];
    for (int i = 0; i < 16; ++i) state[i] = in[i];
    provider_aes_add_round_key(state, round_keys, 0);
    for (int round = 1; round < 14; ++round) {
        provider_aes_sub_bytes(state);
        provider_aes_shift_rows(state);
        provider_aes_mix_columns(state);
        provider_aes_add_round_key(state, round_keys, round);
    }
    provider_aes_sub_bytes(state);
    provider_aes_shift_rows(state);
    provider_aes_add_round_key(state, round_keys, 14);
    for (int i = 0; i < 16; ++i) out[i] = state[i];
}

static inline void provider_aes_encrypt_block128(const thread uint round_keys[44],
                                                 const thread uchar in[16],
                                                 thread uchar out[16]) {
    uchar state[16];
    for (int i = 0; i < 16; ++i) state[i] = in[i];
    provider_aes_add_round_key(state, round_keys, 0);
    for (int round = 1; round < 10; ++round) {
        provider_aes_sub_bytes(state);
        provider_aes_shift_rows(state);
        provider_aes_mix_columns(state);
        provider_aes_add_round_key(state, round_keys, round);
    }
    provider_aes_sub_bytes(state);
    provider_aes_shift_rows(state);
    provider_aes_add_round_key(state, round_keys, 10);
    for (int i = 0; i < 16; ++i) out[i] = state[i];
}

#endif
