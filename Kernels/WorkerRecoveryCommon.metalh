#ifndef METAL_CRYPTO_WORKER_RECOVERY_COMMON_METALH
#define METAL_CRYPTO_WORKER_RECOVERY_COMMON_METALH

#include "GPUHash.metalh"

using namespace metal;

REC_DEVICE bool recovery_checksum_valid_ids_dyn(const thread ushort* ids, int words_count) {
    if (words_count <= 0 || words_count > 48 || (words_count % 3) != 0) {
        return false;
    }

    const int total_bits = words_count * 11;
    const int ent_bits = (total_bits * 32) / 33;
    const int cs_bits = total_bits - ent_bits;
    if (cs_bits <= 0) {
        return false;
    }

    const int ent_bytes = (ent_bits + 7) >> 3;
    thread uchar bits[68];
    thread uchar entropy[68];
    thread uchar digest[32];

    for (int i = 0; i < 68; ++i) {
        bits[i] = 0u;
        entropy[i] = 0u;
    }

    int bitpos = 0;
    for (int i = 0; i < words_count; ++i) {
        const int v = int(ids[i] & 0x7ffu);
        for (int b = 10; b >= 0; --b) {
            const uchar bit = uchar((v >> b) & 1);
            bits[bitpos >> 3] |= uchar(bit << (7 - (bitpos & 7)));
            ++bitpos;
        }
    }

    for (int i = 0; i < 68; ++i) {
        if (i >= ent_bytes) {
            break;
        }
        entropy[i] = bits[i];
    }

    if ((ent_bits & 7) != 0 && ent_bytes > 0) {
        entropy[ent_bytes - 1] &= uchar(0xffu << (8 - (ent_bits & 7)));
    }

    SHA256(entropy, size_t(ent_bytes), digest);

    for (int i = 0; i < cs_bits; ++i) {
        const int phrase_bit_pos = ent_bits + i;
        const uchar phrase_bit = uchar((bits[phrase_bit_pos >> 3] >> (7 - (phrase_bit_pos & 7))) & 1u);
        const uchar digest_bit = uchar((digest[i >> 3] >> (7 - (i & 7))) & 1u);
        if (phrase_bit != digest_bit) {
            return false;
        }
    }

    return true;
}

REC_DEVICE bool recovery_checksum_valid_ids_fixed(const thread ushort* ids, int words_count) {
    return recovery_checksum_valid_ids_dyn(ids, words_count);
}

#endif
