	hmac_sha512_const_precomp(hctx, (const thread uint32_t*)hmac_input, (thread uint32_t*)hmacsha512_result);
	secp256k1_ec_seckey_tweak_add(hmacsha512_result, (const thread uint8_t*)parent->key);
	memcpy(child->key, hmacsha512_result, 32);
