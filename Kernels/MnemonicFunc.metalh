REC_DEVICE
// normal_private_child_from_private_save_pub: saves pub for normal private child from private.
void normal_private_child_from_private_save_pub(const constant secp256k1_ge_storage*  precPtr, const size_t precPitch, const thread extended_private_key_t* parent, thread extended_private_key_t* child, uint32_t normal_child_number, thread uint8_t* out_serialized_pub) {
	uint32_t hmacsha512_result[16];
	extended_public_key_t pub;
	secp256k1_ec_pubkey_create((thread secp256k1_pubkey*)&pub.key, parent->key, precPtr, precPitch);

	uint8_t hmac_input[40];
	serialized_public_key((thread uint8_t*)&pub.key, (thread uint8_t*)&hmac_input);
	memcpy(out_serialized_pub, hmac_input, 33);
	hmac_input[33] = (normal_child_number >> 24) & 0xFF;
	hmac_input[34] = (normal_child_number >> 16) & 0xFF;
	hmac_input[35] = (normal_child_number >> 8) & 0xFF;
	hmac_input[36] = normal_child_number & 0xFF;

	hmac_sha512_const((thread uint32_t*)parent->chain_code, (thread uint32_t*)&hmac_input, hmacsha512_result);
	secp256k1_ec_seckey_tweak_add((thread uint8_t*)hmacsha512_result, (const thread uint8_t*)parent->key);
	memcpy(child->key, hmacsha512_result, 32);
	memcpy(child->chain_code, &hmacsha512_result[8], 32);
}

// Device helper: hardened_private_child_from_private_ed25519.
REC_DEVICE  void hardened_private_child_from_private_ed25519(const thread extended_private_key_t* parent, thread extended_private_key_t* child, uint32_t hardened_child_number) {
	uint8_t hmacsha512_result[64];
	uint8_t hmac_input[40];
	hmac_input[0] = 0;
	memcpy(&hmac_input[1], parent->key, 32);

	hmac_input[33] = (hardened_child_number >> 24) & 0xFF;
	hmac_input[34] = (hardened_child_number >> 16) & 0xFF;
	hmac_input[35] = (hardened_child_number >> 8) & 0xFF;
	hmac_input[36] = hardened_child_number & 0xFF;
	hmac_sha512_const((thread uint32_t*)parent->chain_code, (thread uint32_t*)&hmac_input, (thread uint32_t*)&hmacsha512_result);

	memcpy(child->key, hmacsha512_result, 32);

	memcpy(child->chain_code, hmacsha512_result + 32, 32);
}

