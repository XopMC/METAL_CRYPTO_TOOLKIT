#include "Words.metalh"

#ifdef memcpy
#undef memcpy
#endif
#ifdef memset
#undef memset
#endif

typedef const constant char (*dict_t)[34];

constant uchar mn_seed_version_key[12] = { 'S', 'e', 'e', 'd', ' ', 'v', 'e', 'r', 's', 'i', 'o', 'n' };
constant char mn_root_seed_chain[] = { 'R', 'o', 'o', 't', ' ', 'S', 'e', 'e', 'd', ' ', 'C', 'h', 'a', 'i', 'n', ' ', 0 };

static inline void mn_memcpy(thread uchar* dst, const thread uchar* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = src[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, const constant uchar* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = src[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, const device uchar* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = src[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, const thread uint32_t* src, const ulong len) {
	const thread uchar* bytes = reinterpret_cast<const thread uchar*>(src);
	for (ulong i = 0; i < len; ++i) {
		dst[i] = bytes[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, thread uint32_t* src, const ulong len) {
	const thread uchar* bytes = reinterpret_cast<const thread uchar*>(src);
	for (ulong i = 0; i < len; ++i) {
		dst[i] = bytes[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, const thread char* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = static_cast<uchar>(src[i]);
	}
}

static inline void mn_memcpy(thread char* dst, const constant char* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = src[i];
	}
}

static inline void mn_memcpy(thread uchar* dst, const constant char* src, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = static_cast<uchar>(src[i]);
	}
}

static inline void mn_memset(thread uchar* dst, const uchar value, const ulong len) {
	for (ulong i = 0; i < len; ++i) {
		dst[i] = value;
	}
}

#define memcpy(DST, SRC, LEN) mn_memcpy(reinterpret_cast<thread uchar*>(DST), SRC, ulong(LEN))
#define memset(DST, VALUE, LEN) mn_memset(reinterpret_cast<thread uchar*>(DST), uchar(VALUE), ulong(LEN))

REC_DEVICE
void hardened_private_child_from_private(const thread extended_private_key_t* parent, thread extended_private_key_t* child, uint32_t hardened_child_number) {

	uint32_t hmacsha512_result[16];
	uint8_t hmac_input[40];
	hmac_input[0] = 0;
	memcpy(&hmac_input[1], parent->key, 32);
	hmac_input[33] = (hardened_child_number >> 24) & 0xFF;
	hmac_input[34] = (hardened_child_number >> 16) & 0xFF;
	hmac_input[35] = (hardened_child_number >> 8) & 0xFF;
	hmac_input[36] = hardened_child_number & 0xFF;
	hmac_sha512_const((thread uint32_t*)parent->chain_code, (thread uint32_t*)&hmac_input, hmacsha512_result);
	secp256k1_ec_seckey_tweak_add((thread uint8_t*)hmacsha512_result, (const thread uint8_t*)parent->key);
	memcpy(child->key, hmacsha512_result, 32);
	memcpy(child->chain_code, &hmacsha512_result[8], 32);
}

REC_DEVICE
void hardened_private_child_from_private_precomp(const thread extended_private_key_t* parent, thread extended_private_key_t* child, uint32_t hardened_child_number, const thread hmac_sha512_precomp_t* hctx) {
	uint8_t hmacsha512_result[64];
	uint8_t hmac_input[40];
	hmac_input[0] = 0;
	memcpy(&hmac_input[1], parent->key, 32);
	hmac_input[33] = (hardened_child_number >> 24) & 0xFF;
	hmac_input[34] = (hardened_child_number >> 16) & 0xFF;
	hmac_input[35] = (hardened_child_number >> 8) & 0xFF;
	hmac_input[36] = hardened_child_number & 0xFF;
	hmac_sha512_const_precomp(hctx, (const thread uint32_t*)hmac_input, (thread uint32_t*)hmacsha512_result);
	secp256k1_ec_seckey_tweak_add(hmacsha512_result, (const thread uint8_t*)parent->key);
	memcpy(child->key, hmacsha512_result, 32);
	memcpy(child->chain_code, hmacsha512_result + 32, 32);
}

REC_DEVICE
void normal_private_child_from_private(const constant secp256k1_ge_storage*  precPtr, const size_t precPitch, const thread extended_private_key_t* parent, thread extended_private_key_t* child, uint32_t normal_child_number) {
	uint32_t hmacsha512_result[16];
	extended_public_key_t pub;
	secp256k1_ec_pubkey_create((thread secp256k1_pubkey*)&pub.key, parent->key, precPtr, precPitch);

	uint8_t hmac_input[40];
	serialized_public_key((thread uint8_t*)&pub.key, (thread uint8_t*)&hmac_input);
	hmac_input[33] = (normal_child_number >> 24) & 0xFF;
	hmac_input[34] = (normal_child_number >> 16) & 0xFF;
	hmac_input[35] = (normal_child_number >> 8) & 0xFF;
	hmac_input[36] = normal_child_number & 0xFF;

	hmac_sha512_const((thread uint32_t*)parent->chain_code, (thread uint32_t*)&hmac_input, hmacsha512_result);
	secp256k1_ec_seckey_tweak_add((thread uint8_t*)hmacsha512_result, (const thread uint8_t*)parent->key);
	memcpy(child->key, hmacsha512_result, 32);
	memcpy(child->chain_code, &hmacsha512_result[8], 32);
}

