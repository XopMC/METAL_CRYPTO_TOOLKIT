    }
    (*out).mode = WALLET_MODE_ARMORYWALLET;
    (*out).type = 0x01u;
    (*out).target_index = target_index;
    walletks_copy_password(*out, pass, pass_len);
    for (int i = 0; i < 32; ++i) {
        (*out).priv[i] = priv32[i];
    }
    for (int i = 0; i < 65; ++i) {
        (*out).payload[i] = pubkey65[i];
    }
    (*out).payload_len = 65u;
}

static inline bool walletks_load_candidate_pass(uchar candidate_kind,
                                                const device char* pass_data,
                                                const device uchar* pass_lens,
                                                uint pass_count,
                                                const device WalletMaskSpec* mask_spec,
                                                const device WalletRangeSpec* range_spec,
                                                ulong candidate_index,
                                                thread uchar pass_local[WALLET_PASS_STRIDE],
                                                thread uint* pass_len) {
    return walletdat_load_candidate_pass(candidate_kind, pass_data, pass_lens, pass_count,
                                         mask_spec, range_spec, candidate_index,
                                         pass_local, pass_len);
}

static inline void walletks_keystore_mac_direct(const thread uchar dk[32],
                                                const device WalletKeystoreTarget& target,
                                                thread uchar mac[32]) {
    union {
        uchar b[200];
        ulong q[25];
    } h;
#pragma unroll
    for (int i = 0; i < 25; ++i) {
        h.q[i] = 0ul;
    }
#pragma unroll
    for (int i = 0; i < 16; ++i) {
        h.b[i] = dk[16 + i];
    }
    for (uint i = 0u; i < target.ciphertext_len; ++i) {
        h.b[16u + i] = target.ciphertext[i];
    }

    const uint len = 16u + target.ciphertext_len;
    h.b[len] ^= 0x01u;
    h.b[135] ^= 0x80u;
    keccakf(h.q);

#pragma unroll
    for (int i = 0; i < 32; ++i) {
        mac[i] = h.b[i];
    }
}

static inline void walletks_keystore_mac_generic(const thread uchar dk[32],
                                                 const device WalletKeystoreTarget& target,
                                                 thread uchar mac[32]) {
    if (target.ciphertext_len < 120u) {
        walletks_keystore_mac_direct(dk, target, mac);
        return;
    }

    uchar mac_input[16 + WALLET_MAX_CIPHERTEXT_LEN];
    for (int i = 0; i < 16; ++i) {
        mac_input[i] = dk[16 + i];
    }
    for (uint i = 0u; i < target.ciphertext_len; ++i) {
        mac_input[16u + i] = target.ciphertext[i];
    }
    keccak(reinterpret_cast<const thread char*>(mac_input), int(16u + target.ciphertext_len),
           mac, 32);
}

static inline void walletks_aes128_ctr_xor(const thread uchar key16[16],
                                           const device uchar iv16[16],
                                           const device uchar* ciphertext,
                                           uint ciphertext_len,
                                           thread uchar* plaintext) {
    uint round_keys[44];
    uchar counter[16];
    uchar stream[16];
    provider_aes_expand_key128(key16, round_keys);
    for (int i = 0; i < 16; ++i) {
        counter[i] = iv16[i];
    }
    for (uint off = 0u; off < ciphertext_len; off += 16u) {
        provider_aes_encrypt_block128(round_keys, counter, stream);
        const uint n = ((ciphertext_len - off) < 16u) ? (ciphertext_len - off) : 16u;
        for (uint i = 0u; i < n; ++i) {
            plaintext[off + i] = uchar(ciphertext[off + i] ^ stream[i]);
        }
        for (int i = 15; i >= 0; --i) {
            counter[i] = uchar(counter[i] + 1u);
            if (counter[i] != 0u) {
                break;
            }
        }
    }
}

static inline bool walletks_priv_to_xy(const constant secp256k1_ge_storage* precPtr,
                                       ulong precPitch,
                                       const thread uchar priv32[32],
                                       thread uchar pubkey65[65],
                                       thread ulong px[4],
                                       thread ulong py[4]);

static inline bool walletks_eth_address_from_private(const constant secp256k1_ge_storage* precPtr,
                                                     ulong precPitch,
                                                     const thread uchar priv32[32],
                                                     thread uchar out20[20]) {
    thread uchar pubkey65[65];
    thread ulong px[4];
    thread ulong py[4];
    if (!walletks_priv_to_xy(precPtr, precPitch, priv32, pubkey65, px, py)) {
        return false;
    }
    thread uint eth_words[5];
    keccak_eth64_tail20_from_xy(px, py, eth_words);
    const thread uchar* eth_bytes = reinterpret_cast<const thread uchar*>(eth_words);
    for (int i = 0; i < 20; ++i) {
        out20[i] = eth_bytes[i];
    }
    return true;
}

static inline bool walletks_pubkey_from_private(const constant secp256k1_ge_storage* precPtr,
                                                ulong precPitch,
                                                const thread uchar priv32[32],
                                                thread uchar* out,
                                                uint out_len) {
    if (out_len != 33u && out_len != 65u) {
        return false;
    }
    thread uchar pubkey65[65];
    thread ulong px[4];
    thread ulong py[4];
    if (!walletks_priv_to_xy(precPtr, precPitch, priv32, pubkey65, px, py)) {
        return false;
    }
    if (out_len == 65u) {
        for (int i = 0; i < 65; ++i) {
            out[i] = pubkey65[i];
        }
    } else {
        out[0] = (py[0] & 1ul) != 0ul ? 0x03u : 0x02u;
        for (int i = 0; i < 32; ++i) {
            out[1 + i] = pubkey65[1 + i];
        }
    }
    return true;
}

static inline uint walletks_password_to_utf16be_ascii(const thread uchar* pass,
                                                      uint pass_len,
                                                      thread uchar* out) {
    if (pass_len > WALLET_MAX_PASSWORD_LEN) {
        pass_len = WALLET_MAX_PASSWORD_LEN;
    }
    for (uint i = 0u; i < pass_len; ++i) {
        out[i << 1u] = 0u;
        out[(i << 1u) + 1u] = pass[i];
    }
    return pass_len << 1u;
}

static inline void walletks_aes256_cfb_decrypt32(const thread uchar key32[32],
                                                 const device uchar iv16[16],
                                                 const device uchar ciphertext32[32],
                                                 thread uchar plain32[32]) {
    uint round_keys[60];
    provider_aes_expand_key(key32, round_keys);
    uchar feedback[16];
    for (int i = 0; i < 16; ++i) {
        feedback[i] = iv16[i];
    }
    for (int off = 0; off < 32; off += 16) {
        uchar stream[16];
        provider_aes_encrypt_block(round_keys, feedback, stream);
        for (int i = 0; i < 16; ++i) {
            const uchar c = ciphertext32[off + i];
            plain32[off + i] = uchar(c ^ stream[i]);
            feedback[i] = c;
        }
    }
}

static inline uint walletks_load_le32(const thread uchar* p) {
    return uint(p[0]) |
           (uint(p[1]) << 8u) |
           (uint(p[2]) << 16u) |
           (uint(p[3]) << 24u);
}

static inline void walletks_store_be32(device uchar* out, uint v) {
    out[0] = uchar(v >> 24u);
    out[1] = uchar(v >> 16u);
    out[2] = uchar(v >> 8u);
    out[3] = uchar(v);
}

static inline ulong walletks_load_be64(const thread uchar* p) {
    ulong v = 0ul;
    for (int i = 0; i < 8; ++i) {
        v = (v << 8u) | ulong(p[i]);
    }
    return v;
}

static inline ulong walletks_load_be64(const device uchar* p) {
    ulong v = 0ul;
    for (int i = 0; i < 8; ++i) {
        v = (v << 8u) | ulong(p[i]);
    }
    return v;
}

static inline void walletks_store_be64(thread uchar* p, ulong v) {
    for (int i = 7; i >= 0; --i) {
        p[i] = uchar(v);
        v >>= 8u;
    }
}

static inline void walletks_store_be64(device uchar* p, ulong v) {
    for (int i = 7; i >= 0; --i) {
        p[i] = uchar(v);
        v >>= 8u;
    }
}

static inline void walletks_sha512_words_to_bytes(const thread ulong words[8],
                                                  thread uchar out[64]) {
    for (int i = 0; i < 8; ++i) {
        walletks_store_be64(out + uint(i) * 8u, words[i]);
    }
}

static inline void walletks_sha512_words_to_bytes(const thread ulong words[8],
                                                  device uchar out[64]) {
    for (int i = 0; i < 8; ++i) {
        walletks_store_be64(out + uint(i) * 8u, words[i]);
    }
}

static inline void walletks_sha512_bytes_to_words(const thread uchar in[64],
                                                  thread ulong words[8]) {
    for (int i = 0; i < 8; ++i) {
        words[i] = walletks_load_be64(in + uint(i) * 8u);
    }
}

static inline void walletks_sha512_bytes_to_words(const device uchar in[64],
                                                  thread ulong words[8]) {
    for (int i = 0; i < 8; ++i) {
        words[i] = walletks_load_be64(in + uint(i) * 8u);
    }
}

static inline void walletks_sha512_digest64_bytes(const thread uchar in[64],
                                                  thread uchar out[64]) {
    ulong words[8];
    walletks_sha512_bytes_to_words(in, words);
    wallet_sha512_digest64_once_words(words);
    walletks_sha512_words_to_bytes(words, out);
}

static inline void walletks_sha512_digest64_bytes(const device uchar in[64],
                                                  device uchar out[64]) {
    ulong words[8];
    walletks_sha512_bytes_to_words(in, words);
    wallet_sha512_digest64_once_words(words);
    walletks_sha512_words_to_bytes(words, out);
}

static inline void walletks_sha512_pass_salt_bytes(const thread uchar* pass,
                                                   uint pass_len,
                                                   const device uchar* salt,
                                                   uint salt_len,
                                                   thread uchar out[64]) {
    ulong words[8];
    wallet_sha512_pass_salt_words(pass, pass_len, salt, salt_len, words);
    walletks_sha512_words_to_bytes(words, out);
}

static inline void walletks_sha256_load_be_block_pre(const device uchar* p,
                                                     thread uint w[16]) {
    for (int i = 0; i < 16; ++i) {
        const device uchar* q = p + (uint(i) << 2u);
        w[i] = (uint(q[0]) << 24u) | (uint(q[1]) << 16u) | (uint(q[2]) << 8u) | uint(q[3]);
    }
}

static inline void walletks_sha256_finalize_pre(thread uint s[8],
                                                const device uchar* tail,
                                                uint tail_len,
                                                ulong total_len_bytes,
                                                thread uchar out[32]) {
    uint w[16];
    for (int i = 0; i < 16; ++i) {
        w[i] = 0u;
    }

    for (uint i = 0u; i < tail_len; ++i) {
        const uint wi = i >> 2u;
        const uint sh = (3u - (i & 3u)) * 8u;
        w[wi] |= uint(tail[i]) << sh;
    }
    {
        const uint wi = tail_len >> 2u;
        const uint sh = (3u - (tail_len & 3u)) * 8u;
        w[wi] |= 0x80u << sh;
    }

    const ulong bitlen = total_len_bytes * 8ul;
    if (tail_len <= 55u) {
        w[14] = uint(bitlen >> 32u);
        w[15] = uint(bitlen);
        SHA256Transform(s, w);
    } else {
        SHA256Transform(s, w);
        for (int i = 0; i < 14; ++i) {
            w[i] = 0u;
        }
        w[14] = uint(bitlen >> 32u);
        w[15] = uint(bitlen);
        SHA256Transform(s, w);
    }

    for (int i = 0; i < 8; ++i) {
        const uint v = s[i];
        out[(uint(i) << 2u) + 0u] = uchar(v >> 24u);
        out[(uint(i) << 2u) + 1u] = uchar(v >> 16u);
        out[(uint(i) << 2u) + 2u] = uchar(v >> 8u);
        out[(uint(i) << 2u) + 3u] = uchar(v);
    }
}

static inline void walletks_hmac_sha256_from_precomp_device(
    const thread WalletHmacSha256Precomp* ctx,
    const device uchar* msg,
    uint msg_len,
    thread uchar out_mac[32]) {
    uint s[8];
    uint w[16];
    for (int i = 0; i < 8; ++i) {
        s[i] = ctx->istate[i];
    }

    const uint nblocks = msg_len >> 6u;
    const uint rem = msg_len & 63u;
    const device uchar* p = msg;
    for (uint i = 0u; i < nblocks; ++i, p += 64) {
        walletks_sha256_load_be_block_pre(p, w);
        SHA256Transform(s, w);
    }

    uchar ihash[32];
    walletks_sha256_finalize_pre(s, p, rem, 64ul + ulong(msg_len), ihash);

    for (int i = 0; i < 8; ++i) {
        s[i] = ctx->ostate[i];
    }
    wallet_sha256_finalize_pre(s, ihash, 32u, 96ul, out_mac);
}

static inline void walletks_sha256_of_prefix64_plus_msg_device(const thread uchar prefix64[64],
                                                               const device uchar* msg,
                                                               uint msg_len,
                                                               thread uchar out[32]) {
    uint s[8];
    SHA256Initialize(s);

    uint w[16];
    wallet_sha256_load_be_block_pre(prefix64, w);
    SHA256Transform(s, w);

    const uint nblocks = msg_len >> 6u;
    const uint rem = msg_len & 63u;
    const device uchar* p = msg;
    for (uint i = 0u; i < nblocks; ++i, p += 64) {
        walletks_sha256_load_be_block_pre(p, w);
        SHA256Transform(s, w);
    }
    walletks_sha256_finalize_pre(s, p, rem, 64ul + ulong(msg_len), out);
}

static inline void walletks_hmac_sha256_device(const thread uchar* key,
                                               uint key_len,
                                               const device uchar* msg,
                                               uint msg_len,
                                               thread uchar out_mac[32]) {
    uchar k0[64];
    uchar ipad[64];
    uchar opad[64];

    for (int i = 0; i < 64; ++i) {
        k0[i] = 0u;
    }
    if (key_len > 64u) {
        uchar kh[32];
        SHA256(key, size_t(key_len), kh);
        for (int i = 0; i < 32; ++i) {
            k0[i] = kh[i];
        }
    } else {
        for (uint i = 0u; i < key_len; ++i) {
            k0[i] = key[i];
        }
    }

    for (int i = 0; i < 64; ++i) {
        ipad[i] = uchar(k0[i] ^ 0x36u);
        opad[i] = uchar(k0[i] ^ 0x5cu);
    }

    uchar ihash[32];
    walletks_sha256_of_prefix64_plus_msg_device(ipad, msg, msg_len, ihash);
    sha256_of_prefix64_plus_msg(opad, ihash, 32u, out_mac);
}

static inline void walletks_pbkdf2_sha256_with_hmac_device_salt(
    const thread uchar* pass,
    uint pass_len,
    const device uchar* salt_in,
    uint salt_len,
    uint iterations,
    const thread WalletHmacSha256Precomp* hmac_ctx,
    bool use_fast_hmac,
    device uchar* out,
    uint out_len) {
    uchar salt_block[WALLET_SCRYPT_MAX_BLOCK + 4u];
    uchar u[32];
    uchar u_next[32];
    if (salt_len > WALLET_SCRYPT_MAX_BLOCK) {
        salt_len = WALLET_SCRYPT_MAX_BLOCK;
    }
    for (uint block = 1u, written = 0u; written < out_len; ++block) {
        for (uint i = 0u; i < salt_len; ++i) {
            salt_block[i] = salt_in[i];
        }
        wallet_store_be32(salt_block + salt_len, block);
        if (use_fast_hmac) {
            wallet_hmac_sha256_from_precomp(hmac_ctx, salt_block, salt_len + 4u, u);
        } else {
            hmac_sha256(pass, size_t(pass_len), salt_block, size_t(salt_len + 4u), u);
        }
        const uint ncopy = ((out_len - written) < 32u) ? (out_len - written) : 32u;
        for (uint i = 0u; i < ncopy; ++i) {
            out[written + i] = u[i];
        }
        for (uint iter = 1u; iter < iterations; ++iter) {
            if (use_fast_hmac) {
                wallet_hmac_sha256_from_precomp(hmac_ctx, u, 32u, u_next);
            } else {
                hmac_sha256(pass, size_t(pass_len), u, 32u, u_next);
            }
            for (int i = 0; i < 32; ++i) {
                u[i] = u_next[i];
                if (i < int(ncopy)) {
                    out[written + uint(i)] = uchar(out[written + uint(i)] ^ u_next[i]);
                }
            }
        }
        written += ncopy;
    }
}

static inline uint walletks_rotl32(uint v, uint n) {
    return (v << n) | (v >> (32u - n));
}

static inline void walletks_salsa20_8_words_thread(thread uint x[16]);

static inline void walletks_salsa20_8_words(device uint x[16]) {
    uint z[16];
    for (int i = 0; i < 16; ++i) {
        z[i] = x[i];
    }
    for (int i = 0; i < 8; i += 2) {
        z[4] ^= walletks_rotl32(z[0] + z[12], 7u);  z[8] ^= walletks_rotl32(z[4] + z[0], 9u);
        z[12] ^= walletks_rotl32(z[8] + z[4], 13u); z[0] ^= walletks_rotl32(z[12] + z[8], 18u);
        z[9] ^= walletks_rotl32(z[5] + z[1], 7u);   z[13] ^= walletks_rotl32(z[9] + z[5], 9u);
        z[1] ^= walletks_rotl32(z[13] + z[9], 13u); z[5] ^= walletks_rotl32(z[1] + z[13], 18u);
        z[14] ^= walletks_rotl32(z[10] + z[6], 7u); z[2] ^= walletks_rotl32(z[14] + z[10], 9u);
        z[6] ^= walletks_rotl32(z[2] + z[14], 13u); z[10] ^= walletks_rotl32(z[6] + z[2], 18u);
        z[3] ^= walletks_rotl32(z[15] + z[11], 7u); z[7] ^= walletks_rotl32(z[3] + z[15], 9u);
        z[11] ^= walletks_rotl32(z[7] + z[3], 13u); z[15] ^= walletks_rotl32(z[11] + z[7], 18u);

        z[1] ^= walletks_rotl32(z[0] + z[3], 7u);    z[2] ^= walletks_rotl32(z[1] + z[0], 9u);
        z[3] ^= walletks_rotl32(z[2] + z[1], 13u);   z[0] ^= walletks_rotl32(z[3] + z[2], 18u);
        z[6] ^= walletks_rotl32(z[5] + z[4], 7u);    z[7] ^= walletks_rotl32(z[6] + z[5], 9u);
        z[4] ^= walletks_rotl32(z[7] + z[6], 13u);   z[5] ^= walletks_rotl32(z[4] + z[7], 18u);
        z[11] ^= walletks_rotl32(z[10] + z[9], 7u);  z[8] ^= walletks_rotl32(z[11] + z[10], 9u);
        z[9] ^= walletks_rotl32(z[8] + z[11], 13u);  z[10] ^= walletks_rotl32(z[9] + z[8], 18u);
        z[12] ^= walletks_rotl32(z[15] + z[14], 7u); z[13] ^= walletks_rotl32(z[12] + z[15], 9u);
        z[14] ^= walletks_rotl32(z[13] + z[12], 13u); z[15] ^= walletks_rotl32(z[14] + z[13], 18u);
    }
    for (int i = 0; i < 16; ++i) {
        x[i] += z[i];
    }
}

static inline void walletks_scrypt_blockmix_words(device uint* b,
                                                  device uint* y,
                                                  const uint r) {
    uint x[16];
    const uint block_count = 2u * r;
    for (uint i = 0u; i < 16u; ++i) {
        x[i] = b[(block_count - 1u) * 16u + i];
    }
    for (uint i = 0u; i < block_count; ++i) {
        uint tmp[16];
        for (uint j = 0u; j < 16u; ++j) {
            tmp[j] = x[j] ^ b[i * 16u + j];
        }
        walletks_salsa20_8_words_thread(tmp);
        for (uint j = 0u; j < 16u; ++j) {
            x[j] = tmp[j];
            y[i * 16u + j] = tmp[j];
        }
    }
    for (uint i = 0u; i < r; ++i) {
        for (uint j = 0u; j < 16u; ++j) {
            b[i * 16u + j] = y[(2u * i) * 16u + j];
            b[(i + r) * 16u + j] = y[(2u * i + 1u) * 16u + j];
        }
    }
}

static inline void walletks_salsa20_8_words_thread(thread uint x[16]) {
    uint z[16];
    for (int i = 0; i < 16; ++i) {
        z[i] = x[i];
    }
    for (int i = 0; i < 8; i += 2) {
        z[4] ^= walletks_rotl32(z[0] + z[12], 7u);  z[8] ^= walletks_rotl32(z[4] + z[0], 9u);
        z[12] ^= walletks_rotl32(z[8] + z[4], 13u); z[0] ^= walletks_rotl32(z[12] + z[8], 18u);
        z[9] ^= walletks_rotl32(z[5] + z[1], 7u);   z[13] ^= walletks_rotl32(z[9] + z[5], 9u);
        z[1] ^= walletks_rotl32(z[13] + z[9], 13u); z[5] ^= walletks_rotl32(z[1] + z[13], 18u);
        z[14] ^= walletks_rotl32(z[10] + z[6], 7u); z[2] ^= walletks_rotl32(z[14] + z[10], 9u);
        z[6] ^= walletks_rotl32(z[2] + z[14], 13u); z[10] ^= walletks_rotl32(z[6] + z[2], 18u);
        z[3] ^= walletks_rotl32(z[15] + z[11], 7u); z[7] ^= walletks_rotl32(z[3] + z[15], 9u);
        z[11] ^= walletks_rotl32(z[7] + z[3], 13u); z[15] ^= walletks_rotl32(z[11] + z[7], 18u);

        z[1] ^= walletks_rotl32(z[0] + z[3], 7u);    z[2] ^= walletks_rotl32(z[1] + z[0], 9u);
        z[3] ^= walletks_rotl32(z[2] + z[1], 13u);   z[0] ^= walletks_rotl32(z[3] + z[2], 18u);
        z[6] ^= walletks_rotl32(z[5] + z[4], 7u);    z[7] ^= walletks_rotl32(z[6] + z[5], 9u);
        z[4] ^= walletks_rotl32(z[7] + z[6], 13u);   z[5] ^= walletks_rotl32(z[4] + z[7], 18u);
        z[11] ^= walletks_rotl32(z[10] + z[9], 7u);  z[8] ^= walletks_rotl32(z[11] + z[10], 9u);
        z[9] ^= walletks_rotl32(z[8] + z[11], 13u);  z[10] ^= walletks_rotl32(z[9] + z[8], 18u);
        z[12] ^= walletks_rotl32(z[15] + z[14], 7u); z[13] ^= walletks_rotl32(z[12] + z[15], 9u);
        z[14] ^= walletks_rotl32(z[13] + z[12], 13u); z[15] ^= walletks_rotl32(z[14] + z[13], 18u);
    }
    for (int i = 0; i < 16; ++i) {
        x[i] += z[i];
    }
}

static inline void walletks_scrypt_blockmix_words_r8_fast(device uint* b,
                                                          device uint* y) {
    uint x[16];
    for (uint i = 0u; i < 16u; ++i) {
        x[i] = b[15u * 16u + i];
    }
    for (uint i = 0u; i < 16u; ++i) {
        uint tmp[16];
        for (uint j = 0u; j < 16u; ++j) {
            tmp[j] = x[j] ^ b[i * 16u + j];
        }
        walletks_salsa20_8_words_thread(tmp);
        const uint dst = (i >> 1u) * 16u;
        for (uint j = 0u; j < 16u; ++j) {
            x[j] = tmp[j];
            if ((i & 1u) != 0u) {
                y[dst + j] = tmp[j];
            } else {
                b[dst + j] = tmp[j];
            }
        }
    }
    for (uint i = 0u; i < 128u; ++i) {
        b[128u + i] = y[i];
    }
}

static inline void walletks_scrypt_blockmix_xor_words_r8_fused(device uint* b,
                                                               const device uint* v,
                                                               device uint* y) {
    uint x[16];
    for (uint i = 0u; i < 16u; ++i) {
        x[i] = b[15u * 16u + i] ^ v[15u * 16u + i];
    }
    for (uint i = 0u; i < 16u; ++i) {
        uint tmp[16];
        for (uint j = 0u; j < 16u; ++j) {
            tmp[j] = x[j] ^ b[i * 16u + j] ^ v[i * 16u + j];
        }
        walletks_salsa20_8_words_thread(tmp);
        const uint dst = (i >> 1u) * 16u;
        for (uint j = 0u; j < 16u; ++j) {
            x[j] = tmp[j];
            if ((i & 1u) != 0u) {
                y[dst + j] = tmp[j];
            } else {
                b[dst + j] = tmp[j];
            }
        }
    }
    for (uint i = 0u; i < 128u; ++i) {
        b[128u + i] = y[i];
    }
}

static inline void walletks_copy_words_r8_block(device uint* dst,
                                                const device uint* src) {
    for (uint i = 0u; i < 256u; ++i) {
        dst[i] = src[i];
    }
}

static inline bool walletks_scrypt_sha256_32_params(const thread uchar* pass,
                                                    uint pass_len,
                                                    const device uchar* salt,
                                                    uint salt_len,
                                                    uint n,
                                                    uint r,
                                                    uint p,
                                                    device uchar* scratch,
                                                    ulong scratch_stride,
                                                    ulong lane,
                                                    thread uchar out32[32]) {
    if (p == 0u || r == 0u || r > WALLET_SCRYPT_MAX_R ||
        n < 2u || ((n & (n - 1u)) != 0u)) {
        return false;
    }
    const uint block_size = 128u * r;
    const ulong b_len = ulong(p) * ulong(block_size);
    if (p != 0u && b_len / ulong(p) != ulong(block_size)) {
        return false;
    }
    const ulong need = ulong(n) * ulong(block_size) + b_len + 4ul + ulong(block_size);
    if (scratch == nullptr || scratch_stride < need) {
        return false;
    }

    device uchar* v = scratch + lane * scratch_stride;
    device uchar* final_b = v + ulong(n) * ulong(block_size);
    device uchar* y = final_b + b_len + 4ul;

    WalletHmacSha256Precomp hmac_ctx;
    const bool use_fast_hmac = wallet_hmac_sha256_precompute(pass, pass_len, &hmac_ctx);
    walletks_pbkdf2_sha256_with_hmac_device_salt(pass, pass_len, salt, salt_len, 1u,
                                                 &hmac_ctx, use_fast_hmac, final_b, uint(b_len));

    device uint* v_words = reinterpret_cast<device uint*>(v);
    device uint* y_words = reinterpret_cast<device uint*>(y);
    const uint block_words = block_size >> 2u;

    for (uint part = 0u; part < p; ++part) {
        device uchar* b = final_b + ulong(part) * ulong(block_size);
        device uint* b_words = reinterpret_cast<device uint*>(b);
        for (uint i = 0u; i < n; ++i) {
            device uint* vi = v_words + ulong(i) * ulong(block_words);
            if (r == 8u) {
                walletks_copy_words_r8_block(vi, b_words);
                walletks_scrypt_blockmix_words_r8_fast(b_words, y_words);
            } else {
                for (uint j = 0u; j < block_words; ++j) {
                    vi[j] = b_words[j];
                }
                walletks_scrypt_blockmix_words(b_words, y_words, r);
            }
        }
        for (uint i = 0u; i < n; ++i) {
            const uint j = b_words[(2u * r - 1u) * 16u] & (n - 1u);
            const device uint* vj = v_words + ulong(j) * ulong(block_words);
            if (r == 8u) {
                walletks_scrypt_blockmix_xor_words_r8_fused(b_words, vj, y_words);
            } else {
                for (uint k = 0u; k < block_words; ++k) {
                    b_words[k] ^= vj[k];
                }
                walletks_scrypt_blockmix_words(b_words, y_words, r);
            }
        }
    }

    walletks_store_be32(final_b + b_len, 1u);
    if (use_fast_hmac) {
        walletks_hmac_sha256_from_precomp_device(&hmac_ctx, final_b, uint(b_len) + 4u, out32);
    } else {
        walletks_hmac_sha256_device(pass, pass_len, final_b, uint(b_len) + 4u, out32);
    }
    return true;
}

static inline bool walletks_scrypt_sha256_32(const thread uchar* pass,
                                             uint pass_len,
                                             const device WalletKeystoreTarget& target,
                                             device uchar* scratch,
                                             ulong scratch_stride,
                                             ulong tid,
                                             thread uchar out32[32]) {
    return walletks_scrypt_sha256_32_params(pass, pass_len, target.salt, target.salt_len,
                                            target.scrypt_n, target.scrypt_r, target.scrypt_p,
                                            scratch, scratch_stride, tid, out32);
}

static inline bool walletks_armory_romix_one_iter(const thread uchar* pass,
                                                  uint pass_len,
                                                  const device ArmoryWalletTarget& target,
                                                  device uchar* scratch,
                                                  ulong scratch_stride,
                                                  ulong lane,
                                                  thread uchar out32[32]) {
    const uint mem = target.kdf_mem;
    if (mem < 64u || (mem & 63u) != 0u || ulong(mem) > scratch_stride || scratch == nullptr) {
        return false;
    }

    device uchar* lut = scratch + lane * scratch_stride;
    uchar x[64];
    uchar y[64];

    walletks_sha512_pass_salt_bytes(pass, pass_len, target.salt, 32u, x);
    for (int i = 0; i < 64; ++i) {
        lut[i] = x[i];
    }
    for (uint off = 64u; off < mem; off += 64u) {
        walletks_sha512_digest64_bytes(lut + off - 64u, lut + off);
    }
    for (int i = 0; i < 64; ++i) {
        x[i] = lut[ulong(mem) - 64ul + ulong(i)];
    }

    const uint sequence_count = mem >> 6u;
    const uint lookups = sequence_count >> 1u;
    for (uint seq = 0u; seq < lookups; ++seq) {
        const uint idx = walletks_load_le32(x + 60u) % sequence_count;
        const device uchar* v = lut + ulong(idx) * 64ul;
        for (int i = 0; i < 64; ++i) {
            y[i] = uchar(x[i] ^ v[i]);
        }
        walletks_sha512_digest64_bytes(y, x);
    }
    for (int i = 0; i < 32; ++i) {
        out32[i] = x[i];
    }
    return true;
}

static inline bool walletks_armory_kdf_romix(const thread uchar* pass,
                                             uint pass_len,
                                             const device ArmoryWalletTarget& target,
                                             device uchar* scratch,
                                             ulong scratch_stride,
                                             ulong lane,
                                             thread uchar key32[32]) {
    if (target.kdf_iterations == 0u || target.kdf_mem < 64u || pass_len > WALLET_MAX_PASSWORD_LEN) {
        return false;
    }
    if (!walletks_armory_romix_one_iter(pass, pass_len, target, scratch, scratch_stride, lane, key32)) {
        return false;
    }
    for (uint iter = 1u; iter < target.kdf_iterations; ++iter) {
        if (!walletks_armory_romix_one_iter(key32, 32u, target, scratch, scratch_stride, lane, key32)) {
            return false;
        }
    }
    return true;
}

static inline void walletks_store_seed_hex(ulong seed,
                                           thread uchar out[WALLET_PASS_STRIDE],
                                           thread uint* out_len) {
    constant char* hexd = "0123456789abcdef";
    for (int i = 0; i < 16; ++i) {
        const int shift = (15 - i) * 4;
        out[i] = uchar(hexd[(seed >> uint(shift)) & 0x0ful]);
    }
    *out_len = 16u;
}

static inline void walletks_store_seed_hex(ulong seed,
                                           device uchar out[WALLET_PASS_STRIDE],
                                           thread uint* out_len) {
    constant char* hexd = "0123456789abcdef";
    for (int i = 0; i < 16; ++i) {
        const int shift = (15 - i) * 4;
        out[i] = uchar(hexd[(seed >> uint(shift)) & 0x0ful]);
    }
    *out_len = 16u;
}

static inline void walletks_store_randstorm_exact_label(ulong state,
                                                        uint time0,
                                                        uint time1,
                                                        thread uchar out[WALLET_PASS_STRIDE],
                                                        thread uint* out_len) {
    constant char* hexd = "0123456789abcdef";
    uint p = 0u;
    constant char* prefix0 = "state=";
    for (int i = 0; i < 6; ++i) {
        out[p++] = uchar(prefix0[i]);
    }
    for (int i = 0; i < 16; ++i) {
        const int shift = (15 - i) * 4;
        out[p++] = uchar(hexd[(state >> uint(shift)) & 0x0ful]);
    }
    constant char* prefix1 = ";t0=";
    for (int i = 0; i < 4; ++i) {
        out[p++] = uchar(prefix1[i]);
    }
    for (int i = 0; i < 8; ++i) {
        const int shift = (7 - i) * 4;
        out[p++] = uchar(hexd[(time0 >> uint(shift)) & 0x0fu]);
    }
    constant char* prefix2 = ";t1=";
    for (int i = 0; i < 4; ++i) {
        out[p++] = uchar(prefix2[i]);
    }
    for (int i = 0; i < 8; ++i) {
        const int shift = (7 - i) * 4;
        out[p++] = uchar(hexd[(time1 >> uint(shift)) & 0x0fu]);
    }
    *out_len = p;
}

static inline bool walletks_is_unique64_len_aware(const thread uchar* data, int len) {
    if (len <= 0) {
        return false;
    }
    const int required_distinct = (len <= 1) ? 1 : (len <= 4 ? 2 : (len <= 8 ? 3 : 4));
    const int required_nonzero = (len <= 2) ? 1 : 2;
    const int required_changes = (len <= 1) ? 0 : (len <= 4 ? 1 : 2);
    ulong seen0 = 0ul;
    ulong seen1 = 0ul;
    ulong seen2 = 0ul;
    ulong seen3 = 0ul;
    int distinct = 0;
    int nonzero_count = 0;
    int changes = 0;
    uchar prev = data[0];
    for (int i = 0; i < len; ++i) {
        const uchar v = data[i];
        if (v != 0u) {
            ++nonzero_count;
        }
        if (i > 0 && v != prev) {
            ++changes;
        }
        prev = v;
        const ulong bit = 1ul << (v & 63u);
        switch (v >> 6u) {
            case 0u:
                if ((seen0 & bit) == 0ul) {
                    seen0 |= bit;
                    ++distinct;
                }
                break;
            case 1u:
                if ((seen1 & bit) == 0ul) {
                    seen1 |= bit;
                    ++distinct;
                }
                break;
            case 2u:
                if ((seen2 & bit) == 0ul) {
                    seen2 |= bit;
                    ++distinct;
                }
                break;
            default:
                if ((seen3 & bit) == 0ul) {
                    seen3 |= bit;
                    ++distinct;
                }
                break;
        }
    }
    return distinct >= required_distinct &&
           nonzero_count >= required_nonzero &&
           changes >= required_changes;
}

struct WalletksRandstormV8_2011Profile64 {
    uint hi;
    uint lo;

    static inline void init(thread WalletksRandstormV8_2011Profile64& r, ulong seed) {
        r.hi = uint(seed >> 32);
        r.lo = uint(seed);
        if (r.hi == 0u) {
            r.hi = 1u;
        }
        if (r.lo == 0u) {
            r.lo = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        hi = 36969u * (hi & 0xffffu) + (hi >> 16);
        lo = 18273u * (lo & 0xffffu) + (lo >> 16);
        const uint random_bits = (hi << 16) + (lo & 0xffffu);
        return ushort((random_bits & 0x3fffffffu) >> 14);
    }
};

struct WalletksRandstormV8_2015Profile64 {
    ushort a;
    ushort b;
    ushort c;
    ushort d;

    static inline void init(thread WalletksRandstormV8_2015Profile64& r, ulong seed) {
        r.a = ushort(seed & 0xfffful);
        r.b = ushort((seed >> 16) & 0xfffful);
        r.c = ushort((seed >> 32) & 0xfffful);
        r.d = ushort((seed >> 48) & 0xfffful);
        if (r.a < 2u) {
            r.a = 1u;
        }
        if (r.b < 2u) {
            r.b = 1u;
        }
        if (r.c < 2u) {
            r.c = 1u;
        }
        if (r.d < 2u) {
            r.d = 1u;
        }
    }

    inline ushort next_pool_u16() thread {
        const uint r0 = 18030u * uint(a) + uint(b);
        const uint r1 = 36969u * uint(c) + uint(d);
        a = ushort(r0 & 0xffffu);
        b = ushort(r0 >> 16);
        c = ushort(r1 & 0xffffu);
        d = ushort(r1 >> 16);
        return ushort((r0 ^ r1) >> 4);
    }
};

struct WalletksRandstormSpiderMonkeyLcg48Profile64 {
    ulong state;

    static inline void init(thread WalletksRandstormSpiderMonkeyLcg48Profile64& r, ulong seed) {
        r.state = seed & 0xfffffffffffful;
        if (r.state == 0ul) {
            r.state = 1ul;
        }
    }

    inline ushort next_pool_u16() thread {
        state = (state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
        const ushort out = ushort((state >> 32) & 0xfffful);
        state = (state * 0x5deece66dul + 0xbul) & 0xfffffffffffful;
        return out;
    }
};

struct WalletksRandstormJscWeakRandomProfile64 {
    uint low;
    uint high;

    static inline void init(thread WalletksRandstormJscWeakRandomProfile64& r, ulong seed) {
        r.low = uint(seed) ^ 0x49616e42u;
        r.high = uint(seed);
    }

    inline ushort next_pool_u16() thread {
        high = (high << 16) + (high >> 16);
        high += low;
        low += high;
        return ushort(high >> 16);
    }
};

static inline uchar walletks_randstorm_arc4_next_byte64(thread uchar s[256], thread uchar& i, thread uchar& j) {
    i = uchar(i + 1u);
    j = uchar(j + s[i]);
    const uchar t = s[i];
    s[i] = s[j];
    s[j] = t;
    return s[uchar(t + s[i])];
}

static inline ulong walletks_randstorm_arc4_next64(thread uchar s[256], thread uchar& i, thread uchar& j) {
    ulong v = ulong(walletks_randstorm_arc4_next_byte64(s, i, j));
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 8;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 16;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 24;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 32;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 40;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 48;
    v |= ulong(walletks_randstorm_arc4_next_byte64(s, i, j)) << 56;
    return v;
}

template <typename Profile>
static inline void walletks_randstorm_seeded_arc4_state(thread uchar s[256],
                                                        thread uchar& i,
                                                        thread uchar& j,
                                                        ulong math_random_state,
                                                        bool seed_time_mode,
                                                        uint seed_time0,
                                                        uint seed_time1) {
    thread Profile profile;
    Profile::init(profile, math_random_state);
    for (int n = 0; n < 256; ++n) {
        s[n] = uchar(n);
    }

    const uint seed_word0 = seed_time_mode ? seed_time0 : uint(math_random_state);
    const uint seed_word1 = seed_time_mode ? seed_time1 : uint(math_random_state);
    ushort pool_pair = 0u;
    uchar k = 0u;
    for (int n = 0; n < 256; ++n) {
        uchar pool_byte;
        if ((n & 1) == 0) {
            pool_pair = profile.next_pool_u16();
            pool_byte = uchar(pool_pair >> 8);
        } else {
            pool_byte = uchar(pool_pair & 255u);
        }
        if (n < 4) {
            pool_byte ^= uchar(seed_word0 >> uint(n * 8));
        } else if (n < 8) {
            pool_byte ^= uchar(seed_word1 >> uint((n - 4) * 8));
        }

        k = uchar(k + s[n] + pool_byte);
        const uchar t = s[n];
        s[n] = s[k];
        s[k] = t;
    }
    i = 0u;
    j = 0u;
}

template <typename Profile>
static inline bool walletks_randstorm_exact_arc4_entropy_mode12(int entropy_len,
                                                                thread uchar entropy[128],
                                                                ulong seed) {
    if (entropy_len < 0 || entropy_len > 128) {
        return false;
    }
    thread uchar s[256];
    uchar i = 0u;
    uchar j = 0u;
    walletks_randstorm_seeded_arc4_state<Profile>(s, i, j, seed, false, 0u, 0u);
    ulong r = 0ul;
    for (int n = 0; n < entropy_len; ++n) {
        if ((n & 7) == 0) {
            r = walletks_randstorm_arc4_next64(s, i, j);
        }
        entropy[n] = uchar((r >> uint((n & 7) * 8)) & 0xfful);
    }
    return walletks_is_unique64_len_aware(entropy, entropy_len);
}

static inline bool walletks_entropy_fill64_exact_walletjs(int entropy_len,
                                                          thread uchar entropy[128],
                                                          ulong seed,
                                                          int mode,
                                                          int gen) {
    if (mode != 12) {
        return false;
    }
    switch (gen) {
        case 211: return walletks_randstorm_exact_arc4_entropy_mode12<WalletksRandstormV8_2011Profile64>(entropy_len, entropy, seed);
        case 212: return walletks_randstorm_exact_arc4_entropy_mode12<WalletksRandstormV8_2015Profile64>(entropy_len, entropy, seed);
        case 213: return walletks_randstorm_exact_arc4_entropy_mode12<WalletksRandstormSpiderMonkeyLcg48Profile64>(entropy_len, entropy, seed);
        case 214: return walletks_randstorm_exact_arc4_entropy_mode12<WalletksRandstormJscWeakRandomProfile64>(entropy_len, entropy, seed);
        default: return false;
    }
}

template <typename Profile>
static inline bool walletks_randstorm_jsbn_arc4_fill64_profile(int entropy_len,
                                                               thread uchar entropy[128],
                                                               ulong math_random_state,
                                                               uint seed_time0,
                                                               uint seed_time1) {
    if (entropy_len < 0 || entropy_len > 128) {
        return false;
    }
    thread uchar s[256];
    uchar i = 0u;
    uchar j = 0u;
    walletks_randstorm_seeded_arc4_state<Profile>(s, i, j, math_random_state, true, seed_time0, seed_time1);
    for (int n = 0; n < entropy_len; ++n) {
        entropy[n] = walletks_randstorm_arc4_next_byte64(s, i, j);
    }
    return true;
}

static inline bool walletks_randstorm_jsbn_arc4_fill64(int entropy_len,
                                                       thread uchar entropy[128],
                                                       ulong math_random_state,
                                                       uint seed_time0,
                                                       uint seed_time1,
                                                       int gen) {
    switch (gen) {
        case 211: return walletks_randstorm_jsbn_arc4_fill64_profile<WalletksRandstormV8_2011Profile64>(entropy_len, entropy, math_random_state, seed_time0, seed_time1);
        case 212: return walletks_randstorm_jsbn_arc4_fill64_profile<WalletksRandstormV8_2015Profile64>(entropy_len, entropy, math_random_state, seed_time0, seed_time1);
        case 213: return walletks_randstorm_jsbn_arc4_fill64_profile<WalletksRandstormSpiderMonkeyLcg48Profile64>(entropy_len, entropy, math_random_state, seed_time0, seed_time1);
        case 214: return walletks_randstorm_jsbn_arc4_fill64_profile<WalletksRandstormJscWeakRandomProfile64>(entropy_len, entropy, math_random_state, seed_time0, seed_time1);
        default: return false;
    }
}

static inline bool walletks_prng64_seed_to_ec_priv(WalletJsSpec spec,
                                                   ulong seed,
                                                   thread uchar priv32[32]) {
    thread uchar entropy[33];
    if (!walletks_entropy_fill64_exact_walletjs(33, entropy, seed,
                                                int(spec.prng_mode),
                                                int(spec.prng_gen))) {
        return false;
    }
    for (int i = 0; i < 32; ++i) {
        priv32[i] = entropy[i + 1];
    }
    return true;
}

static inline bool walletks_randstorm_exact_to_ec_priv(WalletJsSpec spec,
                                                       ulong flat_index,
                                                       thread uchar source[WALLET_PASS_STRIDE],
                                                       thread uint* source_len,
                                                       thread uchar priv32[32]) {
    const ulong time_count = spec.randstorm_time_count == 0ul ? 1ul : spec.randstorm_time_count;
    const ulong delta_count = spec.randstorm_time_delta_count == 0u ? 1ul : ulong(spec.randstorm_time_delta_count);
    const ulong delta_idx = flat_index % delta_count;
    flat_index /= delta_count;
    const ulong time_idx = flat_index % time_count;
    const ulong state_idx = flat_index / time_count;
    const ulong state = spec.randstorm_state_start + state_idx;
    const uint time0 = spec.randstorm_time_start + uint(time_idx);
    const uint time1 = time0 + uint(delta_idx);
    thread uchar entropy[33];
    if (!walletks_randstorm_jsbn_arc4_fill64(33, entropy, state, time0, time1, int(spec.prng_gen))) {
        return false;
    }
    for (int i = 0; i < 32; ++i) {
        priv32[i] = entropy[i + 1];
    }
    walletks_store_randstorm_exact_label(state, time0, time1, source, source_len);
    return true;
}

static inline bool walletks_prepare_candidate(WalletJsSpec spec,
                                              uchar candidate_kind,
                                              const device char* pass_data,
                                              const device uchar* pass_lens,
                                              uint pass_count,
                                              const device WalletMaskSpec* mask_spec,
                                              const device WalletRangeSpec* range_spec,
                                              ulong candidate_start,
                                              ulong tid,
                                              thread uchar source[WALLET_PASS_STRIDE],
                                              thread uint* source_len,
                                              thread uchar* source_kind,
                                              thread ulong* source_seed,
                                              thread uchar priv32[32]) {
    *source_len = 0u;
    *source_kind = WALLETJS_SOURCE_PASSWORD;
    *source_seed = 0ul;
    if (spec.profile_kind == WALLETJS_PROFILE_SHA256_BRAIN) {
        if (!walletdat_load_candidate_pass(candidate_kind, pass_data, pass_lens, pass_count,
                                           mask_spec, range_spec, candidate_start + tid,
                                           source, source_len)) {
            return false;
        }
        SHA256(source, *source_len, priv32);
        return true;
    }
    if (spec.profile_kind == WALLETJS_PROFILE_PRNG64_SEED) {
        const ulong seed = candidate_start + tid;
        if (!walletks_prng64_seed_to_ec_priv(spec, seed, priv32)) {
            return false;
        }
        *source_len = 0u;
        *source_seed = seed;
        *source_kind = WALLETJS_SOURCE_SEED64;
        return true;
    }
    if (spec.profile_kind == WALLETJS_PROFILE_RANDSTORM_JSBN_EXACT) {
        const ulong flat = candidate_start + tid;
        if (!walletks_randstorm_exact_to_ec_priv(spec, flat, source, source_len, priv32)) {
            return false;
        }
        *source_seed = 0ul;
        *source_kind = WALLETJS_SOURCE_PASSWORD;
        return true;
    }

    return false;
}

static inline bool walletks_seed_to_priv(WalletJsSpec spec,
                                         ulong seed,
                                         thread uchar source[WALLET_PASS_STRIDE],
                                         thread uint* source_len,
                                         thread uchar* source_kind,
                                         thread ulong* source_seed,
                                         thread uchar priv32[32]) {
    *source_kind = WALLETJS_SOURCE_SEED64;
    *source_seed = seed;
    *source_len = 0u;
    if (spec.profile_kind == WALLETJS_PROFILE_RANDSTORM_JSBN_EXACT) {
        if (!walletks_randstorm_exact_to_ec_priv(spec, seed, source, source_len, priv32)) {
            return false;
        }
        *source_kind = WALLETJS_SOURCE_PASSWORD;
        *source_seed = 0ul;
        return true;
    }
    return walletks_prng64_seed_to_ec_priv(spec, seed, priv32);
}

static inline bool walletks_priv_to_xy(const constant secp256k1_ge_storage* precPtr,
                                       ulong precPitch,
                                       const thread uchar priv32[32],
                                       thread uchar pubkey65[65],
                                       thread ulong px[4],
                                       thread ulong py[4]) {
    pubkey65[0] = 0x04u;
    const int ok = secp256k1_ec_pubkey_create(reinterpret_cast<thread secp256k1_pubkey*>(pubkey65 + 1),
                                              priv32,
                                              precPtr,
                                              size_t(precPitch));
    if (ok == 0) {
        return false;
    }
    for (int w = 0; w < 4; ++w) {
        const int off = (3 - w) * 8;
        px[w] = walletks_load_be64(pubkey65 + 1 + off);
        py[w] = walletks_load_be64(pubkey65 + 33 + off);
    }
    return true;
}

static inline void walletks_emit_result(device bool* isResult,
                                        device bool* buffResult,
                                        const thread uchar* source,
                                        uint source_len,
                                        uchar source_kind,
                                        ulong source_seed,
                                        const thread uchar priv32[32],
                                        uchar type,
                                        const thread void* payload,
                                        uint payload_len,
                                        device WalletModeResult* wallet_results,
                                        device atomic_uint* wallet_count,
                                        uint max_founds) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
    if (wallet_results == nullptr || wallet_count == nullptr) {
        return;
    }
    const ulong ridx = wallet_atomic_add_count(wallet_count, 1u);
    if (ridx >= ulong(max_founds)) {
        return;
    }
    device WalletModeResult& out = wallet_results[ridx];
    wallet_zero_result(out);
    out.mode = WALLET_MODE_WALLETJS;
    out.type = type;
    out.target_index = 0u;
    out.reserved[0] = source_kind;
    if (source_kind == WALLETJS_SOURCE_SEED64) {
        uint seed_len = 0u;
        walletks_store_seed_hex(source_seed, out.password, &seed_len);
        out.password_len = ushort(seed_len);
    } else {
        const uint n = (source_len > WALLET_MAX_PASSWORD_LEN) ? WALLET_MAX_PASSWORD_LEN : source_len;
        out.password_len = ushort(n);
        for (uint i = 0u; i < n; ++i) {
            out.password[i] = source[i];
        }
    }
    for (int i = 0; i < 32; ++i) {
        out.priv[i] = priv32[i];
    }
    const uint p = (payload_len > WALLETDAT_MAX_PUBKEY_LEN) ? WALLETDAT_MAX_PUBKEY_LEN : payload_len;
    const thread uchar* bytes = reinterpret_cast<const thread uchar*>(payload);
    for (uint i = 0u; i < p; ++i) {
        out.payload[i] = bytes[i];
    }
    out.payload_len = uchar(p);
}

static inline bool walletks_check_hash(device RuntimeConfig& config,
                                       device XorFilterState& filters,
                                       device FilterStorageState& filter_storage,
                                       const device uchar* bloom_storage,
                                       const device uchar* xor_storage,
                                       const device uchar* xor_un_storage,
                                       const device uchar* xor_uc_storage,
                                       const device uchar* xor_hc_storage,
                                       const thread uint* h,
                                       uint payload_len) {
    return filter_check_hash_payload(config, filters, filter_storage, bloom_storage,
                                     xor_storage, xor_un_storage, xor_uc_storage,
                                     xor_hc_storage, h, payload_len);
}

static inline void walletks_check_emit_targets(device bool* isResult,
                                               device bool* buffResult,
                                               const constant secp256k1_ge_storage* precPtr,
                                               ulong precPitch,
                                               const thread uchar* source,
                                               uint source_len,
                                               uchar source_kind,
                                               ulong source_seed,
                                               const thread uchar priv32[32],
                                               bool do_c,
                                               bool do_u,
                                               bool do_s,
                                               bool do_r,
                                               bool do_x,
                                               bool do_e,
                                               device RuntimeConfig& config,
                                               device XorFilterState& filters,
                                               device FilterStorageState& filter_storage,
                                               const device uchar* bloom_storage,
                                               const device uchar* xor_storage,
                                               const device uchar* xor_un_storage,
                                               const device uchar* xor_uc_storage,
                                               const device uchar* xor_hc_storage,
                                               device WalletModeResult* wallet_results,
                                               device atomic_uint* wallet_count) {
    thread uchar pubkey65[65];
    thread ulong px[4];
    thread ulong py[4];
    if (!walletks_priv_to_xy(precPtr, precPitch, priv32, pubkey65, px, py)) {
        return;
    }

    thread uint h[8] = { 0u };
    thread uint comp_hash[8] = { 0u };
    const uchar odd_py = uchar(py[0] & 1ul);
    const bool need_comp_hash = do_c || do_s || config.p2wsh != 0u;
    if (need_comp_hash) {
        _GetHash160Comp_fast(px, odd_py, reinterpret_cast<thread uchar*>(comp_hash));
    }
    if (do_c) {
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, comp_hash, 20u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x02u, comp_hash, 20u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
    if (do_u) {
        _GetHash160Uncomp_fast(px, py, reinterpret_cast<thread uchar*>(h));
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, h, 20u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x01u, h, 20u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
    if (do_s) {
        for (int i = 0; i < 8; ++i) {
            h[i] = comp_hash[i];
        }
        _GetHash160P2SHCompFromHash(h, h);
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, h, 20u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x03u, h, 20u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
    if (config.p2wsh != 0u) {
        thread uchar p2wsh_hash[32];
        thread uint p2wsh_rmd[8] = { 0u };
        _GetP2WSHComp_fast(px, odd_py, p2wsh_hash, p2wsh_rmd);
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, p2wsh_rmd, 20u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x07u, p2wsh_hash, 32u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
    if (do_r) {
        (void)pubkey65;
    }
    if (do_x) {
        thread uint xpoint[8] = { 0u };
        u64x4_to_x32(px, reinterpret_cast<thread unsigned char*>(xpoint));
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, xpoint, 32u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x05u, xpoint, 32u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
    if (do_e) {
        thread uint eth_hash160[5] = { 0u };
        keccak_eth64_tail20_from_xy(px, py, eth_hash160);
        if (walletks_check_hash(config, filters, filter_storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, eth_hash160, 20u)) {
            walletks_emit_result(isResult, buffResult, source, source_len, source_kind,
                                 source_seed, priv32, 0x06u, eth_hash160, 20u,
                                 wallet_results, wallet_count, config.maxFounds);
        }
    }
}

static inline void walletjs_worker_impl(device bool* isResult,
                                        device bool* buffResult,
                                        const constant secp256k1_ge_storage* precPtr,
                                        ulong precPitch,
                                        WalletJsSpec spec,
                                        uchar candidate_kind,
                                        const device char* pass_data,
                                        const device uchar* pass_lens,
                                        uint pass_count,
                                        const device WalletMaskSpec* mask_spec,
                                        const device WalletRangeSpec* range_spec,
                                        ulong candidate_start,
                                        ulong candidate_count,
                                        bool do_c,
                                        bool do_u,
                                        bool do_s,
                                        bool do_r,
                                        bool do_x,
                                        bool do_e,
                                        bool use_runtime_targets,
                                        device RuntimeConfig& config,
                                        device XorFilterState& filters,
                                        device FilterStorageState& filter_storage,
                                        const device uchar* bloom_storage,
                                        const device uchar* xor_storage,
                                        const device uchar* xor_un_storage,
                                        const device uchar* xor_uc_storage,
                                        const device uchar* xor_hc_storage,
                                        device WalletModeResult* wallet_results,
                                        device atomic_uint* wallet_count,
                                        uint tid,
                                        uint threads) {
    if (candidate_count == 0ul) {
        return;
    }
    const ulong stride = ulong(threads);
    for (ulong lane = ulong(tid); lane < candidate_count; lane += stride) {
        thread uchar source[WALLET_PASS_STRIDE];
        uint source_len = 0u;
        uchar source_kind = WALLETJS_SOURCE_PASSWORD;
        ulong source_seed = 0ul;
        thread uchar priv32[32];
        if (!walletks_prepare_candidate(spec, candidate_kind, pass_data, pass_lens, pass_count,
                                        mask_spec, range_spec, candidate_start, lane, source,
                                        &source_len, &source_kind, &source_seed, priv32)) {
            continue;
        }
        const bool c = use_runtime_targets ? (config.compressed != 0u) : do_c;
        const bool u = use_runtime_targets ? (config.uncompressed != 0u) : do_u;
        const bool s = use_runtime_targets ? (config.segwit != 0u) : do_s;
        const bool r = use_runtime_targets ? (config.taproot != 0u) : do_r;
        const bool x = use_runtime_targets ? (config.xpoint != 0u) : do_x;
        const bool e = use_runtime_targets ? (config.ethereum != 0u) : do_e;
        walletks_check_emit_targets(isResult, buffResult, precPtr, precPitch, source,
                                    source_len, source_kind, source_seed, priv32,
                                    c, u, s, r, x, e, config, filters, filter_storage,
                                    bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                    xor_hc_storage, wallet_results, wallet_count);
    }
}

static inline void walletjs_seed_worker_impl(device bool* isResult,
                                             device bool* buffResult,
                                             const constant secp256k1_ge_storage* precPtr,
                                             ulong precPitch,
                                             WalletJsSpec spec,
                                             ulong candidate_start,
                                             ulong candidate_count,
                                             bool do_c,
                                             bool do_u,
                                             bool do_s,
                                             bool do_r,
                                             bool do_x,
                                             bool do_e,
                                             bool use_runtime_targets,
                                             device RuntimeConfig& config,
                                             device XorFilterState& filters,
                                             device FilterStorageState& filter_storage,
                                             const device uchar* bloom_storage,
                                             const device uchar* xor_storage,
                                             const device uchar* xor_un_storage,
                                             const device uchar* xor_uc_storage,
                                             const device uchar* xor_hc_storage,
                                             device WalletModeResult* wallet_results,
                                             device atomic_uint* wallet_count,
                                             uint tid,
                                             uint threads) {
    if (candidate_count == 0ul) {
        return;
    }
    const ulong stride = ulong(threads);
    for (ulong lane = ulong(tid); lane < candidate_count; lane += stride) {
        const ulong seed = candidate_start + lane;
        thread uchar source[WALLET_PASS_STRIDE];
        uint source_len = 0u;
        uchar source_kind = WALLETJS_SOURCE_SEED64;
        ulong source_seed = seed;
        thread uchar priv32[32];
        if (!walletks_seed_to_priv(spec, seed, source, &source_len, &source_kind,
                                   &source_seed, priv32)) {
            continue;
        }
        const bool c = use_runtime_targets ? (config.compressed != 0u) : do_c;
        const bool u = use_runtime_targets ? (config.uncompressed != 0u) : do_u;
        const bool s = use_runtime_targets ? (config.segwit != 0u) : do_s;
        const bool r = use_runtime_targets ? (config.taproot != 0u) : do_r;
        const bool x = use_runtime_targets ? (config.xpoint != 0u) : do_x;
        const bool e = use_runtime_targets ? (config.ethereum != 0u) : do_e;
        walletks_check_emit_targets(isResult, buffResult, precPtr, precPitch,
                                    source_kind == WALLETJS_SOURCE_PASSWORD ? source : nullptr,
                                    source_len, source_kind, source_seed, priv32,
                                    c, u, s, r, x, e, config, filters, filter_storage,
                                    bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                    xor_hc_storage, wallet_results, wallet_count);
    }
}

#endif
