#define WALLET_KEYSTORE_RESULT_MAC_ONLY 0x80u
#endif
#ifndef WALLET_SCRYPT_MAX_R
#define WALLET_SCRYPT_MAX_R 8u
#endif
#ifndef WALLET_SCRYPT_MAX_BLOCK
#define WALLET_SCRYPT_MAX_BLOCK (128u * WALLET_SCRYPT_MAX_R)
#endif

struct WalletJsSpec {
    uint profile_kind;
    uint prng_gen;
    uint prng_mode;
    ulong randstorm_state_start;
    uint randstorm_time_start;
    uint reserved0;
    ulong randstorm_time_count;
    uint randstorm_time_delta_count;
    uint reserved1;
};

struct WalletKeystoreTarget {
    uchar kdf_type;
    uchar has_address;
    uchar reserved0[2];
    uint iterations;
    uint dklen;
    uint scrypt_n;
    uint scrypt_r;
    uint scrypt_p;
    uint salt_len;
    uint ciphertext_len;
    uint target_index;
    uchar salt[WALLET_MAX_SALT_LEN];
    uchar iv[16];
    uchar ciphertext[WALLET_MAX_CIPHERTEXT_LEN];
    uchar mac[32];
    uchar address[20];
    uchar vault_hash[32];
};

struct ExodusSecoTarget {
    uint scrypt_n;
    uint scrypt_r;
    uint scrypt_p;
    uint salt_len;
    uint target_index;
    uchar salt[WALLET_MAX_SALT_LEN];
    uchar key_iv[12];
    uchar key_tag[16];
    uchar encrypted_key[32];
    uchar vault_hash[32];
};

struct BitcoinJWalletTarget {
    uint scrypt_n;
    uint scrypt_r;
    uint scrypt_p;
    uint salt_len;
    uint encrypted_key_len;
    uint pubkey_len;
    uint target_index;
    uchar salt[WALLET_MAX_SALT_LEN];
    uchar iv[16];
    uchar encrypted_key[WALLETDAT_MAX_CRYPTED_KEY_LEN];
    uchar pubkey[WALLETDAT_MAX_PUBKEY_LEN];
    uchar wallet_hash[32];
};

struct ArmoryWalletTarget {
    uint kdf_mem;
    uint kdf_iterations;
    uint target_index;
    uint reserved0;
    uchar salt[32];
    uchar iv[16];
    uchar encrypted_priv[32];
    uchar pubkey[65];
    uchar addr160[20];
    uchar wallet_hash[32];
};

static inline void walletks_mark_inert_kernel(device bool* isResult,
                                              device bool* buffResult) {
    (void)isResult;
    (void)buffResult;
}

static inline void walletks_mark_hit(device bool* isResult,
                                     device bool* buffResult) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
}

static inline void walletks_copy_password(device WalletModeResult& out,
                                          const thread uchar* pass,
                                          uint pass_len) {
    const uint n = (pass_len > WALLET_MAX_PASSWORD_LEN) ? WALLET_MAX_PASSWORD_LEN : pass_len;
    out.password_len = ushort(n);
    for (uint i = 0u; i < n; ++i) {
        out.password[i] = pass[i];
    }
}

static inline device WalletModeResult* walletks_begin_wallet_result(device bool* isResult,
                                                                    device bool* buffResult,
                                                                    device WalletModeResult* wallet_results,
                                                                    device atomic_uint* wallet_count,
                                                                    uint max_founds) {
    walletks_mark_hit(isResult, buffResult);
    if (wallet_results == nullptr || wallet_count == nullptr) {
        return nullptr;
    }
    const ulong ridx = wallet_atomic_add_count(wallet_count, 1u);
    if (ridx >= ulong(max_founds)) {
        return nullptr;
    }
    device WalletModeResult* out = wallet_results + ridx;
    wallet_zero_result(*out);
    return out;
}

static inline void walletks_emit_keystore_priv_result(device bool* isResult,
                                                      device bool* buffResult,
                                                      const thread uchar* pass,
                                                      uint pass_len,
                                                      uint target_index,
                                                      const thread uchar priv32[32],
                                                      const thread uchar eth20[20],
                                                      device WalletModeResult* wallet_results,
                                                      device atomic_uint* wallet_count,
                                                      uint max_founds) {
    device WalletModeResult* out = walletks_begin_wallet_result(isResult, buffResult, wallet_results, wallet_count, max_founds);
    if (out == nullptr) {
        return;
    }
    (*out).mode = WALLET_MODE_KEYSTORE;
    (*out).type = 0x01u;
    (*out).target_index = target_index;
    walletks_copy_password(*out, pass, pass_len);
    for (int i = 0; i < 32; ++i) {
        (*out).priv[i] = priv32[i];
    }
    for (int i = 0; i < 20; ++i) {
        (*out).payload[i] = eth20[i];
    }
    (*out).payload_len = 20u;
}

static inline void walletks_emit_keystore_maconly_result(device bool* isResult,
                                                         device bool* buffResult,
                                                         const thread uchar* pass,
                                                         uint pass_len,
                                                         uint target_index,
                                                         const device uchar vault_hash[32],
                                                         device WalletModeResult* wallet_results,
                                                         device atomic_uint* wallet_count,
                                                         uint max_founds) {
    device WalletModeResult* out = walletks_begin_wallet_result(isResult, buffResult, wallet_results, wallet_count, max_founds);
    if (out == nullptr) {
        return;
    }
    (*out).mode = WALLET_MODE_KEYSTORE;
    (*out).type = 0x80u;
    (*out).target_index = target_index;
    walletks_copy_password(*out, pass, pass_len);
    for (int i = 0; i < 32; ++i) {
        (*out).payload[i] = vault_hash[i];
    }
    (*out).payload_len = 32u;
}

