static inline void walletks_emit_bitcoinjwallet_result(device bool* isResult,
                                                       device bool* buffResult,
                                                       const thread uchar* pass,
                                                       uint pass_len,
                                                       uint target_index,
                                                       uchar result_mode,
                                                       const thread uchar priv32[32],
                                                       const device uchar* pubkey,
                                                       uint pubkey_len,
                                                       device WalletModeResult* wallet_results,
                                                       device atomic_uint* wallet_count,
                                                       uint max_founds) {
    device WalletModeResult* out = walletks_begin_wallet_result(isResult, buffResult, wallet_results, wallet_count, max_founds);
    if (out == nullptr) {
        return;
    }
    (*out).mode = result_mode;
    (*out).type = 0x01u;
    (*out).target_index = target_index;
    walletks_copy_password(*out, pass, pass_len);
    for (int i = 0; i < 32; ++i) {
        (*out).priv[i] = priv32[i];
    }
    const uint p = (pubkey_len > WALLETDAT_MAX_PUBKEY_LEN) ? WALLETDAT_MAX_PUBKEY_LEN : pubkey_len;
    for (uint i = 0u; i < p; ++i) {
        (*out).payload[i] = pubkey[i];
    }
    (*out).payload_len = uchar(p);
}

