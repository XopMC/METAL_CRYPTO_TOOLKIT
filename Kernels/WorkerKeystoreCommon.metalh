#define WALLET_MODE_KEYSTORE 1u
#endif
#ifndef WALLET_MODE_WALLETJS
#define WALLET_MODE_WALLETJS 3u
#endif
#ifndef WALLET_MODE_EXODUSSECO
#define WALLET_MODE_EXODUSSECO 6u
#endif
#ifndef WALLET_MODE_BITCOINJ
#define WALLET_MODE_BITCOINJ 7u
#endif
#ifndef WALLET_MODE_ARMORYWALLET
#define WALLET_MODE_ARMORYWALLET 8u
#endif
#ifndef WALLET_KDF_PBKDF2_SHA256
#define WALLET_KDF_PBKDF2_SHA256 1u
#endif
#ifndef WALLET_KDF_SCRYPT
#define WALLET_KDF_SCRYPT 2u
#endif
#ifndef WALLETJS_PROFILE_SHA256_BRAIN
#define WALLETJS_PROFILE_SHA256_BRAIN 1u
#endif
#ifndef WALLETJS_PROFILE_PRNG64_SEED
#define WALLETJS_PROFILE_PRNG64_SEED 2u
#endif
#ifndef WALLETJS_PROFILE_RANDSTORM_JSBN_EXACT
#define WALLETJS_PROFILE_RANDSTORM_JSBN_EXACT 3u
#endif
