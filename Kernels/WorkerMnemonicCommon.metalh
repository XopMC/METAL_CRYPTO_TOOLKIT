#define MNW_FC_TON_ALL TFC_TON_ALL
#define MNW_FC_XRP_ED TFC_XRP_ED
#define MNW_FC_APTOS_ED TFC_APTOS_ED
#define MNW_FC_SUI_ED TFC_SUI_ED
#define MNW_FC_IOTA_ED TFC_IOTA_ED
#define MNW_FC_ICP_ED TFC_ICP_ED
#define MNW_FC_XTZ_ED TFC_XTZ_ED

struct MnwRuntimeBuffers {
    device RuntimeConfig* config [[id(0)]];
    device XorFilterState* filters [[id(1)]];
    device FilterStorageState* filterStorage [[id(2)]];
    const device uchar* bloomStorage [[id(3)]];
    const device uchar* xorStorage [[id(4)]];
    const device uchar* xorUnStorage [[id(5)]];
    const device uchar* xorUcStorage [[id(6)]];
    const device uchar* xorHcStorage [[id(7)]];
    device char* foundStrings [[id(8)]];
    device uchar* foundPrvKeys [[id(9)]];
    device uint* foundHash160 [[id(10)]];
    device uint* foundLen [[id(11)]];
    device uint* foundIter [[id(12)]];
    device uchar* foundType [[id(13)]];
    device uint* foundDerivations [[id(14)]];
    device uint* foundDerivations2 [[id(15)]];
    device char* foundPass [[id(16)]];
    device ushort* foundPassSize [[id(17)]];
    device long* foundRound [[id(18)]];
    device ulong* foundSeed [[id(19)]];
    device atomic_uint* resultsCount [[id(20)]];
    const device SubstratePathDevice* substratePaths [[id(21)]];
    const device char* customDict [[id(22)]];
};

static inline bool mnw_make_found_from_runtime(thread FoundBuffers& found,
                                               const device MnwRuntimeBuffers& runtime) {
    if (runtime.config == nullptr || runtime.filters == nullptr || runtime.filterStorage == nullptr) {
        return false;
    }
    der_make_found_buffers(runtime.foundStrings, runtime.foundPrvKeys, runtime.foundHash160,
                           runtime.foundLen, runtime.foundIter, runtime.foundType,
                           runtime.foundDerivations, runtime.foundDerivations2,
                           runtime.foundPass, runtime.foundPassSize, runtime.foundRound,
                           runtime.foundSeed, runtime.resultsCount, runtime.config->maxFounds,
                           found);
    return true;
}

static inline void mnw_copy_thread_uchar(thread uchar* dst, const thread uchar* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void mnw_copy_thread_char(thread char* dst, const thread char* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void mnw_copy_device_char_to_thread(thread char* dst, const device char* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void mnw_copy_device_uchar_to_thread(thread uchar* dst, const device uchar* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void mnw_zero_uchar(thread uchar* dst, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = 0u;
    }
}

static inline uchar mnw_hex_nibble(uchar c) {
    if (c >= uchar('0') && c <= uchar('9')) {
        return c - uchar('0');
    }
    if (c >= uchar('a') && c <= uchar('f')) {
        return c - uchar('a') + 10u;
    }
    if (c >= uchar('A') && c <= uchar('F')) {
        return c - uchar('A') + 10u;
    }
    return 0u;
}

static inline void mnw_unhex(thread uchar* str, uint str_sz, thread uchar* unhexed, uint unhexed_sz) {
    const uint n = min(str_sz, unhexed_sz * 2u);
    uint j = 0u;
    for (uint i = 0u; (i + 1u) < n; i += 2u, ++j) {
        unhexed[j] = uchar((mnw_hex_nibble(str[i]) << 4u) | mnw_hex_nibble(str[i + 1u]));
    }
}

static inline void mnw_hexing(const thread uchar* buf, uint buf_sz, thread uchar* hexed, uint hexed_sz) {
    const char table[17] = "0123456789abcdef";
    const uint n = min(buf_sz, hexed_sz >> 1u);
    for (uint i = 0u; i < n; ++i) {
        hexed[i * 2u] = uchar(table[(buf[i] >> 4u) & 0x0fu]);
        hexed[i * 2u + 1u] = uchar(table[buf[i] & 0x0fu]);
    }
}

static inline void mnw_hash_words_from_bytes(const thread uchar* bytes, uint byte_len, thread uint out_words[8]) {
    for (uint i = 0u; i < 8u; ++i) {
        const uint off = i * 4u;
        uint w = 0u;
        for (uint j = 0u; j < 4u && (off + j) < byte_len; ++j) {
            w |= uint(bytes[off + j]) << (8u * j);
        }
        out_words[i] = w;
    }
}

static inline bool mnw_check_and_store(device bool* isResult,
                                       device bool* buffResult,
                                       const thread char* toHash,
                                       ulong len,
                                       const thread uchar* private_key32,
                                       const thread uchar* payload,
                                       uint payload_len,
                                       const thread uint* hash_words,
                                       uchar type_value,
                                       uint c_path,
                                       uint c_path2,
                                       long current_round,
                                       ushort starter_pass,
                                       const device char* passStart,
                                       uint passSize,
                                       ulong buff_index,
                                       bool store_seed,
                                       ulong seed_value,
                                       uint iter_value,
                                       bool store_iter,
                                       device RuntimeConfig& config,
                                       device XorFilterState& filters,
                                       device FilterStorageState& storage,
                                       const device uchar* bloom_storage,
                                       const device uchar* xor_storage,
                                       const device uchar* xor_un_storage,
                                       const device uchar* xor_uc_storage,
                                       const device uchar* xor_hc_storage,
                                       FoundBuffers found) {
    if (!filter_check_hash_payload(config, filters, storage, bloom_storage, xor_storage,
                                   xor_un_storage, xor_uc_storage, xor_hc_storage,
                                   hash_words, payload_len)) {
        return false;
    }
    adadot_store_result(isResult, buffResult, toHash, len, private_key32, nullptr, payload,
                        payload_len, type_value, c_path, c_path2, current_round,
                        starter_pass, passStart, passSize, buff_index, store_seed,
                        seed_value, iter_value, store_iter, config, found);
    return true;
}

static inline void mnw_emit_ton_type(device bool* isResult,
                                     device bool* buffResult,
                                     const thread char* toHash,
                                     ulong len,
                                     const thread uchar* private_key32,
                                     const thread uchar* publ,
                                     const constant char* ton_kind,
                                     uchar type_value,
                                     uint c_path,
                                     long current_round,
                                     ushort starter_pass,
                                     const device char* passStart,
                                     uint passSize,
                                     ulong buff_index,
                                     bool store_seed,
                                     ulong seed_value,
                                     uint iter_value,
                                     bool store_iter,
                                     device RuntimeConfig& config,
                                     device XorFilterState& filters,
                                     device FilterStorageState& storage,
                                     const device uchar* bloom_storage,
                                     const device uchar* xor_storage,
                                     const device uchar* xor_un_storage,
                                     const device uchar* xor_uc_storage,
                                     const device uchar* xor_hc_storage,
                                     FoundBuffers found) {
    if (!ton_type_enabled_config(config, type_value)) {
        return;
    }
    uchar hash_addr[32] = { 0 };
    if (!pubkey_to_hash_ton(publ, ton_kind, hash_addr, config.tonTypeMask)) {
        return;
    }
    uint hash_words[8];
    mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
    mnw_check_and_store(isResult, buffResult, toHash, len, private_key32, hash_addr, 32u,
                        hash_words, type_value, c_path, c_path, current_round, starter_pass,
                        passStart, passSize, buff_index, store_seed, seed_value, iter_value,
	                        store_iter, config, filters, storage, bloom_storage, xor_storage,
	                        xor_un_storage, xor_uc_storage, xor_hc_storage, found);
}

static inline bool mnw_secp_taproot_only(device RuntimeConfig& config) {
    return (MNW_FC_TAPROOT && config.taproot != 0u) &&
           !(MNW_FC_UNCOMPRESSED && config.uncompressed != 0u) &&
           !(MNW_FC_COMPRESSED && config.compressed != 0u) &&
           !(MNW_FC_SEGWIT && config.segwit != 0u) &&
           !(MNW_FC_P2WSH && config.p2wsh != 0u) &&
           !(MNW_FC_ETHEREUM && config.ethereum != 0u) &&
           !(MNW_FC_XPOINT && config.xpoint != 0u) &&
           !(MNW_FC_XRP_SECP && config.xrp != 0u && xrp_type_enabled(config, 0x90u)) &&
           !(MNW_FC_SUI_SECP && config.sui != 0u && sui_type_enabled(config, 0x70u)) &&
           !(MNW_FC_IOTA_SECP && config.iota != 0u && iota_type_enabled(config, 0x50u)) &&
           !(MNW_FC_APTOS_SECP && config.aptos != 0u && aptos_type_enabled(config, 0x22u)) &&
           !(MNW_FC_ICP_SECP && config.icp != 0u && icp_type_enabled(config, 0x53u)) &&
           !(MNW_FC_FIL_SECP && config.fil != 0u) &&
           !(MNW_FC_XTZ_SECP && config.xtz != 0u && xtz_type_enabled(config, 0x92u));
}

static inline void mnw_emit_secp_targets_from_key(device bool* isResult,
                                                  device bool* buffResult,
                                                  const thread char* toHash,
                                                  ulong len,
                                                  thread uchar private_key32[32],
                                                  uint c_path,
                                                  ulong round,
                                                  ushort starter_pass,
                                                  const device char* passStart,
                                                  uint passSize,
                                                  ulong buff_index,
                                                  bool store_seed,
                                                  ulong seed_value,
                                                  uint iter_value,
                                                  bool store_iter,
                                                  bool store_p2wsh_iter,
                                                  constant secp256k1_ge_storage* precPtr,
                                                  ulong precPitch,
                                                  device RuntimeConfig& config,
                                                  device XorFilterState& filters,
                                                  device FilterStorageState& storage,
                                                  const device uchar* bloom_storage,
                                                  const device uchar* xor_storage,
                                                  const device uchar* xor_un_storage,
                                                  const device uchar* xor_uc_storage,
                                                  const device uchar* xor_hc_storage,
                                                  FoundBuffers found) {
    if (!MNW_FC_SECP_ANY || config.secpTargetsAny == 0u) {
        return;
    }
	if (round > 0ul) {
        bump_key_256(private_key32, round, false);
	}
    const bool taproot_only = mnw_secp_taproot_only(config);

	for (ulong s = 0ul; s <= (2ul * round); ++s) {
	    const long current_round = long(s) - long(round);
        if (taproot_only) {
            secp256k1_ge pub_ge;
            secp256k1_ec_pubkey_create_ge(&pub_ge, private_key32, precPtr, size_t(precPitch));
            uint hash_words[8] = { 0 };
            uchar taproot_hash[32] = { 0 };
            TweakTaproot_ge(taproot_hash, &pub_ge, precPtr, size_t(precPitch));
            _GetRMD160(reinterpret_cast<thread uint*>(taproot_hash), hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                taproot_hash, 32u, hash_words, 0x04u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        } else {
	    uchar pubkey65[65] = { 0x04u };
	    secp256k1_ec_pubkey_create(reinterpret_cast<thread secp256k1_pubkey*>(pubkey65 + 1),
	                               private_key32, precPtr, size_t(precPitch));

        uint hash_words[8] = { 0 };
        int keyLenSkip = 0;

        if (MNW_FC_UNCOMPRESSED && config.uncompressed != 0u) {
            keyLenSkip = 0;
            _GetHash160(pubkey65, keyLenSkip, reinterpret_cast<thread uchar*>(hash_words));
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x01u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_COMPRESSED && config.compressed != 0u) {
            keyLenSkip = 0;
            _GetHash160Comp(pubkey65, keyLenSkip, reinterpret_cast<thread uchar*>(hash_words));
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x02u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_SEGWIT && config.segwit != 0u) {
            if (config.compressed == 0u) {
                keyLenSkip = 0;
                _GetHash160Comp(pubkey65, keyLenSkip, reinterpret_cast<thread uchar*>(hash_words));
            }
            _GetHash160P2SHCompFromHash(hash_words, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x03u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_P2WSH && config.p2wsh != 0u) {
            uchar p2wsh_hash[32] = { 0 };
            uint p2wsh_rmd[8] = { 0 };
            _GetP2WSHComp(pubkey65, p2wsh_hash, p2wsh_rmd);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                p2wsh_hash, 32u, p2wsh_rmd, 0x07u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_p2wsh_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_ETHEREUM && config.ethereum != 0u) {
            uchar keccak_hash[32] = { 0 };
            keccak(reinterpret_cast<thread char*>(pubkey65 + 1), 64, keccak_hash, 32);
            for (uint h = 12u, i = 0u; i < 5u; ++i) {
                hash_words[i] = uint(keccak_hash[h]) |
                                ((uint(keccak_hash[h + 1u]) << 8u) & 0x0000ff00u) |
                                ((uint(keccak_hash[h + 2u]) << 16u) & 0x00ff0000u) |
                                ((uint(keccak_hash[h + 3u]) << 24u) & 0xff000000u);
                h += 4u;
            }
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x06u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_TAPROOT && config.taproot != 0u) {
            uchar taproot_hash[32] = { 0 };
            TweakTaproot(taproot_hash, pubkey65, precPtr, size_t(precPitch));
            _GetRMD160(reinterpret_cast<thread uint*>(taproot_hash), hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                taproot_hash, 32u, hash_words, 0x04u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_XPOINT && config.xpoint != 0u) {
            uchar xpoint[32] = { 0 };
            mnw_copy_thread_uchar(xpoint, pubkey65 + 1, 32u);
            mnw_hash_words_from_bytes(xpoint, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                xpoint, 32u, hash_words, 0x05u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_XRP_SECP && config.xrp != 0u && xrp_type_enabled(config, 0x90u)) {
            keyLenSkip = 0;
            _GetHash160Comp(pubkey65, keyLenSkip, reinterpret_cast<thread uchar*>(hash_words));
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x90u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_SUI_SECP && config.sui != 0u && sui_type_enabled(config, 0x70u)) {
            uchar buff[34] = { 0 };
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey65[64] & 1u);
            mnw_copy_thread_uchar(buff + 2, pubkey65 + 1, 32u);
            uchar hash_addr[32] = { 0 };
            Blake2b_256(buff, 34u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                hash_addr, 32u, hash_words, 0x70u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_IOTA_SECP && config.iota != 0u && iota_type_enabled(config, 0x50u)) {
            uchar buff[34] = { 0 };
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey65[64] & 1u);
            mnw_copy_thread_uchar(buff + 2, pubkey65 + 1, 32u);
            uchar hash_addr[32] = { 0 };
            Blake2b_256(buff, 34u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                hash_addr, 32u, hash_words, 0x50u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_APTOS_SECP && config.aptos != 0u && aptos_type_enabled(config, 0x22u)) {
            uchar buff[35] = { 0 };
            buff[0] = 0x01u;
            buff[1] = 0x02u + (pubkey65[64] & 1u);
            mnw_copy_thread_uchar(buff + 2, pubkey65 + 1, 32u);
            buff[34] = 0x02u;
            uchar hash_addr[32] = { 0 };
            sha3_256(reinterpret_cast<thread char*>(buff), 35, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                hash_addr, 32u, hash_words, 0x22u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_ICP_SECP && config.icp != 0u && icp_type_enabled(config, 0x53u)) {
            uchar principal[29] = { 0 };
            icp_principal_from_secp256k1(pubkey65, principal);
            uchar hash_addr[32] = { 0 };
            icp_account_identifier(principal, nullptr, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                hash_addr, 32u, hash_words, 0x53u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_FIL_SECP && config.fil != 0u) {
            if (fil_type_enabled(config, 0x41u)) {
                uchar hash_addr[20] = { 0 };
                Blake2b_160(pubkey65, 65u, hash_addr);
                mnw_hash_words_from_bytes(hash_addr, 20u, hash_words);
                mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                    hash_addr, 20u, hash_words, 0x41u, c_path, c_path,
                                    current_round, starter_pass, passStart, passSize,
                                    buff_index, store_seed, seed_value, iter_value, store_iter,
                                    config, filters, storage, bloom_storage, xor_storage,
                                    xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            }
            if (fil_type_enabled(config, 0x42u)) {
                uchar keccak_hash[32] = { 0 };
                keccak(reinterpret_cast<thread char*>(pubkey65 + 1), 64, keccak_hash, 32);
                for (uint h = 12u, i = 0u; i < 5u; ++i) {
                    hash_words[i] = uint(keccak_hash[h]) |
                                    ((uint(keccak_hash[h + 1u]) << 8u) & 0x0000ff00u) |
                                    ((uint(keccak_hash[h + 2u]) << 16u) & 0x00ff0000u) |
                                    ((uint(keccak_hash[h + 3u]) << 24u) & 0xff000000u);
                    h += 4u;
                }
                mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                    reinterpret_cast<thread uchar*>(hash_words), 20u, hash_words,
                                    0x42u, c_path, c_path, current_round, starter_pass,
                                    passStart, passSize, buff_index, store_seed, seed_value,
                                    iter_value, store_iter, config, filters, storage,
                                    bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                    xor_hc_storage, found);
            }
        }
	        if (MNW_FC_XTZ_SECP && config.xtz != 0u && xtz_type_enabled(config, 0x92u)) {
	            uchar buff[33] = { 0 };
	            buff[0] = 0x02u + (pubkey65[64] & 1u);
            mnw_copy_thread_uchar(buff + 1, pubkey65 + 1, 32u);
            uchar hash_addr[20] = { 0 };
            Blake2b_160(buff, 33u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 20u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, private_key32,
                                hash_addr, 20u, hash_words, 0x92u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
	                                config, filters, storage, bloom_storage, xor_storage,
	                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
	        }
        }

	    if (s < (2ul * round)) {
	        const bool wrapped = bump_key_256(private_key32, 1ul, true);
            if (wrapped) {
                s += 2ul;
            }
        }
    }
}

static inline void mnw_emit_ed_targets_from_key(device bool* isResult,
                                                device bool* buffResult,
                                                const thread char* toHash,
                                                ulong len,
                                                const thread uchar base_key[32],
                                                const thread uchar* next_key,
                                                uint c_path,
                                                ulong round,
                                                ushort starter_pass,
                                                const device char* passStart,
                                                uint passSize,
                                                ulong buff_index,
                                                bool store_seed,
                                                ulong seed_value,
                                                uint iter_value,
                                                bool store_iter,
                                                bool invert_scalar_for_ada,
                                                device RuntimeConfig& config,
                                                const device SubstratePathDevice* substratePaths,
                                                device XorFilterState& filters,
                                                device FilterStorageState& storage,
                                                const device uchar* bloom_storage,
                                                const device uchar* xor_storage,
                                                const device uchar* xor_un_storage,
                                                const device uchar* xor_uc_storage,
                                                const device uchar* xor_hc_storage,
                                                FoundBuffers found) {
    const bool dot_ed_active = MNW_FC_DOT && config.dot != 0u &&
                               dot_type_enabled(config, 0x30u);
    const bool dot_sr_active = MNW_FC_DOT && config.dot != 0u &&
                               dot_type_enabled(config, 0x31u);
    const bool dot_active = dot_ed_active || dot_sr_active;
    const bool dot_suri_active = dot_active && config.substratePathCount > 0u;
    const bool ton_popular_active = MNW_FC_TON && config.ton != 0u &&
                                    (ton_type_enabled_config(config, 0x85u) ||
                                     ton_type_enabled_config(config, 0x86u) ||
                                     ton_type_enabled_config(config, 0x88u) ||
                                     ton_type_enabled_config(config, 0x89u) ||
                                     ton_type_enabled_config(config, 0x8cu));
    const bool ton_all_active = MNW_FC_TON_ALL && config.tonAll != 0u && config.tonTypeMask != 0u;
    const bool aptos_legacy = MNW_FC_APTOS_ED && config.aptos != 0u && aptos_type_enabled(config, 0x20u);
    const bool aptos_general_ed = MNW_FC_APTOS_ED && config.aptos != 0u && aptos_type_enabled(config, 0x21u);
    const bool sui_ed = MNW_FC_SUI_ED && config.sui != 0u && sui_type_enabled(config, 0x71u);
    const bool xrp_ed = MNW_FC_XRP_ED && config.xrp != 0u && xrp_type_enabled(config, 0x91u);
    const bool iota_ed = MNW_FC_IOTA_ED && config.iota != 0u && iota_type_enabled(config, 0x51u);
    const bool icp_ed = MNW_FC_ICP_ED && config.icp != 0u && icp_type_enabled(config, 0x52u);
    const bool xtz_ed = MNW_FC_XTZ_ED && config.xtz != 0u && xtz_type_enabled(config, 0x93u);
    const bool needs_common_pub = (MNW_FC_SOLANA && config.solana != 0u) ||
                                  dot_ed_active || ton_popular_active || ton_all_active ||
                                  aptos_legacy || aptos_general_ed || sui_ed ||
                                  xrp_ed || iota_ed || icp_ed || xtz_ed;
    if (!MNW_FC_ED_ANY || config.edTargetsAny == 0u ||
        !((MNW_FC_SOLANA && config.solana != 0u) ||
          (MNW_FC_ADA && config.ada != 0u) || dot_active ||
          ton_popular_active || ton_all_active || aptos_legacy ||
          aptos_general_ed || sui_ed || xrp_ed || iota_ed || icp_ed ||
          xtz_ed)) {
        return;
    }

    uchar key_cur[32];
    uchar next_cur[32];
    mnw_copy_thread_uchar(key_cur, base_key, 32u);
    const bool has_next_key = next_key != nullptr;
    if (has_next_key) {
        mnw_copy_thread_uchar(next_cur, next_key, 32u);
    }
    if (round > 0ul) {
        bump_key_256(key_cur, round, false);
        if (has_next_key) {
            bump_key_256(next_cur, round, false);
        }
    }

    for (ulong s = 0ul; s <= (2ul * round); ++s) {
        const long current_round = long(s) - long(round);
        uchar publ[32] = { 0 };
        uint hash_words[8] = { 0 };
        if (needs_common_pub) {
            priv_ed25519_key_to_pub_one_config(key_cur, publ, config);
        }

        if (MNW_FC_SOLANA && config.solana != 0u) {
            mnw_hash_words_from_bytes(publ, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur, publ, 32u,
                                hash_words, 0x60u, c_path, c_path, current_round,
                                starter_pass, passStart, passSize, buff_index, store_seed,
                                seed_value, iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (dot_ed_active) {
            adadot_emit_dot_ed25519_public(isResult, buffResult, toHash, len, key_cur, publ,
                                           c_path, current_round, starter_pass, passStart,
                                           passSize, buff_index, store_seed, seed_value,
                                           iter_value, store_iter, config, filters, storage,
                                           bloom_storage, xor_storage, xor_un_storage,
                                           xor_uc_storage, xor_hc_storage, found);
        }
        if (dot_sr_active) {
            adadot_emit_dot_sr25519_seed(isResult, buffResult, toHash, len, key_cur, c_path,
                                         current_round, starter_pass, passStart, passSize,
                                         buff_index, store_seed, seed_value, iter_value,
                                         store_iter, config, filters, storage, bloom_storage,
                                         xor_storage, xor_un_storage, xor_uc_storage,
                                         xor_hc_storage, found);
        }
        if (dot_suri_active) {
            adadot_emit_dot_substrate_from_seed(isResult, buffResult, toHash, len, key_cur,
                                                current_round, starter_pass, passStart,
                                                passSize, buff_index, store_seed, seed_value,
                                                iter_value, store_iter, config, substratePaths,
                                                filters, storage, bloom_storage, xor_storage,
                                                xor_un_storage, xor_uc_storage, xor_hc_storage,
                                                found);
        }
        if (MNW_FC_ADA && config.ada != 0u) {
            const thread uchar* next_ptr = has_next_key ? next_cur : nullptr;
            adadot_emit_ada_direct_keyset(isResult, buffResult, toHash, len, key_cur, next_ptr,
                                          c_path, current_round, starter_pass, passStart,
                                          passSize, buff_index, store_seed, seed_value,
                                          iter_value, store_iter, invert_scalar_for_ada,
                                          config, filters, storage, bloom_storage,
                                          xor_storage, xor_un_storage, xor_uc_storage,
                                          xor_hc_storage, found);
        }
        if (ton_popular_active) {
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v3r1", 0x85u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v3r2", 0x86u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v4r2", 0x88u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v5r1", 0x89u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "hv3", 0x8cu,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (ton_all_active) {
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v1r1", 0x80u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v1r2", 0x81u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v1r3", 0x82u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v2r1", 0x83u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v2r2", 0x84u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "v4r1", 0x87u,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "hv1", 0x8au,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            mnw_emit_ton_type(isResult, buffResult, toHash, len, key_cur, publ, "hv2", 0x8bu,
                              c_path, current_round, starter_pass, passStart, passSize,
                              buff_index, store_seed, seed_value, iter_value, store_iter,
                              config, filters, storage, bloom_storage, xor_storage,
                              xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_XRP_ED && config.xrp != 0u && xrp_type_enabled(config, 0x91u)) {
            int keyLenSkip = 0;
            _GetHash160ED(publ, keyLenSkip, reinterpret_cast<thread uchar*>(hash_words));
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                reinterpret_cast<thread uchar*>(hash_words), 32u, hash_words,
                                0x91u, c_path, c_path, current_round, starter_pass,
                                passStart, passSize, buff_index, store_seed, seed_value,
                                iter_value, store_iter, config, filters, storage,
                                bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                                xor_hc_storage, found);
        }
        if (MNW_FC_APTOS_ED && config.aptos != 0u) {
            if (aptos_type_enabled(config, 0x20u)) {
                uchar buff[33] = { 0 };
                mnw_copy_thread_uchar(buff, publ, 32u);
                uchar hash_addr[32] = { 0 };
                sha3_256(reinterpret_cast<thread char*>(buff), 33, hash_addr);
                mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
                mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                    hash_addr, 32u, hash_words, 0x20u, c_path, c_path,
                                    current_round, starter_pass, passStart, passSize,
                                    buff_index, store_seed, seed_value, iter_value, store_iter,
                                    config, filters, storage, bloom_storage, xor_storage,
                                    xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            }
            if (aptos_type_enabled(config, 0x21u)) {
                uchar buff[34] = { 0 };
                mnw_copy_thread_uchar(buff + 1, publ, 32u);
                buff[33] = 0x02u;
                uchar hash_addr[32] = { 0 };
                sha3_256(reinterpret_cast<thread char*>(buff), 34, hash_addr);
                mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
                mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                    hash_addr, 32u, hash_words, 0x21u, c_path, c_path,
                                    current_round, starter_pass, passStart, passSize,
                                    buff_index, store_seed, seed_value, iter_value, store_iter,
                                    config, filters, storage, bloom_storage, xor_storage,
                                    xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            }
        }
        if (MNW_FC_SUI_ED && config.sui != 0u && sui_type_enabled(config, 0x71u)) {
            uchar buff[33] = { 0 };
            mnw_copy_thread_uchar(buff + 1, publ, 32u);
            uchar hash_addr[32] = { 0 };
            Blake2b_256(buff, 33u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                hash_addr, 32u, hash_words, 0x71u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_IOTA_ED && config.iota != 0u && iota_type_enabled(config, 0x51u)) {
            uchar hash_addr[32] = { 0 };
            Blake2b_256(publ, 32u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                hash_addr, 32u, hash_words, 0x51u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_ICP_ED && config.icp != 0u && icp_type_enabled(config, 0x52u)) {
            uchar principal[29] = { 0 };
            icp_principal_from_ed25519(publ, principal);
            uchar hash_addr[32] = { 0 };
            icp_account_identifier(principal, nullptr, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 32u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                hash_addr, 32u, hash_words, 0x52u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (MNW_FC_XTZ_ED && config.xtz != 0u && xtz_type_enabled(config, 0x93u)) {
            uchar hash_addr[20] = { 0 };
            Blake2b_160(publ, 32u, hash_addr);
            mnw_hash_words_from_bytes(hash_addr, 20u, hash_words);
            mnw_check_and_store(isResult, buffResult, toHash, len, key_cur,
                                hash_addr, 20u, hash_words, 0x93u, c_path, c_path,
                                current_round, starter_pass, passStart, passSize,
                                buff_index, store_seed, seed_value, iter_value, store_iter,
                                config, filters, storage, bloom_storage, xor_storage,
                                xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }

        if (s < (2ul * round)) {
            const bool wrapped = bump_key_256(key_cur, 1ul, true);
            if (has_next_key) {
                bump_key_256(next_cur, 1ul, true);
            }
            if (wrapped) {
                s += 2ul;
            }
        }
    }
}

static inline bool mnw_derivation_path_equal(const device uint* deriv,
                                             uint lhs_offset,
                                             uint lhs_len,
                                             uint rhs_offset,
                                             uint rhs_len) {
    if (lhs_len != rhs_len) {
        return false;
    }
    for (uint i = 0u; i < lhs_len; ++i) {
        if (deriv[lhs_offset + i] != deriv[rhs_offset + i]) {
            return false;
        }
    }
    return true;
}

static inline void mnw_process_paths(device bool* isResult,
                                     device bool* buffResult,
                                     const thread char* toHash,
                                     ulong len,
                                     const thread extended_private_key_t* master_private,
                                     const thread extended_private_key_t* ed25519_master_private,
                                     const device uint* d_derivations,
                                     const device uint* derindex,
                                     uint der_indexes_size,
                                     uint der_start_index,
                                     ulong round,
                                     ushort starter_pass,
                                     const device char* passStart,
                                     uint passSize,
                                     ulong buff_index,
                                     bool store_seed,
                                     ulong seed_value,
                                     uint iter_value,
                                     bool store_iter,
                                     constant secp256k1_ge_storage* precPtr,
                                     ulong precPitch,
                                     device RuntimeConfig& config,
                                     device XorFilterState& filters,
                                     device FilterStorageState& storage,
                                     const device uchar* bloom_storage,
                                     const device uchar* xor_storage,
                                     const device uchar* xor_un_storage,
                                     const device uchar* xor_uc_storage,
                                     const device uchar* xor_hc_storage,
                                     FoundBuffers found,
                                     const device SubstratePathDevice* substratePaths) {
    const bool run_bip32_paths = (MNW_FC_SECP_ANY || MNW_FC_ED_ANY) &&
                                 config.secp256 != 0u &&
                                 config.bipDerivationsEnabled != 0u &&
                                 target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_BIP32);
    const bool run_slip0010_paths = MNW_FC_ED_ANY &&
                                    config.ed25519 != 0u &&
                                    config.bipDerivationsEnabled != 0u &&
                                    target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_SLIP0010);
    const bool run_bip32_ed25519_paths = MNW_FC_ED_ANY &&
                                         config.ed25519 != 0u &&
                                         config.bipDerivationsEnabled != 0u &&
                                         target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_BIP32_ED25519);
    const bool run_dot_suri_paths = MNW_FC_DOT && config.dot != 0u && config.substratePathCount > 0u;
    const bool skip_secp_for_solana_only = MNW_FC_SOLANA && config.solana != 0u &&
                                           (!MNW_FC_SECP_ANY || config.secpTargetsAny == 0u);

    if (run_dot_suri_paths && ed25519_master_private != nullptr) {
        adadot_emit_dot_substrate_from_seed(isResult, buffResult, toHash, len,
                                            ed25519_master_private->key, 0l, starter_pass,
                                            passStart, passSize, buff_index, store_seed,
                                            seed_value, iter_value, store_iter, config,
                                            substratePaths, filters, storage, bloom_storage,
                                            xor_storage, xor_un_storage, xor_uc_storage,
                                            xor_hc_storage, found);
    }

    if (d_derivations == nullptr || derindex == nullptr) {
        return;
    }

    uint processed_se = 0u;
    uint processed_ed = 0u;
    uint processed_bip32_ed = 0u;
    uint c_path = 0u;

    for (uint start_point = der_start_index; start_point < der_indexes_size; ++start_point, ++c_path) {
        const uint path_len = derindex[start_point];

        if (run_bip32_paths && master_private != nullptr) {
            const uint current_offset = processed_se;
            uchar prvKeys[32] = { 0 };
            der_get_child_key_secp256k1(precPtr, size_t(precPitch), master_private,
                                        d_derivations + current_offset, path_len, prvKeys);

            uchar bip32_base_key[32] = { 0 };
            uchar bip32_next_key[32] = { 0 };
            const thread uchar* bip32_next_key_ptr = nullptr;
            mnw_copy_thread_uchar(bip32_base_key, prvKeys, 32u);
            if (MNW_FC_ADA && config.ada != 0u && start_point + 1u < der_indexes_size) {
                const uint next_len = derindex[start_point + 1u];
                const uint next_offset = current_offset + path_len;
                if (!mnw_derivation_path_equal(d_derivations, current_offset, path_len,
                                               next_offset, next_len)) {
                    der_get_child_key_secp256k1(precPtr, size_t(precPitch), master_private,
                                                d_derivations + next_offset, next_len,
                                                bip32_next_key);
                    bip32_next_key_ptr = bip32_next_key;
                }
            }
            mnw_emit_ed_targets_from_key(isResult, buffResult, toHash, len, bip32_base_key,
                                         bip32_next_key_ptr, c_path, round, starter_pass,
                                         passStart, passSize, buff_index, store_seed, seed_value,
                                         iter_value, store_iter, true, config, substratePaths,
                                         filters, storage, bloom_storage, xor_storage,
                                         xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            if (!skip_secp_for_solana_only) {
                mnw_emit_secp_targets_from_key(isResult, buffResult, toHash, len, prvKeys, c_path,
                                               round, starter_pass, passStart, passSize,
                                               buff_index, store_seed, seed_value, iter_value,
                                               store_iter, store_iter, precPtr, precPitch, config, filters,
                                               storage, bloom_storage, xor_storage, xor_un_storage,
                                               xor_uc_storage, xor_hc_storage, found);
            }
        }

        uchar ed_path_key32[32] = { 0 };
        if (run_slip0010_paths && ed25519_master_private != nullptr) {
            der_get_child_key_ed25519(ed25519_master_private,
                                      d_derivations + processed_ed,
                                      path_len, ed_path_key32);
            if (!skip_secp_for_solana_only) {
                uchar secp_copy[32] = { 0 };
                mnw_copy_thread_uchar(secp_copy, ed_path_key32, 32u);
                mnw_emit_secp_targets_from_key(isResult, buffResult, toHash, len, secp_copy,
                                               c_path, round, starter_pass, passStart, passSize,
                                               buff_index, store_seed, seed_value, iter_value,
                                               store_iter, store_iter, precPtr, precPitch, config, filters,
                                               storage, bloom_storage, xor_storage, xor_un_storage,
                                               xor_uc_storage, xor_hc_storage, found);
            }
            mnw_emit_ed_targets_from_key(isResult, buffResult, toHash, len, ed_path_key32, nullptr,
                                         c_path, round, starter_pass, passStart, passSize,
                                         buff_index, store_seed, seed_value, iter_value,
                                         store_iter, false, config, substratePaths, filters,
                                         storage, bloom_storage, xor_storage, xor_un_storage,
                                         xor_uc_storage, xor_hc_storage, found);
        }

        if (run_bip32_ed25519_paths && ed25519_master_private != nullptr) {
            if (!run_slip0010_paths) {
                der_get_child_key_ed25519(ed25519_master_private,
                                          d_derivations + processed_bip32_ed,
                                          path_len,
                                          ed_path_key32);
            }
            mnw_emit_ed_targets_from_key(isResult, buffResult, toHash, len, ed_path_key32,
                                         nullptr, c_path, round, starter_pass, passStart,
                                         passSize, buff_index, store_seed, seed_value,
                                         iter_value, store_iter, false, config, substratePaths,
                                         filters, storage, bloom_storage, xor_storage,
                                         xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }

        processed_se += path_len;
        processed_ed += path_len;
        processed_bip32_ed += path_len;
    }
}

static inline void mnw_process_seed_hmac_candidate(MnwWorkerKind kind,
                                                   device bool* isResult,
                                                   device bool* buffResult,
                                                   const thread char* toHash,
                                                   ulong len,
                                                   const thread uchar* hmac_seed64,
                                                   const device uint* d_derivations,
                                                   const device uint* derindex,
                                                   uint der_indexes_size,
                                                   uint der_start_index,
                                                   ulong round,
                                                   ushort starter_pass,
                                                   const device char* passStart,
                                                   uint passSize,
                                                   ulong buff_index,
                                                   bool store_seed,
                                                   ulong seed_value,
                                                   constant secp256k1_ge_storage* precPtr,
                                                   ulong precPitch,
                                                   device RuntimeConfig& config,
                                                   device XorFilterState& filters,
                                                   device FilterStorageState& storage,
                                                   const device uchar* bloom_storage,
                                                   const device uchar* xor_storage,
                                                   const device uchar* xor_un_storage,
                                                   const device uchar* xor_uc_storage,
                                                   const device uchar* xor_hc_storage,
                                                   FoundBuffers found,
                                                   const device SubstratePathDevice* substratePaths) {
    const bool need_bip32 = (MNW_FC_SECP_ANY || MNW_FC_ED_ANY) &&
                            config.secp256 != 0u &&
                            config.bipDerivationsEnabled != 0u &&
                            target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_BIP32);
    const bool need_ed = MNW_FC_ED_ANY &&
                         config.ed25519 != 0u &&
                         config.bipDerivationsEnabled != 0u &&
                         target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_SLIP0010 |
                                                               DERIVATION_TYPE_MASK_BIP32_ED25519);
    const bool need_dot_suri = MNW_FC_DOT && config.dot != 0u && config.substratePathCount > 0u;
    const bool need_ed_or_dot = need_ed || need_dot_suri;

    uchar bip32_seed[64] = { 0 };
    uchar ed_seed[64] = { 0 };
    thread extended_private_key_t* master_private = nullptr;
    thread extended_private_key_t* ed25519_master_private = nullptr;

    if (kind == MNW_KIND_HMAC && hmac_seed64 != nullptr) {
        if (need_bip32) {
            mnw_copy_thread_uchar(bip32_seed, hmac_seed64, 64u);
            master_private = reinterpret_cast<thread extended_private_key_t*>(bip32_seed);
        }
        if (need_ed_or_dot) {
            mnw_copy_thread_uchar(ed_seed, hmac_seed64, 64u);
            ed25519_master_private = reinterpret_cast<thread extended_private_key_t*>(ed_seed);
        }
    } else {
        if (need_bip32) {
            if (len == 64ul) {
                HMAC_SHA512_BTC_SEED_64(reinterpret_cast<const thread uchar*>(toHash), bip32_seed);
            } else {
                HMAC_SHA512(MNW_BTC_SEED_KEY, 12ul, reinterpret_cast<const thread uchar*>(toHash),
                            len, bip32_seed);
            }
            master_private = reinterpret_cast<thread extended_private_key_t*>(bip32_seed);
        }
        if (need_ed_or_dot) {
            if (config.tonMnemonic == 0u) {
                if (len == 64ul) {
                    HMAC_SHA512_ED25519_SEED_64(reinterpret_cast<const thread uchar*>(toHash), ed_seed);
                } else {
                    HMAC_SHA512(ed_key, 12ul, reinterpret_cast<const thread uchar*>(toHash),
                                len, ed_seed);
                }
            } else {
                fastpbkdf2_hmac_sha512(reinterpret_cast<const thread uchar*>(toHash), len,
                                       ton_salt, 16ul, 100000ul, ed_seed, 64ul);
            }
            ed25519_master_private = reinterpret_cast<thread extended_private_key_t*>(ed_seed);
        }
    }

    mnw_process_paths(isResult, buffResult, toHash, len, master_private, ed25519_master_private,
                      d_derivations, derindex, der_indexes_size, der_start_index, round,
                      starter_pass, passStart, passSize, buff_index, store_seed, seed_value,
                      0u, false, precPtr, precPitch, config, filters, storage, bloom_storage,
                      xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                      substratePaths);
}

static inline bool mnw_entropy_fill(uint entropy_len,
                                    thread uchar* out,
                                    ulong seed_value,
                                    bool is_64,
                                    int mode,
                                    int gen,
                                    ulong skip64) {
    if (entropy_len == 0u || entropy_len > 512u) {
        return false;
    }
    if (is_64) {
        return prng64_entropy_fill(int(entropy_len), out, seed_value, mode, gen, skip64);
    }
    if (seed_value > 0xfffffffful) {
        return false;
    }
    return prng32_entropy_fill(int(entropy_len), out, uint(seed_value), mode, gen, skip64);
}

static inline bool mnw_entropy_transform(thread uchar entropy[512],
                                         thread uint& entropy_len,
                                         uint entropy_mode,
                                         uint iteration,
                                         bool allow_hex_input,
                                         device RuntimeConfig& config) {
    if (entropy_len > 512u) {
        return false;
    }
    if (allow_hex_input && config.isHex != 0u) {
        mnw_unhex(entropy, entropy_len, entropy, entropy_len / 2u);
        entropy_len >>= 1u;
    }

    switch (entropy_mode) {
    case 0x00u:
        break;
    case 0x01u:
        SHA256(entropy, size_t(entropy_len), entropy);
        for (uint i = 1u; i < iteration; ++i) {
            uint hash_len = 32u;
            if (config.utf8 != 0u) {
                uchar hash_local[64] = { 0 };
                mnw_hexing(entropy, 32u, hash_local, 64u);
                mnw_copy_thread_uchar(entropy, hash_local, 64u);
                hash_len = 64u;
            }
            SHA256(entropy, size_t(hash_len), entropy);
        }
        entropy_len = 32u;
        break;
    case 0x02u:
        SHA512(entropy, ulong(entropy_len), entropy);
        for (uint i = 1u; i < iteration; ++i) {
            uint hash_len = 64u;
            if (config.utf8 != 0u) {
                uchar hash_local[128] = { 0 };
                mnw_hexing(entropy, 64u, hash_local, 128u);
                mnw_copy_thread_uchar(entropy, hash_local, 128u);
                hash_len = 128u;
            }
            SHA512(entropy, ulong(hash_len), entropy);
        }
        entropy_len = 64u;
        break;
    case 0x03u:
        keccak(reinterpret_cast<thread char*>(entropy), entropy_len, entropy, 32);
        for (uint i = 1u; i < iteration; ++i) {
            uint hash_len = 32u;
            if (config.utf8 != 0u) {
                uchar hash_local[64] = { 0 };
                mnw_hexing(entropy, 32u, hash_local, 64u);
                mnw_copy_thread_uchar(entropy, hash_local, 64u);
                hash_len = 64u;
            }
            keccak(reinterpret_cast<thread char*>(entropy), hash_len, entropy, 32);
        }
        entropy_len = 32u;
        break;
    case 0x04u:
        sha3_256(reinterpret_cast<thread char*>(entropy), entropy_len, entropy);
        for (uint i = 1u; i < iteration; ++i) {
            uint hash_len = 32u;
            if (config.utf8 != 0u) {
                uchar hash_local[64] = { 0 };
                mnw_hexing(entropy, 32u, hash_local, 64u);
                mnw_copy_thread_uchar(entropy, hash_local, 64u);
                hash_len = 64u;
            }
            sha3_256(reinterpret_cast<thread char*>(entropy), hash_len, entropy);
        }
        entropy_len = 32u;
        break;
    case 0x05u:
        MD5(entropy, size_t(entropy_len), entropy);
        for (uint i = 1u; i < iteration; ++i) {
            uint hash_len = 16u;
            if (config.utf8 != 0u) {
                uchar hash_local[32] = { 0 };
                mnw_hexing(entropy, 16u, hash_local, 32u);
                mnw_copy_thread_uchar(entropy, hash_local, 32u);
                hash_len = 32u;
            }
            MD5(entropy, size_t(hash_len), entropy);
        }
        entropy_len = 16u;
        break;
    case 0x06u: {
        uchar hexed_entropy[512] = { 0 };
        const uint hex_len = min(entropy_len * 2u, 512u);
        mnw_hexing(entropy, entropy_len, hexed_entropy, hex_len);
        mnw_copy_thread_uchar(entropy, hexed_entropy, hex_len);
        entropy_len = hex_len;
        break;
    }
    default:
        break;
    }
    return entropy_len <= 512u;
}

static inline void mnw_process_entropy_candidate(device bool* isResult,
                                                 device bool* buffResult,
                                                 const thread uchar* raw_entropy,
                                                 uint raw_entropy_len,
                                                 bool allow_hex_input,
                                                 const device uint* d_derivations,
                                                 const device uint* derindex,
                                                 uint der_indexes_size,
                                                 uint der_start_index,
                                                 const device char* passwd,
                                                 uint pass_size,
                                                 uint starter_pass,
                                                 bool custom_size,
                                                 int custom_len,
                                                 uchar entropy_mode,
                                                 uint iteration,
                                                 ulong round,
                                                 ulong buff_index,
                                                 constant secp256k1_ge_storage* precPtr,
                                                 ulong precPitch,
                                                 device RuntimeConfig& config,
                                                 device XorFilterState& filters,
                                                 device FilterStorageState& storage,
                                                 const device uchar* bloom_storage,
                                                 const device uchar* xor_storage,
                                                 const device uchar* xor_un_storage,
                                                 const device uchar* xor_uc_storage,
                                                 const device uchar* xor_hc_storage,
                                                 FoundBuffers found,
                                                 const device SubstratePathDevice* substratePaths,
                                                 const device char* customDict) {
    if (raw_entropy_len == 0u || raw_entropy_len > 512u) {
        return;
    }

    uchar entropy[512] = { 0 };
    mnw_copy_thread_uchar(entropy, raw_entropy, raw_entropy_len);
    uint entropy_len = raw_entropy_len;
    if (!mnw_entropy_transform(entropy, entropy_len, uint(entropy_mode), iteration,
                               allow_hex_input, config)) {
        return;
    }
    if (custom_size) {
        if (custom_len <= 0 || custom_len > 512) {
            return;
        }
        entropy_len = uint(custom_len);
    }

    char phrase[512] = { 0 };
    size_t phrase_len = 0;
    dict_t dict = dict_at(int(config.dictLang));
    if (config.electrum == 0u) {
        GenerateMnemonic(reinterpret_cast<thread char*>(entropy), size_t(entropy_len), phrase,
                         int(config.dictLang), customDict, phrase_len, config.oldElectrum);
    } else {
        GenerateMnemonicElectrumV2(reinterpret_cast<thread char*>(entropy), size_t(entropy_len),
                                   phrase, dict, phrase_len, config.electrumSegwit,
                                   config.electrum128, config.electrumCakeWallet);
    }
    if (phrase_len == 0ul || phrase_len > 512ul) {
        return;
    }

    char pass_thread[128] = { 0 };
    const uint pass_copy_len = min(pass_size, uint(kFoundPassBytes));
    if (passwd != nullptr) {
        mnw_copy_device_char_to_thread(pass_thread, passwd, pass_copy_len);
    }

    uchar bip32_seed[64] = { 0 };
    uchar ed_seed[64] = { 0 };
    extended_private_key_t ton_master_private;
    thread extended_private_key_t* master_private = nullptr;
    thread extended_private_key_t* ed25519_master_private = nullptr;
    const bool need_bip32 = (MNW_FC_SECP_ANY || MNW_FC_ED_ANY) &&
                            config.secp256 != 0u &&
                            config.bipDerivationsEnabled != 0u &&
                            target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_BIP32);
    const bool need_ed = MNW_FC_ED_ANY &&
                         config.ed25519 != 0u &&
                         config.bipDerivationsEnabled != 0u &&
                         target_derivation_type_enabled(config, DERIVATION_TYPE_MASK_SLIP0010 |
                                                               DERIVATION_TYPE_MASK_BIP32_ED25519);
    const bool need_dot_suri = MNW_FC_DOT && config.dot != 0u && config.substratePathCount > 0u;
    const bool need_ed_or_dot = need_ed || need_dot_suri;

    if (config.tonMnemonic != 0u) {
        ton_to_masterkey(phrase, ulong(phrase_len), pass_thread, pass_copy_len,
                         &ton_master_private);
        master_private = &ton_master_private;
        ed25519_master_private = &ton_master_private;
    } else {
        uchar pbkdf_salt[136] = { 0 };
        for (uint i = 0u; i < 8u; ++i) {
            pbkdf_salt[i] = config.electrum != 0u ? recovery_electrum_salt[i] : recovery_salt[i];
        }
        for (uint i = 0u; i < pass_copy_len; ++i) {
            pbkdf_salt[8u + i] = uchar(pass_thread[i]);
        }
        const ulong salt_len = 8ul + ulong(pass_copy_len);

        uchar mnemonic_seed[64] = { 0 };
        fastpbkdf2_hmac_sha512(reinterpret_cast<const thread uchar*>(phrase),
                               ulong(phrase_len), pbkdf_salt, salt_len,
                               config.pbkdf2Iterations, mnemonic_seed, 64ul);
        if (need_bip32) {
            HMAC_SHA512_BTC_SEED_64(mnemonic_seed, bip32_seed);
            master_private = reinterpret_cast<thread extended_private_key_t*>(bip32_seed);
        }
        if (need_ed_or_dot) {
            HMAC_SHA512_ED25519_SEED_64(mnemonic_seed, ed_seed);
            ed25519_master_private = reinterpret_cast<thread extended_private_key_t*>(ed_seed);
        }
    }

    mnw_process_paths(isResult, buffResult, phrase, ulong(phrase_len), master_private,
                      ed25519_master_private, d_derivations, derindex, der_indexes_size,
                      der_start_index, round, ushort(starter_pass), passwd, pass_size,
                      buff_index, false, 0ul, iteration, true, precPtr, precPitch, config,
                      filters, storage, bloom_storage, xor_storage, xor_un_storage,
                      xor_uc_storage, xor_hc_storage, found, substratePaths);
}

static inline void mnw_worker_file(MnwWorkerKind kind,
                                   device bool* isResult,
                                   device bool* buffResult,
                                   constant secp256k1_ge_storage* precPtr,
                                   ulong precPitch,
                                   const device char* lines,
                                   const device uint* indexes,
                                   uint indexes_size,
                                   const device uint* d_derivations,
                                   const device uint* derindex,
                                   uint der_indexes_size,
                                   uint der_start_index,
                                   ulong round,
                                   uint tid,
                                   device RuntimeConfig& config,
                                   device XorFilterState& filters,
                                   device FilterStorageState& storage,
                                   const device uchar* bloom_storage,
                                   const device uchar* xor_storage,
                                   const device uchar* xor_un_storage,
                                   const device uchar* xor_uc_storage,
                                   const device uchar* xor_hc_storage,
                                   FoundBuffers found,
                                   const device SubstratePathDevice* substratePaths) {
    if (tid >= indexes_size || lines == nullptr || indexes == nullptr) {
        return;
    }
    const uint start = tid == 0u ? 0u : indexes[tid - 1u];
    uint len = indexes[tid] - start;
    if (len > 512u) {
        len = 512u;
    }
    char toHash[512] = { 0 };
    mnw_copy_device_char_to_thread(toHash, lines + start, len);

    uchar seed64[64] = { 0 };
    const thread uchar* seed_ptr = nullptr;
    if (kind == MNW_KIND_SEED) {
        if (config.isHex != 0u) {
            mnw_unhex(reinterpret_cast<thread uchar*>(toHash), len,
                      reinterpret_cast<thread uchar*>(toHash), len / 2u);
            len >>= 1u;
        }
    } else {
        if (config.isHex != 0u) {
            mnw_unhex(reinterpret_cast<thread uchar*>(toHash), len, seed64, 64u);
        } else {
            const uint copy_len = min(len, 64u);
            mnw_copy_thread_uchar(seed64, reinterpret_cast<thread uchar*>(toHash), copy_len);
        }
        seed_ptr = seed64;
    }

    mnw_process_seed_hmac_candidate(kind, isResult, buffResult, toHash, ulong(len), seed_ptr,
                                    d_derivations, derindex, der_indexes_size, der_start_index,
                                    round, 0u, nullptr, 0u, ulong(tid), false, 0ul, precPtr,
                                    precPitch, config, filters, storage, bloom_storage,
                                    xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                    found, substratePaths);
}

static inline void mnw_worker_gen(MnwWorkerKind kind,
                                  device bool* isResult,
                                  device bool* buffResult,
                                  constant secp256k1_ge_storage* precPtr,
                                  ulong precPitch,
                                  const device uint* d_derivations,
                                  const device uint* derindex,
                                  uint der_indexes_size,
                                  uint der_start_index,
                                  ulong seed_d,
                                  ulong seed_count,
                                  bool is_64,
                                  int entropy_len_i,
                                  int mode,
                                  int gen,
                                  ulong round,
                                  uint tid,
                                  device RuntimeConfig& config,
                                  device XorFilterState& filters,
                                  device FilterStorageState& storage,
                                  const device uchar* bloom_storage,
                                  const device uchar* xor_storage,
                                  const device uchar* xor_un_storage,
                                  const device uchar* xor_uc_storage,
                                  const device uchar* xor_hc_storage,
                                  FoundBuffers found,
                                  const device SubstratePathDevice* substratePaths) {
    if (tid >= seed_count || entropy_len_i <= 0 || entropy_len_i > 512) {
        return;
    }
    const ulong seed_value = seed_d + ulong(tid);
    uchar entropy[512] = { 0 };
    const uint entropy_len = uint(entropy_len_i);
    if (!mnw_entropy_fill(entropy_len, entropy, seed_value, is_64, mode, gen, config.skip64)) {
        return;
    }

    char toHash[512] = { 0 };
    uchar seed64[64] = { 0 };
    const thread uchar* seed_ptr = nullptr;
    ulong len = ulong(entropy_len);

    if (kind == MNW_KIND_SEED) {
        mnw_copy_thread_uchar(reinterpret_cast<thread uchar*>(toHash), entropy, entropy_len);
    } else {
        const uint entropy_len_local = entropy_len < 64u ? 64u : entropy_len;
        for (uint i = 0u; i < 64u; ++i) {
            const uint src = entropy_len_local - 64u + i;
            seed64[i] = src < entropy_len ? entropy[src] : 0u;
        }
        mnw_hexing(seed64, 64u, reinterpret_cast<thread uchar*>(toHash), 128u);
        len = 128ul;
        seed_ptr = seed64;
    }

    mnw_process_seed_hmac_candidate(kind, isResult, buffResult, toHash, len, seed_ptr,
                                    d_derivations, derindex, der_indexes_size, der_start_index,
                                    round, 0u, nullptr, 0u, ulong(tid), true, seed_value,
                                    precPtr, precPitch, config, filters, storage, bloom_storage,
                                    xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                    found, substratePaths);
}

static inline void mnw_build_seq512_value(const device uchar* start_point,
                                          int mode,
                                          ulong starter,
                                          int min_len,
                                          thread uchar out[64],
                                          thread uint& out_len) {
    uint c[16];
    uint r[16];
    uchar seed_be[64];
    loadBE512toWords(start_point, c);
    if (mode == 1) {
        add64to512_device(c, starter, r);
    } else {
        sub64from512_device(c, starter, r);
    }
    out_len = uint(sizeBE512_device(r));
    if (out_len < uint(max(min_len, 0))) {
        out_len = uint(max(min_len, 0));
    }
    if (out_len > 64u) {
        out_len = 64u;
    }
    storeWordsToBE512(r, seed_be);
    for (uint j = 0u; j < out_len; ++j) {
        out[j] = seed_be[64u - out_len + j];
    }
}

static inline void mnw_worker_seq(MnwWorkerKind kind,
                                  device bool* isResult,
                                  device bool* buffResult,
                                  constant secp256k1_ge_storage* precPtr,
                                  ulong precPitch,
                                  const device uint* d_derivations,
                                  const device uint* derindex,
                                  uint der_indexes_size,
                                  uint der_start_index,
                                  int mode,
                                  const device uchar* start_point,
                                  int min_len,
                                  ulong round,
                                  uint tid,
                                  device RuntimeConfig& config,
                                  device XorFilterState& filters,
                                  device FilterStorageState& storage,
                                  const device uchar* bloom_storage,
                                  const device uchar* xor_storage,
                                  const device uchar* xor_un_storage,
                                  const device uchar* xor_uc_storage,
                                  const device uchar* xor_hc_storage,
                                  FoundBuffers found,
                                  const device SubstratePathDevice* substratePaths) {
    if (start_point == nullptr) {
        return;
    }
    const ulong starter = ulong(tid) * config.seqStep;
    uchar value[64] = { 0 };
    uint value_len = 64u;
    mnw_build_seq512_value(start_point, mode, starter, min_len, value, value_len);

    char toHash[128] = { 0 };
    uchar seed64[64] = { 0 };
    const thread uchar* seed_ptr = nullptr;
    ulong len = ulong(value_len);

    if (kind == MNW_KIND_SEED) {
        mnw_copy_thread_uchar(reinterpret_cast<thread uchar*>(toHash), value, value_len);
    } else {
        mnw_copy_thread_uchar(seed64, value, 64u);
        mnw_hexing(seed64, 64u, reinterpret_cast<thread uchar*>(toHash), 128u);
        len = 128ul;
        seed_ptr = seed64;
    }

    mnw_process_seed_hmac_candidate(kind, isResult, buffResult, toHash, len, seed_ptr,
                                    d_derivations, derindex, der_indexes_size, der_start_index,
                                    round, 0u, nullptr, 0u, starter, false, 0ul, precPtr,
                                    precPitch, config, filters, storage, bloom_storage,
                                    xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                    found, substratePaths);
}

static inline uchar mnw_hexset_next_addend_generic(thread ulong& carry, uint base) {
    const uchar add = uchar(carry % ulong(base));
    carry /= ulong(base);
    return add;
}

static inline uchar mnw_hexset_next_addend_pow2(thread ulong& carry, uint mask, uint shift) {
    const uchar add = uchar(carry & ulong(mask));
    carry >>= shift;
    return add;
}

static inline bool mnw_hexset_materialize_candidate_exact(const device uchar* start_digits,
                                                          uint digit_count,
                                                          const device uchar* alphabet,
                                                          uint base,
                                                          ulong offset,
                                                          thread uchar* out_exact) {
    if (start_digits == nullptr || alphabet == nullptr || digit_count == 0u ||
        (digit_count & 1u) != 0u || base == 0u) {
        return false;
    }
    const int exact_size = int(digit_count >> 1u);
    if (base == 1u) {
        if (offset != 0ul) {
            return false;
        }
        const uchar packed = uchar((alphabet[0] << 4u) | alphabet[0]);
        for (int byte_idx = 0; byte_idx < exact_size; ++byte_idx) {
            out_exact[byte_idx] = packed;
        }
        return true;
    }

    ulong carry = offset;
    if (base == 2u || base == 4u || base == 8u || base == 16u) {
        const uint shift = (base == 2u) ? 1u : (base == 4u) ? 2u : (base == 8u) ? 3u : 4u;
        const uint mask = base - 1u;
        for (int byte_idx = exact_size - 1; byte_idx >= 0; --byte_idx) {
            const uint lo_pos = uint((byte_idx << 1) + 1);
            const uint hi_pos = uint(byte_idx << 1);
            uint lo_digit = uint(start_digits[lo_pos]) + uint(mnw_hexset_next_addend_pow2(carry, mask, shift));
            if (lo_digit >= base) {
                lo_digit -= base;
                ++carry;
            }
            uint hi_digit = uint(start_digits[hi_pos]) + uint(mnw_hexset_next_addend_pow2(carry, mask, shift));
            if (hi_digit >= base) {
                hi_digit -= base;
                ++carry;
            }
            out_exact[byte_idx] = uchar((alphabet[hi_digit] << 4u) | alphabet[lo_digit]);
        }
    } else {
        for (int byte_idx = exact_size - 1; byte_idx >= 0; --byte_idx) {
            const uint lo_pos = uint((byte_idx << 1) + 1);
            const uint hi_pos = uint(byte_idx << 1);
            uint lo_digit = uint(start_digits[lo_pos]) + uint(mnw_hexset_next_addend_generic(carry, base));
            if (lo_digit >= base) {
                lo_digit -= base;
                ++carry;
            }
            uint hi_digit = uint(start_digits[hi_pos]) + uint(mnw_hexset_next_addend_generic(carry, base));
            if (hi_digit >= base) {
                hi_digit -= base;
                ++carry;
            }
            out_exact[byte_idx] = uchar((alphabet[hi_digit] << 4u) | alphabet[lo_digit]);
        }
    }
    return carry == 0ul;
}

static inline bool mnw_recovery_hexset_materialize_candidate_exact(const device uchar* template_and_counter,
                                                                   uint digit_count,
                                                                   const device uchar* alphabet,
                                                                   uint base,
                                                                   ulong offset,
                                                                   thread uchar* out_exact) {
    if (template_and_counter == nullptr || alphabet == nullptr || digit_count == 0u ||
        (digit_count & 1u) != 0u || base == 0u) {
        return false;
    }
    const device uchar* templ = template_and_counter;
    const device uchar* counter = template_and_counter + digit_count;
    const int exact_size = int(digit_count >> 1u);
    ulong carry = offset;

    if (base == 1u) {
        if (offset != 0ul) {
            return false;
        }
        for (int byte_idx = exact_size - 1; byte_idx >= 0; --byte_idx) {
            const uint lo_pos = uint((byte_idx << 1) + 1);
            const uint hi_pos = uint(byte_idx << 1);
            const uchar lo_t = templ[lo_pos];
            const uchar hi_t = templ[hi_pos];
            const uchar lo = (lo_t == MNW_RECOVERY_HEXSET_WILDCARD_NIBBLE) ? alphabet[0] : lo_t;
            const uchar hi = (hi_t == MNW_RECOVERY_HEXSET_WILDCARD_NIBBLE) ? alphabet[0] : hi_t;
            out_exact[byte_idx] = uchar((hi << 4u) | lo);
        }
        return true;
    }

    const bool pow2 = base == 2u || base == 4u || base == 8u || base == 16u;
    const uint shift = (base == 2u) ? 1u : (base == 4u) ? 2u : (base == 8u) ? 3u : 4u;
    const uint mask = base - 1u;

    for (int byte_idx = exact_size - 1; byte_idx >= 0; --byte_idx) {
        const uint lo_pos = uint((byte_idx << 1) + 1);
        const uint hi_pos = uint(byte_idx << 1);
        const uchar lo_t = templ[lo_pos];
        const uchar hi_t = templ[hi_pos];
        uchar lo;
        uchar hi;
        if (lo_t == MNW_RECOVERY_HEXSET_WILDCARD_NIBBLE) {
            uint digit = uint(counter[lo_pos]) + uint(pow2 ? mnw_hexset_next_addend_pow2(carry, mask, shift)
                                                           : mnw_hexset_next_addend_generic(carry, base));
            if (digit >= base) {
                digit -= base;
                ++carry;
            }
            lo = alphabet[digit];
        } else {
            lo = lo_t;
        }
        if (hi_t == MNW_RECOVERY_HEXSET_WILDCARD_NIBBLE) {
            uint digit = uint(counter[hi_pos]) + uint(pow2 ? mnw_hexset_next_addend_pow2(carry, mask, shift)
                                                           : mnw_hexset_next_addend_generic(carry, base));
            if (digit >= base) {
                digit -= base;
                ++carry;
            }
            hi = alphabet[digit];
        } else {
            hi = hi_t;
        }
        out_exact[byte_idx] = uchar((hi << 4u) | lo);
    }
    return carry == 0ul;
}

static inline void mnw_hexset_zero_pad_left(thread uchar* dst,
                                           uint total_size,
                                           const thread uchar* src_exact,
                                           uint exact_size) {
    const uint pad = total_size > exact_size ? total_size - exact_size : 0u;
    for (uint i = 0u; i < pad; ++i) {
        dst[i] = 0u;
    }
    for (uint i = 0u; i < exact_size && (pad + i) < total_size; ++i) {
        dst[pad + i] = src_exact[i];
    }
}

static inline int mnw_hexset_compare_exact_bytes(const thread uchar* lhs,
                                                 const device uchar* rhs,
                                                 uint exact_size) {
    if (rhs == nullptr) {
        return 0;
    }
    for (uint i = 0u; i < exact_size; ++i) {
        if (lhs[i] != rhs[i]) {
            return lhs[i] < rhs[i] ? -1 : 1;
        }
    }
    return 0;
}

static inline bool mnw_hexset_candidate_within_exact_bounds(const thread uchar* exact_candidate,
                                                           const device uchar* lower_exact,
                                                           const device uchar* upper_exact,
                                                           uint exact_size,
                                                           bool recovery) {
    if (recovery) {
        return true;
    }
    if (lower_exact != nullptr && mnw_hexset_compare_exact_bytes(exact_candidate, lower_exact, exact_size) < 0) {
        return false;
    }
    if (upper_exact != nullptr && mnw_hexset_compare_exact_bytes(exact_candidate, upper_exact, exact_size) > 0) {
        return false;
    }
    return true;
}

static inline void mnw_worker_seq_hexset(MnwWorkerKind kind,
                                         bool recovery,
                                         device bool* isResult,
                                         device bool* buffResult,
                                         constant secp256k1_ge_storage* precPtr,
                                         ulong precPitch,
                                         const device uint* d_derivations,
                                         const device uint* derindex,
                                         uint der_indexes_size,
                                         uint der_start_index,
                                         const device uchar* hexset_start_digits,
                                         const device uchar* hexset_lower_exact,
                                         const device uchar* hexset_upper_exact,
                                         const device uchar* hexset_alphabet,
                                         uint hexset_base,
                                         uint hexset_size,
                                         ulong gpu_stride,
                                         ulong round,
                                         uint tid,
                                         device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         FoundBuffers found,
                                         const device SubstratePathDevice* substratePaths) {
    if (hexset_size == 0u || hexset_size > 64u || gpu_stride == 0ul) {
        return;
    }
    const ulong starter = ulong(tid) * gpu_stride;
    uchar exact_seed[64] = { 0 };
    const bool materialized = recovery
        ? mnw_recovery_hexset_materialize_candidate_exact(hexset_start_digits, hexset_size * 2u,
                                                          hexset_alphabet, hexset_base, starter,
                                                          exact_seed)
        : mnw_hexset_materialize_candidate_exact(hexset_start_digits, hexset_size * 2u,
                                                 hexset_alphabet, hexset_base, starter,
                                                 exact_seed);
    if (!materialized ||
        !mnw_hexset_candidate_within_exact_bounds(exact_seed, hexset_lower_exact,
                                                  hexset_upper_exact, hexset_size, recovery)) {
        return;
    }

    char toHash[128] = { 0 };
    uchar seed64[64] = { 0 };
    const thread uchar* seed_ptr = nullptr;
    ulong len = ulong(hexset_size);
    if (kind == MNW_KIND_SEED) {
        mnw_copy_thread_uchar(reinterpret_cast<thread uchar*>(toHash), exact_seed, hexset_size);
    } else {
        mnw_hexset_zero_pad_left(seed64, 64u, exact_seed, hexset_size);
        mnw_hexing(exact_seed, hexset_size, reinterpret_cast<thread uchar*>(toHash), hexset_size * 2u);
        len = ulong(hexset_size) * 2ul;
        seed_ptr = seed64;
    }

    mnw_process_seed_hmac_candidate(kind, isResult, buffResult, toHash, len, seed_ptr,
                                    d_derivations, derindex, der_indexes_size, der_start_index,
                                    round, 0u, nullptr, 0u, starter, false, 0ul, precPtr,
                                    precPitch, config, filters, storage, bloom_storage,
                                    xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                    found, substratePaths);
}

static inline void mnw_build_entropy_seq4096(const device uchar* start_point,
                                             int mode,
                                             ulong starter,
                                             int min_len,
                                             thread uchar entropy[512],
                                             thread uint& entropy_len) {
    uint c[128];
    uint r[128];
    uchar be[512];
    loadBE4096toWords(start_point, c);
    if (mode == 1) {
        add64to4096_device(c, starter, r);
    } else {
        sub64from4096_device(c, starter, r);
    }
    entropy_len = uint(sizeBE4096_device(r));
    if (entropy_len < uint(max(min_len, 0))) {
        entropy_len = uint(max(min_len, 0));
    }
    if (entropy_len > 512u) {
        entropy_len = 512u;
    }
    storeWordsToBE4096(r, be);
    for (uint j = 0u; j < entropy_len; ++j) {
        entropy[j] = be[512u - entropy_len + j];
    }
}

static inline void mnw_worker_entropy_file(device bool* isResult,
                                           device bool* buffResult,
                                           constant secp256k1_ge_storage* precPtr,
                                           ulong precPitch,
                                           const device char* lines,
                                           const device uint* indexes,
                                           uint indexes_size,
                                           const device uint* d_derivations,
                                           const device uint* derindex,
                                           uint der_indexes_size,
                                           uint der_start_index,
                                           const device char* passwd,
                                           uint pass_size,
                                           uint starter_pass,
                                           bool custom_size,
                                           const device int* sizes,
                                           uint sizez_size,
                                           uchar entropy_mode,
                                           const device uint* iterations,
                                           uint iterations_size,
                                           ulong round,
                                           uint tid,
                                           device RuntimeConfig& config,
                                           device XorFilterState& filters,
                                           device FilterStorageState& storage,
                                           const device uchar* bloom_storage,
                                           const device uchar* xor_storage,
                                           const device uchar* xor_un_storage,
                                           const device uchar* xor_uc_storage,
                                           const device uchar* xor_hc_storage,
                                           FoundBuffers found,
                                           const device SubstratePathDevice* substratePaths,
                                           const device char* customDict) {
    if (tid >= indexes_size || lines == nullptr || indexes == nullptr ||
        iterations == nullptr || iterations_size == 0u) {
        return;
    }
    const uint start = tid == 0u ? 0u : indexes[tid - 1u];
    uint raw_len = indexes[tid] - start;
    if (raw_len > 512u) {
        raw_len = 512u;
    }
    uchar raw_entropy[512] = { 0 };
    mnw_copy_device_char_to_thread(reinterpret_cast<thread char*>(raw_entropy), lines + start, raw_len);

    const uint size_count = custom_size ? sizez_size : 1u;
    for (uint iter_i = 0u; iter_i < iterations_size; ++iter_i) {
        const uint iteration = iterations[iter_i];
        for (uint size_i = 0u; size_i < size_count; ++size_i) {
            const int custom_len = custom_size && sizes != nullptr ? sizes[size_i] : int(raw_len);
            mnw_process_entropy_candidate(isResult, buffResult, raw_entropy, raw_len, true,
                                          d_derivations, derindex, der_indexes_size,
                                          der_start_index, passwd, pass_size, starter_pass,
                                          custom_size, custom_len, entropy_mode, iteration,
                                          round, ulong(tid), precPtr, precPitch, config,
                                          filters, storage, bloom_storage, xor_storage,
                                          xor_un_storage, xor_uc_storage, xor_hc_storage,
                                          found, substratePaths, customDict);
        }
    }
}

static inline void mnw_worker_entropy_seq(device bool* isResult,
                                          device bool* buffResult,
                                          constant secp256k1_ge_storage* precPtr,
                                          ulong precPitch,
                                          const device uint* d_derivations,
                                          const device uint* derindex,
                                          uint der_indexes_size,
                                          uint der_start_index,
                                          int mode,
                                          const device uchar* start_point,
                                          int min_len,
                                          const device char* passwd,
                                          uint pass_size,
                                          uint starter_pass,
                                          bool custom_size,
                                          int custom_len,
                                          uchar entropy_mode,
                                          uint iteration,
                                          ulong round,
                                          uint tid,
                                          device RuntimeConfig& config,
                                          device XorFilterState& filters,
                                          device FilterStorageState& storage,
                                          const device uchar* bloom_storage,
                                          const device uchar* xor_storage,
                                          const device uchar* xor_un_storage,
                                          const device uchar* xor_uc_storage,
                                          const device uchar* xor_hc_storage,
                                          FoundBuffers found,
                                          const device SubstratePathDevice* substratePaths,
                                          const device char* customDict) {
    if (start_point == nullptr) {
        return;
    }
    const ulong starter = ulong(tid) * config.seqStep;
    uchar entropy[512] = { 0 };
    uint entropy_len = 0u;
    mnw_build_entropy_seq4096(start_point, mode, starter, min_len, entropy, entropy_len);
    mnw_process_entropy_candidate(isResult, buffResult, entropy, entropy_len, false,
                                  d_derivations, derindex, der_indexes_size, der_start_index,
                                  passwd, pass_size, starter_pass, custom_size, custom_len,
                                  entropy_mode, iteration, round, starter, precPtr, precPitch,
                                  config, filters, storage, bloom_storage, xor_storage,
                                  xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                  substratePaths, customDict);
}

static inline void mnw_worker_entropy_seq_hexset(bool recovery,
                                                 device bool* isResult,
                                                 device bool* buffResult,
                                                 constant secp256k1_ge_storage* precPtr,
                                                 ulong precPitch,
                                                 const device uint* d_derivations,
                                                 const device uint* derindex,
                                                 uint der_indexes_size,
                                                 uint der_start_index,
                                                 const device uchar* hexset_start_digits,
                                                 const device uchar* hexset_lower_exact,
                                                 const device uchar* hexset_upper_exact,
                                                 const device uchar* hexset_alphabet,
                                                 uint hexset_base,
                                                 uint hexset_size,
                                                 ulong gpu_stride,
                                                 const device char* passwd,
                                                 uint pass_size,
                                                 uint starter_pass,
                                                 bool custom_size,
                                                 int custom_len,
                                                 uchar entropy_mode,
                                                 uint iteration,
                                                 ulong round,
                                                 uint tid,
                                                 device RuntimeConfig& config,
                                                 device XorFilterState& filters,
                                                 device FilterStorageState& storage,
                                                 const device uchar* bloom_storage,
                                                 const device uchar* xor_storage,
                                                 const device uchar* xor_un_storage,
                                                 const device uchar* xor_uc_storage,
                                                 const device uchar* xor_hc_storage,
                                                 FoundBuffers found,
                                                 const device SubstratePathDevice* substratePaths,
                                                 const device char* customDict) {
    if (hexset_size == 0u || hexset_size > 512u || gpu_stride == 0ul) {
        return;
    }
    const ulong starter = ulong(tid) * gpu_stride;
    uchar entropy[512] = { 0 };
    const bool materialized = recovery
        ? mnw_recovery_hexset_materialize_candidate_exact(hexset_start_digits, hexset_size * 2u,
                                                          hexset_alphabet, hexset_base, starter,
                                                          entropy)
        : mnw_hexset_materialize_candidate_exact(hexset_start_digits, hexset_size * 2u,
                                                 hexset_alphabet, hexset_base, starter,
                                                 entropy);
    if (!materialized ||
        !mnw_hexset_candidate_within_exact_bounds(entropy, hexset_lower_exact,
                                                  hexset_upper_exact, hexset_size, recovery)) {
        return;
    }

    mnw_process_entropy_candidate(isResult, buffResult, entropy, hexset_size, false,
                                  d_derivations, derindex, der_indexes_size, der_start_index,
                                  passwd, pass_size, starter_pass, custom_size, custom_len,
                                  entropy_mode, iteration, round, starter, precPtr, precPitch,
                                  config, filters, storage, bloom_storage, xor_storage,
                                  xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                  substratePaths, customDict);
}

#endif
