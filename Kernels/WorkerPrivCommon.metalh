static inline void priv_emit_p2wsh_from_pubkey65(device bool* isResult,
                                                 device bool* buffResult,
                                                 const thread uchar* private_key32,
                                                 const thread uchar* pubkey65,
                                                 device RuntimeConfig& config,
                                                 device XorFilterState& filters,
                                                 device FilterStorageState& storage,
                                                 const device uchar* bloom_storage,
                                                 const device uchar* xor_storage,
                                                 const device uchar* xor_un_storage,
                                                 const device uchar* xor_uc_storage,
                                                 const device uchar* xor_hc_storage,
                                                 FoundBuffers found) {
    uchar p2wsh_hash[32];
    uint p2wsh_rmd[8] = { 0 };
    _GetP2WSHComp(pubkey65, p2wsh_hash, p2wsh_rmd);
    priv_check_and_store_words(isResult,
                               buffResult,
                               private_key32,
                               p2wsh_hash,
                               32u,
                               p2wsh_rmd,
                               0x07u,
                               config,
                               filters,
                               storage,
                               bloom_storage,
                               xor_storage,
                               xor_un_storage,
                               xor_uc_storage,
                               xor_hc_storage,
                               found);
}

static inline void priv_emit_p2wsh_from_pubkey65_round(device bool* isResult,
                                                       device bool* buffResult,
                                                       const thread uchar* private_key32,
                                                       const thread uchar* pubkey65,
                                                       long current_round,
                                                       device RuntimeConfig& config,
                                                       device XorFilterState& filters,
