    uchar p2wsh_hash[32];
    uint p2wsh_rmd[8] = { 0 };
    _GetP2WSHComp(pubkey65, p2wsh_hash, p2wsh_rmd);
    priv_check_and_store_words_round(isResult,
                                     buffResult,
