constant uint PRIV_THREAD_STEPS = 32u;
constant uchar PRIV_SECP_G65[65] = {
    0x04u,
    0x79u,0xbeu,0x66u,0x7eu,0xf9u,0xdcu,0xbbu,0xacu,0x55u,0xa0u,0x62u,0x95u,0xceu,0x87u,0x0bu,0x07u,
    0x02u,0x9bu,0xfcu,0xdbu,0x2du,0xceu,0x28u,0xd9u,0x59u,0xf2u,0x81u,0x5bu,0x16u,0xf8u,0x17u,0x98u,
    0x48u,0x3au,0xdau,0x77u,0x26u,0xa3u,0xc4u,0x65u,0x5du,0xa4u,0xfbu,0xfcu,0x0eu,0x11u,0x08u,0xa8u,
    0xfdu,0x17u,0xb4u,0x48u,0xa6u,0x85u,0x54u,0x19u,0x9cu,0x47u,0xd0u,0x8fu,0xfbu,0x10u,0xd4u,0xb8u
};
constant uchar PRIV_UNHEX_TAB[80] = {
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0xaa, 0xbb, 0xcc, 0xdd, 0xee,
    0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

static inline void priv_copy_thread_uchar(thread uchar* dst, const thread uchar* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void priv_copy_thread_char_from_uchar(thread char* dst, const thread uchar* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = char(src[i]);
    }
}

static inline void priv_copy_device_uchar(thread uchar* dst, const device uchar* src, uint len) {
    for (uint i = 0u; i < len; ++i) {
        dst[i] = src[i];
    }
}

static inline void priv_unhex(thread uchar* str, uint str_sz, thread uchar* unhexed, uint unhexed_sz) {
    uint j = 0u;
    const uint n = (str_sz < (unhexed_sz * 2u)) ? str_sz : (unhexed_sz * 2u);
    for (uint i = 0u; (i + 1u) < n; i += 2u, ++j) {
        unhexed[j] = (PRIV_UNHEX_TAB[str[i] & 0x4fu] & 0xf0u) |
                     (PRIV_UNHEX_TAB[str[i + 1u] & 0x4fu] & 0x0fu);
    }
}

static inline void priv_hash_words_from_bytes(const thread uchar* bytes, thread uint out_words[8], uint byte_len) {
    for (uint i = 0u; i < 8u; ++i) {
        const uint off = i * 4u;
        if (off + 3u < byte_len) {
            out_words[i] = uint(bytes[off]) |
                           ((uint(bytes[off + 1u]) << 8u) & 0x0000ff00u) |
                           ((uint(bytes[off + 2u]) << 16u) & 0x00ff0000u) |
                           ((uint(bytes[off + 3u]) << 24u) & 0xff000000u);
        } else {
            uint w = 0u;
            for (uint j = 0u; j < 4u && off + j < byte_len; ++j) {
                w |= uint(bytes[off + j]) << (8u * j);
            }
            out_words[i] = w;
        }
    }
}

static inline void priv_store_result(device bool* isResult,
                                     device bool* buffResult,
                                     const thread uchar* private_key32,
                                     const thread void* payload,
                                     uint payload_len,
                                     uchar type_value,
                                     FoundBuffers found) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
    if (found.resultsCount == nullptr) {
        return;
    }

    const ulong idx64 = found_atomic_add_count(found.resultsCount, 1u);
    if (idx64 >= ulong(found.maxFounds)) {
        return;
    }
    const uint idx = uint(idx64);

    if (found.foundPrvKeys != nullptr && private_key32 != nullptr) {
        found_copy_thread_to_device_uchar(found.foundPrvKeys + ulong(idx) * kFoundPrivateKeyBytes, private_key32, 32u);
    }
    if (found.foundHash160 != nullptr && payload != nullptr && payload_len > 0u) {
        const uint n = min(payload_len, kFoundHashWords * 4u);
        device uchar* out = reinterpret_cast<device uchar*>(found.foundHash160 + ulong(idx) * kFoundHashWords);
        found_copy_thread_to_device_bytes(out, payload, n);
    }
    if (found.type != nullptr) {
        found.type[idx] = type_value;
    }
}

static inline void priv_store_result_round(device bool* isResult,
                                           device bool* buffResult,
                                           const thread uchar* private_key32,
                                           const thread void* payload,
                                           uint payload_len,
                                           uchar type_value,
                                           long current_round,
                                           FoundBuffers found) {
    if (buffResult != nullptr) {
        buffResult[0] = true;
    }
    if (isResult != nullptr) {
        isResult[0] = true;
    }
    if (found.resultsCount == nullptr) {
        return;
    }

    const ulong idx64 = found_atomic_add_count(found.resultsCount, 1u);
    if (idx64 >= ulong(found.maxFounds)) {
        return;
    }
    const uint idx = uint(idx64);

    if (found.foundPrvKeys != nullptr && private_key32 != nullptr) {
        found_copy_thread_to_device_uchar(found.foundPrvKeys + ulong(idx) * kFoundPrivateKeyBytes, private_key32, 32u);
    }
    if (found.foundHash160 != nullptr && payload != nullptr && payload_len > 0u) {
        const uint n = min(payload_len, kFoundHashWords * 4u);
        device uchar* out = reinterpret_cast<device uchar*>(found.foundHash160 + ulong(idx) * kFoundHashWords);
        found_copy_thread_to_device_bytes(out, payload, n);
    }
    if (found.type != nullptr) {
        found.type[idx] = type_value;
    }
    if (found.round != nullptr) {
        found.round[idx] = current_round;
    }
}

static inline bool priv_check_hash_words(device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         const thread uint* hash_words) {
    return filter_check_hash(config,
                             filters,
                             storage,
                             bloom_storage,
                             xor_storage,
                             xor_un_storage,
                             xor_uc_storage,
                             xor_hc_storage,
                             hash_words);
}

static inline bool priv_check_hash_bytes(device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         const thread uchar* hash_bytes,
                                         uint byte_len) {
    uint hash_words[8];
    priv_hash_words_from_bytes(hash_bytes, hash_words, byte_len);
    return priv_check_hash_words(config,
                                 filters,
                                 storage,
                                 bloom_storage,
                                 xor_storage,
                                 xor_un_storage,
                                 xor_uc_storage,
                                 xor_hc_storage,
                                 hash_words);
}

static inline void priv_check_and_store_words(device bool* isResult,
                                              device bool* buffResult,
                                              const thread uchar* private_key32,
                                              const thread void* payload,
                                              uint payload_len,
                                              const thread uint* hash_words,
                                              uchar type_value,
                                              device RuntimeConfig& config,
                                              device XorFilterState& filters,
                                              device FilterStorageState& storage,
                                              const device uchar* bloom_storage,
                                              const device uchar* xor_storage,
                                              const device uchar* xor_un_storage,
                                              const device uchar* xor_uc_storage,
                                              const device uchar* xor_hc_storage,
                                              FoundBuffers found) {
    if (priv_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage,
                              xor_uc_storage, xor_hc_storage, hash_words)) {
        priv_store_result(isResult, buffResult, private_key32, payload, payload_len, type_value, found);
    }
}

static inline void priv_check_and_store_bytes(device bool* isResult,
                                              device bool* buffResult,
                                              const thread uchar* private_key32,
                                              const thread uchar* payload,
                                              uint payload_len,
                                              const thread uchar* hash_bytes,
                                              uint hash_len,
                                              uchar type_value,
                                              device RuntimeConfig& config,
                                              device XorFilterState& filters,
                                              device FilterStorageState& storage,
                                              const device uchar* bloom_storage,
                                              const device uchar* xor_storage,
                                              const device uchar* xor_un_storage,
                                              const device uchar* xor_uc_storage,
                                              const device uchar* xor_hc_storage,
                                              FoundBuffers found) {
    uint hash_words[8];
    priv_hash_words_from_bytes(hash_bytes, hash_words, hash_len);
    priv_check_and_store_words(isResult,
                               buffResult,
                               private_key32,
                               payload,
                               payload_len,
                               hash_words,
                               type_value,
                               config,
                               filters,
                               storage,
                               bloom_storage,
                               xor_storage,
                               xor_un_storage,
                               xor_uc_storage,
                               xor_hc_storage,
                               found);
}

static inline void priv_check_and_store_words_round(device bool* isResult,
                                                    device bool* buffResult,
                                                    const thread uchar* private_key32,
                                                    const thread void* payload,
                                                    uint payload_len,
                                                    const thread uint* hash_words,
                                                    uchar type_value,
                                                    long current_round,
                                                    device RuntimeConfig& config,
                                                    device XorFilterState& filters,
                                                    device FilterStorageState& storage,
                                                    const device uchar* bloom_storage,
                                                    const device uchar* xor_storage,
                                                    const device uchar* xor_un_storage,
                                                    const device uchar* xor_uc_storage,
                                                    const device uchar* xor_hc_storage,
                                                    FoundBuffers found) {
    if (priv_check_hash_words(config, filters, storage, bloom_storage, xor_storage, xor_un_storage,
                              xor_uc_storage, xor_hc_storage, hash_words)) {
        priv_store_result_round(isResult, buffResult, private_key32, payload, payload_len, type_value,
                                current_round, found);
    }
}

