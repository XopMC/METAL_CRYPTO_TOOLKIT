                                   constant ulong& lane_count [[buffer(10)]],
                                   constant ulong& state_index_start [[buffer(11)]],
                                   constant ulong& round_start [[buffer(12)]],
                                   constant ulong& round_count [[buffer(13)]],
                                   device ProfanityWalkState* walk_state [[buffer(14)]],
                                   constant ulong& walk_state_capacity [[buffer(15)]],
                                   constant bool& use_walk_state [[buffer(16)]],
