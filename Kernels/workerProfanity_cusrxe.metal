    worker_profanity_impl(isResult, buffResult, precPtr, precPitch, seed_s0, seed_s1,
                          seed_s2, seed_s3, seed32, lane_start, lane_count,
                          state_index_start, round_start, round_count, walk_state,
                          walk_state_capacity, use_walk_state, store_walk_state,
