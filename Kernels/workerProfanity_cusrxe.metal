                                   constant secp256k1_ge_storage* precPtr [[buffer(2)]],
                                   constant ulong& precPitch [[buffer(3)]],
                                   constant ulong& seed_s0 [[buffer(4)]],
                                   constant ulong& seed_s1 [[buffer(5)]],
                                   constant ulong& seed_s2 [[buffer(6)]],
