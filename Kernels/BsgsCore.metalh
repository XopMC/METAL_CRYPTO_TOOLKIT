#ifndef METAL_CRYPTO_BSGS_CORE_METALH
#define METAL_CRYPTO_BSGS_CORE_METALH

#include <metal_stdlib>
#include "../lib/secp256k1/GPUMath.metalh"

using namespace metal;

constant uint BSGS_WALK_SIZE = 1024u;
constant uint BSGS_MAX_SHARDS = 4u;

struct BsgsBabyEntry {
    ulong fingerprint;
    ulong j;
};

struct BsgsCenterProbe {
    ulong x[4];
    uint offset;
    uint odd_y;
};

struct BsgsBabyParams {
    ulong m;
    ulong group_offset;
    ulong output_capacity;
    uint windows;
    uint window_bits;
};

struct BsgsWorkItem {
    ulong center_scalar[4];
    ulong giant_base[4];
    uint target_index;
    uint reserved0;
    ulong reserved1;
};

struct BsgsSearchParams {
    ulong table_count;
    ulong shard_offsets[5];
    ulong giant_count[4];
    ulong m;
    ulong match_skip;
    uint bucket_bits;
    uint work_count;
    uint hit_capacity;
    uint windows;
    uint window_bits;
    uint field_begin;
    uint field_end;
};

struct BsgsHit {
    ulong giant_index[4];
    ulong j;
    uint target_index;
    uint flags;
};

struct BsgsResolveParams {
    ulong width[4];
    ulong m;
    uint hit_count;
    uint reserved;
};

struct BsgsResolved {
    ulong distance[4];
    uint target_index;
    uint valid;
};

static_assert(sizeof(BsgsBabyEntry) == 16, "BsgsBabyEntry layout");
static_assert(sizeof(BsgsCenterProbe) == 40, "BsgsCenterProbe layout");
static_assert(sizeof(BsgsBabyParams) == 32, "BsgsBabyParams layout");
static_assert(sizeof(BsgsWorkItem) == 80, "BsgsWorkItem layout");
static_assert(sizeof(BsgsSearchParams) == 128, "BsgsSearchParams layout");
static_assert(sizeof(BsgsHit) == 48, "BsgsHit layout");
static_assert(sizeof(BsgsResolveParams) == 48, "BsgsResolveParams layout");
static_assert(sizeof(BsgsResolved) == 40, "BsgsResolved layout");

static inline void bsgs_copy256(thread ulong out[4],
                                const thread ulong in[4]) {
    out[0] = in[0];
    out[1] = in[1];
    out[2] = in[2];
    out[3] = in[3];
}

static inline void bsgs_limbs_to_be32(const thread ulong limbs[4],
                                      thread uchar bytes[32]) {
    for (uint limb = 0u; limb < 4u; ++limb) {
        const ulong value = limbs[3u - limb];
        for (uint byte = 0u; byte < 8u; ++byte) {
            bytes[limb * 8u + byte] =
                uchar(value >> ulong(56u - byte * 8u));
        }
    }
}

static inline void bsgs_be32_to_limbs(const thread uchar bytes[32],
                                      thread ulong limbs[4]) {
    for (uint limb = 0u; limb < 4u; ++limb) {
        ulong value = 0ul;
        for (uint byte = 0u; byte < 8u; ++byte) {
            value = (value << 8u) | ulong(bytes[limb * 8u + byte]);
        }
        limbs[3u - limb] = value;
    }
}

static inline secp256k1_ge bsgs_ge_from_limbs(const device ulong* limbs) {
    ulong x_limbs[4];
    ulong y_limbs[4];
    for (uint i = 0u; i < 4u; ++i) {
        x_limbs[i] = limbs[i];
        y_limbs[i] = limbs[4u + i];
    }
    uchar x_bytes[32];
    uchar y_bytes[32];
    bsgs_limbs_to_be32(x_limbs, x_bytes);
    bsgs_limbs_to_be32(y_limbs, y_bytes);
    secp256k1_fe x;
    secp256k1_fe y;
    secp256k1_fe_set_b32(&x, x_bytes);
    secp256k1_fe_set_b32(&y, y_bytes);
    secp256k1_ge out;
    secp256k1_ge_set_xy(&out, &x, &y);
    return out;
}

static inline void bsgs_ge_to_limbs(const thread secp256k1_ge& input,
                                    thread ulong x[4],
                                    thread ulong y[4]) {
    secp256k1_ge affine = input;
    secp256k1_fe_normalize_var(&affine.x);
    secp256k1_fe_normalize_var(&affine.y);
    uchar x_bytes[32];
    uchar y_bytes[32];
    secp256k1_fe_get_b32(x_bytes, &affine.x);
    secp256k1_fe_get_b32(y_bytes, &affine.y);
    bsgs_be32_to_limbs(x_bytes, x);
    bsgs_be32_to_limbs(y_bytes, y);
}

static inline bool bsgs_u256_less(const thread ulong a[4],
                                  const constant ulong* b) {
    for (int limb = 3; limb >= 0; --limb) {
        if (a[uint(limb)] < b[uint(limb)]) {
            return true;
        }
        if (a[uint(limb)] > b[uint(limb)]) {
            return false;
        }
    }
    return false;
}

static inline bool bsgs_u256_less_thread(const thread ulong a[4],
                                         const thread ulong b[4]) {
    for (int limb = 3; limb >= 0; --limb) {
        if (a[uint(limb)] < b[uint(limb)]) return true;
        if (a[uint(limb)] > b[uint(limb)]) return false;
    }
    return false;
}

static inline void bsgs_u256_add_small(thread ulong value[4], ulong addend) {
    const ulong before = value[0];
    value[0] += addend;
    ulong carry = ulong(value[0] < before);
    for (uint limb = 1u; limb < 4u && carry != 0ul; ++limb) {
        const ulong old = value[limb];
        value[limb] += carry;
        carry = ulong(value[limb] < old);
    }
}

static inline bool bsgs_u256_sub_small(thread ulong value[4], ulong subtrahend) {
    const ulong before = value[0];
    value[0] -= subtrahend;
    ulong borrow = ulong(before < subtrahend);
    for (uint limb = 1u; limb < 4u && borrow != 0ul; ++limb) {
        const ulong old = value[limb];
        value[limb] -= borrow;
        borrow = ulong(old == 0ul);
    }
    return borrow == 0ul;
}

static inline void bsgs_u256_mul_small(const thread ulong value[4],
                                       ulong multiplier,
                                       thread ulong out[4]) {
    ulong carry = 0ul;
    for (uint limb = 0u; limb < 4u; ++limb) {
        const ulong lo = value[limb] * multiplier;
        const ulong hi = mulhi(value[limb], multiplier);
        const ulong sum = lo + carry;
        const ulong carry_add = ulong(sum < lo);
        out[limb] = sum;
        carry = hi + carry_add;
    }
}

static inline int bsgs_compare_key(ulong fingerprint,
                                   const thread BsgsBabyEntry& entry) {
    if (fingerprint < entry.fingerprint) return -1;
    if (fingerprint > entry.fingerprint) return 1;
    return 0;
}

static inline int bsgs_compare_x256(const thread ulong x[4],
                                    const thread BsgsCenterProbe& probe) {
    for (int limb = 3; limb >= 0; --limb) {
        if (x[uint(limb)] < probe.x[uint(limb)]) return -1;
        if (x[uint(limb)] > probe.x[uint(limb)]) return 1;
    }
    return 0;
}

static inline BsgsBabyEntry bsgs_table_entry(
    ulong index,
    const device BsgsBabyEntry* shard0,
    const device BsgsBabyEntry* shard1,
    const device BsgsBabyEntry* shard2,
    const device BsgsBabyEntry* shard3,
    const constant BsgsSearchParams& params) {
    if (index < params.shard_offsets[1]) {
        return shard0[index];
    }
    if (index < params.shard_offsets[2]) {
        return shard1[index - params.shard_offsets[1]];
    }
    if (index < params.shard_offsets[3]) {
        return shard2[index - params.shard_offsets[2]];
    }
    return shard3[index - params.shard_offsets[3]];
}

#endif
