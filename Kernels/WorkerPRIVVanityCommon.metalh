    const device uchar* xorStorage;
    const device uchar* xorUnStorage;
    const device uchar* xorUcStorage;
    const device uchar* xorHcStorage;
    FoundBuffers found;

    inline void operator()(thread ulong* x, uchar odd_y, int pkField) thread {
        const ulong resultIndex = batchBase + ulong(uint(pkField));
        priv_vanity_emit_parity_fast(Kind, isResult, buffResult, startPoint, mode, resultIndex,
                                     step, x, odd_y, *config, *filters, *filterStorage, bloomStorage,
                                     xorStorage, xorUnStorage, xorUcStorage, xorHcStorage, found);
    }
};

template <PrivVanityKind Kind>
struct PrivVanityFullYEmitterStatic {
