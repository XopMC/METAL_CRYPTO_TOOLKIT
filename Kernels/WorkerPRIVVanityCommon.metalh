    inline void operator()(thread ulong* x, thread ulong* y, int pkField) thread {
        const ulong resultIndex = batchBase + ulong(uint(pkField));
        priv_vanity_emit_full_y_fast(Kind, isResult, buffResult, startPoint, mode, resultIndex,
                                     step, x, y, *config, *filters, *filterStorage, bloomStorage,
                                     xorStorage, xorUnStorage, xorUcStorage, xorHcStorage, found);
    }
};

constant uint PRIV_VANITY_WALK_PAIRS = 16u;
constant uint PRIV_VANITY_WALK_POINTS = PRIV_VANITY_WALK_PAIRS * 2u;

struct PrivVanityWalkScratch {
    secp256k1_gej points[PRIV_VANITY_WALK_POINTS];
    secp256k1_fe z[PRIV_VANITY_WALK_POINTS];
    secp256k1_fe zinv[PRIV_VANITY_WALK_POINTS];
};

static inline void priv_vanity_emit_parity_gej_batch(PrivVanityKind kind,
                                                      device bool* isResult,
                                                      device bool* buffResult,
                                                      const device uchar* start_point,
                                                      int mode,
                                                      ulong batch_base,
                                                      ulong step,
                                                      thread PrivVanityWalkScratch& scratch,
                                                      uint point_count,
                                                      uint first_offset,
                                                      bool includes_last_negative,
                                                      device RuntimeConfig& config,
                                                      device XorFilterState& filters,
                                                      device FilterStorageState& filter_storage,
                                                      const device uchar* bloom_storage,
                                                      const device uchar* xor_storage,
                                                      const device uchar* xor_un_storage,
                                                      const device uchar* xor_uc_storage,
                                                      const device uchar* xor_hc_storage,
                                                      FoundBuffers found) {
    secp256k1_fe_inv_all_var(point_count, scratch.zinv, scratch.z);
    for (uint i = 0u; i < point_count; ++i) {
        secp256k1_ge point;
        secp256k1_ge_set_gej_zinv(&point, &scratch.points[i], &scratch.zinv[i]);
        ulong x[4];
        ulong y[4];
        worker_priv_seq_fe_to_u64x4(x, &point.x);
        worker_priv_seq_fe_to_u64x4(y, &point.y);

        uint pk_field;
        if (includes_last_negative && i + 1u == point_count) {
            pk_field = 0u;
        } else {
            const uint pair = i >> 1u;
            const uint offset = first_offset + pair;
            pk_field = ((i & 1u) == 0u)
                ? (PRIV_VANITY_GRP_SIZE / 2u + offset)
                : (PRIV_VANITY_GRP_SIZE / 2u - offset);
        }
        const ulong result_index = priv_vanity_index_from_pkfield(mode, batch_base, pk_field);
        priv_vanity_emit_parity_fast(kind, isResult, buffResult, start_point, mode, result_index,
                                     step, x, uchar(y[0] & 1ul), config, filters, filter_storage, bloom_storage,
                                     xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                     found);
    }
}

static inline void priv_vanity_emit_taproot(device bool* isResult,
                                            device bool* buffResult,
                                            const thread uchar* private_key,
                                            thread uchar pubkey65[65],
                                            constant secp256k1_ge_storage* precPtr,
                                            ulong precPitch,
                                            device RuntimeConfig& config,
                                            device XorFilterState& filters,
                                            device FilterStorageState& filter_storage,
                                            const device uchar* bloom_storage,
                                            const device uchar* xor_storage,
                                            const device uchar* xor_un_storage,
                                            const device uchar* xor_uc_storage,
                                            const device uchar* xor_hc_storage,
                                            FoundBuffers found,
                                            uchar type_value = 0x04u) {
    uchar taproot_hash[32];
    uint hash160[8] = { 0u };
    priv_vanity_tweak_taproot(taproot_hash, pubkey65, precPtr, size_t(precPitch));
    _GetRMD160(reinterpret_cast<thread uint*>(taproot_hash), hash160);
    priv_vanity_check_and_store(isResult, buffResult, private_key, taproot_hash, 32u, hash160,
                                type_value, config, filters, filter_storage, bloom_storage,
                                xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found);
}

static inline void priv_vanity_emit_eth(device bool* isResult,
                                        device bool* buffResult,
                                        const thread uchar* private_key,
                                        thread uchar pubkey65[65],
                                        device RuntimeConfig& config,
                                        device XorFilterState& filters,
                                        device FilterStorageState& filter_storage,
                                        const device uchar* bloom_storage,
                                        const device uchar* xor_storage,
                                        const device uchar* xor_un_storage,
                                        const device uchar* xor_uc_storage,
                                        const device uchar* xor_hc_storage,
                                        FoundBuffers found,
                                        uchar type_value = 0x06u) {
    uchar keccak_hash[32];
    uint hash160[8] = { 0u };
    keccak(reinterpret_cast<thread char*>(pubkey65 + 1), 64, keccak_hash, 32);
    for (uint h = 12u, i = 0u; i < 5u; ++i) {
        hash160[i] = uint(keccak_hash[h]) |
                     ((uint(keccak_hash[h + 1u]) << 8u) & 0x0000ff00u) |
                     ((uint(keccak_hash[h + 2u]) << 16u) & 0x00ff0000u) |
                     ((uint(keccak_hash[h + 3u]) << 24u) & 0xff000000u);
        h += 4u;
    }
    priv_vanity_check_and_store(isResult, buffResult, private_key, hash160, 20u, hash160,
                                type_value, config, filters, filter_storage, bloom_storage,
                                xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage, found);
}

static inline void priv_vanity_emit_kind(PrivVanityKind kind,
                                         device bool* isResult,
                                         device bool* buffResult,
                                         const thread uchar* private_key,
                                         thread uchar pubkey65[65],
                                         constant secp256k1_ge_storage* precPtr,
                                         ulong precPitch,
                                         device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& filter_storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         FoundBuffers found) {
    switch (kind) {
        case PrivVanityKindX:
            priv_vanity_emit_x(isResult, buffResult, private_key, pubkey65, config, filters,
                               filter_storage, bloom_storage, xor_storage, xor_un_storage,
                               xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindU:
            priv_vanity_emit_uncompressed(isResult, buffResult, private_key, pubkey65, config,
                                          filters, filter_storage, bloom_storage, xor_storage,
                                          xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindS:
            priv_vanity_emit_segwit(isResult, buffResult, private_key, pubkey65, config, filters,
                                    filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                    xor_uc_storage, xor_hc_storage, found);
            if (config.p2wsh != 0u) {
                priv_vanity_emit_p2wsh(isResult, buffResult, private_key, pubkey65, config, filters,
                                       filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                       xor_uc_storage, xor_hc_storage, found);
            }
            break;
        case PrivVanityKindR:
            priv_vanity_emit_taproot(isResult, buffResult, private_key, pubkey65, precPtr, precPitch,
                                     config, filters, filter_storage, bloom_storage, xor_storage,
                                     xor_un_storage, xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindE:
            priv_vanity_emit_eth(isResult, buffResult, private_key, pubkey65, config, filters,
                                 filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                 xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindC:
            priv_vanity_emit_compressed(isResult, buffResult, private_key, pubkey65, config, filters,
                                        filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                        xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindP:
            priv_vanity_emit_p2wsh(isResult, buffResult, private_key, pubkey65, config, filters,
                                   filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                   xor_uc_storage, xor_hc_storage, found);
            break;
        case PrivVanityKindCusr:
            break;
    }
}

static inline void priv_vanity_emit_cusr(device bool* isResult,
                                         device bool* buffResult,
                                         const thread uchar* private_key,
                                         thread uchar pubkey65[65],
                                         constant secp256k1_ge_storage* precPtr,
                                         ulong precPitch,
                                         device RuntimeConfig& config,
                                         device XorFilterState& filters,
                                         device FilterStorageState& filter_storage,
                                         const device uchar* bloom_storage,
                                         const device uchar* xor_storage,
                                         const device uchar* xor_un_storage,
                                         const device uchar* xor_uc_storage,
                                         const device uchar* xor_hc_storage,
                                         FoundBuffers found) {
    const bool endo = config.endomorphism != 0u;
    if (!endo) {
        uint comp_hash[8] = { 0u };
        if (config.uncompressed != 0u) {
            priv_vanity_emit_uncompressed(isResult, buffResult, private_key, pubkey65, config,
                                          filters, filter_storage, bloom_storage, xor_storage,
                                          xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (config.compressed != 0u) {
            priv_vanity_emit_compressed(isResult, buffResult, private_key, pubkey65, config,
                                        filters, filter_storage, bloom_storage, xor_storage,
                                        xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                        0x02u, comp_hash);
        }
        if (config.segwit != 0u) {
            if (config.compressed == 0u) {
                int keyLenSkip = 0;
                _GetHash160Comp(pubkey65, keyLenSkip, reinterpret_cast<thread uchar*>(comp_hash));
            }
            priv_vanity_emit_segwit_from_comp_hash(isResult, buffResult, private_key, comp_hash,
                                                   config, filters, filter_storage, bloom_storage,
                                                   xor_storage, xor_un_storage, xor_uc_storage,
                                                   xor_hc_storage, found);
        }
        if (config.p2wsh != 0u) {
            priv_vanity_emit_p2wsh(isResult, buffResult, private_key, pubkey65, config, filters,
                                   filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                   xor_uc_storage, xor_hc_storage, found);
        }
        if (config.taproot != 0u) {
            priv_vanity_emit_taproot(isResult, buffResult, private_key, pubkey65, precPtr, precPitch,
                                     config, filters, filter_storage, bloom_storage, xor_storage,
                                     xor_un_storage, xor_uc_storage, xor_hc_storage, found);
        }
        if (config.xpoint != 0u) {
            priv_vanity_emit_x(isResult, buffResult, private_key, pubkey65, config, filters,
                               filter_storage, bloom_storage, xor_storage, xor_un_storage,
                               xor_uc_storage, xor_hc_storage, found);
        }
        if (config.ethereum != 0u) {
            priv_vanity_emit_eth(isResult, buffResult, private_key, pubkey65, config, filters,
                                 filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                 xor_uc_storage, xor_hc_storage, found);
        }
        return;
    }

    uchar x_beta1[32];
    uchar x_beta2[32];
    uchar y_neg[32];
    priv_vanity_mul_x_beta(pubkey65 + 1, PRIV_VANITY_BETA, x_beta1);
    priv_vanity_mul_x_beta(pubkey65 + 1, PRIV_VANITY_BETA2, x_beta2);
    priv_vanity_neg_y(pubkey65 + 33, y_neg);
    const bool odd_py = (pubkey65[64] & 1u) != 0u;

    for (uint j = 0u; j < 3u; ++j) {
        uchar vbase = uchar(j * 2u);
        uchar odd_variant = uchar(vbase + (odd_py ? 0u : 1u));
        uchar even_variant = uchar(vbase + (odd_py ? 1u : 0u));
        uchar base_variant = uchar(j * 2u);
        uchar pub_pos[65];
        uchar pub_neg[65];
        pub_pos[0] = 0x04u;
        pub_neg[0] = 0x04u;
        if (j == 0u) {
            priv_vanity_copy_x(pub_pos, pubkey65 + 1);
            priv_vanity_copy_x(pub_neg, pubkey65 + 1);
        } else if (j == 1u) {
            priv_vanity_copy_x(pub_pos, x_beta1);
            priv_vanity_copy_x(pub_neg, x_beta1);
        } else {
            priv_vanity_copy_x(pub_pos, x_beta2);
            priv_vanity_copy_x(pub_neg, x_beta2);
        }
        priv_vanity_copy_y(pub_pos, pubkey65 + 33);
        priv_vanity_copy_y(pub_neg, y_neg);

        if (config.uncompressed != 0u) {
            priv_vanity_emit_uncompressed(isResult, buffResult, private_key, pub_pos, config,
                                          filters, filter_storage, bloom_storage, xor_storage,
                                          xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                          priv_vanity_make_endo_type(2u, uchar(vbase + 0u)));
            priv_vanity_emit_uncompressed(isResult, buffResult, private_key, pub_neg, config,
                                          filters, filter_storage, bloom_storage, xor_storage,
                                          xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                          priv_vanity_make_endo_type(2u, uchar(vbase + 1u)));
        }

        if (config.compressed != 0u || config.segwit != 0u || config.p2wsh != 0u) {
            uint hash_odd[8] = { 0u };
            uint hash_even[8] = { 0u };
            if (config.compressed != 0u) {
                pub_pos[64] = 1u;
                priv_vanity_emit_compressed(isResult, buffResult, private_key, pub_pos, config,
                                            filters, filter_storage, bloom_storage, xor_storage,
                                            xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                            priv_vanity_make_endo_type(0u, odd_variant), hash_odd);
                pub_pos[64] = 0u;
                priv_vanity_emit_compressed(isResult, buffResult, private_key, pub_pos, config,
                                            filters, filter_storage, bloom_storage, xor_storage,
                                            xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                            priv_vanity_make_endo_type(0u, even_variant), hash_even);
            } else if (config.segwit != 0u) {
                int keyLenSkipOdd = 0;
                pub_pos[64] = 1u;
                _GetHash160Comp(pub_pos, keyLenSkipOdd, reinterpret_cast<thread uchar*>(hash_odd));
                int keyLenSkipEven = 0;
                pub_pos[64] = 0u;
                _GetHash160Comp(pub_pos, keyLenSkipEven, reinterpret_cast<thread uchar*>(hash_even));
            }
            if (config.segwit != 0u) {
                uint seg_hash[8];
                for (uint i = 0u; i < 8u; ++i) {
                    seg_hash[i] = hash_odd[i];
                }
                priv_vanity_emit_segwit_from_comp_hash(isResult, buffResult, private_key, seg_hash,
                                                       config, filters, filter_storage, bloom_storage,
                                                       xor_storage, xor_un_storage, xor_uc_storage,
                                                       xor_hc_storage, found,
                                                       priv_vanity_make_endo_type(1u, odd_variant));
                for (uint i = 0u; i < 8u; ++i) {
                    seg_hash[i] = hash_even[i];
                }
                priv_vanity_emit_segwit_from_comp_hash(isResult, buffResult, private_key, seg_hash,
                                                       config, filters, filter_storage, bloom_storage,
                                                       xor_storage, xor_un_storage, xor_uc_storage,
                                                       xor_hc_storage, found,
                                                       priv_vanity_make_endo_type(1u, even_variant));
            }
            if (config.p2wsh != 0u) {
                pub_pos[64] = 1u;
                priv_vanity_emit_p2wsh(isResult, buffResult, private_key, pub_pos, config,
                                       filters, filter_storage, bloom_storage, xor_storage,
                                       xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                       priv_vanity_make_endo_type(PRIV_VANITY_ENDO_GROUP_P2WSH, odd_variant));
                pub_pos[64] = 0u;
                priv_vanity_emit_p2wsh(isResult, buffResult, private_key, pub_pos, config,
                                       filters, filter_storage, bloom_storage, xor_storage,
                                       xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                       priv_vanity_make_endo_type(PRIV_VANITY_ENDO_GROUP_P2WSH, even_variant));
            }
            pub_pos[64] = pubkey65[64];
        }

        if (config.taproot != 0u) {
            priv_vanity_emit_taproot(isResult, buffResult, private_key, pub_pos, precPtr, precPitch,
                                     config, filters, filter_storage, bloom_storage, xor_storage,
                                     xor_un_storage, xor_uc_storage, xor_hc_storage, found,
                                     priv_vanity_make_endo_type(4u, base_variant));
        }
        if (config.xpoint != 0u) {
            priv_vanity_emit_x(isResult, buffResult, private_key, pub_pos, config, filters,
                               filter_storage, bloom_storage, xor_storage, xor_un_storage,
                               xor_uc_storage, xor_hc_storage, found,
                               priv_vanity_make_endo_type(5u, base_variant));
        }
        if (config.ethereum != 0u) {
            priv_vanity_emit_eth(isResult, buffResult, private_key, pub_pos, config, filters,
                                 filter_storage, bloom_storage, xor_storage, xor_un_storage,
                                 xor_uc_storage, xor_hc_storage, found,
                                 priv_vanity_make_endo_type(3u, base_variant));
        }
    }
}

static inline void priv_vanity_run(PrivVanityKind kind,
                                   device bool* isResult,
                                   device bool* buffResult,
                                   constant secp256k1_ge_storage* precPtr,
                                   ulong precPitch,
                                   int mode,
                                   const device uchar* start_point,
                                   ulong step,
                                   int thread_steps_pub,
                                   device RuntimeConfig& config,
                                   device XorFilterState& filters,
                                   device FilterStorageState& filter_storage,
                                   const device uchar* bloom_storage,
                                   const device uchar* xor_storage,
                                   const device uchar* xor_un_storage,
                                   const device uchar* xor_uc_storage,
                                   const device uchar* xor_hc_storage,
                                   FoundBuffers found,
                                   uint tid) {
    if (start_point == nullptr || precPtr == nullptr || thread_steps_pub <= 0 ||
        config.secp256 == 0u || !priv_vanity_filters_active(config)) {
        return;
    }

    const ulong starter = ulong(thread_steps_pub) * ulong(tid);
    uchar prvKeys[PRIV_VANITY_BATCH * 32u];
    uchar pubKeys[PRIV_VANITY_BATCH * 65u];

    for (uint base = 0u; base < uint(thread_steps_pub); base += PRIV_VANITY_BATCH) {
        const uint count = min(PRIV_VANITY_BATCH, uint(thread_steps_pub) - base);
        for (uint i = 0u; i < count; ++i) {
            const ulong idx = priv_vanity_result_index(mode, starter, base + i);
            priv_build_seq128_key(prvKeys + i * 32u, start_point, mode, idx, step);
        }

        secp256k1_ec_pubkey_create_serialized_batch_myunsafe(pubKeys,
                                                             prvKeys,
                                                             int(count),
                                                             precPtr,
                                                             size_t(precPitch));

        for (uint i = 0u; i < count; ++i) {
            thread uchar* private_key = prvKeys + i * 32u;
            thread uchar* pubkey65 = pubKeys + i * 65u;
            if (kind == PrivVanityKindCusr) {
                priv_vanity_emit_cusr(isResult, buffResult, private_key, pubkey65, precPtr,
                                      precPitch, config, filters, filter_storage, bloom_storage,
                                      xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                      found);
            } else {
                priv_vanity_emit_kind(kind, isResult, buffResult, private_key, pubkey65, precPtr,
                                      precPitch, config, filters, filter_storage, bloom_storage,
                                      xor_storage, xor_un_storage, xor_uc_storage, xor_hc_storage,
                                      found);
            }
        }
    }
}

static inline void priv_vanity_run_parity_walk(PrivVanityKind kind,
                                               bool persist_centers,
                                               device bool* isResult,
                                               device bool* buffResult,
                                               constant secp256k1_ge_storage* precPtr,
                                               ulong precPitch,
                                               int mode,
                                               const device uchar* start_point,
                                               ulong step,
                                               int thread_steps_pub,
                                               device ulong* startx_buf,
                                               device ulong* starty_buf,
                                               const device ulong* vanity_gx,
                                               const device ulong* vanity_gy,
                                               const device ulong* vanity_2gnx,
                                               const device ulong* vanity_2gny,
                                               device RuntimeConfig& config,
                                               device XorFilterState& filters,
                                               device FilterStorageState& filter_storage,
                                               const device uchar* bloom_storage,
                                               const device uchar* xor_storage,
                                               const device uchar* xor_un_storage,
                                               const device uchar* xor_uc_storage,
                                               const device uchar* xor_hc_storage,
                                               FoundBuffers found,
                                               uint tid,
                                               uint tid_in_group,
                                               uint threads_per_group,
                                               uint threadgroup_position) {
    if (startx_buf == nullptr || starty_buf == nullptr || vanity_gx == nullptr ||
        vanity_gy == nullptr || vanity_2gnx == nullptr || vanity_2gny == nullptr ||
        step == 0ul || thread_steps_pub <= 0 ||
        (uint(thread_steps_pub) % PRIV_VANITY_GRP_SIZE) != 0u) {
        priv_vanity_run(kind, isResult, buffResult, precPtr, precPitch, mode,
                        start_point, step, thread_steps_pub, config, filters, filter_storage,
                        bloom_storage, xor_storage, xor_un_storage, xor_uc_storage,
                        xor_hc_storage, found, tid);
        return;
    }
    if (start_point == nullptr || precPtr == nullptr || config.secp256 == 0u ||
        !priv_vanity_filters_active(config)) {
        return;
    }

    device ulong* start_x_base = startx_buf + ulong(threadgroup_position) *
        4ul * ulong(threads_per_group);
    device ulong* start_y_base = starty_buf + ulong(threadgroup_position) *
        4ul * ulong(threads_per_group);
    ulong center_x[4];
    ulong center_y[4];
    worker_priv_seq_load256a(center_x, start_x_base, tid_in_group, threads_per_group);
    worker_priv_seq_load256a(center_y, start_y_base, tid_in_group, threads_per_group);

    const ulong starter = ulong(thread_steps_pub) * ulong(tid);
    const uint num_batches = uint(thread_steps_pub) / PRIV_VANITY_GRP_SIZE;
    PrivVanityParityEmitter emitter = {
        kind,
        isResult,
        buffResult,
        start_point,
        mode,
        0ul,
        step,
        &config,
        &filters,
        &filter_storage,
        bloom_storage,
        xor_storage,
        xor_un_storage,
        xor_uc_storage,
        xor_hc_storage,
        found
    };

    for (uint batch = 0u; batch < num_batches; ++batch) {
        emitter.batchBase = starter + ulong(batch) * ulong(PRIV_VANITY_GRP_SIZE);
        vanity_walk_batch_1024_parity(center_x, center_y, vanity_gx, vanity_gy,
                                      vanity_2gnx, vanity_2gny, mode != 1, emitter);
    }

    if (persist_centers) {
        worker_priv_seq_store256a(start_x_base, center_x, tid_in_group, threads_per_group);
        worker_priv_seq_store256a(start_y_base, center_y, tid_in_group, threads_per_group);
    }
}

